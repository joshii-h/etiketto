msgstr ""

#. type: Bullet: '- '
#: docs/server-install.md
#, markdown-text
msgid "`max_copies` per printer set to what is sensible."
msgstr ""

#. type: Bullet: '- '
#: docs/server-install.md
#, markdown-text
msgid "The server reachable only through the HTTPS proxy, only from the networks that need it; never from the internet."
msgstr ""

#. type: Bullet: '- '
#: docs/server-install.md
#, markdown-text
msgid "`--trusted-proxy` set to the proxy's own address, nothing wider."
msgstr ""

#. type: Bullet: '- '
#: docs/server-install.md
