#: tavletta/app.py:147 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "กล่องและกรอบ"

#: tavletta/app.py:221 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "ออกแบบและพิมพ์ฉลาก"

#: tavletta/app.py:224
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta เป็นภาษาโรมานช์ แปลว่าแผ่นกระดานเล็ก ๆ (มาจาก tavla แผ่นกระดาน/โต๊ะ) อ่านว่า tav-LET-ta"

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:230
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:238
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "แนวคิดสำหรับตัวแปร (ตัวนับ วันที่ UUID) ไม่มีโค้ด"

#: tavletta/app.py:241
msgid "Protocol knowledge"
msgstr "ความรู้ด้านโพรโทคอล"

#: tavletta/app.py:246
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "จาก %(projects)s และคู่มือของผู้ผลิต เขียนขึ้นใหม่โดยไม่ใช้โค้ดของโครงการเหล่านั้น ดู THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "ต้องการ NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ต้องการจำนวนเต็มตั้งแต่ %(min)d ถึง %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "ต้องการแถว เช่น 3-10, 5 หรือ 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "หากไม่มีคำสั่ง แอปจะเริ่มทำงาน และเปิดไฟล์ฉลากที่ระบุในแอป"

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "พิมพ์ไฟล์ฉลากโดยไม่เปิดหน้าต่าง"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "พิมพ์ไฟล์ฉลากโดยไม่เปิดหน้าต่าง"

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "ฉลาก (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "รุ่นเครื่องพิมพ์ ค่าเริ่มต้นคือรุ่นของฉลาก: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "ที่อยู่เครื่องพิมพ์ ค่าเริ่มต้นคือที่ตั้งไว้ในแอป"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "จำนวนสำเนา"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "ข้อความขององค์ประกอบ NAME หรือค่าของตัวแปร {=NAME} ตัวแปรในข้อความจะถูกเติมค่า ใช้ซ้ำได้"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "เหมือน --set แต่ใช้ค่าตามที่ระบุ: วงเล็บปีกกาไม่ใช่ตัวแปร"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "ตัวนับของฉลากแรก แทนค่าที่บันทึกไว้ในฉลาก"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "พิมพ์ด้วยค่าเริ่มต้นของรุ่นเครื่องพิมพ์ แทนการตัด สี คุณภาพ ตัวเลือกเพิ่มเติม (พิมพ์ต่อเนื่อง ความละเอียดสูง การป้อนเทป) การตั้งค่าเครื่องพิมพ์ และเส้นขอบแผ่นฉลากที่เลือกไว้ล่าสุดในแอป ที่อยู่และระยะขอบปลอดภัยยังคงเดิม"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "วิธีพิมพ์ของเครื่องพิมพ์ความร้อนที่มีการตั้งค่านี้: printer (ตามที่ตั้งไว้ในเครื่องพิมพ์), transfer (ใช้ริบบอน) หรือ direct (ความร้อนโดยตรง ไม่ใช้ริบบอน) ค่าเริ่มต้นคือวิธีที่เลือกไว้ในแอป เมื่อใช้ --printer-defaults จะเป็นวิธีที่ตั้งไว้ในเครื่องพิมพ์"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "ไม่ต้องถามเครื่องพิมพ์ก่อนเรนเดอร์ (รุ่น เทป และความละเอียด)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ไม่บันทึกค่าตัวนับถัดไปลงในฉลาก (ไฟล์อ่านอย่างเดียว) การพิมพ์ครั้งถัดไปจะเริ่มจากหมายเลขเดิม"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "ฉลากแบบชุด: หนึ่งฉลากต่อแต่ละแถวของไฟล์ CSV, ODS หรือ XLSX นี้ ค่าเริ่มต้นคือไฟล์ข้อมูลของฉลาก"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "ชีตของไฟล์ข้อมูล ค่าเริ่มต้นคือชีตแรก"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "เฉพาะแถวเหล่านี้ของไฟล์ข้อมูล เช่น 3-10, 5 หรือ 7- (นับจาก 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "ตรวจสอบและเรนเดอร์เท่านั้น ไม่พิมพ์"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "เมื่อใช้ --dry-run: บันทึกแต่ละฉลากเป็น PNG แบบที่หน้าต่างส่งออก สูงสุด 600 dpi (- สำหรับ stdout: เฉพาะฉลากแรก)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "แสดงรายการเครื่องพิมพ์ที่พบในเครือข่าย"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "แสดงรายการเครื่องพิมพ์ที่พบในเครือข่าย: รุ่น ที่อยู่ ชื่อ"

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "เฉพาะเครื่องพิมพ์รุ่นนี้: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "ต้องเป็นที่อยู่หรือเครือข่าย เช่น 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "โฟลเดอร์ที่มีไฟล์ฉลากที่เซิร์ฟเวอร์ใช้ได้"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "พิมพ์เฉพาะที่ที่อยู่เครื่องพิมพ์นี้ (* ตรงกับทุกค่า) ใช้ซ้ำได้"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: เครื่องพิมพ์ที่ไคลเอนต์ใช้ได้ ตามชื่อ"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "จำนวนฉลากสูงสุดในงานพิมพ์หนึ่งงาน คือจำนวนสำเนาคูณจำนวนแถว (ค่าเริ่มต้น 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "ค้นหาเครื่องพิมพ์ในเครือข่าย (ปิดเป็นค่าเริ่มต้น)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "อนุญาตหน้าเอกสาร (PDF, รูปภาพ) ในฉลากที่ส่งมากับคำขอ แล้ว PDF จะถูกวาดในโพรเซสแยกที่มีขีดจำกัด (ปิดโดยค่าเริ่มต้น)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "เรียกใช้เซิร์ฟเวอร์การพิมพ์พร้อม REST API"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "เรียกใช้เซิร์ฟเวอร์การพิมพ์: REST API และเมื่อใช้ --mcp จะมี MCP สำหรับไคลเอนต์ AI ด้วย"

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "ที่อยู่ที่จะรับฟัง (ค่าเริ่มต้น 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "พอร์ตที่จะรับฟัง (ค่าเริ่มต้น %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "ไฟล์ที่มีโทเค็นการเข้าถึง หากไม่มีจะใช้ตัวแปรสภาพแวดล้อม TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: โทเค็นการเข้าถึงที่มีชื่อพร้อมบทบาท"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "ให้บริการ MCP ที่ /mcp ด้วย"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "ขนาดเนื้อหาคำขอสูงสุดเป็น MB (ค่าเริ่มต้น 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "พร็อกซีย้อนกลับที่ส่วนหัว X-Forwarded-For ระบุไคลเอนต์ เช่น 172.16.0.0/12 ใช้ซ้ำได้"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "อนุญาตคำขอจากหน้าเว็บของต้นทางนี้ ใช้ซ้ำได้"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "ให้บริการ MCP ผ่านอินพุตและเอาต์พุตมาตรฐาน"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "ให้บริการ MCP ผ่านอินพุตและเอาต์พุตมาตรฐาน สำหรับไคลเอนต์ AI เช่น Claude Desktop"

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "จัดการโทเค็นการเข้าถึงของเซิร์ฟเวอร์การพิมพ์"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "จัดการโทเค็นการเข้าถึงของเซิร์ฟเวอร์การพิมพ์"

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "สร้างโทเค็นและเพิ่มแฮชของโทเค็นลงใน tokens.toml"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "สร้างโทเค็น เพิ่มแฮชลงใน tokens.toml และแสดงโทเค็นเพียงครั้งเดียว"

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "ชื่อของโทเค็น เช่น ชื่ออุปกรณ์"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: ดูได้อย่างเดียว; print: พิมพ์ได้ด้วย; admin: จัดการงานทั้งหมดได้ด้วย"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "tokens.toml ที่จะเพิ่มโทเค็นลงไป"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "เฉพาะเครื่องพิมพ์นี้จาก printers.toml ใช้ซ้ำได้"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml สำหรับตรวจสอบ --printer"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "ใช้ได้ถึง เช่น 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "หมายเหตุสำหรับผู้ใช้"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "จัดเก็บแฮชด้วย scrypt แทน SHA-256"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "รับโทเค็นที่คุณเลือกเองจากอินพุตมาตรฐาน (จัดเก็บด้วย scrypt) แทนการสร้างใหม่"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:538
#, python-format
msgid "Unknown printer model: %s"
msgstr "ไม่รู้จักรุ่นเครื่องพิมพ์: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:658
#: tavletta/server/service.py:686
#, python-format
msgid "Cannot open %s"
msgstr "เปิด %s ไม่ได้"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ไม่ใช่วันที่ ต้องการเช่น 2026-12-31 หรือ 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} จะถูกเติมเมื่อพิมพ์และตั้งค่าไม่ได้"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "ฉลากไม่มีองค์ประกอบหรือตัวแปรชื่อ %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1015
msgid "The label is empty"
msgstr "ฉลากว่างเปล่า"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "เขียนเอาต์พุตไม่ได้"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output เขียนภาพ PNG: ระบุชื่อที่ลงท้ายด้วย .png"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:920
#: tavletta/server/service.py:943 tavletta/server/service.py:1192
#: tavletta/server/service.py:1347
msgid "The label cannot be prepared for printing."
msgstr "เตรียมฉลากสำหรับพิมพ์ไม่ได้"

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "ไม่พบเครื่องพิมพ์ – ระบุที่อยู่ด้วย --host"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "พบเครื่องพิมพ์หลายเครื่อง – เลือกหนึ่งเครื่องด้วย --host (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:701 tavletta/server/service.py:1337
#, python-format
msgid "Cannot save %s"
msgstr "บันทึก %s ไม่ได้"

#: tavletta/cli.py:757 tavletta/server/service.py:1340
msgid "the labels were printed, but the next counter value was not saved"
msgstr "พิมพ์ฉลากแล้ว แต่ไม่ได้บันทึกค่าตัวนับถัดไป"

#: tavletta/cli.py:772 tavletta/server/service.py:1044
msgid "nothing was printed: the next counter value could not be saved"
msgstr "ไม่ได้พิมพ์อะไรเลย: บันทึกค่าตัวนับถัดไปไม่ได้"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "ถูกขัดจังหวะ"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: เครื่องพิมพ์รุ่นนี้ไม่มีการตั้งค่าวิธีพิมพ์: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet และ --rows ต้องใช้ไฟล์ข้อมูล (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:783
msgid "No rows to print"
msgstr "ไม่มีแถวที่จะพิมพ์"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
