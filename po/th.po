msgstr "จุด"

#: tavletta/ui/texts.py:173
msgid "Double"
msgstr "เส้นคู่"

#: tavletta/ui/texts.py:175
msgid "Line"
msgstr "เส้น"

#: tavletta/ui/texts.py:176
msgid "Rectangle"
msgstr "สี่เหลี่ยมผืนผ้า"

#: tavletta/ui/texts.py:177
msgid "Ellipse"
msgstr "วงรี"

#: tavletta/ui/texts.py:178
msgid "Separator"
msgstr "เส้นคั่น"

#: tavletta/ui/texts.py:181
msgid "Horizontal"
msgstr "แนวนอน"

#: tavletta/ui/texts.py:182
msgid "Vertical"
msgstr "แนวตั้ง"

#: tavletta/ui/texts.py:183
msgid "Diagonal, rising"
msgstr "แนวทแยง ขึ้น"

#: tavletta/ui/texts.py:184
msgid "Diagonal, falling"
msgstr "แนวทแยง ลง"

#: tavletta/ui/texts.py:187
msgctxt "arrows"
msgid "None"
msgstr "ไม่มี"

#: tavletta/ui/texts.py:188
msgid "At the start"
msgstr "ที่จุดเริ่มต้น"

#: tavletta/ui/texts.py:189
msgid "At the end"
msgstr "ที่จุดสิ้นสุด"

#: tavletta/ui/texts.py:190
msgid "At both ends"
msgstr "ที่ทั้งสองปลาย"

#: tavletta/ui/texts.py:193
msgctxt "fill"
msgid "None"
msgstr "ไม่มี"

#: tavletta/ui/texts.py:194
