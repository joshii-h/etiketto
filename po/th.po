msgstr "ขวา"

#: etiketto/ui/texts.py:39
msgid "QR code"
msgstr "รหัส QR"

#: etiketto/ui/texts.py:51
#, python-format
msgid "Not an image: %s"
msgstr "ไม่ใช่รูปภาพ: %s"

#: etiketto/ui/texts.py:59
msgid "Image"
msgstr "รูปภาพ"

#: etiketto/ui/texts.py:81
msgid "System printer (CUPS, IPP)"
msgstr "เครื่องพิมพ์ของระบบ (CUPS, IPP)"

#: etiketto/ui/texts.py:87
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "องค์ประกอบ %(n)d: รหัสว่างเปล่า"

#: etiketto/ui/texts.py:88
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "องค์ประกอบ %(n)d: EAN-13 ต้องมีตัวเลข 12 หลักพอดี"

#: etiketto/ui/texts.py:89
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "องค์ประกอบ %(n)d: เลขตรวจสอบของ EAN-13 ไม่ถูกต้อง"

#: etiketto/ui/texts.py:90
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "องค์ประกอบ %(n)d: Code 128 มีได้ไม่เกิน %(max)d อักขระ"

#: etiketto/ui/texts.py:92
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "องค์ประกอบ %(n)d: แท่งบางเกินไปจนสแกนได้ไม่แน่นอน – ใช้ฉลากที่ยาวขึ้นหรือใหญ่ขึ้น หรือเนื้อหาที่สั้นลง"

#: etiketto/ui/texts.py:96
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "องค์ประกอบ %(n)d: Code 128 รับเฉพาะอักษรละติน ตัวเลข และเครื่องหมายวรรคตอน"

#: etiketto/ui/texts.py:98
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "องค์ประกอบ %(n)d: อ่านรูปภาพไม่ได้"

#: etiketto/ui/texts.py:99
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "วาดองค์ประกอบ %(n)d ไม่ได้"

#: etiketto/ui/texts.py:100
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "ระยะขอบปลอดภัย กรอบ และระยะขอบไม่เหลือพื้นที่ – โปรดลดลง"

#: etiketto/ui/texts.py:101
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "ความยาวคงที่สั้นกว่าระยะห่าง – โปรดเพิ่ม"

#: etiketto/ui/texts.py:102
msgid "The background image cannot be read"
msgstr "อ่านรูปพื้นหลังไม่ได้"

#: etiketto/ui/texts.py:103
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "องค์ประกอบ %(n)d: %(name)s ไม่ใช่ตัวแปรที่รู้จัก"

#: etiketto/ui/texts.py:105
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "องค์ประกอบ %(n)d: วันที่ของ %(name)s อยู่ก่อนปี 1 หรือหลังปี 9999"

#: etiketto/ui/texts.py:108
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "องค์ประกอบ %(n)d: ตัวแปร %(name)s… ไม่ได้ปิด – ปิดด้วย }"

#: etiketto/ui/texts.py:121
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "ฉลากที่พิมพ์แล้ว: %(n)d จาก %(total)d"

#: etiketto/ui/texts.py:126
msgid "The labels still waiting in the queue were canceled."
msgstr "ฉลากที่ยังรออยู่ในคิวถูกยกเลิกแล้ว"

#: etiketto/ui/texts.py:135
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "ไม่พบเครื่องพิมพ์ ตรวจสอบว่าเครื่องพิมพ์เปิดอยู่และอยู่ในเครือข่ายเดียวกัน หรือป้อนที่อยู่ IP"

#: etiketto/ui/texts.py:138
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "เครื่องพิมพ์ไม่ตอบสนอง ตรวจสอบว่าเครื่องพิมพ์เปิดอยู่และไม่ได้อยู่ในโหมดพัก"

#: etiketto/ui/texts.py:140
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "เครื่องพิมพ์ปฏิเสธการเชื่อมต่อ ปิดแล้วเปิดเครื่องพิมพ์ใหม่ หากหน้าเว็บของเครื่องมีตัวเลือก “Port 9100” ให้เปิดใช้"

#: etiketto/ui/texts.py:143
msgid "No cassette is inserted. Insert one and try again."
msgstr "ไม่ได้ใส่ตลับ ใส่ตลับแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:144
msgid "The printer's cover is open. Close it and try again."
msgstr "ฝาเครื่องพิมพ์เปิดอยู่ ปิดฝาแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:145
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "ฉลากติดค้าง เปิดฝา นำฉลากออก แล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:146
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "ไม่รู้จักตลับ ใส่ตลับใหม่หรือลองตลับอื่น"

#: etiketto/ui/texts.py:147
msgid "The printer is busy. Wait a moment and try again."
msgstr "เครื่องพิมพ์ไม่ว่าง รอสักครู่แล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:148
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "ฉลากยาวเกินไปสำหรับเครื่องพิมพ์นี้: ยาวได้สูงสุด %(max)s"

#: etiketto/ui/texts.py:149
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "ฉลากกว้างเกินไปสำหรับเครื่องพิมพ์นี้ กว้างได้สูงสุด %(max)s"

#: etiketto/ui/texts.py:150
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "ฉลากในเครื่องพิมพ์หมด ใส่ม้วนใหม่แล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:151
msgid "The print head is open. Close it and try again."
msgstr "หัวพิมพ์เปิดอยู่ ปิดแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:153
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "เครื่องพิมพ์หาฉลากถัดไปไม่พบ ตรวจสอบว่าใส่ฉลากถูกต้องและผ่านเซนเซอร์ฉลาก"

#: etiketto/ui/texts.py:157
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "ริบบอนมีปัญหา ตรวจสอบว่าใส่ถูกต้องและตรงกับวิธีพิมพ์ที่ตั้งไว้บนเครื่องพิมพ์"

#: etiketto/ui/texts.py:160
msgid "The printer is paused. Resume it on its display and try again."
msgstr "เครื่องพิมพ์หยุดชั่วคราว ให้ทำงานต่อจากหน้าจอของเครื่องแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:161
msgid "The printer is out of paper. Load paper and try again."
msgstr "กระดาษในเครื่องพิมพ์หมด ใส่กระดาษแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:163
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "กระดาษติด ให้นำกระดาษออกตามที่หน้าจอของเครื่องพิมพ์แสดงแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:165
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "หมึกหรือผงหมึกในเครื่องพิมพ์หมด ให้เปลี่ยนแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:166
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "เครื่องพิมพ์ไม่สามารถพิมพ์ขนาดนี้ได้ ให้เลือกขนาดกระดาษที่เครื่องพิมพ์รองรับ"

#: etiketto/ui/texts.py:168
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "เครื่องพิมพ์ไม่รับรูปแบบใดเลยที่ Etiketto ส่งได้ (PDF, PWG Raster, JPEG)"

#: etiketto/ui/texts.py:171
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "คิวของเครื่องพิมพ์หยุดชั่วคราว ให้ทำงานต่อในการตั้งค่าเครื่องพิมพ์ของระบบแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:175
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "งานพิมพ์ถูกพักไว้ในคิว เช่น จนกว่าจะถูกปล่อยหรือมีการป้อนรหัสผ่าน ตรวจสอบคิวในการตั้งค่าเครื่องพิมพ์ของระบบแล้วลองอีกครั้ง"

#: etiketto/ui/texts.py:179
msgid "The print job was canceled at the printer or in the queue."
msgstr "งานพิมพ์ถูกยกเลิกที่เครื่องพิมพ์หรือในคิว"

#: etiketto/ui/texts.py:181
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "เครื่องพิมพ์รายงานปัญหา ปิดแล้วเปิดเครื่องพิมพ์ใหม่ จากนั้นลองอีกครั้ง"

#: etiketto/ui/texts.py:192
msgid "Printed"
msgstr "พิมพ์แล้ว"

#: etiketto/ui/texts.py:198
msgid "Sent to the printer – it prints when its turn comes"
msgstr "ส่งไปยังเครื่องพิมพ์แล้ว – จะพิมพ์เมื่อถึงคิว"

#: etiketto/ui/texts.py:202
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "เครื่องพิมพ์นี้ไม่มีโหมดสี “%(wanted)s” จึงพิมพ์ด้วย “%(used)s”"

#: etiketto/ui/texts.py:212
msgid "Warming up…"
msgstr "กำลังอุ่นเครื่อง…"

#: etiketto/ui/texts.py:213
msgid "Cooling down…"
msgstr "กำลังลดอุณหภูมิ…"

#: etiketto/ui/texts.py:214
msgid "Cleaning…"
msgstr "กำลังทำความสะอาด…"

#: etiketto/ui/texts.py:215
msgid "Swipe the printer's panel to cut the label"
msgstr "ปัดแผงของเครื่องพิมพ์เพื่อตัดฉลาก"

#: etiketto/ui/texts.py:217
msgid "Out of paper – load paper to continue"
msgstr "กระดาษหมด – ใส่กระดาษเพื่อดำเนินการต่อ"

#: etiketto/ui/texts.py:218
msgid "Cover open – close it to continue"
msgstr "ฝาเปิดอยู่ – ปิดฝาเพื่อดำเนินการต่อ"

#: etiketto/ui/texts.py:219
msgid "Paper jammed – remove it to continue"
msgstr "กระดาษติด – นำกระดาษออกเพื่อดำเนินการต่อ"

#: etiketto/ui/texts.py:230
msgid "This label needs a newer version of Etiketto"
msgstr "ฉลากนี้ต้องใช้ Etiketto รุ่นที่ใหม่กว่า"

#: etiketto/ui/texts.py:232
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s ไม่ใช่ฉลาก Etiketto"

#: etiketto/ui/texts.py:233 etiketto/ui/texts.py:253
#: etiketto/server/service.py:681
#, python-format
msgid "The file is damaged: %s"
msgstr "ไฟล์เสียหาย: %s"

#: etiketto/ui/texts.py:240
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "ไม่พบไฟล์ข้อมูล %s แล้ว เลือกไฟล์ใหม่อีกครั้งหรือเอาออก"

#: etiketto/ui/texts.py:244
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s ไม่มีชีตชื่อ %(sheet)s"

#: etiketto/ui/texts.py:246
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s ไม่ใช่ตาราง ใช้ไฟล์ CSV, ODS หรือ XLSX"

#: etiketto/ui/texts.py:248
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s ใหญ่เกินไปสำหรับฉลากแบบชุด แบ่งเป็นไฟล์ที่เล็กลง หรือเอาแถวและคอลัมน์ที่ไม่ต้องใช้ออก"

#: etiketto/ui/texts.py:251
#, python-format
msgid "%s contains no data."
msgstr "%s ไม่มีข้อมูล"

#: etiketto/ui/texts.py:259
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "การพิมพ์หยุดที่แถว %(row)d หากต้องการพิมพ์ต่อ ให้พิมพ์ใหม่ตั้งแต่แถว %(row)d"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "สำเนาของแถว %(row)d ที่พิมพ์แล้ว: %(copies)d"

#: etiketto/ui/texts.py:273
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "บันทึก %s ไม่ได้: ไม่มีสิทธิ์เขียนที่นั่น"

#: etiketto/ui/texts.py:275
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "บันทึก %s ไม่ได้: ดิสก์เต็ม"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "ตลับนี้น่าจะผลิตเมื่อ %(month)s %(year)d กระดาษ ZINK ที่เก่าจะพิมพ์สีได้จางลง"

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "วันที่"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "ควรบริโภคก่อน (ใน 30 วัน)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "เวลา"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "ตัวนับ"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "ตัวนับแบบมีเลขศูนย์นำหน้า"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "หมายเลขสำเนา"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "จำนวนสำเนา"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "ID แบบสุ่ม"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "แทรกตัวแปร"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "ตัวแปรจะถูกเติมเมื่อพิมพ์ ฉลากที่พิมพ์แต่ละใบจะได้ค่าตัวนับถัดไป รวมถึงจากสำเนาหนึ่งไปอีกสำเนาหนึ่งด้วย ตัวอย่างจะแสดงค่าของการพิมพ์ครั้งถัดไป"

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "เพิ่มเติมเกี่ยวกับตัวแปร"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "เพิ่มขึ้นทุกครั้งที่พิมพ์ฉลาก ตามค่าขั้น"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "ตัวเลขถัดไป"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "ขั้น"

#: etiketto/ui/window.py:101
msgid "Open"
msgstr "เปิด"

#: etiketto/ui/window.py:108
msgid "Templates"
msgstr "แม่แบบ"

#: etiketto/ui/window.py:114
msgid "Save"
msgstr "บันทึก"

#: etiketto/ui/window.py:131
msgid "New label"
msgstr "ฉลากใหม่"

#: etiketto/ui/window.py:132
msgid "Save as…"
msgstr "บันทึกเป็น…"

#: etiketto/ui/window.py:134
msgid "Data for serial labels…"
msgstr "ข้อมูลสำหรับฉลากแบบชุด…"

#: etiketto/ui/window.py:135
msgid "Forget allowed data files"
msgstr "ลืมไฟล์ข้อมูลที่อนุญาตไว้"

#: etiketto/ui/window.py:136
msgid "Export PNG…"
msgstr "ส่งออกเป็น PNG…"

#: etiketto/ui/window.py:137
msgid "Help"
msgstr "วิธีใช้"

#: etiketto/ui/window.py:138
