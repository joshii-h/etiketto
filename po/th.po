msgstr "ตามขวางของม้วน"

#: etiketto/ui/texts.py:35
msgid "Along the roll"
msgstr "ตามความยาวม้วน"

#: etiketto/ui/texts.py:38
msgid "Left"
msgstr "ซ้าย"

#: etiketto/ui/texts.py:38
