msgstr "ตาราง"

#. translators: %(formats)s is a list of file formats: PNG, JPEG, …
#: tavletta/ui/texts.py:218
#, python-format
msgid ""
"%(name)s is not an image Tavletta can use. Images in %(formats)s can be used."
msgstr "%(name)s ไม่ใช่รูปภาพที่ Tavletta ใช้ได้ ใช้ได้เฉพาะรูปภาพในรูปแบบ %(formats)s"

#: tavletta/ui/texts.py:226
#, python-format
msgid "%(name)s is not a label, an image or a data file"
msgstr "%(name)s ไม่ใช่ฉลาก รูปภาพ หรือไฟล์ข้อมูล"

#. translators: the print density a NIIMBOT model uses by default
#: tavletta/ui/texts.py:244
msgctxt "print density"
msgid "Default"
msgstr "ค่าเริ่มต้น"

#: tavletta/ui/texts.py:248
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:251
#, python-format
msgid "%d in/s"
msgstr "%d นิ้ว/วินาที"

#: tavletta/ui/texts.py:260
msgid "Image"
msgstr "รูปภาพ"

#: tavletta/ui/texts.py:295
#, python-format
msgid "Endless, %(width)s wide"
msgstr "ต่อเนื่อง กว้าง %(width)s"

#: tavletta/ui/texts.py:305
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "ตรวจสอบว่าฉลากทั้งหมดอยู่ในส่วนที่เลือก ลากเพื่อย้ายส่วนที่เลือกหรือขอบของมัน หรือวาดใหม่"

#: tavletta/ui/texts.py:309
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "หลายพื้นที่อาจเป็นฉลาก ตรวจสอบส่วนที่เลือกหรือลองพื้นที่ถัดไป"

#: tavletta/ui/texts.py:311
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "เลือกทุกอย่างที่พิมพ์อยู่บนหน้าแล้ว ลากเพื่อเลือกฉลาก"

#: tavletta/ui/texts.py:312
msgid "Nothing is printed on this page."
msgstr "ไม่มีสิ่งใดพิมพ์อยู่บนหน้านี้"

#: tavletta/ui/texts.py:317
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "ไฟล์ PDF ต้องใช้ Poppler (poppler-glib) ซึ่งยังไม่ได้ติดตั้ง"

#: tavletta/ui/texts.py:328
msgid "System printer (CUPS, IPP)"
msgstr "เครื่องพิมพ์ของระบบ (CUPS, IPP)"

#: tavletta/ui/texts.py:329
msgid "Receipt printer (ESC/POS)"
msgstr "เครื่องพิมพ์ใบเสร็จ (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:331
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, ม้วนต่อเนื่อง"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:333
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, ฉลากไดคัท"

#: tavletta/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "องค์ประกอบ %(n)d: รหัสว่างเปล่า"

#: tavletta/ui/texts.py:341
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "องค์ประกอบ %(n)d: EAN-13 ต้องมีตัวเลข 12 หลักพอดี"

#: tavletta/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "องค์ประกอบ %(n)d: เลขตรวจสอบของ EAN-13 ไม่ถูกต้อง"

#: tavletta/ui/texts.py:343
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "องค์ประกอบ %(n)d: Code 128 มีได้ไม่เกิน %(max)d อักขระ"

#: tavletta/ui/texts.py:345
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "องค์ประกอบ %(n)d: แท่งบางเกินไปจนสแกนได้ไม่แน่นอน – ใช้ฉลากที่ยาวขึ้นหรือใหญ่ขึ้น หรือเนื้อหาที่สั้นลง"

#: tavletta/ui/texts.py:349
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "องค์ประกอบ %(n)d: Code 128 รับเฉพาะอักษรละติน ตัวเลข และเครื่องหมายวรรคตอน"

#: tavletta/ui/texts.py:351
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "องค์ประกอบ %(n)d: EAN-8 ต้องมีตัวเลข 7 หลัก หรือ 8 หลักเมื่อรวมเลขตรวจสอบ"

#: tavletta/ui/texts.py:352
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "องค์ประกอบ %(n)d: UPC-A ต้องมีตัวเลข 11 หลัก หรือ 12 หลักเมื่อรวมเลขตรวจสอบ"

#: tavletta/ui/texts.py:354
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "องค์ประกอบ %(n)d: UPC-E ต้องมีตัวเลข 7 หลักที่ขึ้นต้นด้วย 0 หรือ 1 หรือ 8 หลักเมื่อรวมเลขตรวจสอบ"

#: tavletta/ui/texts.py:356
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "องค์ประกอบ %(n)d: ITF-14 ต้องมีตัวเลข 13 หลัก หรือ 14 หลักเมื่อรวมเลขตรวจสอบ"

#: tavletta/ui/texts.py:357
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "องค์ประกอบ %(n)d: เลขตรวจสอบไม่ถูกต้อง"

#: tavletta/ui/texts.py:359
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "องค์ประกอบ %(n)d: Code 39 รับเฉพาะอักษรตัวพิมพ์ใหญ่ ตัวเลข ช่องว่าง และ - . $ / + %%"

#: tavletta/ui/texts.py:362
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "องค์ประกอบ %(n)d: Code 93 รับเฉพาะอักษรละติน ตัวเลข และเครื่องหมายวรรคตอน"

#: tavletta/ui/texts.py:365
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "องค์ประกอบ %(n)d: ข้อมูล GS1 รับเฉพาะอักษรละติน ตัวเลข และเครื่องหมายวรรคตอน"

#: tavletta/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "องค์ประกอบ %(n)d: ข้อมูล GS1 ต้องเป็นตัวระบุการประยุกต์ใช้ในวงเล็บ แต่ละตัวตามด้วยค่าของมัน เช่น (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:371
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "องค์ประกอบ %(n)d: (%(ai)s) ไม่ใช่ตัวระบุการประยุกต์ใช้ของ GS1"

#: tavletta/ui/texts.py:373
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "องค์ประกอบ %(n)d: ค่าของตัวระบุการประยุกต์ใช้ (%(ai)s) มีความยาวไม่ถูกต้อง"

#: tavletta/ui/texts.py:376
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "องค์ประกอบ %(n)d: เลขตรวจสอบของตัวระบุการประยุกต์ใช้ (%(ai)s) ไม่ถูกต้อง"

#: tavletta/ui/texts.py:379
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "องค์ประกอบ %(n)d: ค่าของตัวระบุการประยุกต์ใช้ (%(ai)s) ไม่ถูกต้อง: มีวันที่ ตัวเลข หรืออักขระที่ไม่อนุญาต"

#: tavletta/ui/texts.py:383
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "องค์ประกอบ %(n)d: ไม่มีหมายเลข UPC-A ที่ย่อเป็นตัวเลข UPC-E เหล่านี้ได้ – ตรวจสอบตัวเลขหรือใช้ UPC-A"

#: tavletta/ui/texts.py:387
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "องค์ประกอบ %(n)d: เครื่องสแกนที่ตั้งเป็น Full ASCII จะอ่าน $, /, + หรือ %% ที่อยู่หน้าอักษรตัวใหญ่เป็นอักขระอื่น"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "องค์ประกอบ %(n)d: เนื้อหายาวเกินไปสำหรับโค้ดประเภทนี้"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "องค์ประกอบ %(n)d: เข้ารหัสเนื้อหานี้ด้วยโค้ดประเภทนี้ไม่ได้"

#: tavletta/ui/texts.py:393
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "องค์ประกอบ %(n)d: โค้ดประเภทนี้ต้องใช้ไลบรารี Zint (zint-bindings) ซึ่งยังไม่ได้ติดตั้ง"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "องค์ประกอบ %(n)d: อ่านรูปภาพไม่ได้"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "องค์ประกอบ %(n)d: สัญลักษณ์นี้ไม่อยู่ในคลังสัญลักษณ์"

#: tavletta/ui/texts.py:398
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "องค์ประกอบ %(n)d: อ่านเอกสารไม่ได้"

#: tavletta/ui/texts.py:400
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "องค์ประกอบ %(n)d: ไฟล์ PDF ต้องใช้ Poppler (poppler-glib) ซึ่งยังไม่ได้ติดตั้ง"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "วาดองค์ประกอบ %(n)d ไม่ได้"

#: tavletta/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "องค์ประกอบ %(n)d: ไม่ได้ติดตั้งฟอนต์ %(font)s – จะใช้ฟอนต์อื่นแทน"

#: tavletta/ui/texts.py:407
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "ระยะขอบปลอดภัย กรอบ ระยะร่นเข้าของกรอบ และระยะขอบไม่เหลือพื้นที่ – โปรดลดลง"

#: tavletta/ui/texts.py:409
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "ความยาวคงที่สั้นกว่าระยะห่าง – โปรดเพิ่ม"

#: tavletta/ui/texts.py:410
msgid "The background image cannot be read"
msgstr "อ่านรูปพื้นหลังไม่ได้"

#: tavletta/ui/texts.py:412
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "องค์ประกอบ %(n)d: โมดูลของโค้ดกว้างเพียงหนึ่งจุดพิมพ์และอาจสแกนไม่ได้ – ขยายโค้ดให้ใหญ่ขึ้น"

#: tavletta/ui/texts.py:416
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "องค์ประกอบ %(n)d: พื้นที่ว่างรอบโค้ดที่จำเป็นไม่พอ – ขยายโค้ดให้ใหญ่ขึ้น"

#: tavletta/ui/texts.py:420
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "องค์ประกอบ %(n)d: โค้ดไม่พอดีกับพื้นที่ แม้ใช้หนึ่งจุดพิมพ์ต่อโมดูล – ขยายฉลากหรือลดเนื้อหาให้สั้นลง"

#: tavletta/ui/texts.py:423
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "องค์ประกอบ %(n)d: %(name)s ไม่ใช่ตัวแปรที่รู้จัก"

#: tavletta/ui/texts.py:425
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "องค์ประกอบ %(n)d: วันที่ของ %(name)s อยู่ก่อนปี 1 หรือหลังปี 9999"

#: tavletta/ui/texts.py:428
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "องค์ประกอบ %(n)d: ตัวแปร %(name)s… ไม่ได้ปิด – ปิดด้วย }"

#: tavletta/ui/texts.py:431
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "องค์ประกอบ %(n)d: บนเครื่องพิมพ์ขาวดำ องค์ประกอบนี้แทบไม่โดดเด่นจากสิ่งที่อยู่ด้านหลัง ทั้งหมดหรือบางส่วน – เลือกสีอื่นหรือย้ายตำแหน่ง"

#: tavletta/ui/texts.py:434
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "องค์ประกอบ %(n)d: รูปทรงไม่มีทั้งเส้นและการเติม"

#: tavletta/ui/texts.py:436
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "องค์ประกอบ %(n)d ล้ำขอบฉลากและถูกตัดออกตรงนั้น – ย้ายหรือทำให้เล็กลง"

#: tavletta/ui/texts.py:440
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "องค์ประกอบ %(n)d: ระยะห่างภายใน กรอบ เส้นขอบตัวอักษร หรือเงา ไม่เหลือพื้นที่สำหรับข้อความ – โปรดลดลง"

#: tavletta/ui/texts.py:455
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "แผ่นที่พิมพ์แล้ว: %(n)d จาก %(total)d"

#: tavletta/ui/texts.py:457
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "ฉลากที่พิมพ์แล้ว: %(n)d จาก %(total)d"

#: tavletta/ui/texts.py:461
msgid "The sheets still waiting in the queue were canceled."
msgstr "แผ่นที่ยังรออยู่ในคิวถูกยกเลิกแล้ว"

#: tavletta/ui/texts.py:463
msgid "The labels still waiting in the queue were canceled."
msgstr "ฉลากที่ยังรออยู่ในคิวถูกยกเลิกแล้ว"

#: tavletta/ui/texts.py:470
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "ฉลากขนาด %(size)s ช่องว่าง %(gap)s ดังนั้นฉลากใหม่จะเริ่มทุก %(pitch)s แต่เครื่องพิมพ์วัดได้ฉลากทุก %(measured)s ตรวจสอบขนาดฉลากและช่องว่าง"

#: tavletta/ui/texts.py:486
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "ไม่พบเครื่องพิมพ์ ตรวจสอบว่าเครื่องพิมพ์เปิดอยู่และอยู่ในเครือข่ายเดียวกัน หรือป้อนที่อยู่ IP"

#: tavletta/ui/texts.py:490
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "ไม่พบเครื่องพิมพ์ทาง USB ตรวจสอบสายเคเบิลและตรวจสอบว่าเครื่องพิมพ์เปิดอยู่และไม่ได้อยู่ในโหมดพัก แล้วค้นหาอีกครั้ง"

#: tavletta/ui/texts.py:493
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "เครื่องพิมพ์ไม่ตอบสนอง ตรวจสอบว่าเครื่องพิมพ์เปิดอยู่และไม่ได้อยู่ในโหมดพัก"

#: tavletta/ui/texts.py:495
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "เครื่องพิมพ์หยุดรับข้อมูล ตรวจสอบว่าเครื่องแสดงปัญหาหรือไม่ เช่น ฉลากหมดหรือฝาเปิดอยู่ แล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:499
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "เครื่องพิมพ์ปฏิเสธการเชื่อมต่อ ปิดแล้วเปิดเครื่องพิมพ์ใหม่ หากหน้าเว็บของเครื่องมีตัวเลือก “Port 9100” ให้เปิดใช้"

#: tavletta/ui/texts.py:502
msgid "No cassette is inserted. Insert one and try again."
msgstr "ไม่ได้ใส่ตลับ ใส่ตลับแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:503
msgid "The printer's cover is open. Close it and try again."
msgstr "ฝาเครื่องพิมพ์เปิดอยู่ ปิดฝาแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:504
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "ฉลากติดค้าง เปิดฝา นำฉลากออก แล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:505
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "ไม่รู้จักตลับ ใส่ตลับใหม่หรือลองตลับอื่น"

#: tavletta/ui/texts.py:506
msgid "The printer is busy. Wait a moment and try again."
msgstr "เครื่องพิมพ์ไม่ว่าง รอสักครู่แล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:507
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "ฉลากยาวเกินไปสำหรับเครื่องพิมพ์นี้: ยาวได้สูงสุด %(max)s"

#: tavletta/ui/texts.py:508
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "ฉลากกว้างเกินไปสำหรับเครื่องพิมพ์นี้ กว้างได้สูงสุด %(max)s"

#: tavletta/ui/texts.py:509
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "ฉลากในเครื่องพิมพ์หมด ใส่ม้วนใหม่แล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:510
msgid "The print head is open. Close it and try again."
msgstr "หัวพิมพ์เปิดอยู่ ปิดแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:512
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "เครื่องพิมพ์หาฉลากถัดไปไม่พบ ตรวจสอบว่าใส่ฉลากถูกต้องและผ่านเซนเซอร์ฉลาก"

#: tavletta/ui/texts.py:516
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "ริบบอนมีปัญหา ตรวจสอบว่าใส่ถูกต้องและตรงกับวิธีพิมพ์ที่ตั้งไว้บนเครื่องพิมพ์"

#: tavletta/ui/texts.py:522
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "เครื่องพิมพ์หาริบบอนไม่พบ ใส่ริบบอนแล้วลองอีกครั้ง ฉลากที่พิมพ์โดยไม่ใช้ริบบอนต้องเลือก “%(direct)s” ที่ “%(method)s”"

#: tavletta/ui/texts.py:529
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "ใส่ริบบอนไว้แล้ว แต่เครื่องพิมพ์พิมพ์โดยไม่ใช้ริบบอน (ความร้อนโดยตรง) สำหรับฉลากที่ต้องใช้ริบบอน ให้เลือก “%(transfer)s” ที่ “%(method)s” หรือถอดริบบอนออก"

#: tavletta/ui/texts.py:534
msgid "The printer is paused. Resume it on its display and try again."
msgstr "เครื่องพิมพ์หยุดชั่วคราว ให้ทำงานต่อจากหน้าจอของเครื่องแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:535
msgid "The printer is out of paper. Load paper and try again."
msgstr "กระดาษในเครื่องพิมพ์หมด ใส่กระดาษแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:537
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "กระดาษติด ให้นำกระดาษออกตามที่หน้าจอของเครื่องพิมพ์แสดงแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:539
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "หมึกหรือผงหมึกในเครื่องพิมพ์หมด ให้เปลี่ยนแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:540
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "เครื่องพิมพ์ไม่สามารถพิมพ์ขนาดนี้ได้ ให้เลือกขนาดกระดาษที่เครื่องพิมพ์รองรับ"

#: tavletta/ui/texts.py:542
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "เครื่องพิมพ์ไม่รับรูปแบบใดเลยที่ Tavletta ส่งได้ (PDF, PWG Raster, JPEG)"

#: tavletta/ui/texts.py:545
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "คิวของเครื่องพิมพ์หยุดชั่วคราว ให้ทำงานต่อในการตั้งค่าเครื่องพิมพ์ของระบบแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:549
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "งานพิมพ์ถูกพักไว้ในคิว เช่น จนกว่าจะถูกปล่อยหรือมีการป้อนรหัสผ่าน ตรวจสอบคิวในการตั้งค่าเครื่องพิมพ์ของระบบแล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:553
msgid "The print job was canceled at the printer or in the queue."
msgstr "งานพิมพ์ถูกยกเลิกที่เครื่องพิมพ์หรือในคิว"

#: tavletta/ui/texts.py:554
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "เครื่องพิมพ์ไม่ได้รายงานความละเอียดทันเวลา เลือกได้ที่ “%s”"

#: tavletta/ui/texts.py:557
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "ม้วนที่ใส่อยู่ไม่ตรงกับฉลาก ใส่ม้วนที่ตรงกัน หรือเลือกขนาดฉลากหรือรุ่นเครื่องพิมพ์ให้ตรงกับม้วนที่ใส่อยู่"

#: tavletta/ui/texts.py:560
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "แบตเตอรี่ของเครื่องพิมพ์เหลือน้อย – ชาร์จหรือต่ออะแดปเตอร์ไฟ"

#: tavletta/ui/texts.py:561
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "หัวพิมพ์ร้อนเกินไป รอจนเย็นลง แล้วลองอีกครั้ง"

#: tavletta/ui/texts.py:563
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta พิมพ์บนเครื่องพิมพ์รุ่นนี้ไม่ได้ เพราะเครื่องไม่รับภาพแรสเตอร์ที่ Tavletta ส่งไป"

#: tavletta/ui/texts.py:567
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta ไม่รู้จักเครื่องพิมพ์รุ่นนี้และยังพิมพ์บนเครื่องนี้ไม่ได้"

#: tavletta/ui/texts.py:570
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "เครื่องพิมพ์อยู่ในโหมด Editor Lite และแสดงเป็นไดรฟ์ USB ปิด Editor Lite ที่เครื่องพิมพ์ (ไฟดับลง) แล้วค้นหาอีกครั้ง"

#: tavletta/ui/texts.py:574
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta ไม่ได้รับอนุญาตให้ใช้พอร์ต USB ของเครื่องพิมพ์ ให้เพิ่มผู้ใช้ของคุณในกลุ่ม “lp” (sudo usermod -aG lp $USER) แล้วออกจากระบบและเข้าสู่ระบบอีกครั้ง"

#: tavletta/ui/texts.py:578
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "หน้านี้ใหญ่เกินกว่าจะสร้างที่ความละเอียดที่เครื่องพิมพ์รับได้ เลือกขนาดกระดาษที่เล็กลง หรือพิมพ์ด้วยเครื่องพิมพ์ที่รับ PDF"

#: tavletta/ui/texts.py:582
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "ที่ความละเอียดของเครื่องพิมพ์นี้ โค้ดไม่พอดีกับฉลากและจะถูกตัด ขยายฉลากหรือลดเนื้อหาของโค้ดให้สั้นลง"

#: tavletta/ui/texts.py:586
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta ไม่ได้รับอนุญาตให้ใช้พอร์ตอนุกรมของเครื่องพิมพ์ ให้เพิ่มผู้ใช้ของคุณในกลุ่ม “dialout” (sudo usermod -aG dialout $USER; บน Arch Linux กลุ่มชื่อ “uucp”) แล้วออกจากระบบและเข้าสู่ระบบอีกครั้ง"

#: tavletta/ui/texts.py:591
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "เครื่องพิมพ์รายงานปัญหา ปิดแล้วเปิดเครื่องพิมพ์ใหม่ จากนั้นลองอีกครั้ง"

#: tavletta/ui/texts.py:602
msgid "Printed"
msgstr "พิมพ์แล้ว"

#: tavletta/ui/texts.py:608
msgid "Sent to the printer – it prints when its turn comes"
msgstr "ส่งไปยังเครื่องพิมพ์แล้ว – จะพิมพ์เมื่อถึงคิว"

#: tavletta/ui/texts.py:610
msgid "Sent to the printer – it did not confirm printing"
msgstr "ส่งไปยังเครื่องพิมพ์แล้ว – เครื่องพิมพ์ไม่ได้ยืนยันการพิมพ์"

#: tavletta/ui/texts.py:614
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "พิมพ์ด้วย “%(used)s” เพราะม้วนที่ใส่อยู่ต้องใช้แบบนี้"

#: tavletta/ui/texts.py:618
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "เครื่องพิมพ์นี้ไม่มีโหมดสี “%(wanted)s” จึงพิมพ์ด้วย “%(used)s”"

#: tavletta/ui/texts.py:628
msgid "Warming up…"
msgstr "กำลังอุ่นเครื่อง…"

#: tavletta/ui/texts.py:629
msgid "Cooling down…"
msgstr "กำลังลดอุณหภูมิ…"

#: tavletta/ui/texts.py:630
msgid "Cleaning…"
msgstr "กำลังทำความสะอาด…"

#: tavletta/ui/texts.py:631
msgid "Swipe the printer's panel to cut the label"
msgstr "ปัดแผงของเครื่องพิมพ์เพื่อตัดฉลาก"

#: tavletta/ui/texts.py:633
msgid "Out of paper – load paper to continue"
msgstr "กระดาษหมด – ใส่กระดาษเพื่อดำเนินการต่อ"

#: tavletta/ui/texts.py:634
msgid "Cover open – close it to continue"
msgstr "ฝาเปิดอยู่ – ปิดฝาเพื่อดำเนินการต่อ"

#: tavletta/ui/texts.py:635
msgid "Paper jammed – remove it to continue"
msgstr "กระดาษติด – นำกระดาษออกเพื่อดำเนินการต่อ"

#: tavletta/ui/texts.py:646
msgid "This label needs a newer version of Tavletta"
msgstr "ฉลากนี้ต้องใช้ Tavletta รุ่นที่ใหม่กว่า"

#: tavletta/ui/texts.py:648
#, python-format
msgid "%s is not a Tavletta label"
msgstr "%s ไม่ใช่ฉลาก Tavletta"

#: tavletta/ui/texts.py:649 tavletta/ui/texts.py:669
#: tavletta/server/service.py:697
#, python-format
msgid "The file is damaged: %s"
msgstr "ไฟล์เสียหาย: %s"

#: tavletta/ui/texts.py:656
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "ไม่พบไฟล์ข้อมูล %s แล้ว เลือกไฟล์ใหม่อีกครั้งหรือเอาออก"

#: tavletta/ui/texts.py:660
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s ไม่มีชีตชื่อ %(sheet)s"

#: tavletta/ui/texts.py:662
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s ไม่ใช่ตาราง ใช้ไฟล์ CSV, ODS หรือ XLSX"

#: tavletta/ui/texts.py:664
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s ใหญ่เกินไปสำหรับฉลากแบบชุด แบ่งเป็นไฟล์ที่เล็กลง หรือเอาแถวและคอลัมน์ที่ไม่ต้องใช้ออก"

#: tavletta/ui/texts.py:667
#, python-format
msgid "%s contains no data."
msgstr "%s ไม่มีข้อมูล"

#: tavletta/ui/texts.py:678
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "การพิมพ์หยุดที่แถว %(row)d หากต้องการพิมพ์ต่อ ให้พิมพ์ใหม่ตั้งแต่แถว %(row)d"

#: tavletta/ui/texts.py:682
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "สำเนาของแถว %(row)d ที่พิมพ์แล้ว: %(copies)d"

#: tavletta/ui/texts.py:687
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
