#: etiketto/app.py:200 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "ออกแบบและพิมพ์ฉลาก"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "แนวคิดสำหรับตัวแปร (ตัวนับ วันที่ UUID) ไม่มีโค้ด"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "ความรู้ด้านโพรโทคอล"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "จาก %(projects)s และคู่มือของผู้ผลิต เขียนขึ้นใหม่โดยไม่ใช้โค้ดของโครงการเหล่านั้น ดู THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "ต้องการ NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ต้องการจำนวนเต็มตั้งแต่ %(min)d ถึง %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "ต้องการแถว เช่น 3-10, 5 หรือ 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "หากไม่มีคำสั่ง แอปจะเริ่มทำงาน และเปิดไฟล์ฉลากที่ระบุในแอป"

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "พิมพ์ไฟล์ฉลากโดยไม่เปิดหน้าต่าง"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "พิมพ์ไฟล์ฉลากโดยไม่เปิดหน้าต่าง"

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "ฉลาก (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "รุ่นเครื่องพิมพ์ ค่าเริ่มต้นคือรุ่นของฉลาก: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "ที่อยู่เครื่องพิมพ์ ค่าเริ่มต้นคือที่ตั้งไว้ในแอป"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "จำนวนสำเนา"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "ข้อความขององค์ประกอบ NAME หรือค่าของตัวแปร {=NAME} ตัวแปรในข้อความจะถูกเติมค่า ใช้ซ้ำได้"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "เหมือน --set แต่ใช้ค่าตามที่ระบุ: วงเล็บปีกกาไม่ใช่ตัวแปร"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "ตัวนับของฉลากแรก แทนค่าที่บันทึกไว้ในฉลาก"

#: etiketto/cli.py:203
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "ไม่ต้องถามเครื่องพิมพ์ก่อนเรนเดอร์ (รุ่น เทป และความละเอียด)"

#: etiketto/cli.py:209
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ไม่บันทึกค่าตัวนับถัดไปลงในฉลาก (ไฟล์อ่านอย่างเดียว) การพิมพ์ครั้งถัดไปจะเริ่มจากหมายเลขเดิม"

#: etiketto/cli.py:218
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "ฉลากแบบชุด: หนึ่งฉลากต่อแต่ละแถวของไฟล์ CSV, ODS หรือ XLSX นี้ ค่าเริ่มต้นคือไฟล์ข้อมูลของฉลาก"

#: etiketto/cli.py:223
msgid "the sheet of the data file, by default the first"
msgstr "ชีตของไฟล์ข้อมูล ค่าเริ่มต้นคือชีตแรก"

#: etiketto/cli.py:229
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "เฉพาะแถวเหล่านี้ของไฟล์ข้อมูล เช่น 3-10, 5 หรือ 7- (นับจาก 1)"

#: etiketto/cli.py:232
msgid "check and render only, do not print"
msgstr "ตรวจสอบและเรนเดอร์เท่านั้น ไม่พิมพ์"

#: etiketto/cli.py:238
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "เมื่อใช้ --dry-run: บันทึกภาพเป็น PNG ตามที่เครื่องพิมพ์จะได้รับ (- สำหรับ stdout: เฉพาะภาพแรก)"

#: etiketto/cli.py:244
msgid "list the printers found on the network"
msgstr "แสดงรายการเครื่องพิมพ์ที่พบในเครือข่าย"

#: etiketto/cli.py:245
msgid "List the printers found on the network: model, address, name."
msgstr "แสดงรายการเครื่องพิมพ์ที่พบในเครือข่าย: รุ่น ที่อยู่ ชื่อ"

#: etiketto/cli.py:247
#, python-format
msgid "only this printer model: %s"
msgstr "เฉพาะเครื่องพิมพ์รุ่นนี้: %s"

#: etiketto/cli.py:266
#, python-format
msgid "Unknown printer model: %s"
msgstr "ไม่รู้จักรุ่นเครื่องพิมพ์: %s"

#: etiketto/cli.py:273 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:240 etiketto/ui/texts.py:528
#, python-format
msgid "Cannot open %s"
msgstr "เปิด %s ไม่ได้"

#: etiketto/cli.py:295
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ไม่ใช่วันที่ ต้องการเช่น 2026-12-31 หรือ 2026-12-31T08:30"

#: etiketto/cli.py:325
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} จะถูกเติมเมื่อพิมพ์และตั้งค่าไม่ได้"

#: etiketto/cli.py:330
#, python-format
msgid "The label has no element or variable named %s"
msgstr "ฉลากไม่มีองค์ประกอบหรือตัวแปรชื่อ %s"

#: etiketto/cli.py:354 etiketto/ui/printing.py:99
msgid "The label is empty"
msgstr "ฉลากว่างเปล่า"

#: etiketto/cli.py:387
msgid "Cannot write the output"
msgstr "เขียนเอาต์พุตไม่ได้"

#: etiketto/cli.py:418
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output เขียนภาพ PNG: ระบุชื่อที่ลงท้ายด้วย .png"

#: etiketto/cli.py:442 etiketto/cli.py:646 etiketto/ui/printing.py:538
#: etiketto/ui/printing.py:699
msgid "The label cannot be prepared for printing."
msgstr "เตรียมฉลากสำหรับพิมพ์ไม่ได้"

#: etiketto/cli.py:524
msgid "No printer found – give its address with --host"
msgstr "ไม่พบเครื่องพิมพ์ – ระบุที่อยู่ด้วย --host"

#: etiketto/cli.py:526
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "พบเครื่องพิมพ์หลายเครื่อง – เลือกหนึ่งเครื่องด้วย --host (etiketto list-printers)"

#: etiketto/cli.py:537 etiketto/ui/texts.py:571
#, python-format
msgid "Cannot save %s"
msgstr "บันทึก %s ไม่ได้"

#: etiketto/cli.py:539
msgid "the labels were printed, but the next counter value was not saved"
msgstr "พิมพ์ฉลากแล้ว แต่ไม่ได้บันทึกค่าตัวนับถัดไป"

#: etiketto/cli.py:554
msgid "nothing was printed: the next counter value could not be saved"
msgstr "ไม่ได้พิมพ์อะไรเลย: บันทึกค่าตัวนับถัดไปไม่ได้"

#: etiketto/cli.py:614 etiketto/cli.py:641 etiketto/cli.py:899
msgid "Interrupted"
msgstr "ถูกขัดจังหวะ"

#: etiketto/cli.py:724
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "ฉลากใช้ไฟล์ข้อมูลที่อยู่นอกโฟลเดอร์ของฉลาก: ระบุด้วย --data"

#: etiketto/cli.py:730
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet และ --rows ต้องใช้ไฟล์ข้อมูล (--data)"

#: etiketto/cli.py:750 etiketto/ui/printing.py:570
msgid "No rows to print"
msgstr "ไม่มีแถวที่จะพิมพ์"

#: etiketto/cli.py:759 etiketto/ui/window.py:520
#, python-format
msgid "No such column: %s"
msgstr "ไม่มีคอลัมน์นี้: %s"

#: etiketto/cli.py:764 etiketto/ui/printing.py:649
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "ไม่สามารถสร้างบาร์โค้ดหรือคิวอาร์โค้ดของแถวเหล่านี้จากค่าของแถวได้ เช่น EAN-13 ที่มีตัวอักษร หรือเซลล์ว่าง แก้ไขไฟล์ข้อมูลแล้วอ่านอีกครั้ง หรือพิมพ์โดยไม่รวมแถวเหล่านี้"

#: etiketto/cli.py:769 etiketto/ui/printing.py:654
#, python-format
msgid "Rows: %s"
msgstr "แถว: %s"

#: etiketto/cli.py:777
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "กำลังรอให้การพิมพ์อื่นของ %s เสร็จ…"

#: etiketto/cli.py:784
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ยังถูกล็อกโดยการพิมพ์อื่น – ลองใหม่ภายหลัง"

#: etiketto/cli.py:790
msgid "--output needs --dry-run"
msgstr "--output ต้องใช้ร่วมกับ --dry-run"

#: etiketto/cli.py:804
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "ไม่ได้บันทึกค่าตัวนับถัดไป: การพิมพ์ครั้งถัดไปจะใช้หมายเลขซ้ำ"

#: etiketto/cli.py:875 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "ไม่พบเครื่องพิมพ์"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "ตาราง (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "เลือกไฟล์ข้อมูล"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:109 etiketto/ui/files.py:131
#: etiketto/ui/files.py:212 etiketto/ui/texts.py:150
msgid "Only local files can be used"
msgstr "ใช้ได้เฉพาะไฟล์ในเครื่องเท่านั้น"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto จะถามอีกครั้งก่อนอ่านไฟล์ข้อมูลที่อยู่นอกโฟลเดอร์ของฉลาก"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "อ่านไฟล์ข้อมูลหรือไม่"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "ฉลากนี้ใช้ไฟล์ข้อมูลที่อยู่นอกโฟลเดอร์ของฉลาก:\n\n%s\n\nอ่านเฉพาะเมื่อคุณรู้ว่าฉลากนี้มาจากที่ใด"

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "ไม่ใช่ตอนนี้"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "อ่านไฟล์ข้อมูล"

#: etiketto/ui/data.py:265
msgid "Reading…"
msgstr "กำลังอ่าน…"

#: etiketto/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "ยังไม่ได้อ่าน: อยู่นอกโฟลเดอร์ของฉลาก"

#: etiketto/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "แถว: %(rows)d · คอลัมน์: %(columns)d"

#: etiketto/ui/data.py:281
msgid "Serial labels"
msgstr "ฉลากแบบชุด"

#: etiketto/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
