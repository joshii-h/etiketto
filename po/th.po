msgid "Open"
msgstr "เปิด"

#: etiketto/ui/window.py:97
msgid "Templates"
msgstr "แม่แบบ"

#: etiketto/ui/window.py:103
msgid "Save"
msgstr "บันทึก"

#: etiketto/ui/window.py:120
msgid "New label"
msgstr "ฉลากใหม่"

#: etiketto/ui/window.py:121
msgid "Shipping label…"
msgstr "ฉลากจัดส่ง…"

#: etiketto/ui/window.py:122
msgid "Save as…"
msgstr "บันทึกเป็น…"

#: etiketto/ui/window.py:124
msgid "Export PNG…"
msgstr "ส่งออกเป็น PNG…"

#: etiketto/ui/window.py:125
msgid "Help"
msgstr "วิธีใช้"

#: etiketto/ui/window.py:126
msgid "Report a problem…"
msgstr "รายงานปัญหา…"

#: etiketto/ui/window.py:127
msgid "About Etiketto"
msgstr "เกี่ยวกับ Etiketto"

#: etiketto/ui/window.py:343
msgid "Unsaved label"
msgstr "ฉลากที่ยังไม่บันทึก"

#: etiketto/ui/window.py:397
msgid "content scaled down to fit"
msgstr "ย่อเนื้อหาให้พอดีแล้ว"

#: etiketto/ui/window.py:399
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "ยาวเกินไปสำหรับเครื่องพิมพ์นี้: สูงสุด %s"

#: etiketto/ui/window.py:404
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "กว้างเกินไปสำหรับเครื่องพิมพ์นี้ สูงสุด %s"

#: etiketto/ui/window.py:409
#, python-format
msgid "Problem: %s"
msgstr "ปัญหา: %s"

#: etiketto/ui/window.py:484
msgid "The browser cannot be opened"
msgstr "เปิดเบราว์เซอร์ไม่ได้"

#: etiketto/ui/window.py:486
msgid "Copy link"
msgstr "คัดลอกลิงก์"

#: etiketto/ui/window.py:532
msgid "Only local files can be dropped"
msgstr "วางได้เฉพาะไฟล์ในเครื่องเท่านั้น"

#: etiketto/ui/window.py:550
msgid "Please wait until printing has finished"
msgstr "โปรดรอจนกว่าการพิมพ์จะเสร็จ"
