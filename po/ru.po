#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Плашка и рамка"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Создание и печать этикеток"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta по-ретороманиски означает «дощечка» (от tavla — доска, стол). Произносится tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Идеи для переменных (счётчик, дата, UUID), без кода"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "Сведения о протоколах"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Из %(projects)s и руководств производителей, написано заново без их кода; см. THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "ожидается NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ожидается целое число от %(min)d до %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "ожидаются строки вида 3-10, 5 или 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Без команды запускается приложение; указанные файлы этикеток открываются в нём."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "печатает файл этикетки без открытия окна"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Печатает файл этикетки без открытия окна."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "этикетка (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "модель принтера, по умолчанию модель этикетки: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "адрес принтера, по умолчанию заданный в приложении"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "число копий"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "текст элемента NAME или значение переменной {=NAME}; переменные в тексте подставляются; можно повторять"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "как --set, но значение используется как есть: фигурные скобки не являются переменными"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "счётчик первой этикетки вместо сохранённого в этикетке"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "печатать с настройками модели принтера по умолчанию вместо обрезки, цветов, качества, дополнений (цепная печать, высокое разрешение, подача ленты), настроек принтера и контуров листов этикеток, выбранных в приложении последними; адрес и безопасное поле сохраняются"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "способ печати термопринтера, у которого есть эта настройка: printer (как настроено на принтере), transfer (с красящей лентой) или direct (прямая термопечать, без ленты); по умолчанию выбранный в приложении, с --printer-defaults — настроенный на принтере"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "не опрашивать принтер перед отрисовкой (модель, лента и разрешение)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "не сохранять следующее значение счётчика в этикетке (файл только для чтения); следующая печать начнётся с того же номера"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "серийные этикетки: по этикетке на каждую строку этого файла CSV, ODS или XLSX; по умолчанию файл данных этикетки"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "лист файла данных, по умолчанию первый"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "только эти строки файла данных, например 3-10, 5 или 7- (считая с 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "только проверить и отрисовать, не печатать"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "с --dry-run: сохраняет каждую этикетку в PNG так, как её экспортирует окно, не более 600 dpi (- для stdout: только первую)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "выводит список принтеров, найденных в сети"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "Выводит список принтеров, найденных в сети: модель, адрес, имя."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "только эта модель принтера: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "ожидается адрес или сеть, например 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "папка с файлами этикеток, которые может использовать сервер"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "печатать только на этом адресе принтера (* соответствует чему угодно); можно повторять"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: принтеры, которые клиенты могут использовать, по имени"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "максимум этикеток в одном задании печати, копии, умноженные на строки (по умолчанию 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "искать принтеры в сети (по умолчанию выключено)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "разрешить страницы документов (PDF, изображения) в этикетках, отправленных с запросом; PDF тогда рисуются в отдельном процессе с ограничениями (по умолчанию выключено)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "запускает сервер печати с REST API"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Запуск сервера печати: REST API и, с --mcp, MCP для клиентов ИИ."

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "адрес для прослушивания (по умолчанию 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "порт для прослушивания (по умолчанию %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "файл с токеном доступа; иначе переменная окружения TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: именованные токены доступа с ролями"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "также предоставлять MCP по адресу /mcp"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "максимальный размер тела запроса в MB (по умолчанию 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "обратный прокси, заголовок X-Forwarded-For которого указывает клиента, например 172.16.0.0/12; можно повторять"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "разрешать запросы с веб-страниц этого источника; можно повторять"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "предоставляет MCP через стандартный ввод и вывод"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Предоставляет MCP через стандартный ввод и вывод для клиентов ИИ, например Claude Desktop."

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "управляет токенами доступа сервера печати"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "Управление токенами доступа сервера печати."

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "создаёт токен и добавляет его хеш в tokens.toml"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Создание токена, добавление его хеша в tokens.toml и однократный показ токена."

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "имя токена, например устройство"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: только просмотр; print: также печать; admin: также все задания"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "tokens.toml, в который его добавить"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "только этот принтер из printers.toml; можно повторять"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml для проверки --printer"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "действителен до, например 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "примечание для людей"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "хранить хеш с помощью scrypt вместо SHA-256"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "взять выбранный вами токен со стандартного ввода (хранится с помощью scrypt) вместо создания нового"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:538
#, python-format
msgid "Unknown printer model: %s"
msgstr "Неизвестная модель принтера: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:658
#: tavletta/server/service.py:686
#, python-format
msgid "Cannot open %s"
msgstr "Не удалось открыть %s"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s не является датой, ожидается, например, 2026-12-31 или 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} подставляется при печати и не может быть задано"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "В этикетке нет элемента или переменной с именем %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1015
msgid "The label is empty"
msgstr "Этикетка пуста"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "Не удаётся записать вывод"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output записывает изображения PNG: укажите имя с окончанием .png"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:920
#: tavletta/server/service.py:943 tavletta/server/service.py:1192
#: tavletta/server/service.py:1347
msgid "The label cannot be prepared for printing."
msgstr "Не удалось подготовить этикетку к печати."

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "Принтер не найден – укажите его адрес через --host"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Найдено несколько принтеров – выберите один через --host (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:701 tavletta/server/service.py:1337
#, python-format
msgid "Cannot save %s"
msgstr "Не удалось сохранить %s"

#: tavletta/cli.py:757 tavletta/server/service.py:1340
msgid "the labels were printed, but the next counter value was not saved"
msgstr "этикетки напечатаны, но следующее значение счётчика не сохранено"

#: tavletta/cli.py:772 tavletta/server/service.py:1044
msgid "nothing was printed: the next counter value could not be saved"
msgstr "ничего не напечатано: следующее значение счётчика не удалось бы сохранить"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "Прервано"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: у этой модели принтера нет настройки способа печати: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet и --rows требуют файл данных (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:783
msgid "No rows to print"
msgstr "Нет строк для печати"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Этикетка использует файл данных вне своей папки: укажите его через --data"

#: tavletta/cli.py:1020 tavletta/ui/window.py:849
#: tavletta/server/service.py:837
#, python-format
msgid "No such column: %s"
msgstr "Нет такого столбца: %s"

#: tavletta/cli.py:1025 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Штрихкод или QR-код этих строк нельзя создать из их значений, например EAN-13 с буквами или пустая ячейка. Исправьте файл данных и прочитайте его снова или печатайте без этих строк."

#: tavletta/cli.py:1030 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Строки: %s"

#: tavletta/cli.py:1038
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Ожидание завершения другой печати %s…"

#: tavletta/cli.py:1045 tavletta/server/service.py:1186
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s всё ещё заблокирован другой печатью – попробуйте позже"

#: tavletta/cli.py:1051
msgid "--output needs --dry-run"
msgstr "--output требует --dry-run"

#: tavletta/cli.py:1068
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Следующее значение счётчика не сохраняется: следующая печать повторит номера"

#: tavletta/cli.py:1163
msgid "Waiting for the printer's answer…"
msgstr "Ожидание ответа принтера…"

#: tavletta/cli.py:1191 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Принтер не найден"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Таблицы (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Выбор файла данных"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "Можно использовать только локальные файлы"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "Tavletta снова спросит, прежде чем читать файлы данных вне папки этикетки"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Прочитать файл данных?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Эта этикетка использует файл данных вне своей папки:\n\n%s\n\nЧитайте его, только если знаете, откуда эта этикетка."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Не сейчас"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Прочитать файл данных"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "Чтение…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Не прочитан: вне папки этикетки"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Строк: %(rows)d · Столбцов: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Серийные этикетки"

#: tavletta/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "По одной этикетке на каждую строку таблицы. Вставляйте столбцы в тексты и коды; каждая этикетка показывает значения своей строки."

#: tavletta/ui/data.py:290
msgid "No data file"
msgstr "Нет файла данных"

#: tavletta/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS или XLSX"

#: tavletta/ui/data.py:291 tavletta/ui/elements.py:316
#: tavletta/ui/elements.py:334 tavletta/ui/elements.py:347
msgid "Choose…"
msgstr "Выбрать…"

#: tavletta/ui/data.py:304
msgid "Columns"
msgstr "Столбцы"

#: tavletta/ui/data.py:320
msgid "Read again"
msgstr "Прочитать заново"

#: tavletta/ui/data.py:324
msgid "Choose another file"
msgstr "Выбрать другой файл"

#: tavletta/ui/data.py:326
msgid "Remove data file"
msgstr "Удалить файл данных"

#: tavletta/ui/data.py:337
msgid "Sheet"
msgstr "Лист"

#: tavletta/ui/data.py:357
msgid "Insert column"
msgstr "Вставить столбец"

#: tavletta/ui/elements.py:83 tavletta/ui/shortcuts.py:57
msgid "Content"
msgstr "Содержимое"

#: tavletta/ui/elements.py:93
msgid "No content yet"
msgstr "Содержимого пока нет"

