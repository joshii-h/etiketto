msgid "Along the roll"
msgstr "Вдоль рулона"

#: etiketto/ui/texts.py:75
msgid "Single label"
msgstr "Отдельная этикетка"

#: etiketto/ui/texts.py:75
msgid "Label sheet"
msgstr "Лист этикеток"

#: etiketto/ui/texts.py:78
msgid "Resolution"
msgstr "Разрешение"

#: etiketto/ui/texts.py:79
msgid "Label sensor"
msgstr "Датчик этикеток"

#: etiketto/ui/texts.py:80
msgid "After printing"
msgstr "После печати"

#: etiketto/ui/texts.py:81
msgid "Darkness"
msgstr "Насыщенность"

#: etiketto/ui/texts.py:82
msgid "Speed"
msgstr "Скорость"

#: etiketto/ui/texts.py:83
msgid "Print upside down"
msgstr "Печатать вверх ногами"

#: etiketto/ui/texts.py:87
msgid "As reported by the printer"
msgstr "Как сообщает принтер"

#: etiketto/ui/texts.py:88
msgid "As set on the printer"
msgstr "Как настроено на принтере"

#: etiketto/ui/texts.py:89
msgid "Gap between labels"
msgstr "Зазор между этикетками"

#: etiketto/ui/texts.py:90
msgid "Black mark"
msgstr "Чёрная метка"

#: etiketto/ui/texts.py:91
msgid "Continuous media"
msgstr "Непрерывный материал"

#: etiketto/ui/texts.py:92
msgid "Tear off"
msgstr "Отрыв"

#: etiketto/ui/texts.py:93
msgid "Peel off"
msgstr "Отделение"

#: etiketto/ui/texts.py:94
msgid "Cut off"
msgstr "Отрезка"

#: etiketto/ui/texts.py:98
msgid "Left"
msgstr "Слева"

#: etiketto/ui/texts.py:98
msgid "Right"
msgstr "Справа"

#: etiketto/ui/texts.py:103
msgid "2D codes"
msgstr "2D-коды"

#: etiketto/ui/texts.py:105
msgid "QR code"
msgstr "QR-код"

#: etiketto/ui/texts.py:112
msgid "Linear barcodes"
msgstr "Линейные штрихкоды"

#: etiketto/ui/texts.py:127
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Идентификаторы применения в скобках, например (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:130
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Ссылки, текст, доступ к Wi-Fi; считывается телефоном"

#: etiketto/ui/texts.py:131
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Текст или числа на малой площади, например на мелких деталях"

#: etiketto/ui/texts.py:132
msgid "Much text, e.g. an address or a document number"
msgstr "Много текста, например адрес или номер документа"

#: etiketto/ui/texts.py:133
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Текст или числа; не нужно свободное поле, например на билетах"

#: etiketto/ui/texts.py:134
msgid "Latin letters, digits and punctuation"
msgstr "Латинские буквы, цифры и знаки препинания"

#: etiketto/ui/texts.py:135
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Заглавные буквы, цифры, пробелы и - . $ / + %"

#: etiketto/ui/texts.py:136
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Латинские буквы, цифры и знаки препинания; короче, чем Code 39"

#: etiketto/ui/texts.py:137
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 цифр, контрольная цифра добавляется (или 13 вместе с ней)"

#: etiketto/ui/texts.py:138
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 цифр, контрольная цифра добавляется (или 8 вместе с ней)"

#: etiketto/ui/texts.py:139
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 цифр, контрольная цифра добавляется (или 12 вместе с ней)"

#: etiketto/ui/texts.py:140
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 цифр, начиная с 0 или 1, контрольная цифра добавляется (или 8 вместе с ней)"

#: etiketto/ui/texts.py:141
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 цифр GTIN транспортной коробки, контрольная цифра добавляется (или 14 вместе с ней)"

#: etiketto/ui/texts.py:147
msgid "Whole area, centred"
msgstr "Вся область, по центру"

#: etiketto/ui/texts.py:147
msgid "Fill the label, edges cut off"
msgstr "Заполнить этикетку, края обрезаются"

#: etiketto/ui/texts.py:161
#, python-format
msgid "Not an image: %s"
msgstr "Не изображение: %s"

#: etiketto/ui/texts.py:179
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:182
#, python-format
msgid "%d in/s"
msgstr "%d дюйм/с"

#: etiketto/ui/texts.py:191
msgid "Image"
msgstr "Изображение"

#: etiketto/ui/texts.py:218
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Непрерывная, ширина %(width)s"

#: etiketto/ui/texts.py:228
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Проверьте, что вся этикетка находится внутри выделения. Перетащите, чтобы сдвинуть его или его края, или нарисуйте новое."

#: etiketto/ui/texts.py:232
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Этикеткой могут быть несколько областей. Проверьте выделение или попробуйте следующую."

#: etiketto/ui/texts.py:234
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Выделено всё напечатанное на странице. Перетащите, чтобы выбрать этикетку."

#: etiketto/ui/texts.py:235
msgid "Nothing is printed on this page."
msgstr "На этой странице ничего не напечатано."

#: etiketto/ui/texts.py:240
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Для файлов PDF нужен Poppler (poppler-glib), который не установлен"

#: etiketto/ui/texts.py:251
msgid "System printer (CUPS, IPP)"
msgstr "Системный принтер (CUPS, IPP)"

#: etiketto/ui/texts.py:252
msgid "Receipt printer (ESC/POS)"
msgstr "Чековый принтер (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:254
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, непрерывные рулоны"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:256
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, высечные этикетки"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Элемент %(n)d: код пуст"

#: etiketto/ui/texts.py:264
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Элемент %(n)d: для EAN-13 нужно ровно 12 цифр"

#: etiketto/ui/texts.py:265
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Элемент %(n)d: неверная контрольная цифра EAN-13"

#: etiketto/ui/texts.py:267
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Элемент %(n)d: Code 128 допускает только латинские буквы, цифры и знаки препинания"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Элемент %(n)d: для EAN-8 нужно 7 цифр или 8 с контрольной цифрой"

#: etiketto/ui/texts.py:270
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Элемент %(n)d: для UPC-A нужно 11 цифр или 12 с контрольной цифрой"

#: etiketto/ui/texts.py:272
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Элемент %(n)d: для UPC-E нужно 7 цифр, начиная с 0 или 1, или 8 с контрольной цифрой"

#: etiketto/ui/texts.py:274
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Элемент %(n)d: для ITF-14 нужно 13 цифр или 14 с контрольной цифрой"

#: etiketto/ui/texts.py:275
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Элемент %(n)d: неверная контрольная цифра"

#: etiketto/ui/texts.py:277
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Элемент %(n)d: Code 39 допускает только заглавные буквы, цифры, пробелы и - . $ / + %%"

#: etiketto/ui/texts.py:280
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Элемент %(n)d: Code 93 допускает только латинские буквы, цифры и знаки препинания"

#: etiketto/ui/texts.py:283
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Элемент %(n)d: данные GS1 допускают только латинские буквы, цифры и знаки препинания"

#: etiketto/ui/texts.py:286
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Элемент %(n)d: данные GS1 должны состоять из идентификаторов применения в скобках, за каждым из которых следует его значение, например (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:289
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Элемент %(n)d: (%(ai)s) не является идентификатором применения GS1"

#: etiketto/ui/texts.py:291
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Элемент %(n)d: значение идентификатора применения (%(ai)s) имеет неверную длину"

#: etiketto/ui/texts.py:294
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Элемент %(n)d: неверная контрольная цифра идентификатора применения (%(ai)s)"

#: etiketto/ui/texts.py:297
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Элемент %(n)d: недопустимое значение идентификатора применения (%(ai)s): дата, число или символ, которые он не допускает"

#: etiketto/ui/texts.py:301
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Элемент %(n)d: ни один номер UPC-A не сокращается до этих цифр UPC-E – проверьте их или используйте UPC-A"

#: etiketto/ui/texts.py:305
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Элемент %(n)d: сканеры в режиме Full ASCII читают $, /, + или %% перед заглавной буквой как другой символ"

#: etiketto/ui/texts.py:308
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Элемент %(n)d: содержимое слишком длинное для этого типа кода"

#: etiketto/ui/texts.py:309
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Элемент %(n)d: содержимое невозможно закодировать в этом типе кода"

#: etiketto/ui/texts.py:311
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Элемент %(n)d: для этого типа кода нужна библиотека Zint (zint-bindings), которая не установлена"

#: etiketto/ui/texts.py:314
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Элемент %(n)d: не удалось прочитать изображение"

#: etiketto/ui/texts.py:315
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Элемент %(n)d: этого символа нет в библиотеке символов"

#: etiketto/ui/texts.py:316
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Элемент %(n)d: не удалось прочитать документ"

#: etiketto/ui/texts.py:318
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Элемент %(n)d: для файлов PDF нужен Poppler (poppler-glib), который не установлен"

#: etiketto/ui/texts.py:320
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Не удалось нарисовать элемент %(n)d"

#: etiketto/ui/texts.py:321
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Защитное поле, рамка и отступ от края не оставляют места – уменьшите их"

#: etiketto/ui/texts.py:322
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Фиксированная длина меньше интервала – увеличьте её"

#: etiketto/ui/texts.py:323
msgid "The background image cannot be read"
msgstr "Не удалось прочитать фоновое изображение"

#: etiketto/ui/texts.py:325
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Элемент %(n)d: модули кода шириной всего в одну точку печати и могут не считаться – увеличьте код"

#: etiketto/ui/texts.py:329
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Элемент %(n)d: свободное поле, нужное коду вокруг, не помещается – увеличьте код"

#: etiketto/ui/texts.py:333
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Элемент %(n)d: код не помещается в своё место даже при одной точке печати на модуль – увеличьте этикетку или сократите содержимое"

#: etiketto/ui/texts.py:336
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Элемент %(n)d: %(name)s не является известной переменной"

#: etiketto/ui/texts.py:338
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Элемент %(n)d: дата %(name)s раньше 1 года или позже 9999"

#: etiketto/ui/texts.py:341
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Элемент %(n)d: переменная %(name)s… не закрыта – завершите её символом }"

#: etiketto/ui/texts.py:355
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Уже напечатано листов: %(n)d из %(total)d."

#: etiketto/ui/texts.py:357
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Уже напечатано этикеток: %(n)d из %(total)d."

#: etiketto/ui/texts.py:361
msgid "The sheets still waiting in the queue were canceled."
msgstr "Листы, ещё ожидавшие в очереди, отменены."

#: etiketto/ui/texts.py:363
msgid "The labels still waiting in the queue were canceled."
msgstr "Этикетки, ещё ожидавшие в очереди, отменены."

#: etiketto/ui/texts.py:372
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Принтер не найден. Убедитесь, что он включён и находится в той же сети, или введите его IP-адрес."

#: etiketto/ui/texts.py:376
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Принтер не найден по USB. Проверьте кабель и убедитесь, что принтер включён и не в спящем режиме, затем повторите поиск."

#: etiketto/ui/texts.py:379
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Принтер не отвечает. Убедитесь, что он включён и не в спящем режиме."

#: etiketto/ui/texts.py:381
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Принтер перестал принимать данные. Проверьте, не сообщает ли он о проблеме, например о закончившихся этикетках или открытой крышке, и повторите попытку."

#: etiketto/ui/texts.py:385
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Принтер отклоняет подключение. Выключите и снова включите его. Если в его веб-интерфейсе есть параметр «Port 9100», включите его."

#: etiketto/ui/texts.py:388
msgid "No cassette is inserted. Insert one and try again."
msgstr "Кассета не вставлена. Вставьте её и повторите попытку."

#: etiketto/ui/texts.py:389
msgid "The printer's cover is open. Close it and try again."
msgstr "Крышка принтера открыта. Закройте её и повторите попытку."

#: etiketto/ui/texts.py:390
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Этикетка застряла. Откройте крышку, извлеките её и повторите попытку."

#: etiketto/ui/texts.py:391
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Кассета не распознана. Вставьте её заново или попробуйте другую."

#: etiketto/ui/texts.py:392
msgid "The printer is busy. Wait a moment and try again."
msgstr "Принтер занят. Подождите немного и повторите попытку."

#: etiketto/ui/texts.py:393
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Этикетка слишком длинная для этого принтера: не более %(max)s."

#: etiketto/ui/texts.py:394
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Этикетка слишком широкая для этого принтера: максимум %(max)s."

#: etiketto/ui/texts.py:395
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "В принтере закончились этикетки. Загрузите новый рулон и повторите попытку."

#: etiketto/ui/texts.py:396
msgid "The print head is open. Close it and try again."
msgstr "Печатающая головка открыта. Закройте её и повторите попытку."

#: etiketto/ui/texts.py:398
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Принтер не находит следующую этикетку. Проверьте, правильно ли загружены этикетки и проходят ли они через датчик этикеток."

#: etiketto/ui/texts.py:402
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Проблема с красящей лентой. Проверьте, правильно ли она вставлена и соответствует ли способу печати, заданному в принтере."

#: etiketto/ui/texts.py:405
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Принтер приостановлен. Возобновите работу на его дисплее и повторите попытку."

#: etiketto/ui/texts.py:406
msgid "The printer is out of paper. Load paper and try again."
msgstr "В принтере закончилась бумага. Загрузите бумагу и повторите попытку."

#: etiketto/ui/texts.py:408
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Замятие бумаги. Извлеките её так, как показано на дисплее принтера, и повторите попытку."

#: etiketto/ui/texts.py:410
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "В принтере закончился тонер или чернила. Замените картридж и повторите попытку."

#: etiketto/ui/texts.py:411
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Принтер не может напечатать этот размер. Выберите размер бумаги, который он поддерживает."

#: etiketto/ui/texts.py:413
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Принтер не принимает ни один из форматов, которые может отправить Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:416
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Очередь принтера приостановлена. Возобновите её в настройках принтера системы и повторите попытку."

#: etiketto/ui/texts.py:420
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Задание печати было задержано в очереди, например до его освобождения или ввода пароля. Проверьте очередь в настройках принтера системы и повторите попытку."

#: etiketto/ui/texts.py:424
msgid "The print job was canceled at the printer or in the queue."
msgstr "Задание печати было отменено на принтере или в очереди."

#: etiketto/ui/texts.py:425
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Принтер не сообщил своё разрешение вовремя. Выберите его в разделе «%s»."

#: etiketto/ui/texts.py:428
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Загруженный рулон не подходит к этикетке. Загрузите подходящий рулон или выберите размер этикетки или модель принтера для загруженного рулона."

#: etiketto/ui/texts.py:432
msgid ""
"The printer's batteries are low. Connect the power adapter or charge the "
"batteries, then try again."
msgstr "Батареи принтера разряжены. Подключите адаптер питания или зарядите батареи, затем повторите попытку."

#: etiketto/ui/texts.py:435
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Печатающая головка слишком горячая. Подождите, пока она остынет, затем повторите попытку."

#: etiketto/ui/texts.py:437
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto не может печатать на этой модели принтера: она не принимает растровые изображения, которые отправляет Etiketto."

#: etiketto/ui/texts.py:441
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto не знает эту модель принтера и пока не может на ней печатать."

#: etiketto/ui/texts.py:444
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Принтер находится в режиме Editor Lite и виден как USB-накопитель. Выключите Editor Lite на принтере (его индикатор погаснет), затем повторите поиск."

#: etiketto/ui/texts.py:448
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "У Etiketto нет доступа к USB-порту принтера. Добавьте своего пользователя в группу «lp» (sudo usermod -aG lp $USER), затем выйдите из системы и войдите снова."

#: etiketto/ui/texts.py:452
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "При разрешении этого принтера код не помещается на этикетке и будет обрезан. Увеличьте этикетку или сократите содержимое кода."

#: etiketto/ui/texts.py:456
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "У Etiketto нет доступа к последовательному порту принтера. Добавьте своего пользователя в группу «dialout» (sudo usermod -aG dialout $USER; в Arch Linux группа называется «uucp»), затем выйдите из системы и войдите снова."

#: etiketto/ui/texts.py:461
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Принтер сообщил о проблеме. Выключите и снова включите его, затем повторите попытку."

#: etiketto/ui/texts.py:472
msgid "Printed"
msgstr "Напечатано"

#: etiketto/ui/texts.py:478
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Отправлено на принтер – будет напечатано, когда подойдёт очередь"

#: etiketto/ui/texts.py:482
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Напечатано в режиме «%(used)s», так как этого требует загруженный рулон"

#: etiketto/ui/texts.py:486
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Цветовой режим «%(wanted)s» недоступен на этом принтере, напечатано в режиме «%(used)s»"

#: etiketto/ui/texts.py:496
msgid "Warming up…"
msgstr "Прогрев…"

#: etiketto/ui/texts.py:497
msgid "Cooling down…"
msgstr "Охлаждение…"

#: etiketto/ui/texts.py:498
msgid "Cleaning…"
msgstr "Очистка…"

#: etiketto/ui/texts.py:499
msgid "Swipe the printer's panel to cut the label"
msgstr "Проведите по панели принтера, чтобы отрезать этикетку"

#: etiketto/ui/texts.py:501
msgid "Out of paper – load paper to continue"
msgstr "Нет бумаги – загрузите бумагу, чтобы продолжить"

#: etiketto/ui/texts.py:502
msgid "Cover open – close it to continue"
msgstr "Крышка открыта – закройте её, чтобы продолжить"

#: etiketto/ui/texts.py:503
msgid "Paper jammed – remove it to continue"
msgstr "Замятие бумаги – извлеките её, чтобы продолжить"

#: etiketto/ui/texts.py:514
msgid "This label needs a newer version of Etiketto"
msgstr "Для этой этикетки нужна более новая версия Etiketto"

#: etiketto/ui/texts.py:516
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s не является этикеткой Etiketto"

#: etiketto/ui/texts.py:517 etiketto/ui/texts.py:537
#, python-format
msgid "The file is damaged: %s"
msgstr "Файл повреждён: %s"

#: etiketto/ui/texts.py:524
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Файла данных %s больше нет. Выберите его снова или удалите."

#: etiketto/ui/texts.py:528
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "В %(file)s нет листа с именем %(sheet)s"

#: etiketto/ui/texts.py:530
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s не является таблицей. Используйте файл CSV, ODS или XLSX."

#: etiketto/ui/texts.py:532
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s слишком велик для серийных этикеток. Разделите его на файлы поменьше или удалите ненужные строки и столбцы."

#: etiketto/ui/texts.py:535
#, python-format
msgid "%s contains no data."
msgstr "%s не содержит данных."

#: etiketto/ui/texts.py:543
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Печать остановилась на строке %(row)d. Чтобы продолжить, запустите печать снова со строки %(row)d."

#: etiketto/ui/texts.py:547
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Уже напечатано копий строки %(row)d: %(copies)d."

#: etiketto/ui/texts.py:557
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Не удалось сохранить %s: нет прав на запись"

#: etiketto/ui/texts.py:559
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Не удалось сохранить %s: диск заполнен"

#: etiketto/ui/texts.py:569
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Вероятная дата выпуска кассеты: %(month)s %(year)d. Старая бумага ZINK печатает более блёклые цвета."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Дата"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Годен до (через 30 дней)"

