msgstr "7 цифр, контрольная цифра добавляется (или 8 вместе с ней)"

#: tavletta/ui/texts.py:151
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 цифр, контрольная цифра добавляется (или 12 вместе с ней)"

#: tavletta/ui/texts.py:152
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 цифр, начиная с 0 или 1, контрольная цифра добавляется (или 8 вместе с ней)"

#: tavletta/ui/texts.py:153
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 цифр GTIN транспортной коробки, контрольная цифра добавляется (или 14 вместе с ней)"

