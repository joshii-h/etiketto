#: etiketto/ui/texts.py:92
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – make the label "
"longer or the content shorter"
msgstr "Элемент %(n)d: штрихи слишком тонкие для надёжного сканирования – сделайте этикетку длиннее или содержимое короче"

#: etiketto/ui/texts.py:96
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Элемент %(n)d: Code 128 допускает только латинские буквы, цифры и знаки препинания"

#: etiketto/ui/texts.py:98
#, python-format
msgid "Element %(n)d: the image cannot be read"
