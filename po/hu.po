#, python-format
msgid "The file is damaged: %s"
msgstr "A fájl sérült: %s"

#: etiketto/ui/texts.py:240
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "A(z) %s adatfájl már nem létezik. Válassza ki újra, vagy távolítsa el."

#: etiketto/ui/texts.py:244
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "A(z) %(file)s fájlban nincs %(sheet)s nevű munkalap"

#: etiketto/ui/texts.py:246
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "A(z) %s nem táblázat. Használjon CSV-, ODS- vagy XLSX-fájlt."

#: etiketto/ui/texts.py:248
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "A(z) %s túl nagy a sorozatcímkékhez. Ossza fel kisebb fájlokra, vagy távolítsa el a felesleges sorokat és oszlopokat."

#: etiketto/ui/texts.py:251
#, python-format
msgid "%s contains no data."
msgstr "A(z) %s nem tartalmaz adatot."

#: etiketto/ui/texts.py:259
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "A nyomtatás a(z) %(row)d. sornál leállt. A folytatáshoz nyomtasson újra a(z) %(row)d. sortól."

#: etiketto/ui/texts.py:263
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "A(z) %(row)d. sor már kinyomtatott példányai: %(copies)d."

#: etiketto/ui/texts.py:273
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Nem menthető: %s (nincs írási jogosultság)"

#: etiketto/ui/texts.py:275
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Nem menthető: %s (a lemez megtelt)"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "A kazetta valószínű gyártási ideje: %(month)s %(year)d. A régi ZINK-papír halványabb színekkel nyomtat."

