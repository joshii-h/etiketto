msgid "Linear barcodes"
msgstr "Lineáris vonalkódok"

#: etiketto/ui/texts.py:71
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Alkalmazás-azonosítók zárójelben, pl. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:74
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Linkek, szöveg, Wi-Fi-hozzáférés; telefonnal olvasható"

#: etiketto/ui/texts.py:75
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Szöveg vagy számok kis helyen, pl. apró alkatrészeken"

#: etiketto/ui/texts.py:76
msgid "Much text, e.g. an address or a document number"
msgstr "Sok szöveg, pl. cím vagy dokumentumszám"

#: etiketto/ui/texts.py:77
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Szöveg vagy számok; nem kell hozzá üres szegély, pl. jegyeken"

#: etiketto/ui/texts.py:78
msgid "Latin letters, digits and punctuation"
msgstr "Latin betűk, számjegyek és írásjelek"

#: etiketto/ui/texts.py:79
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Nagybetűk, számjegyek, szóközök és - . $ / + %"

#: etiketto/ui/texts.py:80
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Latin betűk, számjegyek és írásjelek; rövidebb, mint a Code 39"

#: etiketto/ui/texts.py:81
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 számjegy, az ellenőrző számjegy hozzáadódik (vagy 13 azzal együtt)"

#: etiketto/ui/texts.py:82
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 számjegy, az ellenőrző számjegy hozzáadódik (vagy 8 azzal együtt)"

#: etiketto/ui/texts.py:83
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 számjegy, az ellenőrző számjegy hozzáadódik (vagy 12 azzal együtt)"

#: etiketto/ui/texts.py:84
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 számjegy 0-val vagy 1-gyel kezdve, az ellenőrző számjegy hozzáadódik (vagy 8 azzal együtt)"

#: etiketto/ui/texts.py:85
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "Egy gyűjtőkarton GTIN-jének 13 számjegye, az ellenőrző számjegy hozzáadódik (vagy 14 azzal együtt)"

#: etiketto/ui/texts.py:91
msgid "Whole area, centred"
msgstr "Teljes terület, középre"

#: etiketto/ui/texts.py:91
msgid "Fill the label, edges cut off"
msgstr "Címke kitöltése, a szélek levágva"

#: etiketto/ui/texts.py:105
#, python-format
msgid "Not an image: %s"
msgstr "Nem kép: %s"

#: etiketto/ui/texts.py:113
msgid "Image"
msgstr "Kép"

#: etiketto/ui/texts.py:140
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Folyamatos, %(width)s széles"

#: etiketto/ui/texts.py:150
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Ellenőrizze, hogy a teljes címke a kijelölésen belül van-e. Húzással mozgathatja a kijelölést vagy a széleit, vagy rajzolhat újat."

#: etiketto/ui/texts.py:154
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Több terület is lehet a címke. Ellenőrizze a kijelölést, vagy próbálja a következőt."

#: etiketto/ui/texts.py:156
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Az oldalon minden nyomtatott tartalom ki van jelölve. Húzással válassza ki a címkét."

#: etiketto/ui/texts.py:157
msgid "Nothing is printed on this page."
msgstr "Ezen az oldalon nincs semmi nyomtatva."

#: etiketto/ui/texts.py:162
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "A PDF-fájlokhoz Poppler (poppler-glib) kell, amely nincs telepítve"

#: etiketto/ui/texts.py:172
msgid "System printer (CUPS, IPP)"
msgstr "Rendszernyomtató (CUPS, IPP)"

#: etiketto/ui/texts.py:178
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "%(n)d. elem: a kód üres"

#: etiketto/ui/texts.py:179
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "%(n)d. elem: az EAN-13 pontosan 12 számjegyet igényel"

#: etiketto/ui/texts.py:180
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "%(n)d. elem: az EAN-13 ellenőrző számjegye hibás"

#: etiketto/ui/texts.py:182
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a Code 128 csak latin betűket, számjegyeket és írásjeleket fogad el"

#: etiketto/ui/texts.py:184
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "%(n)d. elem: az EAN-8 7 számjegyet igényel, vagy 8-at az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:185
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "%(n)d. elem: az UPC-A 11 számjegyet igényel, vagy 12-t az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:187
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "%(n)d. elem: az UPC-E 7, 0-val vagy 1-gyel kezdődő számjegyet igényel, vagy 8-at az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:189
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "%(n)d. elem: az ITF-14 13 számjegyet igényel, vagy 14-et az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:190
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "%(n)d. elem: az ellenőrző számjegy hibás"

#: etiketto/ui/texts.py:192
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "%(n)d. elem: a Code 39 csak nagybetűket, számjegyeket, szóközöket és - . $ / + %% jeleket fogad el"

#: etiketto/ui/texts.py:195
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a Code 93 csak latin betűket, számjegyeket és írásjeleket fogad el"

#: etiketto/ui/texts.py:198
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a GS1-adatok csak latin betűket, számjegyeket és írásjeleket fogadnak el"

#: etiketto/ui/texts.py:201
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "%(n)d. elem: a GS1-adatoknak zárójeles alkalmazás-azonosítókból kell állniuk, mindegyik után az értékével, pl. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:204
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "%(n)d. elem: (%(ai)s) nem GS1 alkalmazás-azonosító"

#: etiketto/ui/texts.py:206
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) értékének hossza hibás"

#: etiketto/ui/texts.py:209
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) ellenőrző számjegye hibás"

#: etiketto/ui/texts.py:212
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) értéke érvénytelen: olyan dátum, szám vagy karakter, amelyet nem enged meg"

#: etiketto/ui/texts.py:216
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "%(n)d. elem: egyetlen UPC-A szám sem rövidül ezekre az UPC-E számjegyekre – ellenőrizze őket, vagy használjon UPC-A-t"

#: etiketto/ui/texts.py:220
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "%(n)d. elem: a Full ASCII módra állított olvasók a nagybetű előtti $, /, + vagy %% jelet más karakterként olvassák"

#: etiketto/ui/texts.py:223
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "%(n)d. elem: a tartalom túl hosszú ehhez a kódtípushoz"

#: etiketto/ui/texts.py:224
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "%(n)d. elem: a tartalom nem kódolható ebben a kódtípusban"

#: etiketto/ui/texts.py:226
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "%(n)d. elem: ehhez a kódtípushoz a Zint könyvtár (zint-bindings) szükséges, amely nincs telepítve"

#: etiketto/ui/texts.py:229
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "%(n)d. elem: a kép nem olvasható"

#: etiketto/ui/texts.py:230
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "%(n)d. elem: ez a szimbólum nincs a szimbólumtárban"

#: etiketto/ui/texts.py:231
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "%(n)d. elem: a dokumentum nem olvasható"

#: etiketto/ui/texts.py:233
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "%(n)d. elem: a PDF-fájlokhoz Poppler (poppler-glib) kell, amely nincs telepítve"

#: etiketto/ui/texts.py:235
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "%(n)d. elem: nem rajzolható meg"

#: etiketto/ui/texts.py:236
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "A biztonsági margó, a keret és a szélső térköz nem hagy helyet – csökkentse őket"

#: etiketto/ui/texts.py:237
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "A rögzített hossz rövidebb a térköznél – növelje"

#: etiketto/ui/texts.py:238
msgid "The background image cannot be read"
msgstr "A háttérkép nem olvasható"

#: etiketto/ui/texts.py:240
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "%(n)d. elem: a kód moduljai csak egy nyomtatási pont szélesek, ezért lehet, hogy nem olvashatók be – nagyítsa a kódot"

#: etiketto/ui/texts.py:244
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "%(n)d. elem: a kód körül szükséges üres hely nem fér el – nagyítsa a kódot"

#: etiketto/ui/texts.py:248
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "%(n)d. elem: a kód modulonként egy nyomtatási ponttal sem fér el a helyén – nagyítsa a címkét vagy rövidítse a tartalmat"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott ívek: %(n)d / %(total)d."

#: etiketto/ui/texts.py:265
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott címkék: %(n)d / %(total)d."

#: etiketto/ui/texts.py:269
msgid "The sheets still waiting in the queue were canceled."
msgstr "A sorban még várakozó ívek nyomtatása megszakadt."

#: etiketto/ui/texts.py:271
msgid "The labels still waiting in the queue were canceled."
msgstr "A sorban még várakozó címkék nyomtatása megszakadt."

#: etiketto/ui/texts.py:280
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "A nyomtató nem található. Ellenőrizze, hogy be van-e kapcsolva és ugyanazon a hálózaton van-e, vagy adja meg az IP-címét."

#: etiketto/ui/texts.py:284
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "A nyomtató nem található USB-n. Ellenőrizze a kábelt, és hogy a nyomtató be van-e kapcsolva és nem alszik-e, majd keressen újra."

#: etiketto/ui/texts.py:287
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A nyomtató nem válaszol. Ellenőrizze, hogy be van-e kapcsolva, és nem alszik-e."

#: etiketto/ui/texts.py:289
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "A nyomtató nem fogad több adatot. Ellenőrizze, hogy jelez-e hibát, például kifogyott címkéket vagy nyitott fedelet, majd próbálja újra."

#: etiketto/ui/texts.py:293
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A nyomtató elutasítja a kapcsolatot. Kapcsolja ki, majd újra be. Ha a webes felületén van „Port 9100” beállítás, kapcsolja be."

#: etiketto/ui/texts.py:296
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nincs behelyezett kazetta. Helyezzen be egyet, és próbálja újra."

#: etiketto/ui/texts.py:297
msgid "The printer's cover is open. Close it and try again."
msgstr "A nyomtató fedele nyitva van. Csukja be, és próbálja újra."

#: etiketto/ui/texts.py:298
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A címke elakadt. Nyissa ki a fedelet, vegye ki a címkét, és próbálja újra."

#: etiketto/ui/texts.py:299
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "A kazetta nem ismerhető fel. Helyezze be újra, vagy próbáljon egy másikat."

#: etiketto/ui/texts.py:300
msgid "The printer is busy. Wait a moment and try again."
msgstr "A nyomtató foglalt. Várjon egy kicsit, és próbálja újra."

#: etiketto/ui/texts.py:301
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A címke túl hosszú ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:302
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A címke túl széles ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:303
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A nyomtatóból kifogyott a címke. Töltsön be új tekercset, és próbálja újra."

#: etiketto/ui/texts.py:304
msgid "The print head is open. Close it and try again."
msgstr "A nyomtatófej nyitva van. Zárja le, és próbálja újra."

#: etiketto/ui/texts.py:306
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A nyomtató nem találja a következő címkét. Ellenőrizze, hogy a címkék megfelelően vannak-e betöltve, és áthaladnak-e a címkeérzékelőn."

#: etiketto/ui/texts.py:310
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Probléma van a festékszalaggal. Ellenőrizze, hogy megfelelően van-e behelyezve, és megfelel-e a nyomtatón beállított nyomtatási módnak."

#: etiketto/ui/texts.py:313
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A nyomtató szünetel. Folytassa a kijelzőjén, és próbálja újra."

#: etiketto/ui/texts.py:314
msgid "The printer is out of paper. Load paper and try again."
msgstr "A nyomtatóból kifogyott a papír. Töltsön be papírt, és próbálja újra."

#: etiketto/ui/texts.py:316
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Elakadt a papír. Távolítsa el a nyomtató kijelzőjén látható módon, és próbálja újra."

#: etiketto/ui/texts.py:318
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A nyomtatóból kifogyott a toner vagy a tinta. Cserélje ki, és próbálja újra."

#: etiketto/ui/texts.py:319
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A nyomtató nem tudja kinyomtatni ezt a méretet. Válasszon olyan papírméretet, amelyet kínál."

#: etiketto/ui/texts.py:321
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A nyomtató az Etiketto által küldhető formátumok egyikét sem fogadja el (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:324
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A nyomtató várólistája szünetel. Folytassa a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:328
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "A nyomtatási feladatot visszatartotta a várólista, például amíg fel nem oldják, vagy meg nem adnak egy jelszót. Ellenőrizze a várólistát a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:332
msgid "The print job was canceled at the printer or in the queue."
msgstr "A nyomtatási feladatot a nyomtatón vagy a várólistában megszakították."

#: etiketto/ui/texts.py:334
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Az Etiketto nem használhatja a nyomtató USB-portját. Adja hozzá a felhasználóját az „lp” csoporthoz (sudo usermod -aG lp $USER), majd jelentkezzen ki, és jelentkezzen be újra."

#: etiketto/ui/texts.py:338
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Ennek a nyomtatónak a felbontásán egy kód nem fér el a címkén, és levágódna. Nagyítsa a címkét vagy rövidítse a kód tartalmát."

#: etiketto/ui/texts.py:342
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A nyomtató hibát jelzett. Kapcsolja ki, majd újra be, és próbálja meg még egyszer."

#: etiketto/ui/texts.py:354
msgid "Warming up…"
msgstr "Bemelegítés…"

#: etiketto/ui/texts.py:355
msgid "Cooling down…"
msgstr "Lehűlés…"

#: etiketto/ui/texts.py:356
msgid "Cleaning…"
msgstr "Tisztítás…"

#: etiketto/ui/texts.py:357
msgid "Swipe the printer's panel to cut the label"
msgstr "Húzzon végig a nyomtató paneljén a címke levágásához"

#: etiketto/ui/texts.py:359
msgid "Out of paper – load paper to continue"
msgstr "Kifogyott a papír – a folytatáshoz töltsön be papírt"

#: etiketto/ui/texts.py:360
msgid "Cover open – close it to continue"
msgstr "A fedél nyitva – a folytatáshoz csukja be"

#: etiketto/ui/texts.py:361
msgid "Paper jammed – remove it to continue"
msgstr "Elakadt a papír – a folytatáshoz távolítsa el"

#: etiketto/ui/texts.py:372
msgid "This label needs a newer version of Etiketto"
msgstr "Ehhez a címkéhez az Etiketto újabb verziója szükséges"

