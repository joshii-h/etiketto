msgid "Open"
msgstr "Megnyitás"

#: etiketto/ui/window.py:118
msgid "Templates"
msgstr "Sablonok"

#: etiketto/ui/window.py:124
msgid "Save"
msgstr "Mentés"

#: etiketto/ui/window.py:141
msgid "New label"
msgstr "Új címke"

#: etiketto/ui/window.py:142
msgid "Shipping label…"
msgstr "Szállítási címke…"

#: etiketto/ui/window.py:143
msgid "Save as…"
msgstr "Mentés másként…"

#: etiketto/ui/window.py:145
msgid "Export PNG…"
msgstr "Exportálás PNG-ként…"

#: etiketto/ui/window.py:146
msgid "Help"
msgstr "Súgó"

#: etiketto/ui/window.py:147
msgid "Report a problem…"
msgstr "Probléma jelentése…"

#: etiketto/ui/window.py:148
msgid "About Etiketto"
msgstr "Az Etiketto névjegye"

#: etiketto/ui/window.py:407
msgid "Unsaved label"
msgstr "Mentetlen címke"

#: etiketto/ui/window.py:472
msgid "content scaled down to fit"
msgstr "a tartalom kicsinyítve, hogy elférjen"

#: etiketto/ui/window.py:474
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Túl hosszú ehhez a nyomtatóhoz: legfeljebb %s"

#: etiketto/ui/window.py:479
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Túl széles ehhez a nyomtatóhoz: legfeljebb %s"

#: etiketto/ui/window.py:484
#, python-format
msgid "Problem: %s"
msgstr "Probléma: %s"

#: etiketto/ui/window.py:559
msgid "The browser cannot be opened"
msgstr "A böngésző nem nyitható meg"

#: etiketto/ui/window.py:561
msgid "Copy link"
msgstr "Hivatkozás másolása"

#: etiketto/ui/window.py:607
msgid "Only local files can be dropped"
msgstr "Csak helyi fájlok húzhatók ide"

#: etiketto/ui/window.py:625
msgid "Please wait until printing has finished"
msgstr "Várjon, amíg a nyomtatás befejeződik"
