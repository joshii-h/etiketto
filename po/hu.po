#: etiketto/app.py:136 etiketto/cli.py:163
msgid "Design and print labels"
msgstr "Címkék tervezése, nyomtatása"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE várható: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "egész szám várható %(min)d és %(max)d között: %(value)s"

#: etiketto/cli.py:157
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "sorok várhatók, pl. 3-10, 5 vagy 7-: %s"

#: etiketto/cli.py:164
msgid "Without a command the application starts; label files given open in it."
msgstr "Parancs nélkül az alkalmazás indul el; a megadott címkefájlok abban nyílnak meg."

#: etiketto/cli.py:170
msgid "print a label file without opening a window"
msgstr "címkefájl nyomtatása ablak megnyitása nélkül"

#: etiketto/cli.py:171
msgid "Print a label file without opening a window."
msgstr "Címkefájl nyomtatása ablak megnyitása nélkül."

#: etiketto/cli.py:173
msgid "the label (.etiketto)"
msgstr "a címke (.etiketto)"

#: etiketto/cli.py:176
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "nyomtatómodell, alapértelmezés szerint a címkéé: %s"

#: etiketto/cli.py:179
msgid "printer address, by default the one set in the app"
msgstr "nyomtató címe, alapértelmezés szerint az alkalmazásban beállított cím"

#: etiketto/cli.py:182
msgid "number of copies"
msgstr "példányszám"

#: etiketto/cli.py:192
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "a NAME elem szövege, vagy a {=NAME} változó értéke; a szövegben lévő változók kitöltődnek; ismételhető"

#: etiketto/cli.py:202
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "mint a --set, de az érték változatlanul kerül felhasználásra: a kapcsos zárójelek nem változók"

#: etiketto/cli.py:208
msgid "counter of the first label, instead of the one saved in the label"
msgstr "az első címke számlálója a címkébe mentett helyett"

#: etiketto/cli.py:214
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ne mentse a számláló következő értékét a címkébe (csak olvasható fájl); a következő nyomtatás ugyanattól a számtól indul"

#: etiketto/cli.py:223
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "sorozatcímkék: egy címke a CSV-, ODS- vagy XLSX-fájl minden sorához; alapértelmezés szerint a címke adatfájlja"

#: etiketto/cli.py:228
msgid "the sheet of the data file, by default the first"
msgstr "az adatfájl munkalapja, alapértelmezés szerint az első"

#: etiketto/cli.py:234
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "csak az adatfájl ezen sorai, pl. 3-10, 5 vagy 7- (1-től számolva)"

#: etiketto/cli.py:237
msgid "check and render only, do not print"
msgstr "csak ellenőrzés és megjelenítés, nincs nyomtatás"

#: etiketto/cli.py:243
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run esetén: a képek mentése PNG-ként úgy, ahogy a nyomtató kapná (- a szabványos kimenethez: csak az első)"

#: etiketto/cli.py:249
msgid "list the printers found on the network"
msgstr "a hálózaton talált nyomtatók listázása"

#: etiketto/cli.py:250
msgid "List the printers found on the network: model, address, name."
msgstr "A hálózaton talált nyomtatók listázása: modell, cím, név."

#: etiketto/cli.py:252
#, python-format
msgid "only this printer model: %s"
msgstr "csak ez a nyomtatómodell: %s"

#: etiketto/cli.py:264
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "cím vagy hálózat várható, pl. 172.16.0.0/12: %s"

#: etiketto/cli.py:274
msgid "the folder with the label files the server may use"
msgstr "a mappa azokkal a címkefájlokkal, amelyeket a kiszolgáló használhat"

#: etiketto/cli.py:281
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "nyomtatás csak erre a nyomtatócímre (a * bármire illeszkedik); ismételhető"

#: etiketto/cli.py:287
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: a kliensek által használható nyomtatók, név szerint"

#: etiketto/cli.py:294
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "legfeljebb ennyi címke egy nyomtatási feladatban, példányszám szorozva a sorokkal (alapértelmezés: 10000)"

#: etiketto/cli.py:299
msgid "search the network for printers (off by default)"
msgstr "nyomtatók keresése a hálózaton (alapértelmezés szerint ki)"

#: etiketto/cli.py:306
msgid "run a print server with a REST API"
msgstr "nyomtatókiszolgáló futtatása REST API-val"

#: etiketto/cli.py:307
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Nyomtatókiszolgáló futtatása: REST API, valamint --mcp esetén MCP MI-kliensek számára."

#: etiketto/cli.py:310
msgid "address to listen on (default 127.0.0.1)"
msgstr "a figyelt cím (alapértelmezés: 127.0.0.1)"

#: etiketto/cli.py:316
#, python-format
msgid "port to listen on (default %d)"
msgstr "a figyelt port (alapértelmezés: %d)"

#: etiketto/cli.py:322
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "a hozzáférési tokent tartalmazó fájl; egyébként az ETIKETTO_TOKEN környezeti változó"

#: etiketto/cli.py:328
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: elnevezett hozzáférési tokenek szerepkörökkel"

#: etiketto/cli.py:330
msgid "also serve MCP at /mcp"
msgstr "MCP kiszolgálása a /mcp címen is"

#: etiketto/cli.py:336
msgid "largest request body in MB (default 4)"
msgstr "a kérés törzsének legnagyobb mérete MB-ban (alapértelmezés: 4)"

#: etiketto/cli.py:345
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "fordított proxy, amelynek X-Forwarded-For fejléce megnevezi a klienst, pl. 172.16.0.0/12; ismételhető"

#: etiketto/cli.py:354
msgid "allow requests from web pages of this origin; repeatable"
msgstr "kérések engedélyezése ilyen eredetű weboldalakról; ismételhető"

#: etiketto/cli.py:359
msgid "serve MCP on standard input and output"
msgstr "MCP kiszolgálása a szabványos bemeneten és kimeneten"

#: etiketto/cli.py:361
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP kiszolgálása a szabványos bemeneten és kimeneten MI-kliensek, például a Claude Desktop számára."

#: etiketto/cli.py:371
msgid "manage the access tokens of the print server"
msgstr "a nyomtatókiszolgáló hozzáférési tokenjeinek kezelése"

#: etiketto/cli.py:372
msgid "Manage the access tokens of the print server."
msgstr "A nyomtatókiszolgáló hozzáférési tokenjeinek kezelése."

#: etiketto/cli.py:377
msgid "make a token and add its hash to tokens.toml"
msgstr "token létrehozása és hash-ének hozzáadása a tokens.toml fájlhoz"

#: etiketto/cli.py:378
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Token létrehozása, hash-ének hozzáadása a tokens.toml fájlhoz és a token egyszeri megjelenítése."

#: etiketto/cli.py:380
msgid "name of the token, e.g. the device"
msgstr "a token neve, pl. az eszköz"

#: etiketto/cli.py:385
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: csak megtekintés; print: nyomtatás is; admin: minden feladat is"

#: etiketto/cli.py:387
msgid "tokens.toml to add it to"
msgstr "a tokens.toml, amelyhez hozzá kell adni"

#: etiketto/cli.py:393
msgid "only this printer of printers.toml; repeatable"
msgstr "csak ez a nyomtató a printers.toml fájlból; ismételhető"

#: etiketto/cli.py:396
msgid "printers.toml, to check --printer"
msgstr "printers.toml, a --printer ellenőrzéséhez"

#: etiketto/cli.py:398
msgid "valid until, e.g. 2027-12-31"
msgstr "érvényesség vége, pl. 2027-12-31"

#: etiketto/cli.py:399
msgid "a note for people"
msgstr "megjegyzés embereknek"

#: etiketto/cli.py:401
msgid "store the hash with scrypt instead of SHA-256"
msgstr "a hash tárolása scrypt használatával SHA-256 helyett"

#: etiketto/cli.py:407
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "saját választású token beolvasása a szabványos bemenetről (scrypt használatával tárolva) új létrehozása helyett"

#: etiketto/cli.py:427 etiketto/server/config.py:216
#: etiketto/server/service.py:522
#, python-format
msgid "Unknown printer model: %s"
msgstr "Ismeretlen nyomtatómodell: %s"

#: etiketto/cli.py:434 etiketto/ui/files.py:66 etiketto/ui/texts.py:242
#: etiketto/server/service.py:670
#, python-format
msgid "Cannot open %s"
msgstr "Nem nyitható meg: %s"

#: etiketto/cli.py:456 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "A(z) %s nem dátum, várható pl. 2026-12-31 vagy 2026-12-31T08:30"

#: etiketto/cli.py:493
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "A(z) {=%s} nyomtatáskor töltődik ki, és nem állítható be"

#: etiketto/cli.py:497
#, python-format
msgid "The label has no element or variable named %s"
msgstr "A címkén nincs %s nevű elem vagy változó"

#: etiketto/cli.py:521 etiketto/ui/printing.py:103
#: etiketto/server/service.py:956
msgid "The label is empty"
msgstr "A címke üres"

#: etiketto/cli.py:554
msgid "Cannot write the output"
msgstr "A kimenet nem írható"

#: etiketto/cli.py:585
msgid "--output writes PNG images: give a name ending in .png"
msgstr "a --output PNG-képeket ír: .png végű nevet adjon meg"

#: etiketto/cli.py:621 etiketto/cli.py:655 etiketto/cli.py:774
#: etiketto/cli.py:802 etiketto/ui/printing.py:345 etiketto/ui/printing.py:483
#: etiketto/server/service.py:884 etiketto/server/service.py:1105
#: etiketto/server/service.py:1250
msgid "The label cannot be prepared for printing."
msgstr "A címke nem készíthető elő nyomtatásra."

#: etiketto/cli.py:682
msgid "No printer found – give its address with --host"
msgstr "Nem található nyomtató – adja meg a címét a --host kapcsolóval"

#: etiketto/cli.py:684
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Több nyomtató található – válasszon egyet a --host kapcsolóval (etiketto list-printers)"

#: etiketto/cli.py:695 etiketto/ui/texts.py:276 etiketto/server/service.py:1240
#, python-format
msgid "Cannot save %s"
msgstr "Nem menthető: %s"

#: etiketto/cli.py:697 etiketto/server/service.py:1243
msgid "the labels were printed, but the next counter value was not saved"
msgstr "a címkék kinyomtatva, de a számláló következő értéke nem lett mentve"

#: etiketto/cli.py:712 etiketto/server/service.py:980
msgid "nothing was printed: the next counter value could not be saved"
msgstr "semmi sem lett kinyomtatva: a számláló következő értéke nem lenne menthető"

#: etiketto/cli.py:772 etiketto/cli.py:799 etiketto/cli.py:1010
msgid "Interrupted"
msgstr "Megszakítva"

#: etiketto/cli.py:874
msgid "--sheet and --rows need a data file (--data)"
msgstr "A --sheet és a --rows adatfájlt igényel (--data)"

#: etiketto/cli.py:883 etiketto/ui/printing.py:361
#: etiketto/server/service.py:757
msgid "No rows to print"
msgstr "Nincs nyomtatandó sor"

#: etiketto/cli.py:893
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A címke a mappáján kívüli adatfájlt használ: adja meg a --data kapcsolóval"

#: etiketto/cli.py:914 etiketto/ui/window.py:395 etiketto/server/service.py:810
#, python-format
msgid "No such column: %s"
msgstr "Ismeretlen oszlop: %s"

#: etiketto/cli.py:919 etiketto/ui/printing.py:434
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Ezeknek a soroknak a vonalkódja vagy QR-kódja nem hozható létre az értékeikből, például betűket tartalmazó EAN-13 vagy üres cella miatt. Javítsa az adatfájlt, és olvassa be újra, vagy nyomtasson ezen sorok nélkül."

#: etiketto/cli.py:924 etiketto/ui/printing.py:439
#, python-format
msgid "Rows: %s"
msgstr "Sorok: %s"

#: etiketto/cli.py:932
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Várakozás a(z) %s egy másik nyomtatásának befejezésére…"

#: etiketto/cli.py:939 etiketto/server/service.py:1099
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s még zárolva van egy másik nyomtatás miatt – próbálja újra később"

#: etiketto/cli.py:945
msgid "--output needs --dry-run"
msgstr "A --output használatához --dry-run szükséges"

#: etiketto/cli.py:954
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "A számláló következő értéke nem lesz mentve: a következő nyomtatás megismétli a számokat"

#: etiketto/cli.py:981 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Nem található nyomtató"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Táblázatok (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "Adatfájl kiválasztása"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:86 etiketto/ui/files.py:120
#: etiketto/ui/texts.py:45
msgid "Only local files can be used"
msgstr "Csak helyi fájlok használhatók"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Az Etiketto ismét rákérdez, mielőtt a címke mappáján kívüli adatfájlokat beolvasna"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "Beolvassa az adatfájlt?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Ez a címke a mappáján kívüli adatfájlt használ:\n\n%s\n\nCsak akkor olvassa be, ha tudja, honnan származik a címke."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "Most nem"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "Adatfájl beolvasása"

#: etiketto/ui/data.py:263
msgid "Reading…"
msgstr "Beolvasás…"

#: etiketto/ui/data.py:265
msgid "Not read: outside the label's folder"
msgstr "Nincs beolvasva: a címke mappáján kívül van"

#: etiketto/ui/data.py:268
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Sorok: %(rows)d · Oszlopok: %(columns)d"

#: etiketto/ui/data.py:279
msgid "Serial labels"
msgstr "Sorozatcímkék"

#: etiketto/ui/data.py:281
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "Egy címke a táblázat minden sorához. Szúrjon be oszlopokat a szövegekbe és a kódokba; minden címke a saját sorának értékeit mutatja."

#: etiketto/ui/data.py:288
msgid "No data file"
msgstr "Nincs adatfájl"

#: etiketto/ui/data.py:288
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS vagy XLSX"

#: etiketto/ui/data.py:289 etiketto/ui/elements.py:186
msgid "Choose…"
msgstr "Kiválasztás…"

#: etiketto/ui/data.py:302
msgid "Columns"
msgstr "Oszlopok"

#: etiketto/ui/data.py:318
msgid "Read again"
msgstr "Újraolvasás"

#: etiketto/ui/data.py:322
msgid "Choose another file"
msgstr "Másik fájl kiválasztása"

#: etiketto/ui/data.py:324
msgid "Remove data file"
msgstr "Adatfájl eltávolítása"

#: etiketto/ui/data.py:335
msgid "Sheet"
msgstr "Munkalap"

#: etiketto/ui/data.py:355
msgid "Insert column"
msgstr "Oszlop beszúrása"

#: etiketto/ui/elements.py:35
msgid "Content"
msgstr "Tartalom"

#: etiketto/ui/elements.py:36
msgid "Elements are placed one after another along the tape"
msgstr "Az elemek egymás után következnek a szalag mentén"

#: etiketto/ui/elements.py:43
msgid "No content yet"
msgstr "Még nincs tartalom"

#: etiketto/ui/elements.py:43
msgid "Add text, an image or a code"
msgstr "Adjon hozzá szöveget, képet vagy kódot"

#: etiketto/ui/elements.py:52 etiketto/ui/texts.py:57 etiketto/ui/window.py:495
msgid "Text"
msgstr "Szöveg"

#: etiketto/ui/elements.py:53
msgid "Image…"
msgstr "Kép…"

#: etiketto/ui/elements.py:54
msgid "QR code / barcode"
msgstr "QR-kód / vonalkód"

#: etiketto/ui/elements.py:56
msgid "Add"
msgstr "Hozzáadás"

#: etiketto/ui/elements.py:90 etiketto/ui/label_group.py:125
msgid "Remove"
msgstr "Eltávolítás"

#: etiketto/ui/elements.py:93
msgid "Move down"
msgstr "Mozgatás hátra"

#: etiketto/ui/elements.py:94
msgid "Move up"
msgstr "Mozgatás előre"

#: etiketto/ui/elements.py:107
msgid "Size"
msgstr "Méret"

#: etiketto/ui/elements.py:114
msgid "pt, 0 = fill tape height"
msgstr "pt, 0 = a szalag magasságának kitöltése"

#: etiketto/ui/elements.py:119
msgid "Line alignment"
msgstr "Sorigazítás"

#: etiketto/ui/elements.py:126
msgid "Name for the command line"
msgstr "Név a parancssorhoz"

#: etiketto/ui/elements.py:162
msgid "Font"
msgstr "Betűkészlet"

#: etiketto/ui/elements.py:184
msgid "Image file"
msgstr "Képfájl"

#: etiketto/ui/elements.py:185 etiketto/ui/label_group.py:113
msgid "None"
msgstr "Nincs"

#: etiketto/ui/elements.py:198
msgid "Type"
msgstr "Típus"

#: etiketto/ui/elements.py:200
msgid "Content (link, text, number)"
msgstr "Tartalom (hivatkozás, szöveg, szám)"

#: etiketto/ui/elements.py:209
msgid "Colour"
msgstr "Szín"

#: etiketto/ui/files.py:34
msgid "Etiketto labels"
msgstr "Etiketto-címkék"

#: etiketto/ui/files.py:39
msgid "Images"
msgstr "Képek"

#: etiketto/ui/files.py:42 etiketto/ui/label_group.py:118
msgid "Choose image"
msgstr "Kép kiválasztása"

#: etiketto/ui/files.py:62
#, python-format
msgid "Cannot open template %(name)s"
msgstr "A sablon nem nyitható meg: %(name)s"

#: etiketto/ui/files.py:76
msgid "Open label"
msgstr "Címke megnyitása"

#: etiketto/ui/files.py:94
msgid "label"
msgstr "címke"

#: etiketto/ui/files.py:138
msgid "Save label"
msgstr "Címke mentése"

#: etiketto/ui/files.py:146 etiketto/ui/window.py:133
msgid "Save as template…"
msgstr "Mentés sablonként…"

#: etiketto/ui/files.py:155 etiketto/ui/files.py:168
#, python-format
msgid "Saved %s"
msgstr "Mentve: %s"

#: etiketto/ui/files.py:181
msgid "Export PNG"
msgstr "Exportálás PNG-ként"

#: etiketto/ui/files.py:189 etiketto/ui/window.py:413
msgid "The preview cannot be drawn"
msgstr "Az előnézet nem rajzolható meg"

#: etiketto/ui/files.py:191
msgid "Exported"
msgstr "Exportálva"

#: etiketto/ui/files.py:201
msgid "No templates yet – use “Save as template…”"
msgstr "Még nincsenek sablonok – használja a „Mentés sablonként…” lehetőséget"

#: etiketto/ui/files.py:228 etiketto/ui/label_group.py:48
#: etiketto/ui/window.py:44
msgid "Label"
msgstr "Címke"

#: etiketto/ui/files.py:238
msgid "Discard changes?"
msgstr "Elveti a módosításokat?"

