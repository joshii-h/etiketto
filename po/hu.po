msgstr "%(n)d. elem: ez a szimbólum nincs a szimbólumtárban"

#: etiketto/ui/texts.py:102
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "%(n)d. elem: nem rajzolható meg"

#: etiketto/ui/texts.py:103
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "A biztonsági margó, a keret és a szélső térköz nem hagy helyet – csökkentse őket"

#: etiketto/ui/texts.py:104
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "A rögzített hossz rövidebb a térköznél – növelje"

#: etiketto/ui/texts.py:105
msgid "The background image cannot be read"
msgstr "A háttérkép nem olvasható"

#: etiketto/ui/texts.py:118
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott ívek: %(n)d / %(total)d."

#: etiketto/ui/texts.py:120
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott címkék: %(n)d / %(total)d."

#: etiketto/ui/texts.py:123
msgid "The labels still waiting in the queue were canceled."
msgstr "A sorban még várakozó címkék nyomtatása megszakadt."

#: etiketto/ui/texts.py:132
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "A nyomtató nem található. Ellenőrizze, hogy be van-e kapcsolva és ugyanazon a hálózaton van-e, vagy adja meg az IP-címét."

#: etiketto/ui/texts.py:135
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A nyomtató nem válaszol. Ellenőrizze, hogy be van-e kapcsolva, és nem alszik-e."

#: etiketto/ui/texts.py:137
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A nyomtató elutasítja a kapcsolatot. Kapcsolja ki, majd újra be. Ha a webes felületén van „Port 9100” beállítás, kapcsolja be."

#: etiketto/ui/texts.py:140
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nincs behelyezett kazetta. Helyezzen be egyet, és próbálja újra."

#: etiketto/ui/texts.py:141
msgid "The printer's cover is open. Close it and try again."
msgstr "A nyomtató fedele nyitva van. Csukja be, és próbálja újra."

#: etiketto/ui/texts.py:142
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A címke elakadt. Nyissa ki a fedelet, vegye ki a címkét, és próbálja újra."

#: etiketto/ui/texts.py:143
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "A kazetta nem ismerhető fel. Helyezze be újra, vagy próbáljon egy másikat."

#: etiketto/ui/texts.py:144
msgid "The printer is busy. Wait a moment and try again."
msgstr "A nyomtató foglalt. Várjon egy kicsit, és próbálja újra."

#: etiketto/ui/texts.py:145
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A címke túl hosszú ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:146
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A címke túl széles ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:147
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A nyomtatóból kifogyott a címke. Töltsön be új tekercset, és próbálja újra."

#: etiketto/ui/texts.py:148
msgid "The print head is open. Close it and try again."
msgstr "A nyomtatófej nyitva van. Zárja le, és próbálja újra."

#: etiketto/ui/texts.py:150
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A nyomtató nem találja a következő címkét. Ellenőrizze, hogy a címkék megfelelően vannak-e betöltve, és áthaladnak-e a címkeérzékelőn."

#: etiketto/ui/texts.py:154
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Probléma van a festékszalaggal. Ellenőrizze, hogy megfelelően van-e behelyezve, és megfelel-e a nyomtatón beállított nyomtatási módnak."

#: etiketto/ui/texts.py:157
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A nyomtató szünetel. Folytassa a kijelzőjén, és próbálja újra."

#: etiketto/ui/texts.py:158
msgid "The printer is out of paper. Load paper and try again."
msgstr "A nyomtatóból kifogyott a papír. Töltsön be papírt, és próbálja újra."

#: etiketto/ui/texts.py:160
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Elakadt a papír. Távolítsa el a nyomtató kijelzőjén látható módon, és próbálja újra."

#: etiketto/ui/texts.py:162
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A nyomtatóból kifogyott a toner vagy a tinta. Cserélje ki, és próbálja újra."

#: etiketto/ui/texts.py:163
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A nyomtató nem tudja kinyomtatni ezt a méretet. Válasszon olyan papírméretet, amelyet kínál."

#: etiketto/ui/texts.py:165
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A nyomtató az Etiketto által küldhető formátumok egyikét sem fogadja el (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:168
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A nyomtató várólistája szünetel. Folytassa a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:172
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "A nyomtatási feladatot visszatartotta a várólista, például amíg fel nem oldják, vagy meg nem adnak egy jelszót. Ellenőrizze a várólistát a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:176
msgid "The print job was canceled at the printer or in the queue."
msgstr "A nyomtatási feladatot a nyomtatón vagy a várólistában megszakították."

#: etiketto/ui/texts.py:178
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A nyomtató hibát jelzett. Kapcsolja ki, majd újra be, és próbálja meg még egyszer."

#: etiketto/ui/texts.py:190
msgid "Warming up…"
msgstr "Bemelegítés…"

#: etiketto/ui/texts.py:191
msgid "Cooling down…"
msgstr "Lehűlés…"

#: etiketto/ui/texts.py:192
msgid "Cleaning…"
msgstr "Tisztítás…"

#: etiketto/ui/texts.py:193
msgid "Swipe the printer's panel to cut the label"
msgstr "Húzzon végig a nyomtató paneljén a címke levágásához"

#: etiketto/ui/texts.py:195
msgid "Out of paper – load paper to continue"
msgstr "Kifogyott a papír – a folytatáshoz töltsön be papírt"

#: etiketto/ui/texts.py:196
msgid "Cover open – close it to continue"
msgstr "A fedél nyitva – a folytatáshoz csukja be"

#: etiketto/ui/texts.py:197
msgid "Paper jammed – remove it to continue"
msgstr "Elakadt a papír – a folytatáshoz távolítsa el"

#: etiketto/ui/texts.py:208
msgid "This label needs a newer version of Etiketto"
msgstr "Ehhez a címkéhez az Etiketto újabb verziója szükséges"

#: etiketto/ui/texts.py:210
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s nem Etiketto-címke"

#: etiketto/ui/texts.py:211
#, python-format
msgid "The file is damaged: %s"
msgstr "A fájl sérült: %s"

#: etiketto/ui/texts.py:217
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Nem menthető: %s (nincs írási jogosultság)"

#: etiketto/ui/texts.py:219
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Nem menthető: %s (a lemez megtelt)"

#: etiketto/ui/texts.py:220
#, python-format
msgid "Cannot save %s"
msgstr "Nem menthető: %s"

#: etiketto/ui/texts.py:229
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "A kazetta valószínű gyártási ideje: %(month)s %(year)d. A régi ZINK-papír halványabb színekkel nyomtat."

