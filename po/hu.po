#: etiketto/ui/texts.py:229
msgctxt "print density"
msgid "Default"
msgstr "Alapértelmezett"

#: etiketto/ui/texts.py:233
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:236
#, python-format
msgid "%d in/s"
msgstr "%d hüvelyk/s"

#: etiketto/ui/texts.py:245
msgid "Image"
msgstr "Kép"

#: etiketto/ui/texts.py:280
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Folyamatos, %(width)s széles"

#: etiketto/ui/texts.py:290
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Ellenőrizze, hogy a teljes címke a kijelölésen belül van-e. Húzással mozgathatja a kijelölést vagy a széleit, vagy rajzolhat újat."

#: etiketto/ui/texts.py:294
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Több terület is lehet a címke. Ellenőrizze a kijelölést, vagy próbálja a következőt."

#: etiketto/ui/texts.py:296
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Az oldalon minden nyomtatott tartalom ki van jelölve. Húzással válassza ki a címkét."

#: etiketto/ui/texts.py:297
msgid "Nothing is printed on this page."
msgstr "Ezen az oldalon nincs semmi nyomtatva."

#: etiketto/ui/texts.py:302
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "A PDF-fájlokhoz Poppler (poppler-glib) kell, amely nincs telepítve"

#: etiketto/ui/texts.py:313
msgid "System printer (CUPS, IPP)"
msgstr "Rendszernyomtató (CUPS, IPP)"

#: etiketto/ui/texts.py:314
msgid "Receipt printer (ESC/POS)"
msgstr "Blokknyomtató (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:316
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, folyamatos tekercsek"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:318
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, stancolt címkék"

#: etiketto/ui/texts.py:325
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "%(n)d. elem: a kód üres"

#: etiketto/ui/texts.py:326
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "%(n)d. elem: az EAN-13 pontosan 12 számjegyet igényel"

#: etiketto/ui/texts.py:327
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "%(n)d. elem: az EAN-13 ellenőrző számjegye hibás"

#: etiketto/ui/texts.py:328
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "%(n)d. elem: a Code 128 legfeljebb %(max)d karaktert tartalmazhat"

#: etiketto/ui/texts.py:330
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "%(n)d. elem: a vonalak túl vékonyak a megbízható beolvasáshoz – használjon hosszabb vagy nagyobb címkét, vagy rövidebb tartalmat"

#: etiketto/ui/texts.py:334
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a Code 128 csak latin betűket, számjegyeket és írásjeleket fogad el"

#: etiketto/ui/texts.py:336
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "%(n)d. elem: az EAN-8 7 számjegyet igényel, vagy 8-at az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:337
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "%(n)d. elem: az UPC-A 11 számjegyet igényel, vagy 12-t az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:339
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "%(n)d. elem: az UPC-E 7, 0-val vagy 1-gyel kezdődő számjegyet igényel, vagy 8-at az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:341
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "%(n)d. elem: az ITF-14 13 számjegyet igényel, vagy 14-et az ellenőrző számjeggyel"

#: etiketto/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "%(n)d. elem: az ellenőrző számjegy hibás"

#: etiketto/ui/texts.py:344
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "%(n)d. elem: a Code 39 csak nagybetűket, számjegyeket, szóközöket és - . $ / + %% jeleket fogad el"

#: etiketto/ui/texts.py:347
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a Code 93 csak latin betűket, számjegyeket és írásjeleket fogad el"

#: etiketto/ui/texts.py:350
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "%(n)d. elem: a GS1-adatok csak latin betűket, számjegyeket és írásjeleket fogadnak el"

#: etiketto/ui/texts.py:353
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "%(n)d. elem: a GS1-adatoknak zárójeles alkalmazás-azonosítókból kell állniuk, mindegyik után az értékével, pl. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:356
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "%(n)d. elem: (%(ai)s) nem GS1 alkalmazás-azonosító"

#: etiketto/ui/texts.py:358
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) értékének hossza hibás"

#: etiketto/ui/texts.py:361
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) ellenőrző számjegye hibás"

#: etiketto/ui/texts.py:364
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "%(n)d. elem: az alkalmazás-azonosító (%(ai)s) értéke érvénytelen: olyan dátum, szám vagy karakter, amelyet nem enged meg"

#: etiketto/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "%(n)d. elem: egyetlen UPC-A szám sem rövidül ezekre az UPC-E számjegyekre – ellenőrizze őket, vagy használjon UPC-A-t"

#: etiketto/ui/texts.py:372
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "%(n)d. elem: a Full ASCII módra állított olvasók a nagybetű előtti $, /, + vagy %% jelet más karakterként olvassák"

#: etiketto/ui/texts.py:375
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "%(n)d. elem: a tartalom túl hosszú ehhez a kódtípushoz"

#: etiketto/ui/texts.py:376
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "%(n)d. elem: a tartalom nem kódolható ebben a kódtípusban"

#: etiketto/ui/texts.py:378
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "%(n)d. elem: ehhez a kódtípushoz a Zint könyvtár (zint-bindings) szükséges, amely nincs telepítve"

#: etiketto/ui/texts.py:381
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "%(n)d. elem: a kép nem olvasható"

#: etiketto/ui/texts.py:382
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "%(n)d. elem: ez a szimbólum nincs a szimbólumtárban"

#: etiketto/ui/texts.py:383
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "%(n)d. elem: a dokumentum nem olvasható"

#: etiketto/ui/texts.py:385
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "%(n)d. elem: a PDF-fájlokhoz Poppler (poppler-glib) kell, amely nincs telepítve"

#: etiketto/ui/texts.py:387
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "%(n)d. elem: nem rajzolható meg"

#: etiketto/ui/texts.py:389
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "A biztonsági margó, a keret, annak behúzása és a szélső térköz nem hagy helyet – csökkentse őket"

#: etiketto/ui/texts.py:391
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "A rögzített hossz rövidebb a térköznél – növelje"

#: etiketto/ui/texts.py:392
msgid "The background image cannot be read"
msgstr "A háttérkép nem olvasható"

#: etiketto/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "%(n)d. elem: a kód moduljai csak egy nyomtatási pont szélesek, ezért lehet, hogy nem olvashatók be – nagyítsa a kódot"

#: etiketto/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "%(n)d. elem: a kód körül szükséges üres hely nem fér el – nagyítsa a kódot"

#: etiketto/ui/texts.py:402
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "%(n)d. elem: a kód modulonként egy nyomtatási ponttal sem fér el a helyén – nagyítsa a címkét vagy rövidítse a tartalmat"

#: etiketto/ui/texts.py:405
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "%(n)d. elem: a(z) %(name)s nem ismert változó"

#: etiketto/ui/texts.py:407
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "%(n)d. elem: a(z) %(name)s dátuma az 1. év előtti vagy 9999 utáni"

#: etiketto/ui/texts.py:410
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "%(n)d. elem: a(z) %(name)s… változó nincs lezárva – zárja le ezzel: }"

#: etiketto/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "%(n)d. elem: fekete-fehér nyomtatón alig válik el attól, ami mögötte van, egészben vagy részben – válasszon más színt, vagy helyezze át"

#: etiketto/ui/texts.py:416
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "%(n)d. elem: az alakzatnak nincs se vonala, se kitöltése"

#: etiketto/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "A(z) %(n)d. elem túlnyúlik a címke szélén, és ott levágódik – mozgassa el vagy kicsinyítse"

#: etiketto/ui/texts.py:422
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "%(n)d. elem: a belső margó, a keret, a körvonal vagy az árnyék nem hagy helyet a szövegnek – csökkentse őket"

#: etiketto/ui/texts.py:437
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott ívek: %(n)d / %(total)d."

#: etiketto/ui/texts.py:439
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Már kinyomtatott címkék: %(n)d / %(total)d."

#: etiketto/ui/texts.py:443
msgid "The sheets still waiting in the queue were canceled."
msgstr "A sorban még várakozó ívek nyomtatása megszakadt."

#: etiketto/ui/texts.py:445
msgid "The labels still waiting in the queue were canceled."
msgstr "A sorban még várakozó címkék nyomtatása megszakadt."

#: etiketto/ui/texts.py:452
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "A címke %(size)s, a hézag %(gap)s, így %(pitch)s távolságonként kezdődik új címke. A nyomtató %(measured)s címketávolságot mért. Ellenőrizze a címkeméretet és a hézagot."

#: etiketto/ui/texts.py:468
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "A nyomtató nem található. Ellenőrizze, hogy be van-e kapcsolva és ugyanazon a hálózaton van-e, vagy adja meg az IP-címét."

#: etiketto/ui/texts.py:472
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "A nyomtató nem található USB-n. Ellenőrizze a kábelt, és hogy a nyomtató be van-e kapcsolva és nem alszik-e, majd keressen újra."

#: etiketto/ui/texts.py:475
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A nyomtató nem válaszol. Ellenőrizze, hogy be van-e kapcsolva, és nem alszik-e."

#: etiketto/ui/texts.py:477
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "A nyomtató nem fogad több adatot. Ellenőrizze, hogy jelez-e hibát, például kifogyott címkéket vagy nyitott fedelet, majd próbálja újra."

#: etiketto/ui/texts.py:481
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A nyomtató elutasítja a kapcsolatot. Kapcsolja ki, majd újra be. Ha a webes felületén van „Port 9100” beállítás, kapcsolja be."

#: etiketto/ui/texts.py:484
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nincs behelyezett kazetta. Helyezzen be egyet, és próbálja újra."

#: etiketto/ui/texts.py:485
msgid "The printer's cover is open. Close it and try again."
msgstr "A nyomtató fedele nyitva van. Csukja be, és próbálja újra."

#: etiketto/ui/texts.py:486
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A címke elakadt. Nyissa ki a fedelet, vegye ki a címkét, és próbálja újra."

#: etiketto/ui/texts.py:487
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "A kazetta nem ismerhető fel. Helyezze be újra, vagy próbáljon egy másikat."

#: etiketto/ui/texts.py:488
msgid "The printer is busy. Wait a moment and try again."
msgstr "A nyomtató foglalt. Várjon egy kicsit, és próbálja újra."

#: etiketto/ui/texts.py:489
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A címke túl hosszú ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:490
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A címke túl széles ehhez a nyomtatóhoz: legfeljebb %(max)s."

#: etiketto/ui/texts.py:491
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A nyomtatóból kifogyott a címke. Töltsön be új tekercset, és próbálja újra."

#: etiketto/ui/texts.py:492
msgid "The print head is open. Close it and try again."
msgstr "A nyomtatófej nyitva van. Zárja le, és próbálja újra."

#: etiketto/ui/texts.py:494
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A nyomtató nem találja a következő címkét. Ellenőrizze, hogy a címkék megfelelően vannak-e betöltve, és áthaladnak-e a címkeérzékelőn."

#: etiketto/ui/texts.py:498
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Probléma van a festékszalaggal. Ellenőrizze, hogy megfelelően van-e behelyezve, és megfelel-e a nyomtatón beállított nyomtatási módnak."

#: etiketto/ui/texts.py:504
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "A nyomtató nem talál festékszalagot. Helyezzen be festékszalagot, és próbálja újra. A festékszalag nélkül nyomtatott címkékhez a(z) „%(method)s” beállításnál „%(direct)s” kell."

#: etiketto/ui/texts.py:511
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Festékszalag van behelyezve, de a nyomtató nélküle nyomtat (direkt termál). A festékszalagot igénylő címkékhez válassza a(z) „%(method)s” beállításnál ezt: „%(transfer)s”, vagy vegye ki a festékszalagot."

#: etiketto/ui/texts.py:516
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A nyomtató szünetel. Folytassa a kijelzőjén, és próbálja újra."

#: etiketto/ui/texts.py:517
msgid "The printer is out of paper. Load paper and try again."
msgstr "A nyomtatóból kifogyott a papír. Töltsön be papírt, és próbálja újra."

#: etiketto/ui/texts.py:519
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Elakadt a papír. Távolítsa el a nyomtató kijelzőjén látható módon, és próbálja újra."

#: etiketto/ui/texts.py:521
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A nyomtatóból kifogyott a toner vagy a tinta. Cserélje ki, és próbálja újra."

#: etiketto/ui/texts.py:522
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A nyomtató nem tudja kinyomtatni ezt a méretet. Válasszon olyan papírméretet, amelyet kínál."

#: etiketto/ui/texts.py:524
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A nyomtató az Etiketto által küldhető formátumok egyikét sem fogadja el (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:527
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A nyomtató várólistája szünetel. Folytassa a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:531
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "A nyomtatási feladatot visszatartotta a várólista, például amíg fel nem oldják, vagy meg nem adnak egy jelszót. Ellenőrizze a várólistát a rendszer nyomtatóbeállításaiban, és próbálja újra."

#: etiketto/ui/texts.py:535
msgid "The print job was canceled at the printer or in the queue."
msgstr "A nyomtatási feladatot a nyomtatón vagy a várólistában megszakították."

#: etiketto/ui/texts.py:536
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "A nyomtató nem jelezte időben a felbontását. Válassza ki itt: „%s”."

#: etiketto/ui/texts.py:539
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "A betöltött tekercs nem illik a címkéhez. Töltsön be megfelelő tekercset, vagy válassza ki a betöltött tekercs címkeméretét vagy nyomtatómodelljét."

#: etiketto/ui/texts.py:542
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "A nyomtató akkumulátora lemerülőben van – töltse fel, vagy csatlakoztassa a hálózati adaptert."

#: etiketto/ui/texts.py:543
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "A nyomtatófej túl forró. Várja meg, amíg lehűl, majd próbálja újra."

#: etiketto/ui/texts.py:545
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Az Etiketto nem tud nyomtatni ezen a nyomtatótípuson: nem fogadja az Etiketto által küldött raszterképeket."

#: etiketto/ui/texts.py:549
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Az Etiketto nem ismeri ezt a nyomtatótípust, és még nem tud nyomtatni rajta."

#: etiketto/ui/texts.py:552
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "A nyomtató Editor Lite módban van, és USB-meghajtóként jelenik meg. Kapcsolja ki az Editor Lite módot a nyomtatón (a lámpája kialszik), majd keressen újra."

#: etiketto/ui/texts.py:556
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Az Etiketto nem használhatja a nyomtató USB-portját. Adja hozzá a felhasználóját az „lp” csoporthoz (sudo usermod -aG lp $USER), majd jelentkezzen ki, és jelentkezzen be újra."

#: etiketto/ui/texts.py:560
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Az oldal túl nagy ahhoz, hogy a nyomtató által elfogadott felbontásban elkészüljön. Válasszon kisebb papírméretet, vagy nyomtasson PDF-et elfogadó nyomtatóra."

#: etiketto/ui/texts.py:564
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Ennek a nyomtatónak a felbontásán egy kód nem fér el a címkén, és levágódna. Nagyítsa a címkét vagy rövidítse a kód tartalmát."

#: etiketto/ui/texts.py:568
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Az Etiketto nem használhatja a nyomtató soros portját. Adja hozzá a felhasználóját a „dialout” csoporthoz (sudo usermod -aG dialout $USER; Arch Linuxon a csoport neve „uucp”), majd jelentkezzen ki, és jelentkezzen be újra."

#: etiketto/ui/texts.py:573
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A nyomtató hibát jelzett. Kapcsolja ki, majd újra be, és próbálja meg még egyszer."

#: etiketto/ui/texts.py:584
msgid "Printed"
msgstr "Kinyomtatva"

#: etiketto/ui/texts.py:590
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Elküldve a nyomtatónak – akkor nyomtatja, amikor sorra kerül"

#: etiketto/ui/texts.py:592
msgid "Sent to the printer – it did not confirm printing"
msgstr "Elküldve a nyomtatónak – nem igazolta vissza a nyomtatást"

#: etiketto/ui/texts.py:596
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Nyomtatva ezzel: „%(used)s”, mert a betöltött tekercs ezt igényli"

#: etiketto/ui/texts.py:600
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "„%(wanted)s” színmód nem érhető el ezen a nyomtatón, helyette: „%(used)s”"

#: etiketto/ui/texts.py:610
msgid "Warming up…"
msgstr "Bemelegítés…"

#: etiketto/ui/texts.py:611
msgid "Cooling down…"
msgstr "Lehűlés…"

#: etiketto/ui/texts.py:612
msgid "Cleaning…"
msgstr "Tisztítás…"

#: etiketto/ui/texts.py:613
msgid "Swipe the printer's panel to cut the label"
msgstr "Húzzon végig a nyomtató paneljén a címke levágásához"

#: etiketto/ui/texts.py:615
msgid "Out of paper – load paper to continue"
msgstr "Kifogyott a papír – a folytatáshoz töltsön be papírt"

#: etiketto/ui/texts.py:616
msgid "Cover open – close it to continue"
msgstr "A fedél nyitva – a folytatáshoz csukja be"

#: etiketto/ui/texts.py:617
msgid "Paper jammed – remove it to continue"
msgstr "Elakadt a papír – a folytatáshoz távolítsa el"

#: etiketto/ui/texts.py:628
msgid "This label needs a newer version of Etiketto"
msgstr "Ehhez a címkéhez az Etiketto újabb verziója szükséges"

#: etiketto/ui/texts.py:630
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s nem Etiketto-címke"

#: etiketto/ui/texts.py:631 etiketto/ui/texts.py:651
#: etiketto/server/service.py:686
#, python-format
msgid "The file is damaged: %s"
msgstr "A fájl sérült: %s"

#: etiketto/ui/texts.py:638
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "A(z) %s adatfájl már nem létezik. Válassza ki újra, vagy távolítsa el."

#: etiketto/ui/texts.py:642
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "A(z) %(file)s fájlban nincs %(sheet)s nevű munkalap"

#: etiketto/ui/texts.py:644
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "A(z) %s nem táblázat. Használjon CSV-, ODS- vagy XLSX-fájlt."

#: etiketto/ui/texts.py:646
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "A(z) %s túl nagy a sorozatcímkékhez. Ossza fel kisebb fájlokra, vagy távolítsa el a felesleges sorokat és oszlopokat."

#: etiketto/ui/texts.py:649
#, python-format
msgid "%s contains no data."
msgstr "A(z) %s nem tartalmaz adatot."

#: etiketto/ui/texts.py:660
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "A nyomtatás a(z) %(row)d. sornál leállt. A folytatáshoz nyomtasson újra a(z) %(row)d. sortól."

#: etiketto/ui/texts.py:664
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "A(z) %(row)d. sor már kinyomtatott példányai: %(copies)d."

#: etiketto/ui/texts.py:669
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "A(z) %(row)d. sor a(z) %(sheet)d. ív %(position)d. helyére kerül."

#: etiketto/ui/texts.py:680
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Nem menthető: %s (nincs írási jogosultság)"

#: etiketto/ui/texts.py:682
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Nem menthető: %s (a lemez megtelt)"

#: etiketto/ui/texts.py:692
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "A kazetta valószínű gyártási ideje: %(month)s %(year)d. A régi ZINK-papír halványabb színekkel nyomtat."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Dátum"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Szavatossági idő (30 nap múlva)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "Idő"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "Számláló"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Számláló vezető nullákkal"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "Példány sorszáma"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "Példányszám"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "Véletlen azonosító"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "Változó beszúrása"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "A változók nyomtatáskor töltődnek ki. Minden kinyomtatott címke a számláló következő értékét kapja, példányról példányra is. Az előnézet a következő nyomtatás értékeit mutatja."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "További információ a változókról"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Minden kinyomtatott címkével nő a lépésközzel"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "Következő szám"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "Lépésköz"

#: etiketto/ui/window.py:158
msgid "Templates"
msgstr "Sablonok"

#: etiketto/ui/window.py:189
msgid "Shipping label…"
msgstr "Szállítási címke…"

#: etiketto/ui/window.py:192
msgid "Data for serial labels…"
msgstr "Sorozatcímkék adatai…"

#: etiketto/ui/window.py:193
msgid "Forget allowed data files"
msgstr "Engedélyezett adatfájlok elfelejtése"

#: etiketto/ui/window.py:194
msgid "Export PNG…"
msgstr "Exportálás PNG-ként…"

#: etiketto/ui/window.py:198
msgid "Report a problem…"
msgstr "Probléma jelentése…"

#: etiketto/ui/window.py:199
msgid "About Etiketto"
msgstr "Az Etiketto névjegye"

#: etiketto/ui/window.py:678
msgid "Unsaved label"
msgstr "Mentetlen címke"

#: etiketto/ui/window.py:837
msgid "content scaled down to fit"
msgstr "a tartalom kicsinyítve, hogy elférjen"

#: etiketto/ui/window.py:841
#, python-format
msgid "Problem: %s"
msgstr "Probléma: %s"

#: etiketto/ui/window.py:860
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Túl hosszú ehhez a nyomtatóhoz: legfeljebb %s"

#: etiketto/ui/window.py:864
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Túl széles ehhez a nyomtatóhoz: legfeljebb %s"

#: etiketto/ui/window.py:936
msgid "The browser cannot be opened"
msgstr "A böngésző nem nyitható meg"

#: etiketto/ui/window.py:938
msgid "Copy link"
msgstr "Hivatkozás másolása"

#: etiketto/ui/window.py:1009
msgid "Only local files can be dropped"
msgstr "Csak helyi fájlok húzhatók ide"

#: etiketto/ui/window.py:1047
msgid "Please wait until printing has finished"
msgstr "Várjon, amíg a nyomtatás befejeződik"

#: etiketto/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: etiketto/server/config.py:89 etiketto/server/config.py:93
#: etiketto/server/config.py:99 etiketto/server/main.py:341
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "A(z) %(file)s nem olvasható: %(reason)s"

#: etiketto/server/config.py:109
msgid "expected a table"
msgstr "tábla várható"

#: etiketto/server/config.py:119 etiketto/server/config.py:446
msgid "missing"
msgstr "hiányzik"

#: etiketto/server/config.py:122
msgid "expected text"
msgstr "szöveg várható"

#: etiketto/server/config.py:124
msgid "control characters are not allowed"
msgstr "vezérlőkarakterek nem engedélyezettek"

#: etiketto/server/config.py:130
msgid "expected true or false"
msgstr "true vagy false várható"

#: etiketto/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "szám várható %(min)s és %(max)s között"

#: etiketto/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "a következők egyike várható: %s"

#: etiketto/server/config.py:153 etiketto/server/config.py:159
msgid "unknown key"
msgstr "ismeretlen kulcs"

#: etiketto/server/config.py:162
msgid "nothing defined"
msgstr "nincs semmi megadva"

#: etiketto/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "érvénytelen név: betűk, számjegyek, . _ - (legfeljebb 64)"

#: etiketto/server/config.py:209
msgid "only one printer can be the default"
msgstr "csak egy nyomtató lehet az alapértelmezett"

#: etiketto/server/config.py:223
msgid "not a valid printer address"
msgstr "érvénytelen nyomtatócím"

#: etiketto/server/config.py:245
msgid "this printer model does not cut"
msgstr "ez a nyomtatómodell nem vág"

#: etiketto/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "ennek a nyomtatómodellnek nincsenek színbeállításai"

#: etiketto/server/config.py:406
msgid "expected a date such as 2027-12-31"
msgstr "dátum várható, pl. 2027-12-31"

#: etiketto/server/config.py:420
msgid "the same token twice"
msgstr "ugyanaz a token kétszer"

#: etiketto/server/config.py:433
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s fájlt a számítógép bármely felhasználója módosíthatja: futtassa rá a chmod 600 parancsot"

#: etiketto/server/config.py:443
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "nem token-hash: sha256:… vagy scrypt:… várható"

#: etiketto/server/config.py:469
msgid "expected a list of printer names"
msgstr "nyomtatónevek listája várható"

#: etiketto/server/config.py:471
msgid "printers can only be limited with --printers"
msgstr "a nyomtatók csak a --printers kapcsolóval korlátozhatók"

#: etiketto/server/config.py:473 etiketto/server/service.py:466
#, python-format
msgid "Unknown printer: %s"
msgstr "Ismeretlen nyomtató: %s"

#: etiketto/server/errors.py:29
#, python-format
msgid "Invalid value for %s"
msgstr "Érvénytelen érték ehhez: %s"

#: etiketto/server/http.py:464 etiketto/server/http.py:513
msgid "The request took too long"
msgstr "A kérés túl sokáig tartott"

#: etiketto/server/http.py:473 etiketto/server/service.py:1174
msgid "The server is busy – try again later"
msgstr "A kiszolgáló foglalt – próbálja újra később"

#: etiketto/server/http.py:516
msgid "Internal error"
msgstr "Belső hiba"

#: etiketto/server/http.py:521
msgid "This server only answers on its local address"
msgstr "Ez a kiszolgáló csak a helyi címén válaszol"

#: etiketto/server/http.py:525
msgid "Requests from this web page are not allowed"
msgstr "Erről a weboldalról nem engedélyezettek a kérések"

#: etiketto/server/http.py:543
msgid "Too many requests – try again later"
msgstr "Túl sok kérés – próbálja újra később"

#: etiketto/server/http.py:545
msgid "Access token missing or wrong"
msgstr "A hozzáférési token hiányzik vagy hibás"

#: etiketto/server/http.py:586 etiketto/server/http.py:591
msgid "The request needs a Content-Length"
msgstr "A kéréshez Content-Length szükséges"

#: etiketto/server/http.py:588
msgid "The request has more than one Content-Length"
msgstr "A kérésben több Content-Length is szerepel"

#: etiketto/server/http.py:594
msgid "The request is too large"
msgstr "A kérés túl nagy"

#: etiketto/server/http.py:599
msgid "The request body is incomplete"
msgstr "A kérés törzse hiányos"

