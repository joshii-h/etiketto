msgstr "Ellipszis"

#: etiketto/ui/texts.py:177
msgid "Separator"
msgstr "Elválasztó"

#: etiketto/ui/texts.py:180
msgid "Horizontal"
msgstr "Vízszintes"

#: etiketto/ui/texts.py:181
msgid "Vertical"
msgstr "Függőleges"

#: etiketto/ui/texts.py:182
msgid "Diagonal, rising"
msgstr "Átlós, emelkedő"

#: etiketto/ui/texts.py:183
