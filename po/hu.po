#: etiketto/app.py:136 etiketto/cli.py:118
msgid "Design and print labels"
msgstr "Címkék tervezése, nyomtatása"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:91
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE várható: %s"

#: etiketto/cli.py:107
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "egész szám várható %(min)d és %(max)d között: %(value)s"

#: etiketto/cli.py:119
msgid "Without a command the application starts; label files given open in it."
msgstr "Parancs nélkül az alkalmazás indul el; a megadott címkefájlok abban nyílnak meg."

#: etiketto/cli.py:125
msgid "print a label file without opening a window"
msgstr "címkefájl nyomtatása ablak megnyitása nélkül"

#: etiketto/cli.py:126
msgid "Print a label file without opening a window."
msgstr "Címkefájl nyomtatása ablak megnyitása nélkül."

#: etiketto/cli.py:128
msgid "the label (.etiketto)"
msgstr "a címke (.etiketto)"

#: etiketto/cli.py:131
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "nyomtatómodell, alapértelmezés szerint a címkéé: %s"

#: etiketto/cli.py:134
msgid "printer address, by default the one set in the app"
msgstr "nyomtató címe, alapértelmezés szerint az alkalmazásban beállított cím"

#: etiketto/cli.py:137
msgid "number of copies"
msgstr "példányszám"

#: etiketto/cli.py:147
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "a NAME elem szövege, vagy a {=NAME} változó értéke; a szövegben lévő változók kitöltődnek; ismételhető"

#: etiketto/cli.py:157
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "mint a --set, de az érték változatlanul kerül felhasználásra: a kapcsos zárójelek nem változók"

#: etiketto/cli.py:163
msgid "counter of the first label, instead of the one saved in the label"
msgstr "az első címke számlálója a címkébe mentett helyett"

#: etiketto/cli.py:169
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ne mentse a számláló következő értékét a címkébe (csak olvasható fájl); a következő nyomtatás ugyanattól a számtól indul"

#: etiketto/cli.py:174
msgid "check and render only, do not print"
msgstr "csak ellenőrzés és megjelenítés, nincs nyomtatás"

#: etiketto/cli.py:180
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run esetén: a képek mentése PNG-ként úgy, ahogy a nyomtató kapná (- a szabványos kimenethez: csak az első)"

#: etiketto/cli.py:186
msgid "list the printers found on the network"
msgstr "a hálózaton talált nyomtatók listázása"

#: etiketto/cli.py:187
msgid "List the printers found on the network: model, address, name."
msgstr "A hálózaton talált nyomtatók listázása: modell, cím, név."

#: etiketto/cli.py:189
#, python-format
msgid "only this printer model: %s"
msgstr "csak ez a nyomtatómodell: %s"

#: etiketto/cli.py:208
#, python-format
msgid "Unknown printer model: %s"
msgstr "Ismeretlen nyomtatómodell: %s"

#: etiketto/cli.py:215 etiketto/ui/files.py:88 etiketto/ui/files.py:141
#: etiketto/ui/texts.py:163
#, python-format
msgid "Cannot open %s"
msgstr "Nem nyitható meg: %s"

#: etiketto/cli.py:237
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "A(z) %s nem dátum, várható pl. 2026-12-31 vagy 2026-12-31T08:30"

#: etiketto/cli.py:264
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "A(z) {=%s} nyomtatáskor töltődik ki, és nem állítható be"

#: etiketto/cli.py:269
#, python-format
msgid "The label has no element or variable named %s"
msgstr "A címkén nincs %s nevű elem vagy változó"

#: etiketto/cli.py:293 etiketto/ui/printing.py:76
msgid "The label is empty"
msgstr "A címke üres"

#: etiketto/cli.py:326
msgid "Cannot write the output"
msgstr "A kimenet nem írható"

#: etiketto/cli.py:357
msgid "--output writes PNG images: give a name ending in .png"
msgstr "a --output PNG-képeket ír: .png végű nevet adjon meg"

#: etiketto/cli.py:381 etiketto/ui/printing.py:351
msgid "The label cannot be prepared for printing."
msgstr "A címke nem készíthető elő nyomtatásra."

#: etiketto/cli.py:429
msgid "No printer found – give its address with --host"
msgstr "Nem található nyomtató – adja meg a címét a --host kapcsolóval"

#: etiketto/cli.py:431
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Több nyomtató található – válasszon egyet a --host kapcsolóval (etiketto list-printers)"

#: etiketto/cli.py:443 etiketto/ui/texts.py:410
#, python-format
msgid "Cannot save %s"
msgstr "Nem menthető: %s"

#: etiketto/cli.py:445
msgid "the labels were printed, but the next counter value was not saved"
msgstr "a címkék kinyomtatva, de a számláló következő értéke nem lett mentve"

#: etiketto/cli.py:460
msgid "nothing was printed: the next counter value could not be saved"
msgstr "semmi sem lett kinyomtatva: a számláló következő értéke nem lenne menthető"

#: etiketto/cli.py:520 etiketto/cli.py:641
msgid "Interrupted"
msgstr "Megszakítva"

#: etiketto/cli.py:573
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Várakozás a(z) %s egy másik nyomtatásának befejezésére…"

#: etiketto/cli.py:580
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s még zárolva van egy másik nyomtatás miatt – próbálja újra később"

#: etiketto/cli.py:586
msgid "--output needs --dry-run"
msgstr "A --output használatához --dry-run szükséges"

#: etiketto/cli.py:595
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "A számláló következő értéke nem lesz mentve: a következő nyomtatás megismétli a számokat"

