msgstr "تعذّر حفظ %s: لا يوجد إذن بالكتابة هناك"

#: etiketto/ui/texts.py:257
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "تعذّر حفظ %s: القرص ممتلئ"

#: etiketto/ui/texts.py:258
#, python-format
msgid "Cannot save %s"
msgstr "تعذّر حفظ %s"

#: etiketto/ui/texts.py:267
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "يبدو أن هذه الخرطوشة من %(month)s %(year)d. ورق ZINK القديم يطبع ألوانًا باهتة."

