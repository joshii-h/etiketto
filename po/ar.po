msgstr "لا يوجد عنوان طابعة: حدّده في host"

#: etiketto/server/service.py:491
#, python-format
msgid "This printer address is not allowed: %s"
msgstr "عنوان الطابعة هذا غير مسموح به: %s"

#: etiketto/server/service.py:662
msgid "A sheet needs a data file"
msgstr "تحتاج الورقة إلى ملف بيانات"

#: etiketto/server/service.py:668
msgid ""
"The label uses a data file outside the labels folder: send its rows along"
msgstr "يستخدم الملصق ملف بيانات خارج مجلد الملصقات: أرسل صفوفه معه"

#: etiketto/server/service.py:743
#, python-format
msgid "At most %d labels in one print job"
msgstr "%d ملصق كحد أقصى في مهمة طباعة واحدة"

#: etiketto/server/service.py:763
msgid "Too many print jobs are waiting – try again later"
msgstr "مهام طباعة كثيرة جدًا في الانتظار – حاول مجددًا لاحقًا"

#: etiketto/server/service.py:949
#, python-format
msgid "No such print job: %s"
msgstr "لا توجد مهمة طباعة بهذا المعرّف: %s"

#: etiketto/server/service.py:961
msgid "The print job has already finished"
msgstr "انتهت مهمة الطباعة بالفعل"

#: etiketto/server/service.py:984
msgid "The label is too large to render"
msgstr "الملصق كبير جدًا بحيث يتعذر عرضه"

#: etiketto/server/service.py:1010
#, python-format
msgid ""
"The label is too large: at most %(elements)d elements and %(chars)d "
"characters in a text"
msgstr "الملصق كبير جدًا: %(elements)d عنصرًا كحد أقصى و%(chars)d حرفًا في النص الواحد"

#: etiketto/server/service.py:1020
#, python-format
msgid "At most %d copies on this printer"
msgstr "%d نسخ كحد أقصى على هذه الطابعة"

#: etiketto/server/service.py:1025
msgid "Printers are chosen by name: leave out host"
msgstr "تُختار الطابعات بالاسم: احذف host"
