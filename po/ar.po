#: etiketto/ui/texts.py:108
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "العنصر %(n)d: رقم التحقق في EAN-13 غير صحيح"

#: etiketto/ui/texts.py:110
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "العنصر %(n)d: لا يقبل Code 128 إلا الحروف اللاتينية والأرقام وعلامات الترقيم"

#: etiketto/ui/texts.py:112
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "العنصر %(n)d: تعذّرت قراءة الصورة"

#: etiketto/ui/texts.py:113
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "تعذّر رسم العنصر %(n)d"

#: etiketto/ui/texts.py:114
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "لا يترك هامش الأمان والإطار وتباعد الحواف أي مساحة – قلّلها"

#: etiketto/ui/texts.py:115
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "الطول الثابت أقصر من التباعد – زِده"

#: etiketto/ui/texts.py:116
msgid "The background image cannot be read"
msgstr "تعذّرت قراءة صورة الخلفية"

#: etiketto/ui/texts.py:128
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "الملصقات المطبوعة بالفعل: %(n)d من %(total)d."

#: etiketto/ui/texts.py:133
msgid "The labels still waiting in the queue were canceled."
msgstr "أُلغيت الملصقات التي كانت لا تزال تنتظر في قائمة الانتظار."

#: etiketto/ui/texts.py:142
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "تعذّر العثور على الطابعة. تأكّد من أنها قيد التشغيل وعلى الشبكة نفسها، أو أدخل عنوان IP الخاص بها."

#: etiketto/ui/texts.py:146
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "لا يمكن العثور على الطابعة عبر USB. تحقّق من الكابل ومن أن الطابعة قيد التشغيل وليست في وضع السكون، ثم ابحث مجددًا."

#: etiketto/ui/texts.py:149
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "الطابعة لا تستجيب. تأكّد من أنها قيد التشغيل وليست في وضع السكون."

#: etiketto/ui/texts.py:151
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "توقفت الطابعة عن استقبال البيانات. تحقّق مما إذا كانت تعرض مشكلة، مثل نفاد الملصقات أو غطاء مفتوح، ثم حاول مرة أخرى."

#: etiketto/ui/texts.py:155
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "ترفض الطابعة الاتصال. أطفئها ثم شغّلها مجددًا. إن كانت واجهة الويب الخاصة بها توفّر خيار «Port 9100»، ففعّله."

#: etiketto/ui/texts.py:158
msgid "No cassette is inserted. Insert one and try again."
msgstr "لا توجد خرطوشة. أدخل خرطوشة وحاول مجددًا."

#: etiketto/ui/texts.py:159
msgid "The printer's cover is open. Close it and try again."
msgstr "غطاء الطابعة مفتوح. أغلقه وحاول مجددًا."

#: etiketto/ui/texts.py:160
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "الملصق عالق. افتح الغطاء وأزل الملصق ثم حاول مجددًا."

#: etiketto/ui/texts.py:161
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "لم يتم التعرّف على الخرطوشة. أعد إدخالها أو جرّب خرطوشة أخرى."

#: etiketto/ui/texts.py:162
msgid "The printer is busy. Wait a moment and try again."
msgstr "الطابعة مشغولة. انتظر قليلًا وحاول مجددًا."

#: etiketto/ui/texts.py:163
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "الملصق طويل جدًا لهذه الطابعة: الحد الأقصى %(max)s."

#: etiketto/ui/texts.py:164
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "الملصق أعرض من أن تطبعه هذه الطابعة: الحد الأقصى %(max)s."

#: etiketto/ui/texts.py:165
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "نفدت الملصقات من الطابعة. ضع رولًا جديدًا وحاول مرة أخرى."

#: etiketto/ui/texts.py:166
msgid "The print head is open. Close it and try again."
msgstr "رأس الطباعة مفتوح. أغلقه وحاول مرة أخرى."

#: etiketto/ui/texts.py:168
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "تعذّر على الطابعة العثور على الملصق التالي. تحقق من تحميل الملصقات بشكل صحيح ومن مرورها عبر حسّاس الملصقات."

#: etiketto/ui/texts.py:172
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "توجد مشكلة في شريط الحبر. تحقق من تركيبه بشكل صحيح ومن توافقه مع طريقة الطباعة المضبوطة على الطابعة."

#: etiketto/ui/texts.py:175
msgid "The printer is paused. Resume it on its display and try again."
msgstr "الطابعة متوقفة مؤقتًا. استأنف من شاشتها وحاول مرة أخرى."

#: etiketto/ui/texts.py:176
msgid "The printer is out of paper. Load paper and try again."
msgstr "نفد الورق من الطابعة. حمّل الورق وحاول مجددًا."

#: etiketto/ui/texts.py:178
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "الورق عالق. أزله كما تعرض شاشة الطابعة وحاول مجددًا."

#: etiketto/ui/texts.py:180
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "نفد الحبر أو مسحوق الحبر من الطابعة. استبدله وحاول مجددًا."

#: etiketto/ui/texts.py:181
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "لا تستطيع الطابعة طباعة هذا الحجم. اختر حجم ورق تدعمه."

#: etiketto/ui/texts.py:183
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "لا تقبل الطابعة أيًّا من الصيغ التي يستطيع Etiketto إرسالها (PDF وPWG Raster وJPEG)."

#: etiketto/ui/texts.py:186
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "قائمة انتظار الطابعة متوقفة مؤقتًا. استأنفها من إعدادات الطابعة في النظام وحاول مجددًا."

#: etiketto/ui/texts.py:190
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "احتُجزت مهمة الطباعة في قائمة الانتظار، مثلًا إلى أن يُفرج عنها أو تُدخل كلمة مرور. تحقق من قائمة الانتظار في إعدادات الطابعة في النظام وحاول مجددًا."

#: etiketto/ui/texts.py:194
msgid "The print job was canceled at the printer or in the queue."
msgstr "أُلغيت مهمة الطباعة في الطابعة أو في قائمة الانتظار."

#: etiketto/ui/texts.py:196
msgid ""
"The printer's batteries are low. Connect the power adapter or charge the "
"batteries, then try again."
msgstr "بطاريات الطابعة ضعيفة. وصّل محوّل الطاقة أو اشحن البطاريات، ثم حاول مرة أخرى."

#: etiketto/ui/texts.py:199
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "رأس الطباعة ساخن جدًا. انتظر حتى يبرد، ثم حاول مرة أخرى."

#: etiketto/ui/texts.py:201
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "لا يستطيع Etiketto الطباعة على طراز الطابعة هذا: فهو لا يقبل الصور النقطية التي يرسلها Etiketto."

#: etiketto/ui/texts.py:205
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "لا يعرف Etiketto طراز الطابعة هذا ولا يستطيع الطباعة عليه بعد."

#: etiketto/ui/texts.py:208
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "الطابعة في وضع Editor Lite وتظهر كمحرك أقراص USB. أوقف Editor Lite في الطابعة (ينطفئ مصباحه)، ثم ابحث مرة أخرى."

#: etiketto/ui/texts.py:212
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "لا يملك Etiketto إذن استخدام منفذ USB الخاص بالطابعة. أضف المستخدم الخاص بك إلى المجموعة «lp» (sudo usermod -aG lp $USER)، ثم سجّل الخروج وسجّل الدخول مجددًا."

#: etiketto/ui/texts.py:216
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "أبلغت الطابعة عن مشكلة. أطفئها ثم شغّلها مجددًا، ثم حاول مرة أخرى."

#: etiketto/ui/texts.py:228
msgid "Warming up…"
msgstr "جارٍ التسخين…"

#: etiketto/ui/texts.py:229
msgid "Cooling down…"
msgstr "جارٍ التبريد…"

#: etiketto/ui/texts.py:230
msgid "Cleaning…"
msgstr "جارٍ التنظيف…"

#: etiketto/ui/texts.py:231
msgid "Swipe the printer's panel to cut the label"
msgstr "اسحب على لوحة الطابعة لقص الملصق"

#: etiketto/ui/texts.py:233
msgid "Out of paper – load paper to continue"
msgstr "نفد الورق – حمّل الورق للمتابعة"

#: etiketto/ui/texts.py:234
msgid "Cover open – close it to continue"
msgstr "الغطاء مفتوح – أغلقه للمتابعة"

#: etiketto/ui/texts.py:235
msgid "Paper jammed – remove it to continue"
msgstr "الورق عالق – أزله للمتابعة"

#: etiketto/ui/texts.py:246
msgid "This label needs a newer version of Etiketto"
msgstr "يتطلب هذا الملصق إصدارًا أحدث من Etiketto"

#: etiketto/ui/texts.py:248
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s ليس ملصق Etiketto"

#: etiketto/ui/texts.py:249
#, python-format
msgid "The file is damaged: %s"
msgstr "الملف تالف: %s"

#: etiketto/ui/texts.py:255
#, python-format
