#: tavletta/app.py:147 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "المربع والإطار"

#: tavletta/app.py:221 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "صمّم الملصقات واطبعها"

#: tavletta/app.py:224
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta كلمة رومانشية تعني لوحًا صغيرًا (من tavla، أي لوح أو طاولة). تُلفظ tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:230
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:238
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "أفكار للمتغيرات (العدّاد والتاريخ وUUID)، دون شيفرة"

#: tavletta/app.py:241
msgid "Protocol knowledge"
msgstr "المعرفة بالبروتوكولات"

#: tavletta/app.py:246
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "من %(projects)s ومن أدلة الشركات المصنّعة، مكتوبة من جديد دون شيفرتها؛ انظر THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "المتوقع NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "المتوقع عدد صحيح من %(min)d إلى %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "يُتوقع صفوف مثل 3-10 أو 5 أو 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "بدون أمر يبدأ التطبيق؛ وتُفتح فيه ملفات الملصقات المحددة."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "طباعة ملف ملصق دون فتح نافذة"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "طباعة ملف ملصق دون فتح نافذة."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "الملصق (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "طراز الطابعة، افتراضيًا طراز الملصق: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "عنوان الطابعة، افتراضيًا العنوان المضبوط في التطبيق"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "عدد النسخ"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "نص العنصر NAME، أو قيمة المتغير {=NAME}؛ تُملأ المتغيرات في النص؛ يمكن تكراره"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "مثل --set، لكن تُستخدم القيمة كما هي: الأقواس المعقوفة ليست متغيرات"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "عدّاد الملصق الأول بدلًا من المحفوظ في الملصق"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "اطبع بالإعدادات الافتراضية لطراز الطابعة بدلًا من القص والألوان والجودة والإضافات (الطباعة المتسلسلة والدقة العالية وتقديم الشريط) وإعدادات الطابعة وحدود أوراق الملصقات المختارة آخر مرة في التطبيق؛ يبقى العنوان وهامش الأمان"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "طريقة الطباعة لطابعة حرارية تملك هذا الإعداد: printer (كما هو مضبوط في الطابعة) أو transfer (مع شريط الحبر) أو direct (حرارية مباشرة، بلا شريط)؛ افتراضيًا الطريقة المختارة في التطبيق، ومع --printer-defaults الطريقة المضبوطة في الطابعة"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "لا تسأل الطابعة قبل الرسم (طرازها وشريطها ودقتها)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "عدم حفظ قيمة العدّاد التالية في الملصق (ملف للقراءة فقط)؛ تبدأ الطباعة التالية من الرقم نفسه"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "ملصقات متسلسلة: ملصق لكل صف في ملف CSV أو ODS أو XLSX هذا؛ افتراضيًا ملف بيانات الملصق"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "ورقة ملف البيانات، افتراضيًا الأولى"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "هذه الصفوف فقط من ملف البيانات، مثل 3-10 أو 5 أو 7- (العد من 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "فحص وعرض فقط دون طباعة"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "مع --dry-run: حفظ كل ملصق بصيغة PNG كما تصدّره النافذة، بدقة 600 نقطة في البوصة على الأكثر (- لـ stdout: الأول فقط)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "عرض الطابعات الموجودة على الشبكة"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "عرض الطابعات الموجودة على الشبكة: الطراز والعنوان والاسم."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "هذا الطراز من الطابعات فقط: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "المتوقع عنوان أو شبكة مثل 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "المجلد الذي يحوي ملفات الملصقات التي يُسمح للخادم باستخدامها"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "الطباعة على عنوان الطابعة هذا فقط (* يطابق أي شيء)؛ يمكن تكراره"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: الطابعات التي يمكن للعملاء استخدامها، بأسمائها"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "أقصى عدد من الملصقات في مهمة طباعة واحدة، النسخ مضروبة في الصفوف (الافتراضي 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "البحث عن الطابعات في الشبكة (معطّل افتراضيًا)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "السماح بصفحات المستندات (PDF، الصور) في الملصقات المرسلة مع الطلب؛ تُرسم ملفات PDF حينها في عملية منفصلة ذات حدود (معطّل افتراضيًا)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "تشغيل خادم طباعة مع REST API"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "تشغيل خادم طباعة: REST API، ومع --mcp أيضًا MCP لعملاء الذكاء الاصطناعي."

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "العنوان الذي يُستمع عليه (الافتراضي 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "المنفذ الذي يُستمع عليه (الافتراضي %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "ملف رمز الوصول؛ وإلا فمتغير البيئة TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: رموز وصول مسمّاة مع أدوارها"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "تقديم MCP أيضًا على /mcp"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "أقصى حجم لنص الطلب بالميغابايت MB (الافتراضي 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "وكيل عكسي تُسمّي ترويسة X-Forwarded-For الخاصة به العميل، مثل 172.16.0.0/12؛ يمكن تكراره"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "السماح بالطلبات من صفحات الويب ذات هذا المصدر؛ يمكن تكراره"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "تقديم MCP عبر الإدخال والإخراج القياسيين"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "تقديم MCP عبر الإدخال والإخراج القياسيين، لعملاء الذكاء الاصطناعي مثل Claude Desktop."

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "إدارة رموز الوصول لخادم الطباعة"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "إدارة رموز الوصول لخادم الطباعة."

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "إنشاء رمز وإضافة تجزئته إلى tokens.toml"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "إنشاء رمز وإضافة تجزئته إلى tokens.toml وعرض الرمز مرة واحدة فقط."

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "اسم الرمز، مثل الجهاز"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: العرض فقط؛ print: الطباعة أيضًا؛ admin: جميع المهام أيضًا"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "ملف tokens.toml الذي يُضاف إليه"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "هذه الطابعة فقط من printers.toml؛ يمكن تكراره"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml، للتحقق من --printer"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "صالح حتى، مثل 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "ملاحظة للأشخاص"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "تخزين التجزئة باستخدام scrypt بدلًا من SHA-256"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "أخذ رمز اخترته من الإدخال القياسي (يُخزَّن باستخدام scrypt) بدلًا من إنشاء رمز"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:538
#, python-format
msgid "Unknown printer model: %s"
msgstr "طراز طابعة غير معروف: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:658
#: tavletta/server/service.py:686
#, python-format
msgid "Cannot open %s"
msgstr "تعذّر فتح %s"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ليس تاريخًا، المتوقع مثل 2026-12-31 أو 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} يُملأ عند الطباعة ولا يمكن تعيينه"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "لا يحتوي الملصق على عنصر أو متغير باسم %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1015
msgid "The label is empty"
msgstr "الملصق فارغ"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "تتعذر كتابة المخرجات"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "يكتب --output صور PNG: أعطِ اسمًا ينتهي بـ .png"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:920
#: tavletta/server/service.py:943 tavletta/server/service.py:1192
#: tavletta/server/service.py:1347
msgid "The label cannot be prepared for printing."
msgstr "تعذّر تجهيز الملصق للطباعة."

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "لم يُعثر على طابعة – حدّد عنوانها باستخدام --host"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "عُثر على عدة طابعات – اختر واحدة باستخدام --host (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:701 tavletta/server/service.py:1337
#, python-format
msgid "Cannot save %s"
msgstr "تعذّر حفظ %s"

#: tavletta/cli.py:757 tavletta/server/service.py:1340
msgid "the labels were printed, but the next counter value was not saved"
msgstr "طُبعت الملصقات، لكن لم تُحفظ قيمة العدّاد التالية"

#: tavletta/cli.py:772 tavletta/server/service.py:1044
msgid "nothing was printed: the next counter value could not be saved"
msgstr "لم يُطبع شيء: تعذّر حفظ قيمة العدّاد التالية"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "تمت المقاطعة"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: لا يملك طراز الطابعة هذا إعدادًا لطريقة الطباعة: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "يتطلب --sheet و--rows ملف بيانات (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:783
msgid "No rows to print"
msgstr "لا توجد صفوف للطباعة"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "يستخدم الملصق ملف بيانات خارج مجلده: حدّده باستخدام --data"

#: tavletta/cli.py:1020 tavletta/ui/window.py:849
#: tavletta/server/service.py:837
#, python-format
msgid "No such column: %s"
msgstr "لا يوجد عمود بهذا الاسم: %s"

#: tavletta/cli.py:1025 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "لا يمكن إنشاء الرمز الشريطي أو رمز QR لهذه الصفوف من قيمها، مثل EAN-13 يحتوي على حروف أو خلية فارغة. صحّح ملف البيانات واقرأه مرة أخرى، أو اطبع بدون هذه الصفوف."

#: tavletta/cli.py:1030 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "الصفوف: %s"

#: tavletta/cli.py:1038
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "في انتظار انتهاء طباعة أخرى لـ %s…"

#: tavletta/cli.py:1045 tavletta/server/service.py:1186
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "لا يزال %s مقفلًا بطباعة أخرى – حاول لاحقًا"

#: tavletta/cli.py:1051
msgid "--output needs --dry-run"
msgstr "--output يتطلب --dry-run"

#: tavletta/cli.py:1068
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "لا تُحفظ قيمة العدّاد التالية: ستكرر الطباعة التالية الأرقام"

#: tavletta/cli.py:1163
msgid "Waiting for the printer's answer…"
msgstr "في انتظار رد الطابعة…"

#: tavletta/cli.py:1191 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "لم يُعثر على طابعة"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "جداول (CSV وODS وXLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "اختيار ملف البيانات"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "يمكن استخدام الملفات المحلية فقط"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "سيسأل Tavletta مجددًا قبل قراءة ملفات بيانات خارج مجلد الملصق"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "هل تريد قراءة ملف البيانات؟"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "يستخدم هذا الملصق ملف بيانات خارج مجلده:\n\n%s\n\nلا تقرأه إلا إذا كنت تعرف مصدر الملصق."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "ليس الآن"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "قراءة ملف البيانات"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "جارٍ القراءة…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "لم تتم القراءة: خارج مجلد الملصق"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "الصفوف: %(rows)d · الأعمدة: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "ملصقات متسلسلة"

