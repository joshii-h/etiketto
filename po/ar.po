#: etiketto/app.py:125 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "المربع والإطار"

#: etiketto/app.py:199 etiketto/cli.py:151
msgid "Design and print labels"
msgstr "صمّم الملصقات واطبعها"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:204
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:209
msgid "Protocol knowledge"
msgstr "المعرفة بالبروتوكولات"

#: etiketto/app.py:214
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "من %(projects)s ومن أدلة الشركات المصنّعة، مكتوبة من جديد دون شيفرتها؛ انظر THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:106
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "المتوقع NAME=VALUE: %s"

#: etiketto/cli.py:122
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "المتوقع عدد صحيح من %(min)d إلى %(max)d: %(value)s"

#: etiketto/cli.py:140 etiketto/cli.py:144
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "يُتوقع صفوف مثل 3-10 أو 5 أو 7-: %s"

#: etiketto/cli.py:152
msgid "Without a command the application starts; label files given open in it."
msgstr "بدون أمر يبدأ التطبيق؛ وتُفتح فيه ملفات الملصقات المحددة."

#: etiketto/cli.py:158
msgid "print a label file without opening a window"
msgstr "طباعة ملف ملصق دون فتح نافذة"

#: etiketto/cli.py:159
msgid "Print a label file without opening a window."
msgstr "طباعة ملف ملصق دون فتح نافذة."

#: etiketto/cli.py:161
msgid "the label (.etiketto)"
msgstr "الملصق (.etiketto)"

#: etiketto/cli.py:164
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "طراز الطابعة، افتراضيًا طراز الملصق: %s"

#: etiketto/cli.py:167
msgid "printer address, by default the one set in the app"
msgstr "عنوان الطابعة، افتراضيًا العنوان المضبوط في التطبيق"

#: etiketto/cli.py:170
msgid "number of copies"
msgstr "عدد النسخ"

#: etiketto/cli.py:180
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "نص العنصر NAME، أو قيمة المتغير {=NAME}؛ تُملأ المتغيرات في النص؛ يمكن تكراره"

#: etiketto/cli.py:190
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "مثل --set، لكن تُستخدم القيمة كما هي: الأقواس المعقوفة ليست متغيرات"

#: etiketto/cli.py:196
msgid "counter of the first label, instead of the one saved in the label"
msgstr "عدّاد الملصق الأول بدلًا من المحفوظ في الملصق"

#: etiketto/cli.py:201
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "لا تسأل الطابعة قبل الرسم (طرازها وشريطها ودقتها)"

#: etiketto/cli.py:207
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "عدم حفظ قيمة العدّاد التالية في الملصق (ملف للقراءة فقط)؛ تبدأ الطباعة التالية من الرقم نفسه"

#: etiketto/cli.py:216
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "ملصقات متسلسلة: ملصق لكل صف في ملف CSV أو ODS أو XLSX هذا؛ افتراضيًا ملف بيانات الملصق"

#: etiketto/cli.py:221
msgid "the sheet of the data file, by default the first"
msgstr "ورقة ملف البيانات، افتراضيًا الأولى"

#: etiketto/cli.py:227
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "هذه الصفوف فقط من ملف البيانات، مثل 3-10 أو 5 أو 7- (العد من 1)"

#: etiketto/cli.py:230
msgid "check and render only, do not print"
msgstr "فحص وعرض فقط دون طباعة"

#: etiketto/cli.py:236
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "مع --dry-run: حفظ الصور بصيغة PNG كما ستستلمها الطابعة (- لـ stdout: الأولى فقط)"

#: etiketto/cli.py:242
msgid "list the printers found on the network"
msgstr "عرض الطابعات الموجودة على الشبكة"

#: etiketto/cli.py:243
msgid "List the printers found on the network: model, address, name."
msgstr "عرض الطابعات الموجودة على الشبكة: الطراز والعنوان والاسم."

#: etiketto/cli.py:245
#, python-format
msgid "only this printer model: %s"
msgstr "هذا الطراز من الطابعات فقط: %s"

#: etiketto/cli.py:264
#, python-format
msgid "Unknown printer model: %s"
msgstr "طراز طابعة غير معروف: %s"

#: etiketto/cli.py:271 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:290 etiketto/ui/texts.py:593
#, python-format
msgid "Cannot open %s"
msgstr "تعذّر فتح %s"

#: etiketto/cli.py:293
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ليس تاريخًا، المتوقع مثل 2026-12-31 أو 2026-12-31T08:30"

#: etiketto/cli.py:323
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} يُملأ عند الطباعة ولا يمكن تعيينه"

#: etiketto/cli.py:328
#, python-format
msgid "The label has no element or variable named %s"
msgstr "لا يحتوي الملصق على عنصر أو متغير باسم %s"

#: etiketto/cli.py:352 etiketto/ui/printing.py:107
msgid "The label is empty"
msgstr "الملصق فارغ"

#: etiketto/cli.py:385
msgid "Cannot write the output"
msgstr "تتعذر كتابة المخرجات"

#: etiketto/cli.py:416
msgid "--output writes PNG images: give a name ending in .png"
msgstr "يكتب --output صور PNG: أعطِ اسمًا ينتهي بـ .png"

#: etiketto/cli.py:440 etiketto/cli.py:644 etiketto/ui/printing.py:546
#: etiketto/ui/printing.py:697
msgid "The label cannot be prepared for printing."
msgstr "تعذّر تجهيز الملصق للطباعة."

#: etiketto/cli.py:522
msgid "No printer found – give its address with --host"
msgstr "لم يُعثر على طابعة – حدّد عنوانها باستخدام --host"

#: etiketto/cli.py:524
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "عُثر على عدة طابعات – اختر واحدة باستخدام --host (etiketto list-printers)"

#: etiketto/cli.py:535 etiketto/ui/texts.py:627
#, python-format
msgid "Cannot save %s"
msgstr "تعذّر حفظ %s"

#: etiketto/cli.py:537
msgid "the labels were printed, but the next counter value was not saved"
msgstr "طُبعت الملصقات، لكن لم تُحفظ قيمة العدّاد التالية"

#: etiketto/cli.py:552
msgid "nothing was printed: the next counter value could not be saved"
msgstr "لم يُطبع شيء: تعذّر حفظ قيمة العدّاد التالية"

#: etiketto/cli.py:612 etiketto/cli.py:639 etiketto/cli.py:876
msgid "Interrupted"
msgstr "تمت المقاطعة"

#: etiketto/cli.py:721
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "يستخدم الملصق ملف بيانات خارج مجلده: حدّده باستخدام --data"

#: etiketto/cli.py:727
msgid "--sheet and --rows need a data file (--data)"
msgstr "يتطلب --sheet و--rows ملف بيانات (--data)"

#: etiketto/cli.py:747 etiketto/ui/printing.py:575
msgid "No rows to print"
msgstr "لا توجد صفوف للطباعة"

#: etiketto/cli.py:756 etiketto/ui/window.py:739
#, python-format
msgid "No such column: %s"
msgstr "لا يوجد عمود بهذا الاسم: %s"

#: etiketto/cli.py:761 etiketto/ui/printing.py:648
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "لا يمكن إنشاء الرمز الشريطي أو رمز QR لهذه الصفوف من قيمها، مثل EAN-13 يحتوي على حروف أو خلية فارغة. صحّح ملف البيانات واقرأه مرة أخرى، أو اطبع بدون هذه الصفوف."

#: etiketto/cli.py:766 etiketto/ui/printing.py:653
#, python-format
msgid "Rows: %s"
msgstr "الصفوف: %s"

#: etiketto/cli.py:774
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "في انتظار انتهاء طباعة أخرى لـ %s…"

#: etiketto/cli.py:781
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "لا يزال %s مقفلًا بطباعة أخرى – حاول لاحقًا"

#: etiketto/cli.py:787
msgid "--output needs --dry-run"
msgstr "--output يتطلب --dry-run"

#: etiketto/cli.py:799
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "لا تُحفظ قيمة العدّاد التالية: ستكرر الطباعة التالية الأرقام"

