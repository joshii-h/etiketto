msgstr "طويل جدًا لهذه الطابعة: الحد الأقصى %s"

#: etiketto/ui/window.py:479
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "أعرض من أن تطبعه هذه الطابعة: الحد الأقصى %s"

