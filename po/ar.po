#, python-format
msgid "Cannot save %s"
msgstr "تعذّر حفظ %s"

#: etiketto/cli.py:445
msgid "the labels were printed, but the next counter value was not saved"
msgstr "طُبعت الملصقات، لكن لم تُحفظ قيمة العدّاد التالية"

#: etiketto/cli.py:460
msgid "nothing was printed: the next counter value could not be saved"
msgstr "لم يُطبع شيء: تعذّر حفظ قيمة العدّاد التالية"

