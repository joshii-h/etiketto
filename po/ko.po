#: etiketto/app.py:200 etiketto/cli.py:154
msgid "Design and print labels"
msgstr "라벨 디자인 및 인쇄"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "변수(카운터, 날짜, UUID)에 대한 아이디어, 코드는 포함되지 않음"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "프로토콜 지식"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "%(projects)s 및 제조사 설명서를 바탕으로 해당 코드 없이 새로 작성함; THIRD_PARTY_NOTICES.md 참조"

#: etiketto/cli.py:109
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE 형식이어야 합니다: %s"

#: etiketto/cli.py:125
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d에서 %(max)d 사이의 정수여야 합니다: %(value)s"

#: etiketto/cli.py:143 etiketto/cli.py:147
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10, 5 또는 7- 같은 행이 필요합니다: %s"

#: etiketto/cli.py:155
msgid "Without a command the application starts; label files given open in it."
msgstr "명령 없이 실행하면 앱이 시작되고, 지정한 라벨 파일이 앱에서 열립니다."

#: etiketto/cli.py:161
msgid "print a label file without opening a window"
msgstr "창을 열지 않고 라벨 파일을 인쇄합니다"

#: etiketto/cli.py:162
msgid "Print a label file without opening a window."
msgstr "창을 열지 않고 라벨 파일을 인쇄합니다."

#: etiketto/cli.py:164
msgid "the label (.etiketto)"
msgstr "라벨 (.etiketto)"

#: etiketto/cli.py:167
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "프린터 모델, 기본값은 라벨의 모델: %s"

#: etiketto/cli.py:170
msgid "printer address, by default the one set in the app"
msgstr "프린터 주소, 기본값은 앱에서 설정한 주소"

#: etiketto/cli.py:173
msgid "number of copies"
msgstr "매수"

#: etiketto/cli.py:183
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "요소 NAME의 텍스트 또는 변수 {=NAME}의 값, 텍스트 안의 변수는 채워짐, 여러 번 지정 가능"

#: etiketto/cli.py:193
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set과 같지만 값을 그대로 사용: 중괄호는 변수가 아님"

#: etiketto/cli.py:199
msgid "counter of the first label, instead of the one saved in the label"
msgstr "라벨에 저장된 값 대신 사용할 첫 라벨의 카운터"

#: etiketto/cli.py:205
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "앱에서 마지막으로 선택한 절단, 색상, 품질, 추가 기능(연속 인쇄, 고해상도, 테이프 이송), 프린터 설정, 라벨 시트 윤곽선 대신 프린터 모델의 기본값으로 인쇄; 주소와 안전 여백은 유지"

#: etiketto/cli.py:213
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "렌더링 전에 프린터에 묻지 않음 (모델, 테이프, 해상도)"

#: etiketto/cli.py:219
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "다음 카운터 값을 라벨에 저장하지 않음 (읽기 전용 파일), 다음 인쇄는 같은 번호부터 시작"

#: etiketto/cli.py:228
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "데이터 병합 라벨: 이 CSV, ODS 또는 XLSX 파일의 각 행마다 라벨 하나, 기본값은 라벨의 데이터 파일"

#: etiketto/cli.py:233
msgid "the sheet of the data file, by default the first"
msgstr "데이터 파일의 시트, 기본값은 첫 번째 시트"

#: etiketto/cli.py:239
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "데이터 파일의 이 행들만, 예: 3-10, 5 또는 7- (1부터 셈)"

#: etiketto/cli.py:242
msgid "check and render only, do not print"
msgstr "확인과 렌더링만 하고 인쇄하지 않음"

#: etiketto/cli.py:248
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run과 함께: 프린터가 받을 그대로 이미지를 PNG로 저장 (- 는 표준 출력: 첫 번째만)"

#: etiketto/cli.py:254
msgid "list the printers found on the network"
msgstr "네트워크에서 찾은 프린터 목록 표시"

#: etiketto/cli.py:255
msgid "List the printers found on the network: model, address, name."
msgstr "네트워크에서 찾은 프린터 목록을 표시합니다: 모델, 주소, 이름."

#: etiketto/cli.py:257
#, python-format
msgid "only this printer model: %s"
msgstr "이 프린터 모델만: %s"

#: etiketto/cli.py:276
#, python-format
msgid "Unknown printer model: %s"
msgstr "알 수 없는 프린터 모델: %s"

#: etiketto/cli.py:283 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:240 etiketto/ui/texts.py:528
#, python-format
msgid "Cannot open %s"
msgstr "열 수 없음: %s"

#: etiketto/cli.py:305
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s은(는) 날짜가 아닙니다. 예: 2026-12-31 또는 2026-12-31T08:30"

#: etiketto/cli.py:335
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s}은(는) 인쇄할 때 채워지므로 설정할 수 없습니다"

#: etiketto/cli.py:340
#, python-format
msgid "The label has no element or variable named %s"
msgstr "라벨에 %s라는 이름의 요소나 변수가 없습니다"

#: etiketto/cli.py:364 etiketto/ui/printing.py:104
msgid "The label is empty"
msgstr "라벨이 비어 있습니다"

#: etiketto/cli.py:401
msgid "Cannot write the output"
msgstr "출력을 쓸 수 없습니다"

#: etiketto/cli.py:432
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output은 PNG 이미지를 씁니다: .png로 끝나는 이름을 지정하세요"

#: etiketto/cli.py:457 etiketto/cli.py:666 etiketto/ui/printing.py:545
#: etiketto/ui/printing.py:707
msgid "The label cannot be prepared for printing."
msgstr "라벨을 인쇄용으로 준비할 수 없습니다."

#: etiketto/cli.py:544
msgid "No printer found – give its address with --host"
msgstr "프린터를 찾을 수 없습니다 – --host로 주소를 지정하세요"

#: etiketto/cli.py:546
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "프린터가 여러 대 발견되었습니다 – --host로 하나를 선택하세요 (etiketto list-printers)"

#: etiketto/cli.py:557 etiketto/ui/texts.py:571
#, python-format
msgid "Cannot save %s"
msgstr "저장할 수 없음: %s"

#: etiketto/cli.py:559
msgid "the labels were printed, but the next counter value was not saved"
msgstr "라벨은 인쇄되었지만 다음 카운터 값은 저장되지 않았습니다"

#: etiketto/cli.py:574
msgid "nothing was printed: the next counter value could not be saved"
msgstr "아무것도 인쇄되지 않았습니다: 다음 카운터 값을 저장할 수 없습니다"

#: etiketto/cli.py:634 etiketto/cli.py:661 etiketto/cli.py:974
msgid "Interrupted"
msgstr "중단됨"

#: etiketto/cli.py:759
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "라벨이 폴더 밖에 있는 데이터 파일을 사용합니다: --data로 지정하십시오"

#: etiketto/cli.py:765
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet와 --rows에는 데이터 파일(--data)이 필요합니다"

#: etiketto/cli.py:785 etiketto/ui/printing.py:577
msgid "No rows to print"
msgstr "인쇄할 행이 없습니다"

#: etiketto/cli.py:794 etiketto/ui/window.py:612
#, python-format
msgid "No such column: %s"
msgstr "없는 열: %s"

#: etiketto/cli.py:799 etiketto/ui/printing.py:656
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "이 행들의 값으로는 바코드나 QR 코드를 만들 수 없습니다(예: 문자가 들어간 EAN-13 또는 빈 셀). 데이터 파일을 고친 다음 다시 읽거나, 이 행들을 빼고 인쇄하십시오."

#: etiketto/cli.py:804 etiketto/ui/printing.py:661
#, python-format
msgid "Rows: %s"
msgstr "행: %s"

#: etiketto/cli.py:812
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s의 다른 인쇄가 끝나기를 기다리는 중…"

#: etiketto/cli.py:819
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s이(가) 아직 다른 인쇄에 의해 잠겨 있습니다 – 나중에 다시 시도하세요"

#: etiketto/cli.py:825
msgid "--output needs --dry-run"
msgstr "--output에는 --dry-run이 필요합니다"

#: etiketto/cli.py:842
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "다음 카운터 값이 저장되지 않습니다: 다음 인쇄에서 번호가 반복됩니다"

#: etiketto/cli.py:922
msgid "Waiting for the printer's answer…"
msgstr "프린터의 응답을 기다리는 중…"

#: etiketto/cli.py:950 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "프린터를 찾을 수 없습니다"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "표 (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "데이터 파일 선택"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:109 etiketto/ui/files.py:131
#: etiketto/ui/files.py:212 etiketto/ui/texts.py:150
msgid "Only local files can be used"
msgstr "로컬 파일만 사용할 수 있습니다"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto는 라벨 폴더 밖의 데이터 파일을 읽기 전에 다시 묻습니다"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "데이터 파일을 읽을까요?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "이 라벨은 폴더 밖에 있는 데이터 파일을 사용합니다:\n\n%s\n\n라벨의 출처를 알 때만 읽으십시오."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "나중에"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "데이터 파일 읽기"

#: etiketto/ui/data.py:265
msgid "Reading…"
msgstr "읽는 중…"

#: etiketto/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "읽지 않음: 라벨 폴더 밖에 있음"

#: etiketto/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "행: %(rows)d · 열: %(columns)d"

#: etiketto/ui/data.py:281
msgid "Serial labels"
msgstr "데이터 병합 라벨"

#: etiketto/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "표의 행마다 라벨 하나를 만듭니다. 텍스트와 코드에 열을 넣으면 각 라벨에 해당 행의 값이 표시됩니다."

#: etiketto/ui/data.py:290
msgid "No data file"
msgstr "데이터 파일 없음"

#: etiketto/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS 또는 XLSX"

#: etiketto/ui/data.py:291 etiketto/ui/elements.py:210
#: etiketto/ui/elements.py:223 etiketto/ui/elements.py:236
