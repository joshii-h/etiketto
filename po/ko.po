msgstr "액세스 토큰은 %d자 이상이어야 합니다"

#: tavletta/server/main.py:75
msgid "Use either --printers or --allow-printer"
msgstr "--printers와 --allow-printer 중 하나만 사용하십시오"

#: tavletta/server/main.py:77
msgid "Use either --tokens or --token-file"
