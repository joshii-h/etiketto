msgstr "인쇄 작업이 이미 끝났습니다"

#: tavletta/server/service.py:1262
msgid "The label is too large to render"
msgstr "라벨이 너무 커서 렌더링할 수 없습니다"

#: tavletta/server/service.py:1276
#, python-format
msgid "The label is too large: at most %d images and codes"
