#: etiketto/ui/texts.py:181
#, python-format
msgid "%d in/s"
msgstr "%d인치/초"

#: etiketto/ui/texts.py:190
msgid "Image"
msgstr "이미지"

#: etiketto/ui/texts.py:217
#, python-format
msgid "Endless, %(width)s wide"
msgstr "연속, 너비 %(width)s"

#: etiketto/ui/texts.py:227
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "라벨 전체가 선택 영역 안에 있는지 확인하십시오. 끌어서 선택 영역이나 가장자리를 옮기거나 새로 그리십시오."

#: etiketto/ui/texts.py:231
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "여러 영역이 라벨일 수 있습니다. 선택 영역을 확인하거나 다음 영역을 시도하십시오."

#: etiketto/ui/texts.py:233
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "페이지에 인쇄된 모든 것이 선택되었습니다. 끌어서 라벨을 선택하십시오."

#: etiketto/ui/texts.py:234
msgid "Nothing is printed on this page."
msgstr "이 페이지에는 인쇄된 것이 없습니다."

#: etiketto/ui/texts.py:239
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF 파일에는 Poppler(poppler-glib)가 필요하지만 설치되어 있지 않습니다"

#: etiketto/ui/texts.py:250
msgid "System printer (CUPS, IPP)"
msgstr "시스템 프린터 (CUPS, IPP)"

#: etiketto/ui/texts.py:251
msgid "Receipt printer (ESC/POS)"
msgstr "영수증 프린터(ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:253
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, 연속 롤"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:255
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, 다이컷 라벨"

#: etiketto/ui/texts.py:262
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "요소 %(n)d: 코드가 비어 있습니다"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "요소 %(n)d: EAN-13에는 정확히 12자리 숫자가 필요합니다"

#: etiketto/ui/texts.py:264
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "요소 %(n)d: EAN-13 검사 숫자가 잘못되었습니다"

#: etiketto/ui/texts.py:266
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "요소 %(n)d: Code 128에는 라틴 문자, 숫자, 문장 부호만 쓸 수 있습니다"

#: etiketto/ui/texts.py:268
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "요소 %(n)d: EAN-8에는 숫자 7자리 또는 검사 숫자 포함 8자리가 필요합니다"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "요소 %(n)d: UPC-A에는 숫자 11자리 또는 검사 숫자 포함 12자리가 필요합니다"

#: etiketto/ui/texts.py:271
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "요소 %(n)d: UPC-E에는 0 또는 1로 시작하는 숫자 7자리 또는 검사 숫자 포함 8자리가 필요합니다"

#: etiketto/ui/texts.py:273
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "요소 %(n)d: ITF-14에는 숫자 13자리 또는 검사 숫자 포함 14자리가 필요합니다"

#: etiketto/ui/texts.py:274
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "요소 %(n)d: 검사 숫자가 잘못되었습니다"

#: etiketto/ui/texts.py:276
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "요소 %(n)d: Code 39에는 대문자, 숫자, 공백 및 - . $ / + %%만 쓸 수 있습니다"

#: etiketto/ui/texts.py:279
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "요소 %(n)d: Code 93에는 라틴 문자, 숫자, 문장 부호만 쓸 수 있습니다"

#: etiketto/ui/texts.py:282
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "요소 %(n)d: GS1 데이터에는 라틴 문자, 숫자, 문장 부호만 쓸 수 있습니다"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "요소 %(n)d: GS1 데이터는 괄호로 묶은 응용 식별자와 그 뒤에 오는 값으로 이루어져야 합니다(예: (01)09501101530003(10)AB12)"

#: etiketto/ui/texts.py:288
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "요소 %(n)d: (%(ai)s)은(는) GS1 응용 식별자가 아닙니다"

#: etiketto/ui/texts.py:290
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "요소 %(n)d: 응용 식별자 (%(ai)s)의 값 길이가 잘못되었습니다"

#: etiketto/ui/texts.py:293
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "요소 %(n)d: 응용 식별자 (%(ai)s)의 검사 숫자가 잘못되었습니다"

#: etiketto/ui/texts.py:296
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "요소 %(n)d: 응용 식별자 (%(ai)s)의 값이 올바르지 않습니다. 허용되지 않는 날짜, 숫자 또는 문자가 있습니다"

#: etiketto/ui/texts.py:300
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "요소 %(n)d: 이 UPC-E 숫자로 줄어드는 UPC-A 번호가 없습니다 – 숫자를 확인하거나 UPC-A를 사용하세요"

#: etiketto/ui/texts.py:304
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "요소 %(n)d: Full ASCII로 설정된 스캐너는 대문자 앞의 $, /, + 또는 %%를 다른 문자로 읽습니다"

#: etiketto/ui/texts.py:307
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "요소 %(n)d: 이 코드 종류에 비해 내용이 너무 깁니다"

#: etiketto/ui/texts.py:308
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "요소 %(n)d: 이 내용은 이 코드 종류로 인코딩할 수 없습니다"

#: etiketto/ui/texts.py:310
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "요소 %(n)d: 이 코드 종류에는 Zint 라이브러리(zint-bindings)가 필요하지만 설치되어 있지 않습니다"

#: etiketto/ui/texts.py:313
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "요소 %(n)d: 이미지를 읽을 수 없습니다"

#: etiketto/ui/texts.py:314
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "요소 %(n)d: 이 기호는 기호 라이브러리에 없습니다"

#: etiketto/ui/texts.py:315
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "요소 %(n)d: 문서를 읽을 수 없습니다"

#: etiketto/ui/texts.py:317
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "요소 %(n)d: PDF 파일에는 Poppler(poppler-glib)가 필요하지만 설치되어 있지 않습니다"

#: etiketto/ui/texts.py:319
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "요소 %(n)d을(를) 그릴 수 없습니다"

#: etiketto/ui/texts.py:320
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "안전 여백, 테두리, 가장자리 간격 때문에 공간이 없습니다 – 줄이십시오"

#: etiketto/ui/texts.py:321
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "고정 길이가 간격보다 짧습니다 – 늘리십시오"

#: etiketto/ui/texts.py:322
msgid "The background image cannot be read"
msgstr "배경 이미지를 읽을 수 없습니다"

#: etiketto/ui/texts.py:324
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "요소 %(n)d: 코드의 모듈 너비가 인쇄 점 하나뿐이라 스캔되지 않을 수 있습니다 – 코드를 크게 하세요"

#: etiketto/ui/texts.py:328
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "요소 %(n)d: 코드 주위에 필요한 여백이 들어가지 않습니다 – 코드를 크게 하세요"

#: etiketto/ui/texts.py:332
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "요소 %(n)d: 모듈당 인쇄 점 하나로도 코드가 자리에 들어가지 않습니다 – 라벨을 크게 하거나 내용을 줄이세요"

#: etiketto/ui/texts.py:335
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "요소 %(n)d: %(name)s은(는) 알려진 변수가 아닙니다"

#: etiketto/ui/texts.py:337
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "요소 %(n)d: %(name)s의 날짜가 1년 이전이거나 9999년 이후입니다"

#: etiketto/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "요소 %(n)d: 변수 %(name)s…이(가) 닫히지 않았습니다 – }로 끝내세요"

#: etiketto/ui/texts.py:354
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "이미 인쇄된 시트: %(total)d장 중 %(n)d장."

#: etiketto/ui/texts.py:356
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "이미 인쇄된 라벨: %(total)d개 중 %(n)d개."

#: etiketto/ui/texts.py:360
msgid "The sheets still waiting in the queue were canceled."
msgstr "대기열에서 기다리던 시트는 취소되었습니다."

#: etiketto/ui/texts.py:362
msgid "The labels still waiting in the queue were canceled."
msgstr "대기열에서 기다리던 라벨은 취소되었습니다."

#: etiketto/ui/texts.py:371
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "프린터를 찾을 수 없습니다. 프린터가 켜져 있고 같은 네트워크에 있는지 확인하거나 IP 주소를 입력하십시오."

#: etiketto/ui/texts.py:375
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "USB에서 프린터를 찾을 수 없습니다. 케이블을 확인하고 프린터가 켜져 있으며 절전 상태가 아닌지 확인한 다음 다시 검색하십시오."

#: etiketto/ui/texts.py:378
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "프린터가 응답하지 않습니다. 프린터가 켜져 있고 절전 상태가 아닌지 확인하십시오."

#: etiketto/ui/texts.py:380
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "프린터가 더 이상 데이터를 받지 않습니다. 라벨이 없거나 덮개가 열려 있는 등 프린터에 문제가 표시되는지 확인한 후 다시 시도하십시오."

#: etiketto/ui/texts.py:384
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "프린터가 연결을 거부합니다. 프린터를 껐다가 다시 켜십시오. 웹 인터페이스에 “Port 9100” 옵션이 있으면 켜십시오."

#: etiketto/ui/texts.py:387
msgid "No cassette is inserted. Insert one and try again."
msgstr "카세트가 없습니다. 카세트를 넣고 다시 시도하십시오."

#: etiketto/ui/texts.py:388
msgid "The printer's cover is open. Close it and try again."
msgstr "프린터 덮개가 열려 있습니다. 덮개를 닫고 다시 시도하십시오."

#: etiketto/ui/texts.py:389
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "라벨이 걸렸습니다. 덮개를 열고 라벨을 빼낸 뒤 다시 시도하십시오."

#: etiketto/ui/texts.py:390
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "카세트를 인식할 수 없습니다. 다시 넣거나 다른 카세트를 사용하십시오."

#: etiketto/ui/texts.py:391
msgid "The printer is busy. Wait a moment and try again."
msgstr "프린터가 사용 중입니다. 잠시 후 다시 시도하십시오."

#: etiketto/ui/texts.py:392
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "이 프린터에는 라벨이 너무 깁니다. 최대 %(max)s입니다."

#: etiketto/ui/texts.py:393
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "라벨이 이 프린터에는 너무 넓습니다. 최대 %(max)s입니다."

#: etiketto/ui/texts.py:394
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "프린터에 라벨이 없습니다. 새 롤을 넣고 다시 시도하세요."

#: etiketto/ui/texts.py:395
msgid "The print head is open. Close it and try again."
msgstr "프린트 헤드가 열려 있습니다. 닫고 다시 시도하세요."

#: etiketto/ui/texts.py:397
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "프린터가 다음 라벨을 찾지 못합니다. 라벨이 올바르게 들어 있고 라벨 센서를 통과하는지 확인하세요."

#: etiketto/ui/texts.py:401
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "리본에 문제가 있습니다. 올바르게 끼워졌는지, 프린터에 설정된 인쇄 방식과 맞는지 확인하세요."

#: etiketto/ui/texts.py:404
msgid "The printer is paused. Resume it on its display and try again."
msgstr "프린터가 일시 정지되었습니다. 프린터 화면에서 다시 시작한 뒤 다시 시도하세요."

#: etiketto/ui/texts.py:405
msgid "The printer is out of paper. Load paper and try again."
msgstr "프린터에 용지가 없습니다. 용지를 넣고 다시 시도하세요."

#: etiketto/ui/texts.py:407
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "용지가 걸렸습니다. 프린터 화면의 안내에 따라 제거한 뒤 다시 시도하세요."

#: etiketto/ui/texts.py:409
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "프린터의 토너 또는 잉크가 떨어졌습니다. 교체한 뒤 다시 시도하세요."

#: etiketto/ui/texts.py:410
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "프린터가 이 크기를 인쇄할 수 없습니다. 프린터가 지원하는 용지 크기를 선택하세요."

#: etiketto/ui/texts.py:412
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "프린터가 Etiketto에서 보낼 수 있는 형식(PDF, PWG Raster, JPEG)을 하나도 받지 않습니다."

#: etiketto/ui/texts.py:415
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "프린터 대기열이 일시 정지되었습니다. 시스템 프린터 설정에서 다시 시작한 뒤 다시 시도하세요."

#: etiketto/ui/texts.py:419
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "인쇄 작업이 대기열에서 보류되었습니다. 예를 들어 해제되거나 암호가 입력될 때까지입니다. 시스템 프린터 설정에서 대기열을 확인한 뒤 다시 시도하세요."

#: etiketto/ui/texts.py:423
msgid "The print job was canceled at the printer or in the queue."
msgstr "인쇄 작업이 프린터 또는 대기열에서 취소되었습니다."

#: etiketto/ui/texts.py:424
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "프린터가 제때 해상도를 알리지 않았습니다. “%s”에서 선택하십시오."

#: etiketto/ui/texts.py:427
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "넣은 롤이 라벨과 맞지 않습니다. 맞는 롤을 넣거나, 넣은 롤에 맞는 라벨 크기나 프린터 모델을 선택하세요."

#: etiketto/ui/texts.py:430
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "프린터 배터리가 부족합니다 – 충전하거나 전원 어댑터를 연결하세요."

#: etiketto/ui/texts.py:431
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "프린트 헤드가 너무 뜨겁습니다. 식을 때까지 기다린 다음 다시 시도하세요."

#: etiketto/ui/texts.py:433
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto는 이 프린터 모델에서 인쇄할 수 없습니다: Etiketto가 보내는 래스터 이미지를 받지 않습니다."

#: etiketto/ui/texts.py:437
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto는 이 프린터 모델을 알지 못해 아직 인쇄할 수 없습니다."

#: etiketto/ui/texts.py:440
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "프린터가 Editor Lite 모드여서 USB 드라이브로 표시됩니다. 프린터에서 Editor Lite를 끈 다음(램프가 꺼짐) 다시 검색하세요."

#: etiketto/ui/texts.py:444
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto에 프린터의 USB 포트를 사용할 권한이 없습니다. 사용자를 “lp” 그룹에 추가한(sudo usermod -aG lp $USER) 뒤 로그아웃했다가 다시 로그인하세요."

#: etiketto/ui/texts.py:448
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "프린터가 받는 해상도로 만들기에는 페이지가 너무 큽니다. 더 작은 용지 크기를 선택하거나 PDF를 받는 프린터로 인쇄하세요."

#: etiketto/ui/texts.py:452
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "이 프린터의 해상도에서는 코드가 라벨에 들어가지 않아 잘립니다. 라벨을 크게 하거나 코드 내용을 줄이세요."

#: etiketto/ui/texts.py:456
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto에 프린터의 직렬 포트를 사용할 권한이 없습니다. 사용자를 “dialout” 그룹에 추가한(sudo usermod -aG dialout $USER, Arch Linux에서는 그룹 이름이 “uucp”) 뒤 로그아웃했다가 다시 로그인하세요."

#: etiketto/ui/texts.py:461
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "프린터에서 문제를 보고했습니다. 프린터를 껐다가 다시 켠 뒤 다시 시도하십시오."

#: etiketto/ui/texts.py:472
msgid "Printed"
msgstr "인쇄함"

#: etiketto/ui/texts.py:478
msgid "Sent to the printer – it prints when its turn comes"
msgstr "프린터로 보냄 – 차례가 되면 인쇄됩니다"

#: etiketto/ui/texts.py:480
msgid "Sent to the printer – it did not confirm printing"
msgstr "프린터로 보냈습니다 – 프린터가 인쇄를 확인하지 않았습니다"

#: etiketto/ui/texts.py:484
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "넣은 롤에 필요하므로 “%(used)s”(으)로 인쇄했습니다"

#: etiketto/ui/texts.py:488
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "이 프린터에서는 “%(wanted)s” 색상 모드를 쓸 수 없어 “%(used)s”(으)로 인쇄했습니다"

#: etiketto/ui/texts.py:498
msgid "Warming up…"
msgstr "예열 중…"

#: etiketto/ui/texts.py:499
msgid "Cooling down…"
msgstr "냉각 중…"

#: etiketto/ui/texts.py:500
msgid "Cleaning…"
msgstr "청소 중…"

#: etiketto/ui/texts.py:501
msgid "Swipe the printer's panel to cut the label"
msgstr "프린터 패널을 밀어 라벨을 자르십시오"

#: etiketto/ui/texts.py:503
msgid "Out of paper – load paper to continue"
msgstr "용지 없음 – 계속하려면 용지를 넣으세요"

#: etiketto/ui/texts.py:504
msgid "Cover open – close it to continue"
msgstr "덮개 열림 – 계속하려면 덮개를 닫으세요"

#: etiketto/ui/texts.py:505
msgid "Paper jammed – remove it to continue"
msgstr "용지 걸림 – 계속하려면 용지를 제거하세요"

#: etiketto/ui/texts.py:516
msgid "This label needs a newer version of Etiketto"
msgstr "이 라벨을 열려면 새 버전의 Etiketto가 필요합니다"

#: etiketto/ui/texts.py:518
#, python-format
msgid "%s is not an Etiketto label"
msgstr "Etiketto 라벨이 아님: %s"

#: etiketto/ui/texts.py:519 etiketto/ui/texts.py:539
#, python-format
msgid "The file is damaged: %s"
msgstr "파일이 손상됨: %s"

#: etiketto/ui/texts.py:526
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "데이터 파일 %s이(가) 더 이상 없습니다. 다시 선택하거나 제거하십시오."

#: etiketto/ui/texts.py:530
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s에 %(sheet)s 시트가 없습니다"

#: etiketto/ui/texts.py:532
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s은(는) 표가 아닙니다. CSV, ODS 또는 XLSX 파일을 사용하십시오."

#: etiketto/ui/texts.py:534
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s은(는) 데이터 병합 라벨에 쓰기에 너무 큽니다. 더 작은 파일로 나누거나 필요 없는 행과 열을 제거하십시오."

#: etiketto/ui/texts.py:537
#, python-format
msgid "%s contains no data."
msgstr "%s에 데이터가 없습니다."

#: etiketto/ui/texts.py:548
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "%(row)d행에서 인쇄가 멈췄습니다. 계속하려면 %(row)d행부터 다시 인쇄하십시오."

#: etiketto/ui/texts.py:552
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "%(row)d행에서 이미 인쇄된 매수: %(copies)d."

#: etiketto/ui/texts.py:557
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "%(row)d행은 %(sheet)d번째 시트의 %(position)d번 위치에 들어갑니다."

#: etiketto/ui/texts.py:568
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "저장할 수 없음: %s (쓰기 권한 없음)"

#: etiketto/ui/texts.py:570
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "저장할 수 없음: %s (디스크 공간 부족)"

#: etiketto/ui/texts.py:580
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "이 카세트는 %(year)d년 %(month)s에 만들어진 것 같습니다. 오래된 ZINK 용지는 색이 흐리게 인쇄됩니다."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "날짜"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "유통기한 (30일 후)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "시간"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "카운터"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "앞에 0을 채운 카운터"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "복사 번호"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "매수"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "임의 ID"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "변수 삽입"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "변수는 인쇄할 때 채워집니다. 인쇄되는 라벨마다, 복사본마다도 다음 카운터 값을 받습니다. 미리보기에는 다음 인쇄의 값이 표시됩니다."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "변수에 대해 더 알아보기"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "라벨을 인쇄할 때마다 증가 단위만큼 올라갑니다"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "다음 번호"

#: etiketto/ui/variables.py:122
msgid "Step"
