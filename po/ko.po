#: etiketto/ui/sheets.py:360
msgid ""
"Click a label to leave it out or to print on it again. Only the first sheet "
"is affected: the sheets after it are filled completely."
msgstr "라벨을 클릭하면 제외하거나 다시 인쇄하도록 할 수 있습니다. 첫 번째 시트에만 적용됩니다. 이후 시트는 모두 채워집니다."

#: etiketto/ui/sheets.py:366
msgid "Apply"
msgstr "적용"

