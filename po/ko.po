#: tavletta/server/service.py:1299
#, python-format
msgid ""
"The label is too large: at most %(elements)d elements and %(chars)d "
"characters in a text"
msgstr "라벨이 너무 큽니다: 요소는 최대 %(elements)d개, 텍스트당 최대 %(chars)d자까지 가능합니다"

#: tavletta/server/service.py:1318
#, python-format
msgid "At most %d copies on this printer"
msgstr "이 프린터에서는 최대 %d매까지 가능합니다"

#: tavletta/server/service.py:1323
msgid "Printers are chosen by name: leave out host"
msgstr "프린터는 이름으로 선택합니다: host를 지정하지 마십시오"
