#: etiketto/ui/label_group.py:139
#, python-format
msgid "%(unit)s, 0 = none"
msgstr "%(unit)s, 0 = 없음"

#: etiketto/ui/label_group.py:148
msgid "Automatic length"
msgstr "자동 길이"

#: etiketto/ui/label_group.py:148
