msgstr "롤 가로 방향"

#: etiketto/ui/texts.py:42
msgid "Along the roll"
msgstr "롤 진행 방향"

#: etiketto/ui/texts.py:45
msgid "Left"
msgstr "왼쪽"

#: etiketto/ui/texts.py:45
