msgid "Label"
msgstr "라벨"

#: etiketto/ui/files.py:330
msgid "Discard changes?"
msgstr "바뀐 내용을 버리시겠습니까?"

#: etiketto/ui/files.py:331
msgid "The current label has unsaved changes."
msgstr "현재 라벨에 저장하지 않은 바뀐 내용이 있습니다."

#: etiketto/ui/files.py:333
msgid "Discard"
msgstr "버리기"

#. translators: a month and a year, e.g. "May 2018"; reorder as your language needs
#: etiketto/ui/i18n.py:65
