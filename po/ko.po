msgstr "시트에는 데이터 파일이 필요합니다"

#: tavletta/server/service.py:797
msgid ""
"The label uses a data file outside the labels folder: send its rows along"
msgstr "라벨이 라벨 폴더 밖에 있는 데이터 파일을 사용합니다: 그 행도 함께 보내십시오"

#: tavletta/server/service.py:964
#, python-format
