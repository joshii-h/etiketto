msgstr "라벨 저장"

#: etiketto/ui/files.py:238 etiketto/ui/window.py:168
msgid "Save as template…"
msgstr "서식으로 저장…"

#: etiketto/ui/files.py:247 etiketto/ui/files.py:260
#, python-format
