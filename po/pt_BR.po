msgid "Cannot write the output"
msgstr "Não é possível gravar a saída"

#: etiketto/cli.py:432
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output grava imagens PNG: informe um nome terminado em .png"

#: etiketto/cli.py:457 etiketto/cli.py:666 etiketto/ui/printing.py:550
#: etiketto/ui/printing.py:712
msgid "The label cannot be prepared for printing."
msgstr "Não foi possível preparar a etiqueta para impressão."

#: etiketto/cli.py:544
msgid "No printer found – give its address with --host"
msgstr "Nenhuma impressora encontrada – informe o endereço com --host"

#: etiketto/cli.py:546
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Várias impressoras encontradas – escolha uma com --host (etiketto list-printers)"

#: etiketto/cli.py:557 etiketto/ui/texts.py:640
#, python-format
msgid "Cannot save %s"
msgstr "Não foi possível salvar %s"

#: etiketto/cli.py:559
msgid "the labels were printed, but the next counter value was not saved"
msgstr "as etiquetas foram impressas, mas o próximo valor do contador não foi salvo"

#: etiketto/cli.py:574
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nada foi impresso: o próximo valor do contador não poderia ser salvo"

#: etiketto/cli.py:634 etiketto/cli.py:661 etiketto/cli.py:974
msgid "Interrupted"
msgstr "Interrompido"

#: etiketto/cli.py:759
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A etiqueta usa um arquivo de dados fora da sua pasta: informe-o com --data"

#: etiketto/cli.py:765
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows exigem um arquivo de dados (--data)"

#: etiketto/cli.py:785 etiketto/ui/printing.py:582
msgid "No rows to print"
msgstr "Nenhuma linha para imprimir"

#: etiketto/cli.py:794 etiketto/ui/window.py:844
#, python-format
msgid "No such column: %s"
msgstr "Coluna inexistente: %s"

#: etiketto/cli.py:799 etiketto/ui/printing.py:661
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "O código de barras ou o código QR destas linhas não pode ser criado a partir dos valores delas, por exemplo um EAN-13 com letras ou uma célula vazia. Corrija o arquivo de dados e leia-o novamente, ou imprima sem estas linhas."

#: etiketto/cli.py:804 etiketto/ui/printing.py:666
#, python-format
msgid "Rows: %s"
msgstr "Linhas: %s"

#: etiketto/cli.py:812
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Aguardando o fim de outra impressão de %s…"

#: etiketto/cli.py:819
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ainda está bloqueado por outra impressão – tente mais tarde"

#: etiketto/cli.py:825
msgid "--output needs --dry-run"
msgstr "--output requer --dry-run"

#: etiketto/cli.py:842
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "O próximo valor do contador não é salvo: a próxima impressão repetirá os números"

#: etiketto/cli.py:922
msgid "Waiting for the printer's answer…"
msgstr "Aguardando a resposta da impressora…"

