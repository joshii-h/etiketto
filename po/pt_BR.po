#: etiketto/app.py:200 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Crie e imprima etiquetas"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideias para as variáveis (contador, data, UUID), sem código"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "Conhecimento de protocolos"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "De %(projects)s e dos manuais dos fabricantes, reescrito sem o código deles; veja THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "esperado NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "esperado um número inteiro de %(min)d a %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "esperavam-se linhas como 3-10, 5 ou 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Sem comando, o aplicativo é iniciado; os arquivos de etiqueta indicados são abertos nele."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "imprime um arquivo de etiqueta sem abrir uma janela"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Imprime um arquivo de etiqueta sem abrir uma janela."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "a etiqueta (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modelo de impressora, por padrão o da etiqueta: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "endereço da impressora, por padrão o definido no aplicativo"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "número de cópias"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texto do elemento NAME, ou valor da variável {=NAME}; as variáveis em um texto são preenchidas; repetível"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "como --set, mas o valor é usado como está: as chaves não são variáveis"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contador da primeira etiqueta, em vez do salvo na etiqueta"

#: etiketto/cli.py:204
msgid ""
"print with the printer model's defaults instead of the cut, mode, quality "
"and printer settings last chosen in the app"
msgstr "imprimir com os padrões do modelo de impressora em vez do corte, modo, qualidade e configurações da impressora escolhidos por último no aplicativo"

#: etiketto/cli.py:211
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "não consultar a impressora antes de renderizar (modelo, fita e resolução)"

#: etiketto/cli.py:217
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "não salvar o próximo valor do contador na etiqueta (um arquivo somente leitura); a próxima impressão começa no mesmo número"

#: etiketto/cli.py:226
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etiquetas em série: uma etiqueta para cada linha deste arquivo CSV, ODS ou XLSX; por padrão o arquivo de dados da etiqueta"

#: etiketto/cli.py:231
msgid "the sheet of the data file, by default the first"
msgstr "a planilha do arquivo de dados, por padrão a primeira"

#: etiketto/cli.py:237
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "somente estas linhas do arquivo de dados, por ex. 3-10, 5 ou 7- (contadas a partir de 1)"

#: etiketto/cli.py:240
msgid "check and render only, do not print"
msgstr "apenas verificar e gerar, não imprimir"

#: etiketto/cli.py:246
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "com --dry-run: salva as imagens em PNG como a impressora as receberia (- para stdout: só a primeira)"

#: etiketto/cli.py:252
msgid "list the printers found on the network"
msgstr "lista as impressoras encontradas na rede"

#: etiketto/cli.py:253
msgid "List the printers found on the network: model, address, name."
msgstr "Lista as impressoras encontradas na rede: modelo, endereço, nome."

#: etiketto/cli.py:255
#, python-format
msgid "only this printer model: %s"
msgstr "apenas este modelo de impressora: %s"

#: etiketto/cli.py:274
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modelo de impressora desconhecido: %s"

#: etiketto/cli.py:281 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:240 etiketto/ui/texts.py:528
#, python-format
msgid "Cannot open %s"
msgstr "Não foi possível abrir %s"

#: etiketto/cli.py:303
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s não é uma data, esperado p. ex. 2026-12-31 ou 2026-12-31T08:30"

#: etiketto/cli.py:333
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} é preenchido ao imprimir e não pode ser definido"

#: etiketto/cli.py:338
#, python-format
msgid "The label has no element or variable named %s"
msgstr "A etiqueta não tem nenhum elemento ou variável com o nome %s"

#: etiketto/cli.py:362 etiketto/ui/printing.py:99
msgid "The label is empty"
msgstr "A etiqueta está vazia"

#: etiketto/cli.py:395
msgid "Cannot write the output"
msgstr "Não é possível gravar a saída"

#: etiketto/cli.py:426
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output grava imagens PNG: informe um nome terminado em .png"

#: etiketto/cli.py:450 etiketto/cli.py:654 etiketto/ui/printing.py:540
#: etiketto/ui/printing.py:702
msgid "The label cannot be prepared for printing."
msgstr "Não foi possível preparar a etiqueta para impressão."

#: etiketto/cli.py:532
msgid "No printer found – give its address with --host"
msgstr "Nenhuma impressora encontrada – informe o endereço com --host"

#: etiketto/cli.py:534
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Várias impressoras encontradas – escolha uma com --host (etiketto list-printers)"

#: etiketto/cli.py:545 etiketto/ui/texts.py:571
#, python-format
msgid "Cannot save %s"
msgstr "Não foi possível salvar %s"

#: etiketto/cli.py:547
msgid "the labels were printed, but the next counter value was not saved"
msgstr "as etiquetas foram impressas, mas o próximo valor do contador não foi salvo"

#: etiketto/cli.py:562
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nada foi impresso: o próximo valor do contador não poderia ser salvo"

#: etiketto/cli.py:622 etiketto/cli.py:649 etiketto/cli.py:947
msgid "Interrupted"
msgstr "Interrompido"

#: etiketto/cli.py:745
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A etiqueta usa um arquivo de dados fora da sua pasta: informe-o com --data"

#: etiketto/cli.py:751
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows exigem um arquivo de dados (--data)"

#: etiketto/cli.py:771 etiketto/ui/printing.py:572
msgid "No rows to print"
msgstr "Nenhuma linha para imprimir"

#: etiketto/cli.py:780 etiketto/ui/window.py:598
#, python-format
msgid "No such column: %s"
msgstr "Coluna inexistente: %s"

#: etiketto/cli.py:785 etiketto/ui/printing.py:651
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "O código de barras ou o código QR destas linhas não pode ser criado a partir dos valores delas, por exemplo um EAN-13 com letras ou uma célula vazia. Corrija o arquivo de dados e leia-o novamente, ou imprima sem estas linhas."

#: etiketto/cli.py:790 etiketto/ui/printing.py:656
#, python-format
msgid "Rows: %s"
msgstr "Linhas: %s"

#: etiketto/cli.py:798
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Aguardando o fim de outra impressão de %s…"

#: etiketto/cli.py:805
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ainda está bloqueado por outra impressão – tente mais tarde"

#: etiketto/cli.py:811
msgid "--output needs --dry-run"
msgstr "--output requer --dry-run"

#: etiketto/cli.py:828
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "O próximo valor do contador não é salvo: a próxima impressão repetirá os números"

#: etiketto/cli.py:905
msgid "Waiting for the printer's answer…"
msgstr "Aguardando a resposta da impressora…"

#: etiketto/cli.py:923 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "Nenhuma impressora encontrada"

