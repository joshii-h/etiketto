#: etiketto/ui/texts.py:100
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Não foi possível desenhar o elemento %(n)d"

#: etiketto/ui/texts.py:101
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "A margem de segurança, a borda e a margem lateral não deixam espaço – reduza-as"

#: etiketto/ui/texts.py:102
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "O comprimento fixo é menor que o espaçamento – aumente-o"

#: etiketto/ui/texts.py:103
msgid "The background image cannot be read"
msgstr "Não foi possível ler a imagem de fundo"

#: etiketto/ui/texts.py:115
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etiquetas já impressas: %(n)d de %(total)d."

#: etiketto/ui/texts.py:120
msgid "The labels still waiting in the queue were canceled."
msgstr "As etiquetas que ainda aguardavam na fila foram canceladas."

#: etiketto/ui/texts.py:129
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "A impressora não foi encontrada. Verifique se ela está ligada e na mesma rede, ou digite o endereço IP."

#: etiketto/ui/texts.py:133
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "A impressora não foi encontrada via USB. Verifique o cabo e se a impressora está ligada e ativa, depois procure novamente."

#: etiketto/ui/texts.py:136
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A impressora não responde. Verifique se ela está ligada e ativa."

#: etiketto/ui/texts.py:138
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "A impressora parou de receber dados. Verifique se ela indica algum problema, como falta de etiquetas ou uma tampa aberta, e tente novamente."

#: etiketto/ui/texts.py:142
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A impressora recusa a conexão. Desligue-a e ligue-a novamente. Se a interface web oferecer uma opção “Port 9100”, ative-a."

#: etiketto/ui/texts.py:145
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nenhum cassete inserido. Insira um e tente novamente."

#: etiketto/ui/texts.py:146
msgid "The printer's cover is open. Close it and try again."
msgstr "A tampa da impressora está aberta. Feche-a e tente novamente."

#: etiketto/ui/texts.py:147
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A etiqueta atolou. Abra a tampa, retire-a e tente novamente."

#: etiketto/ui/texts.py:148
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "O cassete não foi reconhecido. Insira-o novamente ou tente outro."

#: etiketto/ui/texts.py:149
msgid "The printer is busy. Wait a moment and try again."
msgstr "A impressora está ocupada. Aguarde um momento e tente novamente."

#: etiketto/ui/texts.py:150
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A etiqueta é longa demais para esta impressora: no máximo %(max)s."

#: etiketto/ui/texts.py:151
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A etiqueta é larga demais para esta impressora: no máximo %(max)s."

#: etiketto/ui/texts.py:152
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A impressora está sem etiquetas. Coloque um novo rolo e tente novamente."

#: etiketto/ui/texts.py:153
msgid "The print head is open. Close it and try again."
msgstr "O cabeçote de impressão está aberto. Feche-o e tente novamente."

#: etiketto/ui/texts.py:155
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A impressora não encontra a próxima etiqueta. Verifique se as etiquetas estão bem carregadas e passam pelo sensor de etiquetas."

#: etiketto/ui/texts.py:159
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Há um problema com a fita. Verifique se ela está bem colocada e se corresponde ao método de impressão configurado na impressora."

#: etiketto/ui/texts.py:162
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A impressora está pausada. Retome-a no display e tente novamente."

#: etiketto/ui/texts.py:163
msgid "The printer is out of paper. Load paper and try again."
msgstr "A impressora está sem papel. Coloque papel e tente novamente."

#: etiketto/ui/texts.py:165
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "O papel está atolado. Remova-o conforme indicado no display da impressora e tente novamente."

#: etiketto/ui/texts.py:167
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A impressora está sem toner ou tinta. Substitua e tente novamente."

#: etiketto/ui/texts.py:168
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A impressora não consegue imprimir este tamanho. Escolha um tamanho de papel que ela ofereça."

#: etiketto/ui/texts.py:170
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A impressora não aceita nenhum dos formatos que o Etiketto pode enviar (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:173
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A fila da impressora está pausada. Retome-a nas configurações de impressora do sistema e tente novamente."

#: etiketto/ui/texts.py:177
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "O trabalho de impressão ficou retido na fila, por exemplo até ser liberado ou até que uma senha seja digitada. Verifique a fila nas configurações de impressora do sistema e tente novamente."

#: etiketto/ui/texts.py:181
msgid "The print job was canceled at the printer or in the queue."
msgstr "O trabalho de impressão foi cancelado na impressora ou na fila."

#: etiketto/ui/texts.py:183
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "O Etiketto não tem permissão para usar a porta USB da impressora. Adicione seu usuário ao grupo “lp” (sudo usermod -aG lp $USER) e depois saia da sessão e entre novamente."

#: etiketto/ui/texts.py:187
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "O Etiketto não tem permissão para usar a porta serial da impressora. Adicione seu usuário ao grupo “dialout” (sudo usermod -aG dialout $USER; no Arch Linux o grupo se chama “uucp”) e depois saia da sessão e entre novamente."

#: etiketto/ui/texts.py:191
msgid "The printer's battery is low. Charge it and try again."
msgstr "A bateria da impressora está fraca. Carregue-a e tente novamente."

#: etiketto/ui/texts.py:193
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A impressora relatou um problema. Desligue-a e ligue-a novamente e tente mais uma vez."

#: etiketto/ui/texts.py:205
msgid "Warming up…"
msgstr "Aquecendo…"

#: etiketto/ui/texts.py:206
msgid "Cooling down…"
msgstr "Resfriando…"

#: etiketto/ui/texts.py:207
msgid "Cleaning…"
msgstr "Limpando…"

#: etiketto/ui/texts.py:208
msgid "Swipe the printer's panel to cut the label"
msgstr "Deslize o dedo no painel da impressora para cortar a etiqueta"

#: etiketto/ui/texts.py:210
msgid "Out of paper – load paper to continue"
msgstr "Sem papel – coloque papel para continuar"

#: etiketto/ui/texts.py:211
msgid "Cover open – close it to continue"
msgstr "Tampa aberta – feche-a para continuar"

#: etiketto/ui/texts.py:212
msgid "Paper jammed – remove it to continue"
msgstr "Papel atolado – remova-o para continuar"

#: etiketto/ui/texts.py:223
msgid "This label needs a newer version of Etiketto"
msgstr "Esta etiqueta precisa de uma versão mais recente do Etiketto"

#: etiketto/ui/texts.py:225
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s não é uma etiqueta do Etiketto"

#: etiketto/ui/texts.py:226
#, python-format
msgid "The file is damaged: %s"
msgstr "O arquivo está danificado: %s"

#: etiketto/ui/texts.py:232
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Não foi possível salvar %s: sem permissão de gravação nesse local"

#: etiketto/ui/texts.py:234
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Não foi possível salvar %s: o disco está cheio"

#: etiketto/ui/texts.py:235
#, python-format
msgid "Cannot save %s"
msgstr "Não foi possível salvar %s"

#: etiketto/ui/texts.py:244
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Este cassete parece ser de %(month)s de %(year)d. Papel ZINK antigo imprime cores mais pálidas."

