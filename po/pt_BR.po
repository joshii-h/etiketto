#: etiketto/ui/texts.py:318
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemento %(n)d: o EAN-8 precisa de 7 dígitos, ou 8 com o dígito verificador"

