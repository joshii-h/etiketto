#: etiketto/app.py:136 etiketto/cli.py:118
msgid "Design and print labels"
msgstr "ラベルをデザインして印刷"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:91
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE の形式が必要です: %s"

#: etiketto/cli.py:107
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d から %(max)d までの整数が必要です: %(value)s"

#: etiketto/cli.py:119
msgid "Without a command the application starts; label files given open in it."
msgstr "コマンドなしではアプリが起動し、指定したラベルファイルがそこで開きます。"

#: etiketto/cli.py:125
msgid "print a label file without opening a window"
msgstr "ウィンドウを開かずにラベルファイルを印刷する"

#: etiketto/cli.py:126
msgid "Print a label file without opening a window."
msgstr "ウィンドウを開かずにラベルファイルを印刷します。"

#: etiketto/cli.py:128
msgid "the label (.etiketto)"
msgstr "ラベル (.etiketto)"

#: etiketto/cli.py:131
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "プリンターの機種。省略時はラベルの設定: %s"

#: etiketto/cli.py:134
msgid "printer address, by default the one set in the app"
msgstr "プリンターのアドレス。省略時はアプリで設定したもの"

#: etiketto/cli.py:137
msgid "number of copies"
msgstr "部数"

#: etiketto/cli.py:147
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "要素 NAME のテキスト、または変数 {=NAME} の値。テキスト内の変数は埋め込まれます。複数回指定できます"

#: etiketto/cli.py:157
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set と同じですが、値をそのまま使います: 波括弧は変数になりません"

#: etiketto/cli.py:163
msgid "counter of the first label, instead of the one saved in the label"
msgstr "最初のラベルのカウンター。ラベルに保存された値の代わりに使用"

#: etiketto/cli.py:169
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "次のカウンター値をラベルに保存しない (読み取り専用ファイル)。次の印刷は同じ番号から始まります"

#: etiketto/cli.py:174
msgid "check and render only, do not print"
msgstr "確認とレンダリングのみ行い、印刷しない"

#: etiketto/cli.py:180
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run 指定時: プリンターに送られるとおりの画像を PNG で保存する (- で標準出力: 最初の 1 枚のみ)"

#: etiketto/cli.py:186
msgid "list the printers found on the network"
msgstr "ネットワーク上で見つかったプリンターを一覧表示する"

#: etiketto/cli.py:187
msgid "List the printers found on the network: model, address, name."
msgstr "ネットワーク上で見つかったプリンターを一覧表示します: 機種、アドレス、名前。"

#: etiketto/cli.py:189
#, python-format
msgid "only this printer model: %s"
msgstr "この機種のプリンターのみ: %s"

#: etiketto/cli.py:208
#, python-format
msgid "Unknown printer model: %s"
msgstr "不明なプリンターの機種: %s"

#: etiketto/cli.py:215 etiketto/ui/files.py:88 etiketto/ui/files.py:141
#: etiketto/ui/texts.py:163
#, python-format
msgid "Cannot open %s"
msgstr "%s を開けません"

#: etiketto/cli.py:237
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s は日付ではありません。2026-12-31 や 2026-12-31T08:30 のように指定してください"

#: etiketto/cli.py:264
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} は印刷時に入力されるため、設定できません"

#: etiketto/cli.py:269
#, python-format
msgid "The label has no element or variable named %s"
msgstr "ラベルに %s という名前の要素または変数がありません"

#: etiketto/cli.py:293 etiketto/ui/printing.py:76
msgid "The label is empty"
msgstr "ラベルが空です"

#: etiketto/cli.py:326
msgid "Cannot write the output"
msgstr "出力を書き込めません"

#: etiketto/cli.py:357
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output は PNG 画像を書き込みます: .png で終わる名前を指定してください"

#: etiketto/cli.py:381 etiketto/ui/printing.py:351
msgid "The label cannot be prepared for printing."
msgstr "ラベルを印刷用に準備できません。"

#: etiketto/cli.py:429
msgid "No printer found – give its address with --host"
msgstr "プリンターが見つかりません。--host でアドレスを指定してください"

#: etiketto/cli.py:431
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "複数のプリンターが見つかりました。--host で 1 台選んでください (etiketto list-printers)"

#: etiketto/cli.py:443 etiketto/ui/texts.py:410
#, python-format
msgid "Cannot save %s"
msgstr "%s を保存できません"

#: etiketto/cli.py:445
msgid "the labels were printed, but the next counter value was not saved"
msgstr "ラベルは印刷されましたが、次のカウンター値は保存されませんでした"

#: etiketto/cli.py:460
msgid "nothing was printed: the next counter value could not be saved"
msgstr "何も印刷されていません: 次のカウンター値を保存できないためです"

#: etiketto/cli.py:520 etiketto/cli.py:641
msgid "Interrupted"
msgstr "中断しました"

#: etiketto/cli.py:573
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s の別の印刷が終わるのを待っています…"

#: etiketto/cli.py:580
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s は別の印刷によってまだロックされています – 後でもう一度お試しください"

#: etiketto/cli.py:586
msgid "--output needs --dry-run"
msgstr "--output には --dry-run が必要です"

#: etiketto/cli.py:595
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "次のカウンター値は保存されません: 次の印刷では同じ番号が繰り返されます"

