msgstr "%s を保存できません: 書き込み権限がありません"

#: etiketto/ui/texts.py:268
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s を保存できません: ディスクがいっぱいです"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Cannot save %s"
msgstr "%s を保存できません"

#: etiketto/ui/texts.py:278
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "このカセットは %(year)d年%(month)s 製のようです。古い ZINK 用紙は色が薄く印刷されます。"

