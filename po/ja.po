#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "ボックスと枠"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "ラベルをデザインして印刷"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta はロマンシュ語で「小さな板」の意味です（tavla「板」から）。発音は tav-LET-ta。"

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "変数（カウンター、日付、UUID）のアイデア。コードは含まれていません"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "プロトコルの知見"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "%(projects)s とメーカーのマニュアルに基づき、それらのコードを使わずに新たに記述; THIRD_PARTY_NOTICES.md を参照"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE の形式が必要です: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d から %(max)d までの整数が必要です: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10、5、7- のような行が必要です: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "コマンドなしではアプリが起動し、指定したラベルファイルがそこで開きます。"

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "ウィンドウを開かずにラベルファイルを印刷する"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "ウィンドウを開かずにラベルファイルを印刷します。"

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "ラベル (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "プリンターの機種。省略時はラベルの設定: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "プリンターのアドレス。省略時はアプリで設定したもの"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "部数"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "要素 NAME のテキスト、または変数 {=NAME} の値。テキスト内の変数は埋め込まれます。複数回指定できます"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set と同じですが、値をそのまま使います: 波括弧は変数になりません"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "最初のラベルのカウンター。ラベルに保存された値の代わりに使用"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "アプリで最後に選んだカット、色、品質、追加設定（チェーン印刷、高解像度、テープ送り）、プリンター設定、ラベルシートの輪郭ではなく、プリンター機種の既定値で印刷する。アドレスと安全マージンはそのまま"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "この設定があるサーマルプリンターの印刷方式: printer（プリンターの設定どおり）、transfer（リボンを使う）、direct（ダイレクトサーマル、リボンなし）。既定はアプリで選んだ方式で、--printer-defaults でも同じです"

#: tavletta/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "描画の前にプリンターに問い合わせない（機種、テープ、解像度）"

#: tavletta/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "次のカウンター値をラベルに保存しない (読み取り専用ファイル)。次の印刷は同じ番号から始まります"

#: tavletta/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "差し込み印刷ラベル: この CSV、ODS、XLSX ファイルの行ごとにラベルを 1 枚。省略時はラベルのデータファイル"

#: tavletta/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "データファイルのシート。省略時は最初のシート"

#: tavletta/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "データファイルのこれらの行だけ。例: 3-10、5、7- (1 から数える)"

#: tavletta/cli.py:267
msgid "check and render only, do not print"
msgstr "確認とレンダリングのみ行い、印刷しない"

#: tavletta/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "--dry-run 指定時: ウィンドウのエクスポートと同じく各ラベルを PNG で保存する (最大 600 dpi、- で標準出力: 最初の 1 枚のみ)"

#: tavletta/cli.py:279
msgid "list the printers found on the network"
msgstr "ネットワーク上で見つかったプリンターを一覧表示する"

#: tavletta/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "ネットワーク上で見つかったプリンターを一覧表示します: 機種、アドレス、名前。"

#: tavletta/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "この機種のプリンターのみ: %s"

#: tavletta/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "172.16.0.0/12 のようなアドレスまたはネットワークが必要です: %s"

#: tavletta/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "サーバーが使用できるラベルファイルのフォルダー"

#: tavletta/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "このプリンターアドレスにのみ印刷する (* は何にでも一致)。複数回指定できます"

#: tavletta/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: クライアントが名前で使用できるプリンター"

#: tavletta/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "1 つの印刷ジョブのラベルの最大数、部数 × 行数 (省略時は 10000)"

#: tavletta/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "ネットワーク上のプリンターを検索する (既定ではオフ)"

#: tavletta/cli.py:335
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "リクエストで送られるラベルに文書ページ (PDF、画像) を許可する。PDF は制限付きの別プロセスで描画される (既定ではオフ)"

#: tavletta/cli.py:344
msgid "run a print server with a REST API"
msgstr "REST API を備えた印刷サーバーを実行する"

#: tavletta/cli.py:345
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "印刷サーバーを実行します: REST API と、--mcp を指定した場合は AI クライアント向けの MCP。"

#: tavletta/cli.py:348
msgid "address to listen on (default 127.0.0.1)"
msgstr "待ち受けるアドレス (省略時は 127.0.0.1)"

#: tavletta/cli.py:354
#, python-format
msgid "port to listen on (default %d)"
msgstr "待ち受けるポート (省略時は %d)"

#: tavletta/cli.py:360
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "アクセストークンを含むファイル。省略時は環境変数 TAVLETTA_TOKEN"

#: tavletta/cli.py:366
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: ロール付きの名前付きアクセストークン"

#: tavletta/cli.py:368
msgid "also serve MCP at /mcp"
msgstr "/mcp で MCP も提供する"

#: tavletta/cli.py:374
msgid "largest request body in MB (default 4)"
msgstr "リクエスト本文の最大サイズ (MB、省略時は 4)"

#: tavletta/cli.py:383
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "X-Forwarded-For ヘッダーでクライアントを示すリバースプロキシ (例: 172.16.0.0/12)。複数回指定できます"

#: tavletta/cli.py:392
msgid "allow requests from web pages of this origin; repeatable"
msgstr "このオリジンの Web ページからのリクエストを許可する。複数回指定できます"

#: tavletta/cli.py:397
msgid "serve MCP on standard input and output"
msgstr "標準入出力で MCP を提供する"

#: tavletta/cli.py:399
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Claude Desktop などの AI クライアント向けに、標準入出力で MCP を提供します。"

#: tavletta/cli.py:409
msgid "manage the access tokens of the print server"
msgstr "印刷サーバーのアクセストークンを管理する"

#: tavletta/cli.py:410
msgid "Manage the access tokens of the print server."
msgstr "印刷サーバーのアクセストークンを管理します。"

#: tavletta/cli.py:415
msgid "make a token and add its hash to tokens.toml"
msgstr "トークンを作成し、そのハッシュを tokens.toml に追加する"

#: tavletta/cli.py:416
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "トークンを作成し、そのハッシュを tokens.toml に追加して、トークンを一度だけ表示します。"

#: tavletta/cli.py:418
msgid "name of the token, e.g. the device"
msgstr "トークンの名前。例: デバイス名"

#: tavletta/cli.py:423
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: 表示のみ。print: 印刷も可能。admin: すべての印刷ジョブも操作可能"

#: tavletta/cli.py:425
msgid "tokens.toml to add it to"
msgstr "追加先の tokens.toml"

#: tavletta/cli.py:431
msgid "only this printer of printers.toml; repeatable"
msgstr "printers.toml のこのプリンターのみ。複数回指定できます"

#: tavletta/cli.py:434
msgid "printers.toml, to check --printer"
msgstr "--printer を確認するための printers.toml"

#: tavletta/cli.py:436
msgid "valid until, e.g. 2027-12-31"
msgstr "有効期限。例: 2027-12-31"

#: tavletta/cli.py:437
msgid "a note for people"
msgstr "人向けのメモ"

#: tavletta/cli.py:439
msgid "store the hash with scrypt instead of SHA-256"
msgstr "SHA-256 の代わりに scrypt でハッシュを保存する"

#: tavletta/cli.py:445
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "トークンを作成する代わりに、自分で選んだトークンを標準入力から読み取る (scrypt で保存)"

#: tavletta/cli.py:465 tavletta/server/config.py:220
#: tavletta/server/service.py:531
#, python-format
msgid "Unknown printer model: %s"
msgstr "不明なプリンターの機種: %s"

#: tavletta/cli.py:472 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:655
#: tavletta/server/service.py:679
#, python-format
msgid "Cannot open %s"
msgstr "%s を開けません"

#: tavletta/cli.py:494 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s は日付ではありません。2026-12-31 や 2026-12-31T08:30 のように指定してください"

#: tavletta/cli.py:531
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} は印刷時に入力されるため、設定できません"

#: tavletta/cli.py:535
#, python-format
msgid "The label has no element or variable named %s"
msgstr "ラベルに %s という名前の要素または変数がありません"

#: tavletta/cli.py:559 tavletta/ui/printing.py:123
#: tavletta/server/service.py:973
msgid "The label is empty"
msgstr "ラベルが空です"

#: tavletta/cli.py:596
msgid "Cannot write the output"
msgstr "出力を書き込めません"

#: tavletta/cli.py:627
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output は PNG 画像を書き込みます: .png で終わる名前を指定してください"

#: tavletta/cli.py:652 tavletta/cli.py:861 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:901
#: tavletta/server/service.py:1128 tavletta/server/service.py:1273
msgid "The label cannot be prepared for printing."
msgstr "ラベルを印刷用に準備できません。"

#: tavletta/cli.py:739
msgid "No printer found – give its address with --host"
msgstr "プリンターが見つかりません。--host でアドレスを指定してください"

#: tavletta/cli.py:741
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "複数のプリンターが見つかりました。--host で 1 台選んでください (tavletta list-printers)"

#: tavletta/cli.py:752 tavletta/ui/texts.py:698 tavletta/server/service.py:1263
#, python-format
msgid "Cannot save %s"
msgstr "%s を保存できません"

#: tavletta/cli.py:754 tavletta/server/service.py:1266
msgid "the labels were printed, but the next counter value was not saved"
msgstr "ラベルは印刷されましたが、次のカウンター値は保存されませんでした"

#: tavletta/cli.py:769 tavletta/server/service.py:1002
msgid "nothing was printed: the next counter value could not be saved"
msgstr "何も印刷されていません: 次のカウンター値を保存できないためです"

#: tavletta/cli.py:829 tavletta/cli.py:856 tavletta/cli.py:1217
msgid "Interrupted"
msgstr "中断しました"

#: tavletta/cli.py:929
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: このプリンター機種には印刷方式の設定がありません: %s"

#: tavletta/cli.py:971
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet と --rows にはデータファイル (--data) が必要です"

#: tavletta/cli.py:980 tavletta/ui/printing.py:585
#: tavletta/server/service.py:774
msgid "No rows to print"
msgstr "印刷する行がありません"

#: tavletta/cli.py:990
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "ラベルはフォルダーの外にあるデータファイルを使っています: --data で指定してください"

#: tavletta/cli.py:1017 tavletta/ui/window.py:849
#: tavletta/server/service.py:827
#, python-format
msgid "No such column: %s"
msgstr "その列はありません: %s"

#: tavletta/cli.py:1022 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "これらの行の値からはバーコードまたは QR コードを作れません(例: 文字を含む EAN-13、空のセル)。データファイルを修正して読み込み直すか、これらの行を除いて印刷してください。"

#: tavletta/cli.py:1027 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "行: %s"

#: tavletta/cli.py:1035
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s の別の印刷が終わるのを待っています…"

#: tavletta/cli.py:1042 tavletta/server/service.py:1122
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s は別の印刷によってまだロックされています – 後でもう一度お試しください"

#: tavletta/cli.py:1048
msgid "--output needs --dry-run"
msgstr "--output には --dry-run が必要です"

#: tavletta/cli.py:1065
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "次のカウンター値は保存されません: 次の印刷では同じ番号が繰り返されます"

#: tavletta/cli.py:1160
msgid "Waiting for the printer's answer…"
msgstr "プリンターの応答を待っています…"

#: tavletta/cli.py:1188 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "プリンターが見つかりません"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "表 (CSV、ODS、XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "データファイルを選択"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "使用できるのはローカルファイルのみです"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "Tavletta はラベルのフォルダーの外にあるデータファイルを読み込む前に再び確認します"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "データファイルを読み込みますか?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "このラベルはフォルダーの外にあるデータファイルを使っています:\n\n%s\n\nラベルの出所がわかっている場合にだけ読み込んでください。"

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "後で"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "データファイルを読み込む"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "読み込み中…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "未読み込み: ラベルのフォルダーの外"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "行: %(rows)d · 列: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "差し込み印刷ラベル"

#: tavletta/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "表の 1 行ごとにラベルを 1 枚作ります。テキストやコードに列を挿入すると、各ラベルにその行の値が入ります。"

#: tavletta/ui/data.py:290
msgid "No data file"
msgstr "データファイルなし"

#: tavletta/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV、ODS、XLSX"

#: tavletta/ui/data.py:291 tavletta/ui/elements.py:316
#: tavletta/ui/elements.py:334 tavletta/ui/elements.py:347
msgid "Choose…"
msgstr "選択…"

#: tavletta/ui/data.py:304
msgid "Columns"
msgstr "列"

#: tavletta/ui/data.py:320
msgid "Read again"
msgstr "再読み込み"

#: tavletta/ui/data.py:324
msgid "Choose another file"
msgstr "別のファイルを選択"

#: tavletta/ui/data.py:326
msgid "Remove data file"
msgstr "データファイルを外す"

#: tavletta/ui/data.py:337
msgid "Sheet"
msgstr "シート"

#: tavletta/ui/data.py:357
msgid "Insert column"
msgstr "列を挿入"

#: tavletta/ui/elements.py:83 tavletta/ui/shortcuts.py:57
msgid "Content"
msgstr "内容"

#: tavletta/ui/elements.py:93
msgid "No content yet"
msgstr "まだ内容がありません"

#: tavletta/ui/elements.py:93
msgid "Add text, an image, a symbol or a code"
msgstr "テキスト、画像、記号、コードを追加してください"

#: tavletta/ui/elements.py:104 tavletta/ui/texts.py:258
#: tavletta/ui/window.py:961
msgid "Text"
msgstr "テキスト"

#: tavletta/ui/elements.py:105
msgid "Image…"
msgstr "画像…"

#: tavletta/ui/elements.py:106
msgid "Symbol…"
