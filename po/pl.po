#: etiketto/ui/texts.py:33
msgid "End"
msgstr "Koniec"

#: etiketto/ui/texts.py:34
msgid "Across the roll"
msgstr "W poprzek rolki"

#: etiketto/ui/texts.py:34
msgid "Along the roll"
msgstr "Wzdłuż rolki"

#: etiketto/ui/texts.py:36
msgid "Single label"
msgstr "Pojedyncza etykieta"

#: etiketto/ui/texts.py:36
msgid "Label sheet"
msgstr "Arkusz etykiet"

#: etiketto/ui/texts.py:39
msgid "Left"
msgstr "Do lewej"

#: etiketto/ui/texts.py:39
msgid "Right"
msgstr "Do prawej"

#: etiketto/ui/texts.py:40
msgid "QR code"
msgstr "Kod QR"

#: etiketto/ui/texts.py:52
#, python-format
msgid "Not an image: %s"
msgstr "To nie jest obraz: %s"

#: etiketto/ui/texts.py:60
msgid "Image"
msgstr "Obraz"

#: etiketto/ui/texts.py:82
msgid "System printer (CUPS, IPP)"
msgstr "Drukarka systemowa (CUPS, IPP)"

#: etiketto/ui/texts.py:88
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Element %(n)d: kod jest pusty"

#: etiketto/ui/texts.py:89
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Element %(n)d: EAN-13 wymaga dokładnie 12 cyfr"

#: etiketto/ui/texts.py:90
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: cyfra kontrolna EAN-13 jest nieprawidłowa"

#: etiketto/ui/texts.py:92
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 przyjmuje tylko litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:94
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: nie można odczytać obrazu"

#: etiketto/ui/texts.py:95
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Nie można narysować elementu %(n)d"

#: etiketto/ui/texts.py:96
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Margines bezpieczeństwa, ramka i odstęp od krawędzi nie zostawiają miejsca – zmniejsz je"

#: etiketto/ui/texts.py:97
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Stała długość jest krótsza niż odstęp – zwiększ ją"

#: etiketto/ui/texts.py:98
msgid "The background image cannot be read"
msgstr "Nie można odczytać obrazu tła"

#: etiketto/ui/texts.py:100
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: moduły kodu mają szerokość tylko jednego punktu druku i mogą się nie zeskanować – powiększ kod"

#: etiketto/ui/texts.py:104
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: wolne miejsce, którego kod potrzebuje wokół siebie, się nie mieści – powiększ kod"

#: etiketto/ui/texts.py:108
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: kod nie mieści się w swoim miejscu, nawet przy jednym punkcie druku na moduł – powiększ etykietę lub skróć treść"

#: etiketto/ui/texts.py:123
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Już wydrukowane arkusze: %(n)d z %(total)d."

#: etiketto/ui/texts.py:125
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Już wydrukowane etykiety: %(n)d z %(total)d."

#: etiketto/ui/texts.py:129
msgid "The sheets still waiting in the queue were canceled."
msgstr "Arkusze, które wciąż czekały w kolejce, zostały anulowane."

#: etiketto/ui/texts.py:131
msgid "The labels still waiting in the queue were canceled."
msgstr "Etykiety, które wciąż czekały w kolejce, zostały anulowane."

#: etiketto/ui/texts.py:140
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Nie odnaleziono drukarki. Sprawdź, czy jest włączona i w tej samej sieci, lub wpisz jej adres IP."

#: etiketto/ui/texts.py:144
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Nie można znaleźć drukarki przez USB. Sprawdź kabel oraz czy drukarka jest włączona i wybudzona, a następnie wyszukaj ponownie."

#: etiketto/ui/texts.py:147
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Drukarka nie odpowiada. Sprawdź, czy jest włączona i wybudzona."

#: etiketto/ui/texts.py:149
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Drukarka przestała przyjmować dane. Sprawdź, czy sygnalizuje problem, na przykład brak etykiet lub otwartą pokrywę, a następnie spróbuj ponownie."

#: etiketto/ui/texts.py:153
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Drukarka odrzuca połączenie. Wyłącz ją i włącz ponownie. Jeśli jej interfejs WWW oferuje opcję „Port 9100”, włącz ją."

#: etiketto/ui/texts.py:156
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nie włożono kasety. Włóż kasetę i spróbuj ponownie."

#: etiketto/ui/texts.py:157
msgid "The printer's cover is open. Close it and try again."
msgstr "Pokrywa drukarki jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:158
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etykieta się zacięła. Otwórz pokrywę, wyjmij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:159
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Nie rozpoznano kasety. Włóż ją ponownie lub spróbuj innej."

#: etiketto/ui/texts.py:160
msgid "The printer is busy. Wait a moment and try again."
msgstr "Drukarka jest zajęta. Poczekaj chwilę i spróbuj ponownie."

#: etiketto/ui/texts.py:161
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etykieta jest za długa dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:162
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etykieta jest zbyt szeroka dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:163
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "W drukarce skończyły się etykiety. Załaduj nową rolkę i spróbuj ponownie."

#: etiketto/ui/texts.py:164
msgid "The print head is open. Close it and try again."
msgstr "Głowica drukująca jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:166
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Drukarka nie może znaleźć następnej etykiety. Sprawdź, czy etykiety są poprawnie załadowane i przechodzą przez czujnik etykiet."

#: etiketto/ui/texts.py:170
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Wystąpił problem z taśmą barwiącą. Sprawdź, czy jest poprawnie założona i odpowiada metodzie druku ustawionej w drukarce."

#: etiketto/ui/texts.py:173
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Drukarka jest wstrzymana. Wznów ją na jej wyświetlaczu i spróbuj ponownie."

#: etiketto/ui/texts.py:174
msgid "The printer is out of paper. Load paper and try again."
msgstr "W drukarce skończył się papier. Załaduj papier i spróbuj ponownie."

#: etiketto/ui/texts.py:176
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Papier się zaciął. Usuń go zgodnie ze wskazaniami wyświetlacza drukarki i spróbuj ponownie."

#: etiketto/ui/texts.py:178
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "W drukarce skończył się toner lub tusz. Wymień go i spróbuj ponownie."

#: etiketto/ui/texts.py:179
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Drukarka nie może wydrukować tego rozmiaru. Wybierz rozmiar papieru, który obsługuje."

#: etiketto/ui/texts.py:181
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Drukarka nie przyjmuje żadnego z formatów, które może wysłać Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:184
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Kolejka drukarki jest wstrzymana. Wznów ją w ustawieniach drukarek systemu i spróbuj ponownie."

#: etiketto/ui/texts.py:188
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Zadanie drukowania zostało wstrzymane w kolejce, na przykład do czasu zwolnienia lub wpisania hasła. Sprawdź kolejkę w ustawieniach drukarek systemu i spróbuj ponownie."

#: etiketto/ui/texts.py:192
msgid "The print job was canceled at the printer or in the queue."
msgstr "Zadanie drukowania zostało anulowane w drukarce lub w kolejce."

#: etiketto/ui/texts.py:194
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto nie ma dostępu do portu USB drukarki. Dodaj swojego użytkownika do grupy „lp” (sudo usermod -aG lp $USER), a następnie wyloguj się i zaloguj ponownie."

#: etiketto/ui/texts.py:198
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Przy rozdzielczości tej drukarki kod nie mieści się na etykiecie i zostałby obcięty. Powiększ etykietę lub skróć treść kodu."

#: etiketto/ui/texts.py:202
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Drukarka zgłosiła problem. Wyłącz ją i włącz ponownie, a następnie spróbuj jeszcze raz."

#: etiketto/ui/texts.py:214
msgid "Warming up…"
msgstr "Rozgrzewanie…"

#: etiketto/ui/texts.py:215
msgid "Cooling down…"
msgstr "Chłodzenie…"

#: etiketto/ui/texts.py:216
msgid "Cleaning…"
msgstr "Czyszczenie…"

#: etiketto/ui/texts.py:217
msgid "Swipe the printer's panel to cut the label"
msgstr "Przesuń palcem po panelu drukarki, aby odciąć etykietę"

#: etiketto/ui/texts.py:219
msgid "Out of paper – load paper to continue"
msgstr "Brak papieru – załaduj papier, aby kontynuować"

#: etiketto/ui/texts.py:220
msgid "Cover open – close it to continue"
msgstr "Pokrywa otwarta – zamknij ją, aby kontynuować"

#: etiketto/ui/texts.py:221
msgid "Paper jammed – remove it to continue"
msgstr "Zacięcie papieru – usuń go, aby kontynuować"

#: etiketto/ui/texts.py:232
msgid "This label needs a newer version of Etiketto"
msgstr "Ta etykieta wymaga nowszej wersji Etiketto"

#: etiketto/ui/texts.py:234
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s nie jest etykietą Etiketto"

#: etiketto/ui/texts.py:235
#, python-format
msgid "The file is damaged: %s"
msgstr "Plik jest uszkodzony: %s"

#: etiketto/ui/texts.py:241
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Nie można zapisać %s: brak uprawnień do zapisu w tym miejscu"

#: etiketto/ui/texts.py:243
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Nie można zapisać %s: dysk jest pełny"

#: etiketto/ui/texts.py:244
#, python-format
msgid "Cannot save %s"
msgstr "Nie można zapisać %s"

#: etiketto/ui/texts.py:253
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Prawdopodobna data produkcji kasety: %(month)s %(year)d. Stary papier ZINK drukuje bledsze kolory."

