#: etiketto/app.py:136 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Twórz i drukuj etykiety"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "oczekiwano NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "oczekiwano liczby całkowitej od %(min)d do %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "oczekiwano wierszy, np. 3-10, 5 lub 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Bez polecenia uruchamia się aplikacja; podane pliki etykiet otwierają się w niej."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "drukuje plik etykiety bez otwierania okna"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Drukuje plik etykiety bez otwierania okna."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "etykieta (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "model drukarki, domyślnie model z etykiety: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "adres drukarki, domyślnie ustawiony w aplikacji"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "liczba kopii"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "tekst elementu NAME lub wartość zmiennej {=NAME}; zmienne w tekście są wypełniane; można powtarzać"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "jak --set, ale wartość jest używana bez zmian: nawiasy klamrowe nie są zmiennymi"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "licznik pierwszej etykiety zamiast zapisanego w etykiecie"

#: etiketto/cli.py:204
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "nie zapisuj następnej wartości licznika w etykiecie (plik tylko do odczytu); następny wydruk zacznie się od tego samego numeru"

#: etiketto/cli.py:213
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etykiety seryjne: jedna etykieta dla każdego wiersza tego pliku CSV, ODS lub XLSX; domyślnie plik danych etykiety"

#: etiketto/cli.py:218
msgid "the sheet of the data file, by default the first"
msgstr "arkusz pliku danych, domyślnie pierwszy"

#: etiketto/cli.py:224
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "tylko te wiersze pliku danych, np. 3-10, 5 lub 7- (liczone od 1)"

#: etiketto/cli.py:227
msgid "check and render only, do not print"
msgstr "tylko sprawdź i wyrenderuj, nie drukuj"

#: etiketto/cli.py:233
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "z --dry-run: zapisuje obrazy jako PNG tak, jak otrzymałaby je drukarka (- dla stdout: tylko pierwszy)"

#: etiketto/cli.py:239
msgid "list the printers found on the network"
msgstr "wyświetla drukarki znalezione w sieci"

#: etiketto/cli.py:240
msgid "List the printers found on the network: model, address, name."
msgstr "Wyświetla drukarki znalezione w sieci: model, adres, nazwa."

#: etiketto/cli.py:242
#, python-format
msgid "only this printer model: %s"
msgstr "tylko ten model drukarki: %s"

#: etiketto/cli.py:254
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "oczekiwano adresu lub sieci, np. 172.16.0.0/12: %s"

#: etiketto/cli.py:264
msgid "the folder with the label files the server may use"
msgstr "folder z plikami etykiet, których serwer może używać"

#: etiketto/cli.py:271
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "drukuj tylko na ten adres drukarki (* pasuje do wszystkiego); można powtarzać"

#: etiketto/cli.py:277
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: drukarki, których klienci mogą używać, według nazwy"

#: etiketto/cli.py:284
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "maksymalna liczba etykiet w jednym zadaniu drukowania, kopie razy wiersze (domyślnie 10000)"

#: etiketto/cli.py:289
msgid "search the network for printers (off by default)"
msgstr "wyszukaj drukarki w sieci (domyślnie wyłączone)"

#: etiketto/cli.py:296
msgid "run a print server with a REST API"
msgstr "uruchom serwer druku z REST API"

#: etiketto/cli.py:297
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Uruchamia serwer druku: REST API oraz, z --mcp, MCP dla klientów AI."

#: etiketto/cli.py:300
msgid "address to listen on (default 127.0.0.1)"
msgstr "adres nasłuchiwania (domyślnie 127.0.0.1)"

#: etiketto/cli.py:306
#, python-format
msgid "port to listen on (default %d)"
msgstr "port nasłuchiwania (domyślnie %d)"

#: etiketto/cli.py:312
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "plik z tokenem dostępu; w przeciwnym razie zmienna środowiskowa ETIKETTO_TOKEN"

#: etiketto/cli.py:318
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: nazwane tokeny dostępu z rolami"

#: etiketto/cli.py:320
msgid "also serve MCP at /mcp"
msgstr "udostępniaj także MCP pod /mcp"

#: etiketto/cli.py:326
msgid "largest request body in MB (default 4)"
msgstr "maksymalny rozmiar treści żądania w MB (domyślnie 4)"

#: etiketto/cli.py:335
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "odwrotne proxy, którego nagłówek X-Forwarded-For wskazuje klienta, np. 172.16.0.0/12; można powtarzać"

#: etiketto/cli.py:344
msgid "allow requests from web pages of this origin; repeatable"
msgstr "zezwalaj na żądania ze stron internetowych o tym pochodzeniu; można powtarzać"

#: etiketto/cli.py:349
msgid "serve MCP on standard input and output"
msgstr "udostępniaj MCP na standardowym wejściu i wyjściu"

#: etiketto/cli.py:351
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Udostępnia MCP na standardowym wejściu i wyjściu, dla klientów AI takich jak Claude Desktop."

#: etiketto/cli.py:361
msgid "manage the access tokens of the print server"
msgstr "zarządzaj tokenami dostępu serwera druku"

#: etiketto/cli.py:362
msgid "Manage the access tokens of the print server."
msgstr "Zarządza tokenami dostępu serwera druku."

#: etiketto/cli.py:367
msgid "make a token and add its hash to tokens.toml"
msgstr "utwórz token i dodaj jego skrót do tokens.toml"

#: etiketto/cli.py:368
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Tworzy token, dodaje jego skrót do tokens.toml i jednorazowo pokazuje token."

#: etiketto/cli.py:370
msgid "name of the token, e.g. the device"
msgstr "nazwa tokenu, np. urządzenia"

#: etiketto/cli.py:375
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: tylko podgląd; print: także drukowanie; admin: także wszystkie zadania drukowania"

#: etiketto/cli.py:377
msgid "tokens.toml to add it to"
msgstr "tokens.toml, do którego go dodać"

#: etiketto/cli.py:383
msgid "only this printer of printers.toml; repeatable"
msgstr "tylko ta drukarka z printers.toml; można powtarzać"

#: etiketto/cli.py:386
msgid "printers.toml, to check --printer"
msgstr "printers.toml, do sprawdzenia --printer"

#: etiketto/cli.py:388
msgid "valid until, e.g. 2027-12-31"
msgstr "ważny do, np. 2027-12-31"

#: etiketto/cli.py:389
msgid "a note for people"
msgstr "notatka dla ludzi"

#: etiketto/cli.py:391
msgid "store the hash with scrypt instead of SHA-256"
msgstr "zapisz skrót za pomocą scrypt zamiast SHA-256"

#: etiketto/cli.py:397
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "pobierz wybrany przez siebie token ze standardowego wejścia (zapisany za pomocą scrypt) zamiast tworzyć nowy"

#: etiketto/cli.py:417 etiketto/server/config.py:216
#: etiketto/server/service.py:474
#, python-format
msgid "Unknown printer model: %s"
msgstr "Nieznany model drukarki: %s"

#: etiketto/cli.py:424 etiketto/ui/files.py:66 etiketto/ui/texts.py:238
#: etiketto/server/service.py:622
#, python-format
msgid "Cannot open %s"
msgstr "Nie można otworzyć %s"

#: etiketto/cli.py:446 etiketto/server/main.py:230
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s nie jest datą, oczekiwano np. 2026-12-31 lub 2026-12-31T08:30"

#: etiketto/cli.py:476
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} jest wypełniane podczas drukowania i nie można go ustawić"

#: etiketto/cli.py:481
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Etykieta nie ma elementu ani zmiennej o nazwie %s"

#: etiketto/cli.py:506 etiketto/ui/printing.py:89
#: etiketto/server/service.py:881
msgid "The label is empty"
msgstr "Etykieta jest pusta"

#: etiketto/cli.py:539
msgid "Cannot write the output"
msgstr "Nie można zapisać wyjścia"

#: etiketto/cli.py:570
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output zapisuje obrazy PNG: podaj nazwę kończącą się na .png"

#: etiketto/cli.py:606 etiketto/cli.py:640 etiketto/cli.py:759
#: etiketto/cli.py:787 etiketto/ui/printing.py:340 etiketto/ui/printing.py:478
#: etiketto/server/service.py:821 etiketto/server/service.py:1030
#: etiketto/server/service.py:1175
msgid "The label cannot be prepared for printing."
msgstr "Nie można przygotować etykiety do druku."

#: etiketto/cli.py:667
msgid "No printer found – give its address with --host"
msgstr "Nie znaleziono drukarki – podaj jej adres przez --host"

#: etiketto/cli.py:669
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Znaleziono kilka drukarek – wybierz jedną przez --host (etiketto list-printers)"

#: etiketto/cli.py:680 etiketto/ui/texts.py:272 etiketto/server/service.py:1165
#, python-format
msgid "Cannot save %s"
msgstr "Nie można zapisać %s"

#: etiketto/cli.py:682 etiketto/server/service.py:1168
msgid "the labels were printed, but the next counter value was not saved"
msgstr "etykiety zostały wydrukowane, ale następna wartość licznika nie została zapisana"

#: etiketto/cli.py:697 etiketto/server/service.py:905
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nic nie wydrukowano: następnej wartości licznika nie dałoby się zapisać"

#: etiketto/cli.py:757 etiketto/cli.py:784 etiketto/cli.py:986
msgid "Interrupted"
msgstr "Przerwano"

#: etiketto/cli.py:860
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Etykieta używa pliku danych spoza swojego folderu: podaj go za pomocą --data"

#: etiketto/cli.py:866
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet i --rows wymagają pliku danych (--data)"

#: etiketto/cli.py:881 etiketto/ui/printing.py:356
#: etiketto/server/service.py:709
msgid "No rows to print"
msgstr "Brak wierszy do wydrukowania"

#: etiketto/cli.py:890 etiketto/ui/window.py:389 etiketto/server/service.py:762
#, python-format
msgid "No such column: %s"
msgstr "Nieznana kolumna: %s"

#: etiketto/cli.py:895 etiketto/ui/printing.py:429
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Kodu kreskowego lub kodu QR tych wierszy nie da się utworzyć z ich wartości, na przykład EAN-13 z literami lub pusta komórka. Popraw plik danych i odczytaj go ponownie albo drukuj bez tych wierszy."

#: etiketto/cli.py:900 etiketto/ui/printing.py:434
#, python-format
msgid "Rows: %s"
msgstr "Wiersze: %s"

#: etiketto/cli.py:908
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Oczekiwanie na zakończenie innego wydruku %s…"

#: etiketto/cli.py:915 etiketto/server/service.py:1024
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s jest nadal zablokowany przez inny wydruk – spróbuj później"

#: etiketto/cli.py:921
msgid "--output needs --dry-run"
msgstr "--output wymaga --dry-run"

#: etiketto/cli.py:930
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Następna wartość licznika nie zostanie zapisana: następny wydruk powtórzy numery"

#: etiketto/cli.py:957 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Nie odnaleziono drukarki"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabele (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "Wybierz plik danych"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:86 etiketto/ui/files.py:120
#: etiketto/ui/texts.py:45
msgid "Only local files can be used"
msgstr "Można używać tylko plików lokalnych"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto znów zapyta przed odczytaniem plików danych spoza folderu etykiety"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "Odczytać plik danych?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Ta etykieta używa pliku danych spoza swojego folderu:\n\n%s\n\nOdczytaj go tylko wtedy, gdy wiesz, skąd pochodzi etykieta."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "Nie teraz"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "Odczytaj plik danych"

#: etiketto/ui/data.py:263
msgid "Reading…"
msgstr "Wczytywanie…"

#: etiketto/ui/data.py:265
msgid "Not read: outside the label's folder"
msgstr "Nieodczytany: poza folderem etykiety"

#: etiketto/ui/data.py:268
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Wiersze: %(rows)d · Kolumny: %(columns)d"

