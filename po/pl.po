#. translators: a month and a year, e.g. "May 2018"; reorder as your language needs
#: etiketto/ui/i18n.py:132
#, python-format
msgid "%(month)s %(year)d"
msgstr "%(month)s %(year)d"

#: etiketto/ui/i18n.py:137
msgctxt "month name"
msgid "January"
msgstr "styczeń"

#: etiketto/ui/i18n.py:138
msgctxt "month name"
msgid "February"
msgstr "luty"

#: etiketto/ui/i18n.py:139
msgctxt "month name"
msgid "March"
msgstr "marzec"

#: etiketto/ui/i18n.py:140
msgctxt "month name"
msgid "April"
msgstr "kwiecień"

#: etiketto/ui/i18n.py:141
msgctxt "month name"
msgid "May"
msgstr "maj"

#: etiketto/ui/i18n.py:142
msgctxt "month name"
msgid "June"
