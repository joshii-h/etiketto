msgstr "Element %(n)d: EAN-13 wymaga dokładnie 12 cyfr"

#: etiketto/ui/texts.py:79
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: cyfra kontrolna EAN-13 jest nieprawidłowa"

#: etiketto/ui/texts.py:81
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 przyjmuje tylko litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:83
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: nie można odczytać obrazu"

#: etiketto/ui/texts.py:84
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Nie można narysować elementu %(n)d"

#: etiketto/ui/texts.py:85
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Margines bezpieczeństwa, ramka i odstęp od krawędzi nie zostawiają miejsca – zmniejsz je"

#: etiketto/ui/texts.py:86
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Stała długość jest krótsza niż odstęp – zwiększ ją"

#: etiketto/ui/texts.py:87
msgid "The background image cannot be read"
msgstr "Nie można odczytać obrazu tła"

#: etiketto/ui/texts.py:104
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Nie odnaleziono drukarki. Sprawdź, czy jest włączona i w tej samej sieci, lub wpisz jej adres IP."

#: etiketto/ui/texts.py:107
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Drukarka nie odpowiada. Sprawdź, czy jest włączona i wybudzona."

#: etiketto/ui/texts.py:109
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Drukarka odrzuca połączenie. Wyłącz ją i włącz ponownie. Jeśli jej interfejs WWW oferuje opcję „Port 9100”, włącz ją."

#: etiketto/ui/texts.py:112
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nie włożono kasety. Włóż kasetę i spróbuj ponownie."

#: etiketto/ui/texts.py:113
msgid "The printer's cover is open. Close it and try again."
msgstr "Pokrywa drukarki jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:114
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etykieta się zacięła. Otwórz pokrywę, wyjmij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:115
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Nie rozpoznano kasety. Włóż ją ponownie lub spróbuj innej."

#: etiketto/ui/texts.py:116
msgid "The printer is busy. Wait a moment and try again."
msgstr "Drukarka jest zajęta. Poczekaj chwilę i spróbuj ponownie."

#: etiketto/ui/texts.py:117
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etykieta jest za długa dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:118
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etykieta jest zbyt szeroka dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:119
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "W drukarce skończyły się etykiety. Załaduj nową rolkę i spróbuj ponownie."

#: etiketto/ui/texts.py:120
msgid "The print head is open. Close it and try again."
msgstr "Głowica drukująca jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:122
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Drukarka nie może znaleźć następnej etykiety. Sprawdź, czy etykiety są poprawnie załadowane i przechodzą przez czujnik etykiet."

#: etiketto/ui/texts.py:126
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Wystąpił problem z taśmą barwiącą. Sprawdź, czy jest poprawnie założona i odpowiada metodzie druku ustawionej w drukarce."

#: etiketto/ui/texts.py:129
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Drukarka jest wstrzymana. Wznów ją na jej wyświetlaczu i spróbuj ponownie."

#: etiketto/ui/texts.py:131
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Drukarka zgłosiła problem. Wyłącz ją i włącz ponownie, a następnie spróbuj jeszcze raz."

#: etiketto/ui/texts.py:143
msgid "Warming up…"
msgstr "Rozgrzewanie…"

#: etiketto/ui/texts.py:144
msgid "Cooling down…"
msgstr "Chłodzenie…"

#: etiketto/ui/texts.py:145
