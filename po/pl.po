#: etiketto/ui/texts.py:122
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Identyfikatory zastosowania w nawiasach, np. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:125
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Linki, tekst, dostęp do Wi-Fi; odczytują go telefony"

#: etiketto/ui/texts.py:126
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Tekst lub liczby na małej powierzchni, np. na drobnych częściach"

#: etiketto/ui/texts.py:127
msgid "Much text, e.g. an address or a document number"
msgstr "Dużo tekstu, np. adres lub numer dokumentu"

#: etiketto/ui/texts.py:128
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Tekst lub liczby; nie wymaga wolnego marginesu, np. na biletach"

#: etiketto/ui/texts.py:129
msgid "Latin letters, digits and punctuation"
msgstr "Litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:130
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Wielkie litery, cyfry, spacje oraz - . $ / + %"

#: etiketto/ui/texts.py:131
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Litery łacińskie, cyfry i znaki interpunkcyjne; krótszy niż Code 39"

#: etiketto/ui/texts.py:132
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 cyfr, cyfra kontrolna zostanie dodana (lub 13 z nią)"

#: etiketto/ui/texts.py:133
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 cyfr, cyfra kontrolna zostanie dodana (lub 8 z nią)"

#: etiketto/ui/texts.py:134
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 cyfr, cyfra kontrolna zostanie dodana (lub 12 z nią)"

#: etiketto/ui/texts.py:135
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 cyfr zaczynających się od 0 lub 1, cyfra kontrolna zostanie dodana (lub 8 z nią)"

#: etiketto/ui/texts.py:136
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 cyfr numeru GTIN kartonu wysyłkowego, cyfra kontrolna zostanie dodana (lub 14 z nią)"

#: etiketto/ui/texts.py:142
msgid "Whole area, centred"
msgstr "Cały obszar, wyśrodkowany"

#: etiketto/ui/texts.py:142
msgid "Fill the label, edges cut off"
msgstr "Wypełnij etykietę, krawędzie przycięte"

#: etiketto/ui/texts.py:156
#, python-format
msgid "Not an image: %s"
msgstr "To nie jest obraz: %s"

#. translators: the print density a NIIMBOT model uses by default
#: etiketto/ui/texts.py:174
msgctxt "print density"
msgid "Default"
msgstr "Domyślna"

#: etiketto/ui/texts.py:178
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:181
#, python-format
msgid "%d in/s"
msgstr "%d cali/s"

#: etiketto/ui/texts.py:190
msgid "Image"
msgstr "Obraz"

#: etiketto/ui/texts.py:217
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Ciągła, szerokość %(width)s"

#: etiketto/ui/texts.py:227
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Sprawdź, czy cała etykieta mieści się w zaznaczeniu. Przeciągnij, aby przesunąć je lub jego krawędzie, albo narysuj nowe."

#: etiketto/ui/texts.py:231
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Etykietą może być kilka obszarów. Sprawdź zaznaczenie lub wypróbuj następny."

#: etiketto/ui/texts.py:233
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Zaznaczono wszystko, co jest wydrukowane na stronie. Przeciągnij, aby wybrać etykietę."

#: etiketto/ui/texts.py:234
msgid "Nothing is printed on this page."
msgstr "Na tej stronie nic nie jest wydrukowane."

#: etiketto/ui/texts.py:239
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Pliki PDF wymagają biblioteki Poppler (poppler-glib), która nie jest zainstalowana"

#: etiketto/ui/texts.py:250
msgid "System printer (CUPS, IPP)"
msgstr "Drukarka systemowa (CUPS, IPP)"

#: etiketto/ui/texts.py:251
msgid "Receipt printer (ESC/POS)"
msgstr "Drukarka paragonów (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:253
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, rolki ciągłe"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:255
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, etykiety wycinane"

#: etiketto/ui/texts.py:262
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Element %(n)d: kod jest pusty"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Element %(n)d: EAN-13 wymaga dokładnie 12 cyfr"

#: etiketto/ui/texts.py:264
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: cyfra kontrolna EAN-13 jest nieprawidłowa"

#: etiketto/ui/texts.py:266
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 przyjmuje tylko litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:268
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Element %(n)d: EAN-8 wymaga 7 cyfr lub 8 z cyfrą kontrolną"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Element %(n)d: UPC-A wymaga 11 cyfr lub 12 z cyfrą kontrolną"

#: etiketto/ui/texts.py:271
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Element %(n)d: UPC-E wymaga 7 cyfr zaczynających się od 0 lub 1, albo 8 z cyfrą kontrolną"

#: etiketto/ui/texts.py:273
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Element %(n)d: ITF-14 wymaga 13 cyfr lub 14 z cyfrą kontrolną"

#: etiketto/ui/texts.py:274
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Element %(n)d: cyfra kontrolna jest nieprawidłowa"

#: etiketto/ui/texts.py:276
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Element %(n)d: Code 39 przyjmuje tylko wielkie litery, cyfry, spacje oraz - . $ / + %%"

#: etiketto/ui/texts.py:279
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 93 przyjmuje tylko litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:282
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: dane GS1 przyjmują tylko litery łacińskie, cyfry i znaki interpunkcyjne"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Element %(n)d: dane GS1 muszą składać się z identyfikatorów zastosowania w nawiasach, każdy z następującą po nim wartością, np. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:288
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Element %(n)d: (%(ai)s) nie jest identyfikatorem zastosowania GS1"

#: etiketto/ui/texts.py:290
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Element %(n)d: wartość identyfikatora zastosowania (%(ai)s) ma nieprawidłową długość"

#: etiketto/ui/texts.py:293
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Element %(n)d: cyfra kontrolna identyfikatora zastosowania (%(ai)s) jest nieprawidłowa"

#: etiketto/ui/texts.py:296
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Element %(n)d: wartość identyfikatora zastosowania (%(ai)s) jest nieprawidłowa: data, liczba lub znak, którego nie dopuszcza"

#: etiketto/ui/texts.py:300
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Element %(n)d: żaden numer UPC-A nie skraca się do tych cyfr UPC-E – sprawdź je lub użyj UPC-A"

#: etiketto/ui/texts.py:304
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Element %(n)d: skanery ustawione na Full ASCII odczytują $, /, + lub %% przed wielką literą jako inny znak"

#: etiketto/ui/texts.py:307
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Element %(n)d: treść jest za długa dla tego typu kodu"

#: etiketto/ui/texts.py:308
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Element %(n)d: treści nie można zakodować w tym typie kodu"

#: etiketto/ui/texts.py:310
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Element %(n)d: ten typ kodu wymaga biblioteki Zint (zint-bindings), która nie jest zainstalowana"

#: etiketto/ui/texts.py:313
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: nie można odczytać obrazu"

#: etiketto/ui/texts.py:314
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Element %(n)d: tego symbolu nie ma w bibliotece symboli"

#: etiketto/ui/texts.py:315
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: nie można odczytać dokumentu"

#: etiketto/ui/texts.py:317
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: pliki PDF wymagają biblioteki Poppler (poppler-glib), która nie jest zainstalowana"

#: etiketto/ui/texts.py:319
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Nie można narysować elementu %(n)d"

#: etiketto/ui/texts.py:320
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Margines bezpieczeństwa, ramka i odstęp od krawędzi nie zostawiają miejsca – zmniejsz je"

#: etiketto/ui/texts.py:321
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Stała długość jest krótsza niż odstęp – zwiększ ją"

#: etiketto/ui/texts.py:322
msgid "The background image cannot be read"
msgstr "Nie można odczytać obrazu tła"

#: etiketto/ui/texts.py:324
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: moduły kodu mają szerokość tylko jednego punktu druku i mogą się nie zeskanować – powiększ kod"

#: etiketto/ui/texts.py:328
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: wolne miejsce, którego kod potrzebuje wokół siebie, się nie mieści – powiększ kod"

#: etiketto/ui/texts.py:332
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: kod nie mieści się w swoim miejscu, nawet przy jednym punkcie druku na moduł – powiększ etykietę lub skróć treść"

#: etiketto/ui/texts.py:335
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Element %(n)d: %(name)s nie jest znaną zmienną"

#: etiketto/ui/texts.py:337
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Element %(n)d: data %(name)s jest wcześniejsza niż rok 1 lub późniejsza niż 9999"

#: etiketto/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Element %(n)d: zmienna %(name)s… nie jest zamknięta – zakończ ją znakiem }"

#: etiketto/ui/texts.py:354
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Już wydrukowane arkusze: %(n)d z %(total)d."

#: etiketto/ui/texts.py:356
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Już wydrukowane etykiety: %(n)d z %(total)d."

#: etiketto/ui/texts.py:360
msgid "The sheets still waiting in the queue were canceled."
msgstr "Arkusze, które wciąż czekały w kolejce, zostały anulowane."

#: etiketto/ui/texts.py:362
msgid "The labels still waiting in the queue were canceled."
msgstr "Etykiety, które wciąż czekały w kolejce, zostały anulowane."

#: etiketto/ui/texts.py:371
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Nie odnaleziono drukarki. Sprawdź, czy jest włączona i w tej samej sieci, lub wpisz jej adres IP."

#: etiketto/ui/texts.py:375
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Nie można znaleźć drukarki przez USB. Sprawdź kabel oraz czy drukarka jest włączona i wybudzona, a następnie wyszukaj ponownie."

#: etiketto/ui/texts.py:378
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Drukarka nie odpowiada. Sprawdź, czy jest włączona i wybudzona."

#: etiketto/ui/texts.py:380
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Drukarka przestała przyjmować dane. Sprawdź, czy sygnalizuje problem, na przykład brak etykiet lub otwartą pokrywę, a następnie spróbuj ponownie."

#: etiketto/ui/texts.py:384
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Drukarka odrzuca połączenie. Wyłącz ją i włącz ponownie. Jeśli jej interfejs WWW oferuje opcję „Port 9100”, włącz ją."

#: etiketto/ui/texts.py:387
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nie włożono kasety. Włóż kasetę i spróbuj ponownie."

#: etiketto/ui/texts.py:388
msgid "The printer's cover is open. Close it and try again."
msgstr "Pokrywa drukarki jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:389
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etykieta się zacięła. Otwórz pokrywę, wyjmij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:390
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Nie rozpoznano kasety. Włóż ją ponownie lub spróbuj innej."

#: etiketto/ui/texts.py:391
msgid "The printer is busy. Wait a moment and try again."
msgstr "Drukarka jest zajęta. Poczekaj chwilę i spróbuj ponownie."

#: etiketto/ui/texts.py:392
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etykieta jest za długa dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:393
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etykieta jest zbyt szeroka dla tej drukarki: maksymalnie %(max)s."

#: etiketto/ui/texts.py:394
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "W drukarce skończyły się etykiety. Załaduj nową rolkę i spróbuj ponownie."

#: etiketto/ui/texts.py:395
msgid "The print head is open. Close it and try again."
msgstr "Głowica drukująca jest otwarta. Zamknij ją i spróbuj ponownie."

#: etiketto/ui/texts.py:397
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Drukarka nie może znaleźć następnej etykiety. Sprawdź, czy etykiety są poprawnie załadowane i przechodzą przez czujnik etykiet."

#: etiketto/ui/texts.py:401
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Wystąpił problem z taśmą barwiącą. Sprawdź, czy jest poprawnie założona i odpowiada metodzie druku ustawionej w drukarce."

#: etiketto/ui/texts.py:404
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Drukarka jest wstrzymana. Wznów ją na jej wyświetlaczu i spróbuj ponownie."

#: etiketto/ui/texts.py:405
msgid "The printer is out of paper. Load paper and try again."
msgstr "W drukarce skończył się papier. Załaduj papier i spróbuj ponownie."

#: etiketto/ui/texts.py:407
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Papier się zaciął. Usuń go zgodnie ze wskazaniami wyświetlacza drukarki i spróbuj ponownie."

#: etiketto/ui/texts.py:409
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "W drukarce skończył się toner lub tusz. Wymień go i spróbuj ponownie."

#: etiketto/ui/texts.py:410
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Drukarka nie może wydrukować tego rozmiaru. Wybierz rozmiar papieru, który obsługuje."

#: etiketto/ui/texts.py:412
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Drukarka nie przyjmuje żadnego z formatów, które może wysłać Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:415
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Kolejka drukarki jest wstrzymana. Wznów ją w ustawieniach drukarek systemu i spróbuj ponownie."

#: etiketto/ui/texts.py:419
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Zadanie drukowania zostało wstrzymane w kolejce, na przykład do czasu zwolnienia lub wpisania hasła. Sprawdź kolejkę w ustawieniach drukarek systemu i spróbuj ponownie."

#: etiketto/ui/texts.py:423
msgid "The print job was canceled at the printer or in the queue."
msgstr "Zadanie drukowania zostało anulowane w drukarce lub w kolejce."

#: etiketto/ui/texts.py:424
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Drukarka nie zgłosiła na czas swojej rozdzielczości. Wybierz ją w „%s”."

#: etiketto/ui/texts.py:427
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Załadowana rolka nie pasuje do etykiety. Załaduj pasującą rolkę albo wybierz rozmiar etykiety lub model drukarki odpowiadający załadowanej rolce."

#: etiketto/ui/texts.py:430
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Bateria drukarki jest słaba – naładuj ją lub podłącz zasilacz."

#: etiketto/ui/texts.py:431
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Głowica drukująca jest za gorąca. Poczekaj, aż ostygnie, a następnie spróbuj ponownie."

#: etiketto/ui/texts.py:433
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto nie może drukować na tym modelu drukarki: nie przyjmuje on obrazów rastrowych wysyłanych przez Etiketto."

#: etiketto/ui/texts.py:437
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto nie zna tego modelu drukarki i nie może jeszcze na nim drukować."

#: etiketto/ui/texts.py:440
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Drukarka jest w trybie Editor Lite i widnieje jako dysk USB. Wyłącz Editor Lite na drukarce (jej lampka zgaśnie), a następnie wyszukaj ponownie."

#: etiketto/ui/texts.py:444
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto nie ma dostępu do portu USB drukarki. Dodaj swojego użytkownika do grupy „lp” (sudo usermod -aG lp $USER), a następnie wyloguj się i zaloguj ponownie."

#: etiketto/ui/texts.py:448
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Strona jest zbyt duża, aby ją utworzyć w rozdzielczości obsługiwanej przez drukarkę. Wybierz mniejszy format papieru lub drukuj na drukarce, która przyjmuje PDF."

#: etiketto/ui/texts.py:452
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Przy rozdzielczości tej drukarki kod nie mieści się na etykiecie i zostałby obcięty. Powiększ etykietę lub skróć treść kodu."

#: etiketto/ui/texts.py:456
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto nie ma dostępu do portu szeregowego drukarki. Dodaj swojego użytkownika do grupy „dialout” (sudo usermod -aG dialout $USER; w Arch Linux grupa nazywa się „uucp”), a następnie wyloguj się i zaloguj ponownie."

#: etiketto/ui/texts.py:461
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Drukarka zgłosiła problem. Wyłącz ją i włącz ponownie, a następnie spróbuj jeszcze raz."

#: etiketto/ui/texts.py:472
msgid "Printed"
msgstr "Wydrukowano"

#: etiketto/ui/texts.py:478
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Wysłano do drukarki – wydruk nastąpi, gdy przyjdzie jego kolej"

#: etiketto/ui/texts.py:480
msgid "Sent to the printer – it did not confirm printing"
msgstr "Wysłano do drukarki – drukarka nie potwierdziła wydruku"

#: etiketto/ui/texts.py:484
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Wydrukowano w trybie „%(used)s”, bo wymaga tego załadowana rolka"

#: etiketto/ui/texts.py:488
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Tryb kolorów „%(wanted)s” jest niedostępny w tej drukarce, wydrukowano w trybie „%(used)s”"

#: etiketto/ui/texts.py:498
msgid "Warming up…"
msgstr "Rozgrzewanie…"

#: etiketto/ui/texts.py:499
msgid "Cooling down…"
msgstr "Chłodzenie…"

#: etiketto/ui/texts.py:500
msgid "Cleaning…"
msgstr "Czyszczenie…"

#: etiketto/ui/texts.py:501
msgid "Swipe the printer's panel to cut the label"
msgstr "Przesuń palcem po panelu drukarki, aby odciąć etykietę"

#: etiketto/ui/texts.py:503
msgid "Out of paper – load paper to continue"
msgstr "Brak papieru – załaduj papier, aby kontynuować"

#: etiketto/ui/texts.py:504
msgid "Cover open – close it to continue"
msgstr "Pokrywa otwarta – zamknij ją, aby kontynuować"

#: etiketto/ui/texts.py:505
msgid "Paper jammed – remove it to continue"
msgstr "Zacięcie papieru – usuń go, aby kontynuować"

#: etiketto/ui/texts.py:516
msgid "This label needs a newer version of Etiketto"
msgstr "Ta etykieta wymaga nowszej wersji Etiketto"

#: etiketto/ui/texts.py:518
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s nie jest etykietą Etiketto"

#: etiketto/ui/texts.py:519 etiketto/ui/texts.py:539
#, python-format
msgid "The file is damaged: %s"
msgstr "Plik jest uszkodzony: %s"

#: etiketto/ui/texts.py:526
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Plik danych %s już nie istnieje. Wybierz go ponownie lub usuń."

#: etiketto/ui/texts.py:530
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s nie ma arkusza o nazwie %(sheet)s"

#: etiketto/ui/texts.py:532
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s nie jest tabelą. Użyj pliku CSV, ODS lub XLSX."

#: etiketto/ui/texts.py:534
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s jest za duży na etykiety seryjne. Podziel go na mniejsze pliki lub usuń niepotrzebne wiersze i kolumny."

#: etiketto/ui/texts.py:537
#, python-format
msgid "%s contains no data."
msgstr "%s nie zawiera danych."

#: etiketto/ui/texts.py:548
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Drukowanie zatrzymało się na wierszu %(row)d. Aby kontynuować, wydrukuj ponownie od wiersza %(row)d."

#: etiketto/ui/texts.py:552
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Już wydrukowane kopie wiersza %(row)d: %(copies)d."

#: etiketto/ui/texts.py:557
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Wiersz %(row)d trafia na pozycję %(position)d arkusza %(sheet)d."

#: etiketto/ui/texts.py:568
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Nie można zapisać %s: brak uprawnień do zapisu w tym miejscu"

#: etiketto/ui/texts.py:570
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Nie można zapisać %s: dysk jest pełny"

#: etiketto/ui/texts.py:580
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Prawdopodobna data produkcji kasety: %(month)s %(year)d. Stary papier ZINK drukuje bledsze kolory."

