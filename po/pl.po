msgstr "Numer kopii"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Liczba kopii"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "Losowy ID"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Wstaw zmienną"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Zmienne są wypełniane podczas drukowania. Każda wydrukowana etykieta dostaje następną wartość licznika, także z kopii na kopię. Podgląd pokazuje wartości następnego wydruku."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Więcej o zmiennych"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Rośnie z każdą wydrukowaną etykietą o krok"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Następny numer"

#: tavletta/ui/variables.py:122
msgid "Step"
msgstr "Krok"

#: tavletta/ui/window.py:158
msgid "Templates"
msgstr "Szablony"

#: tavletta/ui/window.py:189
msgid "Shipping label…"
msgstr "Etykieta wysyłkowa…"

#: tavletta/ui/window.py:192
msgid "Data for serial labels…"
msgstr "Dane do etykiet seryjnych…"

#: tavletta/ui/window.py:193
msgid "Forget allowed data files"
msgstr "Zapomnij dozwolone pliki danych"

#: tavletta/ui/window.py:194
msgid "Export PNG…"
msgstr "Eksportuj jako PNG…"

#: tavletta/ui/window.py:198
msgid "Report a problem…"
msgstr "Zgłoś problem…"

#: tavletta/ui/window.py:199
msgid "About Tavletta"
msgstr "O programie Tavletta"

#: tavletta/ui/window.py:678
msgid "Unsaved label"
msgstr "Niezapisana etykieta"

#: tavletta/ui/window.py:837
msgid "content scaled down to fit"
msgstr "treść pomniejszona, aby się zmieściła"

#: tavletta/ui/window.py:841
#, python-format
msgid "Problem: %s"
msgstr "Problem: %s"

#: tavletta/ui/window.py:860
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Za długa dla tej drukarki: maksymalnie %s"

#: tavletta/ui/window.py:864
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Zbyt szeroka dla tej drukarki: maksymalnie %s"

#: tavletta/ui/window.py:936
msgid "The browser cannot be opened"
msgstr "Nie można otworzyć przeglądarki"

#: tavletta/ui/window.py:938
msgid "Copy link"
msgstr "Skopiuj odnośnik"

#: tavletta/ui/window.py:1009
msgid "Only local files can be dropped"
msgstr "Można upuszczać tylko pliki lokalne"

#: tavletta/ui/window.py:1047
msgid "Please wait until printing has finished"
msgstr "Proszę poczekać na zakończenie drukowania"

#: tavletta/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:342
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "Nie można odczytać %(file)s: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "oczekiwano tabeli"

#: tavletta/server/config.py:119 tavletta/server/config.py:446
msgid "missing"
msgstr "brak"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "oczekiwano tekstu"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "znaki sterujące są niedozwolone"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "oczekiwano true lub false"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "oczekiwano liczby od %(min)s do %(max)s"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "oczekiwano jednej z wartości: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
msgid "unknown key"
msgstr "nieznany klucz"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "nic nie zdefiniowano"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "nieprawidłowa nazwa: litery, cyfry, . _ - (do 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "tylko jedna drukarka może być domyślna"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "nieprawidłowy adres drukarki"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "ten model drukarki nie obcina"

#: tavletta/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "ten model drukarki nie ma ustawień kolorów"

#: tavletta/server/config.py:406
msgid "expected a date such as 2027-12-31"
msgstr "oczekiwano daty, np. 2027-12-31"

#: tavletta/server/config.py:420
msgid "the same token twice"
msgstr "ten sam token dwukrotnie"

#: tavletta/server/config.py:433
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s może zmienić każdy użytkownik tego komputera: wykonaj na nim chmod 600"

#: tavletta/server/config.py:443
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "to nie jest skrót tokenu: oczekiwano sha256:… lub scrypt:…"

#: tavletta/server/config.py:469
msgid "expected a list of printer names"
msgstr "oczekiwano listy nazw drukarek"

#: tavletta/server/config.py:471
msgid "printers can only be limited with --printers"
msgstr "drukarki można ograniczyć tylko z --printers"

#: tavletta/server/config.py:473 tavletta/server/service.py:470
#, python-format
msgid "Unknown printer: %s"
msgstr "Nieznana drukarka: %s"

#: tavletta/server/errors.py:29
#, python-format
msgid "Invalid value for %s"
msgstr "Nieprawidłowa wartość dla %s"

#: tavletta/server/http.py:464 tavletta/server/http.py:513
msgid "The request took too long"
msgstr "Żądanie trwało zbyt długo"

#: tavletta/server/http.py:473 tavletta/server/service.py:1184
msgid "The server is busy – try again later"
msgstr "Serwer jest zajęty – spróbuj ponownie później"

#: tavletta/server/http.py:516
msgid "Internal error"
msgstr "Błąd wewnętrzny"

#: tavletta/server/http.py:521
msgid "This server only answers on its local address"
msgstr "Ten serwer odpowiada tylko na swoim adresie lokalnym"

#: tavletta/server/http.py:525
msgid "Requests from this web page are not allowed"
msgstr "Żądania z tej strony internetowej są niedozwolone"

#: tavletta/server/http.py:543
msgid "Too many requests – try again later"
msgstr "Zbyt wiele żądań – spróbuj ponownie później"

#: tavletta/server/http.py:545
msgid "Access token missing or wrong"
msgstr "Brak tokenu dostępu lub jest on nieprawidłowy"

#: tavletta/server/http.py:586 tavletta/server/http.py:591
msgid "The request needs a Content-Length"
msgstr "Żądanie wymaga nagłówka Content-Length"

#: tavletta/server/http.py:588
msgid "The request has more than one Content-Length"
msgstr "Żądanie ma więcej niż jeden nagłówek Content-Length"

#: tavletta/server/http.py:594
msgid "The request is too large"
msgstr "Żądanie jest zbyt duże"

#: tavletta/server/http.py:599
msgid "The request body is incomplete"
msgstr "Treść żądania jest niekompletna"

#: tavletta/server/http.py:606
msgid "Send the request as application/json"
msgstr "Wyślij żądanie jako application/json"

#: tavletta/server/http.py:635 tavletta/server/http.py:645
msgid "Not found"
msgstr "Nie znaleziono"

#: tavletta/server/http.py:644
msgid "Method not allowed"
msgstr "Niedozwolona metoda"

#: tavletta/server/http.py:661
#, python-format
msgid "Send the header %s with this request"
msgstr "Wyślij nagłówek %s z tym żądaniem"

#: tavletta/server/http.py:805
msgid "The request is not valid JSON"
msgstr "Żądanie nie zawiera prawidłowego JSON"

#: tavletta/server/main.py:35
#, python-format
msgid "The labels folder %s does not exist"
msgstr "Folder etykiet %s nie istnieje"

#: tavletta/server/main.py:48
#, python-format
msgid "Cannot read the token file %s"
msgstr "Nie można odczytać pliku tokenu %s"

#: tavletta/server/main.py:54 tavletta/server/main.py:313
msgid ""
"The access token may only contain printable ASCII characters without spaces"
msgstr "Token dostępu może zawierać tylko drukowalne znaki ASCII bez spacji"

#: tavletta/server/main.py:59 tavletta/server/main.py:318
#, python-format
msgid "The access token must be at least %d characters long"
msgstr "Token dostępu musi mieć co najmniej %d znaków"

#: tavletta/server/main.py:75
msgid "Use either --printers or --allow-printer"
msgstr "Użyj albo --printers, albo --allow-printer"

#: tavletta/server/main.py:77
msgid "Use either --tokens or --token-file"
msgstr "Użyj albo --tokens, albo --token-file"

#: tavletta/server/main.py:91
#, python-format
msgid "Not a valid printer address pattern: %s"
msgstr "Nieprawidłowy wzorzec adresu drukarki: %s"

#: tavletta/server/main.py:117
#, python-format
msgid ""
"Refusing to listen on %s without an access token: set TAVLETTA_TOKEN or use "
"--token-file"
msgstr "Odmowa nasłuchiwania na %s bez tokenu dostępu: ustaw TAVLETTA_TOKEN lub użyj --token-file"

#: tavletta/server/main.py:140
#, python-format
msgid "Cannot listen on %(address)s: %(reason)s"
msgstr "Nie można nasłuchiwać na %(address)s: %(reason)s"

#: tavletta/server/main.py:272
msgid "Not a valid name: letters, digits, . _ - (up to 64)"
msgstr "Nieprawidłowa nazwa: litery, cyfry, . _ - (do 64)"

#: tavletta/server/main.py:283
#, python-format
msgid "%s is in use by another program – try again later"
msgstr "%s jest używany przez inny program – spróbuj ponownie później"

#: tavletta/server/main.py:290
#, python-format
msgid "The token %(name)s was added to %(file)s."
msgstr "Token %(name)s został dodany do %(file)s."

#: tavletta/server/main.py:297
#, python-format
msgid "The token is shown only this once; %s keeps only its hash."
msgstr "Token jest pokazywany tylko ten jeden raz; %s przechowuje tylko jego skrót."

#: tavletta/server/main.py:308
msgid "Access token: "
msgstr "Token dostępu: "

#: tavletta/server/main.py:323
msgid "A chosen token must not look like a made one (etk_…)"
msgstr "Wybrany token nie może wyglądać jak wygenerowany (etk_…)"

#: tavletta/server/main.py:367
#, python-format
msgid "A token named %s exists already"
msgstr "Token o nazwie %s już istnieje"

#: tavletta/server/main.py:394
#, python-format
msgid "This token is in the file already, as %s"
msgstr "Ten token jest już w pliku jako %s"

#: tavletta/server/paths.py:39
#, python-format
msgid "No such label: %s"
msgstr "Nieznana etykieta: %s"

#: tavletta/server/paths.py:46
#, python-format
msgid "No such data file: %s"
msgstr "Nieznany plik danych: %s"

#: tavletta/server/requests.py:95
msgid "The request must be a JSON object"
msgstr "Żądanie musi być obiektem JSON"

#: tavletta/server/requests.py:97
#, python-format
msgid "Unknown field: %s"
msgstr "Nieznane pole: %s"

#: tavletta/server/requests.py:104
msgid "Give the label either by name or as content"
msgstr "Podaj etykietę albo przez nazwę, albo jako zawartość"

#: tavletta/server/requests.py:109
msgid "Give data rows or a data file, not both"
msgstr "Podaj wiersze danych albo plik danych, nie oba naraz"

#: tavletta/server/requests.py:196
#, python-format
msgid "Too many data rows: at most %d"
msgstr "Zbyt wiele wierszy danych: maksymalnie %d"

#: tavletta/server/requests.py:204
#, python-format
msgid "Too many columns: at most %d"
msgstr "Zbyt wiele kolumn: maksymalnie %d"

#: tavletta/server/requests.py:207
#, python-format
msgid "Too many cells: at most %d"
msgstr "Zbyt wiele komórek: maksymalnie %d"

#: tavletta/server/service.py:482
msgid "Choose a printer by its name"
msgstr "Wybierz drukarkę według nazwy"

#: tavletta/server/service.py:546 tavletta/server/service.py:1163
msgid "This access token may not do this"
msgstr "Ten token dostępu nie pozwala na to"

#: tavletta/server/service.py:594
msgid "No printer address: give it as host"
msgstr "Brak adresu drukarki: podaj go jako host"

#: tavletta/server/service.py:603
#, python-format
msgid "This printer address is not allowed: %s"
msgstr "Ten adres drukarki jest niedozwolony: %s"

#: tavletta/server/service.py:698
msgid "Document pages in label_content are not allowed (--allow-pdf-pages)"
msgstr "Strony dokumentów nie są dozwolone w label_content (--allow-pdf-pages)"

#: tavletta/server/service.py:782
msgid "A sheet needs a data file"
msgstr "Arkusz wymaga pliku danych"

#: tavletta/server/service.py:788
msgid ""
"The label uses a data file outside the labels folder: send its rows along"
msgstr "Etykieta używa pliku danych spoza folderu etykiet: wyślij razem z nią jego wiersze"

#: tavletta/server/service.py:922
#, python-format
msgid "At most %d labels in one print job"
msgstr "Maksymalnie %d etykiet w jednym zadaniu drukowania"

#: tavletta/server/service.py:949
msgid "Too many print jobs are waiting – try again later"
msgstr "Zbyt wiele zadań drukowania czeka – spróbuj ponownie później"

#: tavletta/server/service.py:1144
#, python-format
msgid "No such print job: %s"
msgstr "Nieznane zadanie drukowania: %s"

#: tavletta/server/service.py:1156
msgid "The print job has already finished"
msgstr "Zadanie drukowania zostało już zakończone"

#: tavletta/server/service.py:1188
msgid "The label is too large to render"
msgstr "Etykieta jest zbyt duża, aby ją wyrenderować"

#: tavletta/server/service.py:1202
#, python-format
msgid "The label is too large: at most %d images and codes"
msgstr "Etykieta jest zbyt duża: maksymalnie %d obrazów i kodów"

#: tavletta/server/service.py:1225
#, python-format
msgid ""
"The label is too large: at most %(elements)d elements and %(chars)d "
"characters in a text"
msgstr "Etykieta jest zbyt duża: maksymalnie %(elements)d elementów i %(chars)d znaków w tekście"

#: tavletta/server/service.py:1244
#, python-format
msgid "At most %d copies on this printer"
msgstr "Maksymalnie %d kopii na tej drukarce"

#: tavletta/server/service.py:1249
msgid "Printers are chosen by name: leave out host"
msgstr "Drukarki wybiera się według nazwy: pomiń host"
