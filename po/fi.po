msgstr "Ei luettu: tarran kansion ulkopuolella"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Rivejä: %(rows)d · Sarakkeita: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Sarjatarrat"

