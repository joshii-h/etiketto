msgstr "Pyynnöt tältä verkkosivulta eivät ole sallittuja"

#: tavletta/server/http.py:543
msgid "Too many requests – try again later"
msgstr "Liikaa pyyntöjä – yritä myöhemmin uudelleen"

#: tavletta/server/http.py:545
