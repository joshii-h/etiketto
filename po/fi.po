msgstr "Tallentamaton tarra"

#: etiketto/ui/window.py:373
msgid "content scaled down to fit"
msgstr "sisältöä pienennetty, jotta se mahtuu"

#: etiketto/ui/window.py:375
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Liian pitkä tälle tulostimelle: enintään %s"

#: etiketto/ui/window.py:380
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Liian leveä tälle tulostimelle: enintään %s"

#: etiketto/ui/window.py:385
#, python-format
msgid "Problem: %s"
msgstr "Ongelma: %s"

#: etiketto/ui/window.py:460
