msgstr "Liian pitkä tälle tulostimelle: enintään %s"

#: etiketto/ui/window.py:358
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Liian leveä tälle tulostimelle: enintään %s"

#: etiketto/ui/window.py:363
#, python-format
msgid "Problem: %s"
msgstr "Ongelma: %s"

