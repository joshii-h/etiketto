#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Laatikko ja kehys"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Suunnittele ja tulosta tarroja"

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:222
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideoita muuttujiin (laskuri, päivämäärä, UUID), ei koodia"

#: tavletta/app.py:233
msgid "Protocol knowledge"
msgstr "Protokollatieto"

#: tavletta/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Lähteistä %(projects)s ja valmistajien käyttöoppaista, kirjoitettu uudelleen ilman niiden koodia; katso THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "odotettiin NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "odotettiin kokonaislukua väliltä %(min)d–%(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "odotettiin rivejä, esim. 3-10, 5 tai 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Ilman komentoa sovellus käynnistyy; annetut tarratiedostot avataan siinä."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "tulostaa tarratiedoston avaamatta ikkunaa"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Tulostaa tarratiedoston avaamatta ikkunaa."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "tarra (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "tulostinmalli, oletuksena tarran malli: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "tulostimen osoite, oletuksena sovellukseen asetettu osoite"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "kopioiden määrä"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "elementin NAME teksti tai muuttujan {=NAME} arvo; tekstin muuttujat täytetään; voi toistaa"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "kuten --set, mutta arvoa käytetään sellaisenaan: aaltosulkeet eivät ole muuttujia"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "ensimmäisen tarran laskuri tarraan tallennetun sijaan"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "tulosta tulostinmallin oletuksilla sovelluksessa viimeksi valittujen leikkauksen, värien, laadun, lisävalintojen (ketjutulostus, suuri tarkkuus, nauhan syöttö), tulostinasetusten ja tarra-arkkien ääriviivojen sijaan; osoite ja turvamarginaali säilyvät"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "lämpötulostimen tulostustapa, jos tulostimessa on tämä asetus: printer (tulostimen asetusten mukaan), transfer (värinauhalla) tai direct (suoralämpö, ilman värinauhaa); oletuksena sovelluksessa valittu, myös valitsimella --printer-defaults"

#: tavletta/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "älä kysy tulostimelta ennen piirtämistä (malli, nauha ja tarkkuus)"

#: tavletta/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "älä tallenna laskurin seuraavaa arvoa tarraan (vain luku -tiedosto); seuraava tulostus alkaa samasta numerosta"

#: tavletta/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "sarjatarrat: yksi tarra tämän CSV-, ODS- tai XLSX-tiedoston jokaiselle riville; oletuksena tarran datatiedosto"

#: tavletta/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "datatiedoston taulukko, oletuksena ensimmäinen"

#: tavletta/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "vain nämä datatiedoston rivit, esim. 3-10, 5 tai 7- (laskettuna 1:stä)"

#: tavletta/cli.py:267
msgid "check and render only, do not print"
msgstr "vain tarkista ja renderöi, älä tulosta"

#: tavletta/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "valitsimen --dry-run kanssa: tallentaa jokaisen tarran PNG-muodossa niin kuin ikkuna sen vie, enintään 600 dpi (- stdout: vain ensimmäinen)"

#: tavletta/cli.py:279
msgid "list the printers found on the network"
msgstr "luettelee verkosta löytyvät tulostimet"

#: tavletta/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Luettelee verkosta löytyvät tulostimet: malli, osoite, nimi."

#: tavletta/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "vain tämä tulostinmalli: %s"

#: tavletta/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "odotettiin osoitetta tai verkkoa, esim. 172.16.0.0/12: %s"

#: tavletta/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "kansio, jossa ovat palvelimen käytettävissä olevat tarratiedostot"

#: tavletta/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "tulosta vain tähän tulostimen osoitteeseen (* vastaa mitä tahansa); voi toistaa"

#: tavletta/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: tulostimet, joita asiakkaat saavat käyttää, nimen mukaan"

#: tavletta/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "enintään näin monta tarraa yhdessä tulostustyössä, kopiot kertaa rivit (oletus 10000)"

#: tavletta/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "etsi tulostimia verkosta (oletuksena pois päältä)"

#: tavletta/cli.py:336
msgid "run a print server with a REST API"
msgstr "käynnistää tulostuspalvelimen, jossa on REST API"

#: tavletta/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Käynnistää tulostuspalvelimen: REST API ja --mcp-valitsimella MCP tekoälyasiakkaille."

#: tavletta/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "kuunneltava osoite (oletus 127.0.0.1)"

#: tavletta/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "kuunneltava portti (oletus %d)"

#: tavletta/cli.py:352
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "tiedosto, jossa on pääsytunnus; muuten ympäristömuuttuja TAVLETTA_TOKEN"

#: tavletta/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: nimetyt pääsytunnukset rooleineen"

#: tavletta/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "tarjoa MCP myös osoitteessa /mcp"

#: tavletta/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "pyynnön rungon enimmäiskoko megatavuina, MB (oletus 4)"

#: tavletta/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "käänteinen välityspalvelin, jonka X-Forwarded-For-otsake nimeää asiakkaan, esim. 172.16.0.0/12; voi toistaa"

#: tavletta/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "salli pyynnöt tämän alkuperän verkkosivuilta; voi toistaa"

#: tavletta/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "tarjoaa MCP:n vakiosyötteessä ja -tulosteessa"

#: tavletta/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Tarjoaa MCP:n vakiosyötteessä ja -tulosteessa tekoälyasiakkaille, kuten Claude Desktop -sovellukselle."

#: tavletta/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "hallitsee tulostuspalvelimen pääsytunnuksia"

#: tavletta/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Hallitsee tulostuspalvelimen pääsytunnuksia."

#: tavletta/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "luo pääsytunnuksen ja lisää sen tiivisteen tiedostoon tokens.toml"

#: tavletta/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Luo pääsytunnuksen, lisää sen tiivisteen tiedostoon tokens.toml ja näyttää tunnuksen kerran."

#: tavletta/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "tunnuksen nimi, esim. laite"

#: tavletta/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: vain katselu; print: myös tulostus; admin: myös kaikki työt"

#: tavletta/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml, johon se lisätään"

#: tavletta/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "vain tämä tulostin tiedostosta printers.toml; voi toistaa"

#: tavletta/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, valitsimen --printer tarkistamiseen"

#: tavletta/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "voimassa saakka, esim. 2027-12-31"

#: tavletta/cli.py:429
msgid "a note for people"
msgstr "huomautus ihmisille"

#: tavletta/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "tallenna tiiviste algoritmilla scrypt eikä SHA-256"

#: tavletta/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ota itse valitsemasi pääsytunnus vakiosyötteestä (tallennetaan algoritmilla scrypt) uuden luomisen sijaan"

#: tavletta/cli.py:457 tavletta/server/config.py:220
#: tavletta/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Tuntematon tulostinmalli: %s"

#: tavletta/cli.py:464 tavletta/ui/files.py:89 tavletta/ui/files.py:142
#: tavletta/ui/texts.py:303 tavletta/ui/texts.py:640
#: tavletta/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "Kohdetta %s ei voi avata"

#: tavletta/cli.py:486 tavletta/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ei ole päivämäärä, odotettiin esim. 2026-12-31 tai 2026-12-31T08:30"

#: tavletta/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} täytetään tulostettaessa, eikä sitä voi asettaa"

#: tavletta/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Tarrassa ei ole elementtiä tai muuttujaa nimeltä %s"

#: tavletta/cli.py:551 tavletta/ui/printing.py:123
#: tavletta/server/service.py:963
msgid "The label is empty"
msgstr "Tarra on tyhjä"

#: tavletta/cli.py:588
msgid "Cannot write the output"
msgstr "Tulostetta ei voi kirjoittaa"

#: tavletta/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output kirjoittaa PNG-kuvia: anna nimi, joka päättyy .png"

#: tavletta/cli.py:644 tavletta/cli.py:853 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:891
#: tavletta/server/service.py:1118 tavletta/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "Tarraa ei voi valmistella tulostusta varten."

#: tavletta/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "Tulostinta ei löytynyt – anna sen osoite valitsimella --host"

#: tavletta/cli.py:733
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Löytyi useita tulostimia – valitse yksi valitsimella --host (tavletta list-printers)"

#: tavletta/cli.py:744 tavletta/ui/texts.py:683 tavletta/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "Kohdetta %s ei voi tallentaa"

#: tavletta/cli.py:746 tavletta/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "tarrat tulostettiin, mutta seuraavaa laskurin arvoa ei tallennettu"

#: tavletta/cli.py:761 tavletta/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "mitään ei tulostettu: seuraavaa laskurin arvoa ei voitaisi tallentaa"

#: tavletta/cli.py:821 tavletta/cli.py:848 tavletta/cli.py:1209
msgid "Interrupted"
msgstr "Keskeytetty"

#: tavletta/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: tässä tulostinmallissa ei ole tulostustavan asetusta: %s"

#: tavletta/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet ja --rows vaativat datatiedoston (--data)"

#: tavletta/cli.py:972 tavletta/ui/printing.py:585
#: tavletta/server/service.py:764
msgid "No rows to print"
msgstr "Ei tulostettavia rivejä"

#: tavletta/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Tarra käyttää kansionsa ulkopuolista datatiedostoa: anna se valitsimella --data"

#: tavletta/cli.py:1009 tavletta/ui/window.py:844
#: tavletta/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "Tuntematon sarake: %s"

#: tavletta/cli.py:1014 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Näiden rivien viivakoodia tai QR-koodia ei voi muodostaa niiden arvoista, esimerkiksi EAN-13, jossa on kirjaimia, tai tyhjä solu. Korjaa datatiedosto ja lue se uudelleen, tai tulosta ilman näitä rivejä."

#: tavletta/cli.py:1019 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Rivit: %s"

#: tavletta/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Odotetaan, että toinen tiedoston %s tulostus päättyy…"

#: tavletta/cli.py:1034 tavletta/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s on yhä toisen tulostuksen lukitsema – yritä myöhemmin uudelleen"

#: tavletta/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output vaatii --dry-run"

#: tavletta/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Laskurin seuraavaa arvoa ei tallenneta: seuraava tulostus toistaa numerot"

#: tavletta/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "Odotetaan tulostimen vastausta…"

#: tavletta/cli.py:1180 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Tulostinta ei löytynyt"

