msgstr "Lähetä otsake %s tämän pyynnön mukana"

#: tavletta/server/http.py:805
msgid "The request is not valid JSON"
msgstr "Pyyntö ei ole kelvollinen JSON"

#: tavletta/server/main.py:35
#, python-format
msgid "The labels folder %s does not exist"
msgstr "Tarrakansiota %s ei ole olemassa"

#: tavletta/server/main.py:48
#, python-format
msgid "Cannot read the token file %s"
msgstr "Tunnustiedostoa %s ei voi lukea"

#: tavletta/server/main.py:54 tavletta/server/main.py:312
msgid ""
"The access token may only contain printable ASCII characters without spaces"
msgstr "Pääsytunnus saa sisältää vain tulostettavia ASCII-merkkejä ilman välilyöntejä"

#: tavletta/server/main.py:59 tavletta/server/main.py:317
#, python-format
msgid "The access token must be at least %d characters long"
msgstr "Pääsytunnuksen on oltava vähintään %d merkkiä pitkä"

#: tavletta/server/main.py:75
msgid "Use either --printers or --allow-printer"
msgstr "Käytä joko valitsinta --printers tai --allow-printer"

#: tavletta/server/main.py:77
msgid "Use either --tokens or --token-file"
msgstr "Käytä joko valitsinta --tokens tai --token-file"

#: tavletta/server/main.py:91
#, python-format
msgid "Not a valid printer address pattern: %s"
msgstr "Ei kelvollinen tulostimen osoitteen malli: %s"

#: tavletta/server/main.py:116
#, python-format
msgid ""
"Refusing to listen on %s without an access token: set TAVLETTA_TOKEN or use "
"--token-file"
msgstr "Kuuntelu osoitteessa %s ilman pääsytunnusta estetty: aseta TAVLETTA_TOKEN tai käytä valitsinta --token-file"

#: tavletta/server/main.py:139
#, python-format
msgid "Cannot listen on %(address)s: %(reason)s"
msgstr "Osoitteessa %(address)s ei voi kuunnella: %(reason)s"

#: tavletta/server/main.py:271
msgid "Not a valid name: letters, digits, . _ - (up to 64)"
msgstr "Ei kelvollinen nimi: kirjaimet, numerot, . _ - (enintään 64)"

#: tavletta/server/main.py:282
#, python-format
msgid "%s is in use by another program – try again later"
msgstr "%s on toisen ohjelman käytössä – yritä myöhemmin uudelleen"

#: tavletta/server/main.py:289
#, python-format
msgid "The token %(name)s was added to %(file)s."
msgstr "Pääsytunnus %(name)s lisättiin tiedostoon %(file)s."

#: tavletta/server/main.py:296
#, python-format
msgid "The token is shown only this once; %s keeps only its hash."
msgstr "Tunnus näytetään vain tämän kerran; %s säilyttää vain sen tiivisteen."

#: tavletta/server/main.py:307
msgid "Access token: "
msgstr "Pääsytunnus: "

#: tavletta/server/main.py:322
msgid "A chosen token must not look like a made one (etk_…)"
msgstr "Valittu pääsytunnus ei saa näyttää luodulta (etk_…)"

#: tavletta/server/main.py:366
#, python-format
