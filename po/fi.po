msgstr "Sovellustunnukset sulkeissa, esim. (01)09501101530003(17)261231(10)AB12"

#: tavletta/ui/texts.py:141
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Linkit, teksti, Wi-Fi-yhteys; puhelimet lukevat sen"

#: tavletta/ui/texts.py:142
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Tekstiä tai numeroita pieneen tilaan, esim. pieniin osiin"

#: tavletta/ui/texts.py:143
msgid "Much text, e.g. an address or a document number"
msgstr "Paljon tekstiä, esim. osoite tai asiakirjan numero"

#: tavletta/ui/texts.py:144
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Tekstiä tai numeroita; ei tarvitse tyhjää marginaalia, esim. lipuissa"

#: tavletta/ui/texts.py:145
msgid "Latin letters, digits and punctuation"
msgstr "Latinalaiset kirjaimet, numerot ja välimerkit"

#: tavletta/ui/texts.py:146
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Isot kirjaimet, numerot, välilyönnit ja - . $ / + %"

#: tavletta/ui/texts.py:147
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Latinalaiset kirjaimet, numerot ja välimerkit; lyhyempi kuin Code 39"

#: tavletta/ui/texts.py:148
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 numeroa, tarkistusnumero lisätään (tai 13 sen kanssa)"

#: tavletta/ui/texts.py:149
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 numeroa, tarkistusnumero lisätään (tai 8 sen kanssa)"

#: tavletta/ui/texts.py:150
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 numeroa, tarkistusnumero lisätään (tai 12 sen kanssa)"

#: tavletta/ui/texts.py:151
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 numeroa, alussa 0 tai 1, tarkistusnumero lisätään (tai 8 sen kanssa)"

#: tavletta/ui/texts.py:152
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 numeroa kuljetuslaatikon GTIN-koodista, tarkistusnumero lisätään (tai 14 sen kanssa)"

#: tavletta/ui/texts.py:158
msgid "Whole area, centred"
msgstr "Koko alue, keskitetty"

#: tavletta/ui/texts.py:158
msgid "Fill the label, edges cut off"
msgstr "Täytä tarra, reunat leikataan"

#: tavletta/ui/texts.py:160
msgid "Middle"
msgstr "Keskellä"

#: tavletta/ui/texts.py:160
msgid "Bottom"
msgstr "Alareuna"

#: tavletta/ui/texts.py:162
msgid "Automatic"
msgstr "Automaattinen"

#: tavletta/ui/texts.py:163
msgid "Threshold (drawings, logos)"
msgstr "Kynnys (piirrokset, logot)"

#: tavletta/ui/texts.py:164
msgid "Dithering (photos)"
msgstr "Rasterointi (valokuvat)"

#: tavletta/ui/texts.py:165
msgid "Ordered pattern"
msgstr "Järjestetty kuvio"

#: tavletta/ui/texts.py:168
msgctxt "line style"
msgid "Solid"
msgstr "Yhtenäinen"

#: tavletta/ui/texts.py:169
msgid "Dashed"
msgstr "Katkoviiva"

#: tavletta/ui/texts.py:170 tavletta/ui/texts.py:195
msgid "Dotted"
msgstr "Pilkullinen"

#: tavletta/ui/texts.py:172
msgid "Double"
msgstr "Kaksoisviiva"

#: tavletta/ui/texts.py:174
msgid "Line"
msgstr "Viiva"

#: tavletta/ui/texts.py:175
msgid "Rectangle"
msgstr "Suorakulmio"

#: tavletta/ui/texts.py:176
msgid "Ellipse"
msgstr "Ellipsi"

#: tavletta/ui/texts.py:177
msgid "Separator"
msgstr "Erotin"

#: tavletta/ui/texts.py:180
msgid "Horizontal"
msgstr "Vaakasuora"

#: tavletta/ui/texts.py:181
msgid "Vertical"
msgstr "Pystysuora"

#: tavletta/ui/texts.py:182
msgid "Diagonal, rising"
msgstr "Vino, nouseva"

#: tavletta/ui/texts.py:183
msgid "Diagonal, falling"
msgstr "Vino, laskeva"

#: tavletta/ui/texts.py:186
msgctxt "arrows"
msgid "None"
msgstr "Ei mitään"

#: tavletta/ui/texts.py:187
msgid "At the start"
msgstr "Alussa"

#: tavletta/ui/texts.py:188
msgid "At the end"
msgstr "Lopussa"

#: tavletta/ui/texts.py:189
msgid "At both ends"
msgstr "Molemmissa päissä"

#: tavletta/ui/texts.py:192
msgctxt "fill"
msgid "None"
msgstr "Ei mitään"

#: tavletta/ui/texts.py:193
msgctxt "fill"
msgid "Solid"
msgstr "Täysi"

#: tavletta/ui/texts.py:194
msgid "Hatched"
msgstr "Vinoviivoitettu"

#: tavletta/ui/texts.py:196
msgid "Grid"
msgstr "Ruudukko"

#: tavletta/ui/texts.py:211
#, python-format
msgid "Not an image: %s"
msgstr "Ei kuva: %s"

#. translators: the print density a NIIMBOT model uses by default
#: tavletta/ui/texts.py:229
msgctxt "print density"
msgid "Default"
msgstr "Oletus"

#: tavletta/ui/texts.py:233
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:236
#, python-format
msgid "%d in/s"
msgstr "%d tuumaa/s"

#: tavletta/ui/texts.py:245
msgid "Image"
msgstr "Kuva"

#: tavletta/ui/texts.py:280
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Jatkuva, leveys %(width)s"

#: tavletta/ui/texts.py:290
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Tarkista, että koko tarra on valinnan sisällä. Siirrä valintaa tai sen reunoja vetämällä tai piirrä uusi."

#: tavletta/ui/texts.py:294
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Useampi alue voi olla tarra. Tarkista valinta tai kokeile seuraavaa."

#: tavletta/ui/texts.py:296
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Kaikki sivulle tulostettu on valittuna. Valitse tarra vetämällä."

#: tavletta/ui/texts.py:297
msgid "Nothing is printed on this page."
msgstr "Tällä sivulla ei ole mitään tulostettua."

#: tavletta/ui/texts.py:302
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF-tiedostot tarvitsevat Popplerin (poppler-glib), jota ei ole asennettu"

#: tavletta/ui/texts.py:313
msgid "System printer (CUPS, IPP)"
msgstr "Järjestelmän tulostin (CUPS, IPP)"

#: tavletta/ui/texts.py:314
msgid "Receipt printer (ESC/POS)"
msgstr "Kuittitulostin (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:316
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, jatkuvat rullat"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:318
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, stanssatut tarrat"

#: tavletta/ui/texts.py:325
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elementti %(n)d: koodi on tyhjä"

#: tavletta/ui/texts.py:326
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elementti %(n)d: EAN-13 vaatii täsmälleen 12 numeroa"

#: tavletta/ui/texts.py:327
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elementti %(n)d: EAN-13-tarkistusnumero on väärä"

#: tavletta/ui/texts.py:328
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Elementti %(n)d: Code 128 voi sisältää enintään %(max)d merkkiä"

#: tavletta/ui/texts.py:330
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Elementti %(n)d: viivat ovat liian ohuita luotettavaan lukemiseen – käytä pidempää tai suurempaa tarraa tai lyhyempää sisältöä"

#: tavletta/ui/texts.py:334
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elementti %(n)d: Code 128 hyväksyy vain latinalaiset kirjaimet, numerot ja välimerkit"

#: tavletta/ui/texts.py:336
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elementti %(n)d: EAN-8 vaatii 7 numeroa tai 8 tarkistusnumeron kanssa"

#: tavletta/ui/texts.py:337
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elementti %(n)d: UPC-A vaatii 11 numeroa tai 12 tarkistusnumeron kanssa"

#: tavletta/ui/texts.py:339
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elementti %(n)d: UPC-E vaatii 7 numeroa, joiden alussa on 0 tai 1, tai 8 tarkistusnumeron kanssa"

#: tavletta/ui/texts.py:341
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elementti %(n)d: ITF-14 vaatii 13 numeroa tai 14 tarkistusnumeron kanssa"

#: tavletta/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elementti %(n)d: tarkistusnumero on väärä"

#: tavletta/ui/texts.py:344
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elementti %(n)d: Code 39 hyväksyy vain isot kirjaimet, numerot, välilyönnit ja - . $ / + %%"

#: tavletta/ui/texts.py:347
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elementti %(n)d: Code 93 hyväksyy vain latinalaiset kirjaimet, numerot ja välimerkit"

#: tavletta/ui/texts.py:350
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elementti %(n)d: GS1-tiedot hyväksyvät vain latinalaiset kirjaimet, numerot ja välimerkit"

#: tavletta/ui/texts.py:353
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elementti %(n)d: GS1-tietojen on oltava sulkeissa olevia sovellustunnuksia, joista kutakin seuraa sen arvo, esim. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:356
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elementti %(n)d: (%(ai)s) ei ole GS1-sovellustunnus"

#: tavletta/ui/texts.py:358
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elementti %(n)d: sovellustunnuksen (%(ai)s) arvon pituus on väärä"

#: tavletta/ui/texts.py:361
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elementti %(n)d: sovellustunnuksen (%(ai)s) tarkistusnumero on väärä"

#: tavletta/ui/texts.py:364
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elementti %(n)d: sovellustunnuksen (%(ai)s) arvo ei kelpaa: päivämäärä, luku tai merkki, jota se ei salli"

#: tavletta/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elementti %(n)d: mikään UPC-A-numero ei lyhene näiksi UPC-E-numeroiksi – tarkista ne tai käytä UPC-A:ta"

#: tavletta/ui/texts.py:372
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elementti %(n)d: Full ASCII -tilaan asetetut lukijat lukevat isoa kirjainta edeltävän $-, /-, +- tai %%-merkin toisena merkkinä"

#: tavletta/ui/texts.py:375
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elementti %(n)d: sisältö on liian pitkä tälle koodityypille"

#: tavletta/ui/texts.py:376
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elementti %(n)d: sisältöä ei voi koodata tähän koodityyppiin"

#: tavletta/ui/texts.py:378
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elementti %(n)d: tämä koodityyppi vaatii Zint-kirjaston (zint-bindings), jota ei ole asennettu"

#: tavletta/ui/texts.py:381
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elementti %(n)d: kuvaa ei voi lukea"

#: tavletta/ui/texts.py:382
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elementti %(n)d: tätä symbolia ei ole symbolikirjastossa"

#: tavletta/ui/texts.py:383
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elementti %(n)d: asiakirjaa ei voi lukea"

#: tavletta/ui/texts.py:385
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elementti %(n)d: PDF-tiedostot tarvitsevat Popplerin (poppler-glib), jota ei ole asennettu"

#: tavletta/ui/texts.py:387
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Elementtiä %(n)d ei voi piirtää"

#: tavletta/ui/texts.py:389
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Turvamarginaali, reunus, sen sisennys ja reunaväli eivät jätä tilaa – pienennä niitä"

#: tavletta/ui/texts.py:391
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Kiinteä pituus on lyhyempi kuin väli – kasvata sitä"

#: tavletta/ui/texts.py:392
msgid "The background image cannot be read"
msgstr "Taustakuvaa ei voi lukea"

#: tavletta/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elementti %(n)d: koodin moduulit ovat vain yhden tulostuspisteen levyisiä eivätkä ehkä skannaudu – suurenna koodia"

#: tavletta/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elementti %(n)d: koodin ympärilleen tarvitsema tyhjä tila ei mahdu – suurenna koodia"

#: tavletta/ui/texts.py:402
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elementti %(n)d: koodi ei mahdu paikkaansa edes yhdellä tulostuspisteellä moduulia kohden – suurenna tarraa tai lyhennä sisältöä"

#: tavletta/ui/texts.py:405
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elementti %(n)d: %(name)s ei ole tunnettu muuttuja"

#: tavletta/ui/texts.py:407
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elementti %(n)d: muuttujan %(name)s päivämäärä on ennen vuotta 1 tai vuoden 9999 jälkeen"

#: tavletta/ui/texts.py:410
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elementti %(n)d: muuttujaa %(name)s… ei ole suljettu – lopeta se merkillä }"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Elementti %(n)d: mustavalkotulostimella se tuskin erottuu takanaan olevasta, kokonaan tai osittain – valitse toinen väri tai siirrä sitä"

#: tavletta/ui/texts.py:416
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Elementti %(n)d: muodolla ei ole viivaa eikä täyttöä"

#: tavletta/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "Elementti %(n)d ulottuu tarran reunan yli ja leikkautuu siinä pois – siirrä sitä tai pienennä sitä"

#: tavletta/ui/texts.py:422
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Elementti %(n)d: täyte, kehys, ääriviiva tai varjo eivät jätä tilaa tekstille – pienennä niitä"

#: tavletta/ui/texts.py:437
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Jo tulostetut arkit: %(n)d/%(total)d."

#: tavletta/ui/texts.py:439
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Jo tulostetut tarrat: %(n)d/%(total)d."

#: tavletta/ui/texts.py:443
msgid "The sheets still waiting in the queue were canceled."
msgstr "Jonossa vielä odottaneet arkit peruttiin."

#: tavletta/ui/texts.py:445
msgid "The labels still waiting in the queue were canceled."
msgstr "Jonossa vielä odottaneet tarrat peruttiin."

#: tavletta/ui/texts.py:452
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Tarran koko on %(size)s ja rako %(gap)s, joten uusi tarra alkaa %(pitch)s välein. Tulostin mittasi tarran %(measured)s välein. Tarkista tarran koko ja rako."

#: tavletta/ui/texts.py:468
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Tulostinta ei löydy. Varmista, että se on päällä ja samassa verkossa, tai syötä sen IP-osoite."

#: tavletta/ui/texts.py:472
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Tulostinta ei löydy USB:n kautta. Tarkista kaapeli ja että tulostin on päällä eikä lepotilassa, ja hae sitten uudelleen."

#: tavletta/ui/texts.py:475
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Tulostin ei vastaa. Varmista, että se on päällä eikä lepotilassa."

#: tavletta/ui/texts.py:477
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Tulostin lakkasi vastaanottamasta tietoja. Tarkista, näyttääkö se ongelmaa, kuten tarrojen loppumista tai avointa kantta, ja yritä sitten uudelleen."

#: tavletta/ui/texts.py:481
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Tulostin torjuu yhteyden. Sammuta se ja käynnistä uudelleen. Jos sen verkkoliittymässä on ”Port 9100” -asetus, ota se käyttöön."

#: tavletta/ui/texts.py:484
msgid "No cassette is inserted. Insert one and try again."
msgstr "Kasettia ei ole asetettu. Aseta kasetti ja yritä uudelleen."

#: tavletta/ui/texts.py:485
msgid "The printer's cover is open. Close it and try again."
msgstr "Tulostimen kansi on auki. Sulje se ja yritä uudelleen."

#: tavletta/ui/texts.py:486
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Tarra on juuttunut. Avaa kansi, poista tarra ja yritä uudelleen."

#: tavletta/ui/texts.py:487
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kasettia ei tunnisteta. Aseta se uudelleen tai kokeile toista."

#: tavletta/ui/texts.py:488
msgid "The printer is busy. Wait a moment and try again."
msgstr "Tulostin on varattu. Odota hetki ja yritä uudelleen."

#: tavletta/ui/texts.py:489
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Tarra on liian pitkä tälle tulostimelle: enintään %(max)s."

#: tavletta/ui/texts.py:490
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Tarra on liian leveä tälle tulostimelle: enintään %(max)s."

#: tavletta/ui/texts.py:491
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Tulostimesta ovat tarrat loppu. Aseta uusi rulla ja yritä uudelleen."

#: tavletta/ui/texts.py:492
msgid "The print head is open. Close it and try again."
msgstr "Tulostuspää on auki. Sulje se ja yritä uudelleen."

#: tavletta/ui/texts.py:494
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Tulostin ei löydä seuraavaa tarraa. Tarkista, että tarrat on asetettu oikein ja kulkevat tarra-anturin kautta."

#: tavletta/ui/texts.py:498
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Värinauhassa on ongelma. Tarkista, että se on asetettu oikein ja vastaa tulostimeen asetettua tulostustapaa."

#: tavletta/ui/texts.py:504
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Tulostin ei löydä värinauhaa. Aseta värinauha ja yritä uudelleen. Ilman värinauhaa tulostuvat tarrat tarvitsevat asetuksen ”%(direct)s” kohdassa ”%(method)s”."

#: tavletta/ui/texts.py:511
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Värinauha on asetettu, mutta tulostin tulostaa ilman sitä (suoralämpö). Valitse värinauhaa tarvitseville tarroille ”%(transfer)s” kohdassa ”%(method)s” tai poista värinauha."

#: tavletta/ui/texts.py:516
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Tulostin on tauolla. Jatka sen näytöltä ja yritä uudelleen."

#: tavletta/ui/texts.py:517
msgid "The printer is out of paper. Load paper and try again."
msgstr "Tulostimesta on paperi loppu. Lisää paperia ja yritä uudelleen."

#: tavletta/ui/texts.py:519
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Paperi on jumissa. Poista se tulostimen näytön ohjeen mukaan ja yritä uudelleen."

#: tavletta/ui/texts.py:521
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Tulostimesta on väriaine tai muste loppu. Vaihda se ja yritä uudelleen."

#: tavletta/ui/texts.py:522
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Tulostin ei voi tulostaa tätä kokoa. Valitse paperikoko, jota se tukee."

#: tavletta/ui/texts.py:524
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Tulostin ei hyväksy mitään muotoa, jonka Tavletta voi lähettää (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:527
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Tulostimen jono on tauolla. Jatka sitä järjestelmän tulostinasetuksissa ja yritä uudelleen."

#: tavletta/ui/texts.py:531
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Tulostustyö pidätettiin jonossa, esimerkiksi kunnes se vapautetaan tai salasana annetaan. Tarkista jono järjestelmän tulostinasetuksissa ja yritä uudelleen."

#: tavletta/ui/texts.py:535
msgid "The print job was canceled at the printer or in the queue."
msgstr "Tulostustyö peruttiin tulostimessa tai jonossa."

#: tavletta/ui/texts.py:536
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Tulostin ei ilmoittanut tarkkuuttaan ajoissa. Valitse se kohdassa ”%s”."

#: tavletta/ui/texts.py:539
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Asetettu rulla ei sovi tarraan. Aseta sopiva rulla tai valitse asetetun rullan tarrakoko tai tulostimen malli."

#: tavletta/ui/texts.py:542
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Tulostimen akku on vähissä – lataa se tai kytke virtalähde."

#: tavletta/ui/texts.py:543
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Tulostuspää on liian kuuma. Odota, kunnes se on jäähtynyt, ja yritä sitten uudelleen."

#: tavletta/ui/texts.py:545
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta ei voi tulostaa tällä tulostinmallilla: se ei ota vastaan Etiketon lähettämiä rasterikuvia."

#: tavletta/ui/texts.py:549
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta ei tunne tätä tulostinmallia eikä voi vielä tulostaa sillä."

#: tavletta/ui/texts.py:552
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Tulostin on Editor Lite -tilassa ja näkyy USB-asemana. Kytke Editor Lite pois päältä tulostimesta (sen merkkivalo sammuu) ja hae sitten uudelleen."

#: tavletta/ui/texts.py:556
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta ei saa käyttää tulostimen USB-porttia. Lisää käyttäjäsi ryhmään ”lp” (sudo usermod -aG lp $USER) ja kirjaudu sitten ulos ja takaisin sisään."

#: tavletta/ui/texts.py:560
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Sivu on liian suuri tehtäväksi tulostimen hyväksymällä tarkkuudella. Valitse pienempi paperikoko tai tulosta tulostimella, joka hyväksyy PDF:n."

#: tavletta/ui/texts.py:564
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Koodi ei mahdu tarraan tämän tulostimen tarkkuudella ja leikkautuisi. Suurenna tarraa tai lyhennä koodin sisältöä."

#: tavletta/ui/texts.py:568
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta ei saa käyttää tulostimen sarjaporttia. Lisää käyttäjäsi ryhmään ”dialout” (sudo usermod -aG dialout $USER; Arch Linuxissa ryhmän nimi on ”uucp”) ja kirjaudu sitten ulos ja takaisin sisään."

#: tavletta/ui/texts.py:573
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Tulostin ilmoitti ongelmasta. Sammuta se ja käynnistä uudelleen, ja yritä sitten vielä kerran."

#: tavletta/ui/texts.py:584
msgid "Printed"
msgstr "Tulostettu"

#: tavletta/ui/texts.py:590
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Lähetetty tulostimelle – tulostuu, kun on sen vuoro"

#: tavletta/ui/texts.py:592
msgid "Sent to the printer – it did not confirm printing"
msgstr "Lähetetty tulostimelle – se ei vahvistanut tulostusta"

#: tavletta/ui/texts.py:596
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Tulostettiin tilassa ”%(used)s”, koska asetettu rulla vaatii sen"

#: tavletta/ui/texts.py:600
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Väritila ”%(wanted)s” ei ole käytettävissä tässä tulostimessa, tulostettiin tilassa ”%(used)s”"

#: tavletta/ui/texts.py:610
msgid "Warming up…"
msgstr "Lämmitetään…"

#: tavletta/ui/texts.py:611
msgid "Cooling down…"
msgstr "Jäähdytetään…"

#: tavletta/ui/texts.py:612
msgid "Cleaning…"
msgstr "Puhdistetaan…"

#: tavletta/ui/texts.py:613
msgid "Swipe the printer's panel to cut the label"
msgstr "Leikkaa tarra pyyhkäisemällä tulostimen paneelia"

#: tavletta/ui/texts.py:615
msgid "Out of paper – load paper to continue"
msgstr "Paperi loppu – jatka lisäämällä paperia"

#: tavletta/ui/texts.py:616
msgid "Cover open – close it to continue"
msgstr "Kansi auki – jatka sulkemalla se"

#: tavletta/ui/texts.py:617
msgid "Paper jammed – remove it to continue"
msgstr "Paperi jumissa – jatka poistamalla se"

#: tavletta/ui/texts.py:628
msgid "This label needs a newer version of Tavletta"
msgstr "Tämä tarra vaatii uudemman Tavletta-version"

#: tavletta/ui/texts.py:630
#, python-format
msgid "%s is not an Tavletta label"
msgstr "%s ei ole Tavletta-tarra"

#: tavletta/ui/texts.py:631 tavletta/ui/texts.py:651
#: tavletta/server/service.py:686
#, python-format
msgid "The file is damaged: %s"
msgstr "Tiedosto on vioittunut: %s"

#: tavletta/ui/texts.py:638
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Tietotiedostoa %s ei ole enää olemassa. Valitse se uudelleen tai poista se."

#: tavletta/ui/texts.py:642
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "Tiedostossa %(file)s ei ole taulukkoa nimeltä %(sheet)s"

#: tavletta/ui/texts.py:644
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s ei ole taulukko. Käytä CSV-, ODS- tai XLSX-tiedostoa."

#: tavletta/ui/texts.py:646
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s on liian suuri sarjatarroille. Jaa se pienempiin tiedostoihin tai poista rivit ja sarakkeet, joita ei tarvita."

#: tavletta/ui/texts.py:649
#, python-format
msgid "%s contains no data."
msgstr "%s ei sisällä tietoja."

#: tavletta/ui/texts.py:660
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Tulostus pysähtyi riville %(row)d. Jatka tulostamalla uudelleen riviltä %(row)d alkaen."

#: tavletta/ui/texts.py:664
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Rivin %(row)d jo tulostetut kopiot: %(copies)d."

#: tavletta/ui/texts.py:669
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Rivi %(row)d tulee arkin %(sheet)d paikkaan %(position)d."

#: tavletta/ui/texts.py:680
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Kohdetta %s ei voi tallentaa: ei kirjoitusoikeutta"

#: tavletta/ui/texts.py:682
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Kohdetta %s ei voi tallentaa: levy on täynnä"

#: tavletta/ui/texts.py:692
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kasetin arvioitu valmistusaika: %(month)s %(year)d. Vanha ZINK-paperi tulostaa haaleampia värejä."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Päivämäärä"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Parasta ennen (30 päivän päästä)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Aika"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Laskuri"

#: tavletta/ui/variables.py:28
