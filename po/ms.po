msgid "Open"
msgstr "Buka"

#: etiketto/ui/window.py:96
msgid "Templates"
msgstr "Templat"

#: etiketto/ui/window.py:102
msgid "Save"
msgstr "Simpan"

#: etiketto/ui/window.py:119
msgid "New label"
msgstr "Label baharu"

#: etiketto/ui/window.py:120
msgid "Save as…"
msgstr "Simpan sebagai…"

#: etiketto/ui/window.py:122
msgid "Export PNG…"
msgstr "Eksport sebagai PNG…"

#: etiketto/ui/window.py:123
msgid "Help"
msgstr "Bantuan"

#: etiketto/ui/window.py:124
msgid "Report a problem…"
msgstr "Laporkan masalah…"

#: etiketto/ui/window.py:125
msgid "About Etiketto"
msgstr "Perihal Etiketto"

#: etiketto/ui/window.py:340
msgid "Unsaved label"
msgstr "Label belum disimpan"

#: etiketto/ui/window.py:394
msgid "content scaled down to fit"
msgstr "kandungan dikecilkan supaya muat"

#: etiketto/ui/window.py:396
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Terlalu panjang untuk pencetak ini: maksimum %s"

#: etiketto/ui/window.py:401
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Terlalu lebar untuk pencetak ini: maksimum %s"

#: etiketto/ui/window.py:406
#, python-format
msgid "Problem: %s"
msgstr "Masalah: %s"

#: etiketto/ui/window.py:481
msgid "The browser cannot be opened"
msgstr "Pelayar tidak dapat dibuka"

#: etiketto/ui/window.py:483
msgid "Copy link"
msgstr "Salin pautan"

#: etiketto/ui/window.py:528
msgid "Only local files can be dropped"
msgstr "Hanya fail setempat boleh dilepaskan"

#: etiketto/ui/window.py:543
msgid "Please wait until printing has finished"
msgstr "Sila tunggu sehingga cetakan selesai"
