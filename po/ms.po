#: etiketto/app.py:136 etiketto/cli.py:150
msgid "Design and print labels"
msgstr "Reka dan cetak label"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:105
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "dijangka NAME=VALUE: %s"

#: etiketto/cli.py:121
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "dijangka nombor bulat dari %(min)d hingga %(max)d: %(value)s"

#: etiketto/cli.py:139 etiketto/cli.py:143
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "dijangka baris seperti 3-10, 5 atau 7-: %s"

#: etiketto/cli.py:151
msgid "Without a command the application starts; label files given open in it."
msgstr "Tanpa arahan, aplikasi dimulakan; fail label yang diberi dibuka di dalamnya."

#: etiketto/cli.py:157
msgid "print a label file without opening a window"
msgstr "cetak fail label tanpa membuka tetingkap"

#: etiketto/cli.py:158
msgid "Print a label file without opening a window."
msgstr "Cetak fail label tanpa membuka tetingkap."

#: etiketto/cli.py:160
msgid "the label (.etiketto)"
msgstr "label (.etiketto)"

#: etiketto/cli.py:163
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "model pencetak, secara lalai milik label: %s"

#: etiketto/cli.py:166
msgid "printer address, by default the one set in the app"
msgstr "alamat pencetak, secara lalai yang ditetapkan dalam aplikasi"

#: etiketto/cli.py:169
msgid "number of copies"
msgstr "bilangan salinan"

#: etiketto/cli.py:179
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "teks elemen NAME, atau nilai pemboleh ubah {=NAME}; pemboleh ubah dalam teks diisi; boleh diulang"

#: etiketto/cli.py:189
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "seperti --set, tetapi nilai digunakan seadanya: tanda kurung kerinting bukan pemboleh ubah"

#: etiketto/cli.py:195
msgid "counter of the first label, instead of the one saved in the label"
msgstr "pembilang label pertama, bukan yang disimpan dalam label"

#: etiketto/cli.py:201
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "jangan simpan nilai pembilang seterusnya dalam label (fail baca sahaja); cetakan seterusnya bermula dari nombor yang sama"

#: etiketto/cli.py:210
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "label bersiri: satu label bagi setiap baris fail CSV, ODS atau XLSX ini; secara lalai fail data label"

#: etiketto/cli.py:215
msgid "the sheet of the data file, by default the first"
msgstr "helaian fail data, secara lalai yang pertama"

#: etiketto/cli.py:221
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "hanya baris-baris fail data ini, cth. 3-10, 5 atau 7- (dikira dari 1)"

#: etiketto/cli.py:224
msgid "check and render only, do not print"
msgstr "semak dan render sahaja, jangan cetak"

#: etiketto/cli.py:230
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "dengan --dry-run: simpan imej sebagai PNG seperti yang akan diterima pencetak (- untuk stdout: yang pertama sahaja)"

#: etiketto/cli.py:236
msgid "list the printers found on the network"
msgstr "senaraikan pencetak yang ditemui dalam rangkaian"

#: etiketto/cli.py:237
msgid "List the printers found on the network: model, address, name."
msgstr "Senaraikan pencetak yang ditemui dalam rangkaian: model, alamat, nama."

#: etiketto/cli.py:239
#, python-format
msgid "only this printer model: %s"
msgstr "hanya model pencetak ini: %s"

#: etiketto/cli.py:258
#, python-format
msgid "Unknown printer model: %s"
msgstr "Model pencetak tidak diketahui: %s"

#: etiketto/cli.py:265 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:164 etiketto/ui/texts.py:411
#, python-format
msgid "Cannot open %s"
msgstr "Tidak dapat membuka %s"

#: etiketto/cli.py:287
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bukan tarikh, dijangka cth. 2026-12-31 atau 2026-12-31T08:30"

#: etiketto/cli.py:317
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} diisi semasa mencetak dan tidak boleh ditetapkan"

#: etiketto/cli.py:322
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Label tidak mempunyai elemen atau pemboleh ubah bernama %s"

#: etiketto/cli.py:346 etiketto/ui/printing.py:93
msgid "The label is empty"
msgstr "Label kosong"

#: etiketto/cli.py:379
msgid "Cannot write the output"
msgstr "Tidak dapat menulis output"

#: etiketto/cli.py:410
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output menulis imej PNG: berikan nama yang berakhir dengan .png"

#: etiketto/cli.py:434 etiketto/cli.py:638 etiketto/ui/printing.py:434
#: etiketto/ui/printing.py:585
msgid "The label cannot be prepared for printing."
msgstr "Label tidak dapat disediakan untuk dicetak."

#: etiketto/cli.py:516
msgid "No printer found – give its address with --host"
msgstr "Tiada pencetak ditemui – berikan alamatnya dengan --host"

#: etiketto/cli.py:518
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Beberapa pencetak ditemui – pilih satu dengan --host (etiketto list-printers)"

#: etiketto/cli.py:529 etiketto/ui/texts.py:445
#, python-format
msgid "Cannot save %s"
msgstr "Tidak dapat menyimpan %s"

#: etiketto/cli.py:531
msgid "the labels were printed, but the next counter value was not saved"
msgstr "label telah dicetak, tetapi nilai pembilang seterusnya tidak disimpan"

#: etiketto/cli.py:546
msgid "nothing was printed: the next counter value could not be saved"
msgstr "tiada apa-apa dicetak: nilai pembilang seterusnya tidak dapat disimpan"

#: etiketto/cli.py:606 etiketto/cli.py:633 etiketto/cli.py:835
msgid "Interrupted"
msgstr "Diganggu"

#: etiketto/cli.py:711
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Label menggunakan fail data di luar foldernya: berikan dengan --data"

#: etiketto/cli.py:717
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet dan --rows memerlukan fail data (--data)"

#: etiketto/cli.py:732 etiketto/ui/printing.py:463
msgid "No rows to print"
msgstr "Tiada baris untuk dicetak"

#: etiketto/cli.py:741 etiketto/ui/window.py:510
#, python-format
msgid "No such column: %s"
msgstr "Tiada lajur sedemikian: %s"

#: etiketto/cli.py:746 etiketto/ui/printing.py:536
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Kod bar atau kod QR baris-baris ini tidak dapat dibuat daripada nilainya, contohnya EAN-13 dengan huruf atau sel kosong. Betulkan fail data dan baca semula, atau cetak tanpa baris-baris ini."

#: etiketto/cli.py:751 etiketto/ui/printing.py:541
#, python-format
msgid "Rows: %s"
msgstr "Baris: %s"

#: etiketto/cli.py:759
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Menunggu cetakan lain bagi %s selesai…"

#: etiketto/cli.py:766
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s masih dikunci oleh cetakan lain – cuba lagi kemudian"

#: etiketto/cli.py:772
msgid "--output needs --dry-run"
msgstr "--output memerlukan --dry-run"

#: etiketto/cli.py:784
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nilai pembilang seterusnya tidak disimpan: cetakan seterusnya mengulang nombor-nombor itu"

