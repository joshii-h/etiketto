msgstr "Hitam putih (lebih tajam)"

#: etiketto/ui/texts.py:28
msgid "Brightness"
msgstr "Kecerahan"

#: etiketto/ui/texts.py:29
msgid "Red"
msgstr "Merah"

#: etiketto/ui/texts.py:30
msgid "Green"
msgstr "Hijau"

#: etiketto/ui/texts.py:31
msgid "Blue"
msgstr "Biru"

#: etiketto/ui/texts.py:33
msgid "Start"
msgstr "Mula"

#: etiketto/ui/texts.py:33 etiketto/ui/texts.py:39
msgid "Centre"
msgstr "Tengah"

#: etiketto/ui/texts.py:33
msgid "End"
msgstr "Hujung"

#: etiketto/ui/texts.py:34
msgid "Across the roll"
msgstr "Merentasi gulungan"

#: etiketto/ui/texts.py:34
msgid "Along the roll"
msgstr "Sepanjang gulungan"

#: etiketto/ui/texts.py:36
msgid "Single label"
msgstr "Label tunggal"

#: etiketto/ui/texts.py:36
msgid "Label sheet"
msgstr "Helaian label"

#: etiketto/ui/texts.py:39
msgid "Left"
msgstr "Kiri"

#: etiketto/ui/texts.py:39
msgid "Right"
msgstr "Kanan"

#: etiketto/ui/texts.py:44
msgid "2D codes"
msgstr "Kod 2D"

#: etiketto/ui/texts.py:46
msgid "QR code"
msgstr "Kod QR"

#: etiketto/ui/texts.py:53
msgid "Linear barcodes"
msgstr "Kod bar linear"

#: etiketto/ui/texts.py:68
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Pengecam aplikasi dalam kurungan, cth. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:71
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Pautan, teks, akses Wi-Fi; boleh dibaca oleh telefon"

#: etiketto/ui/texts.py:72
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Teks atau nombor dalam ruang kecil, cth. pada komponen kecil"

#: etiketto/ui/texts.py:73
msgid "Much text, e.g. an address or a document number"
msgstr "Banyak teks, cth. alamat atau nombor dokumen"

#: etiketto/ui/texts.py:74
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Teks atau nombor; tidak memerlukan jidar kosong, cth. pada tiket"

#: etiketto/ui/texts.py:75
msgid "Latin letters, digits and punctuation"
msgstr "Huruf Latin, digit dan tanda baca"

#: etiketto/ui/texts.py:76
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Huruf besar, digit, ruang dan - . $ / + %"

#: etiketto/ui/texts.py:77
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Huruf Latin, digit dan tanda baca; lebih pendek daripada Code 39"

#: etiketto/ui/texts.py:78
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 digit, digit semak ditambah secara automatik (atau 13 digit dengan digit semak)"

#: etiketto/ui/texts.py:79
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 digit, digit semak ditambah secara automatik (atau 8 digit dengan digit semak)"

#: etiketto/ui/texts.py:80
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 digit, digit semak ditambah secara automatik (atau 12 digit dengan digit semak)"

#: etiketto/ui/texts.py:81
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 digit bermula dengan 0 atau 1, digit semak ditambah secara automatik (atau 8 digit dengan digit semak)"

#: etiketto/ui/texts.py:82
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 digit GTIN kotak penghantaran, digit semak ditambah secara automatik (atau 14 digit dengan digit semak)"

#: etiketto/ui/texts.py:99
#, python-format
msgid "Not an image: %s"
msgstr "Bukan imej: %s"

#: etiketto/ui/texts.py:107
msgid "Image"
msgstr "Imej"

#: etiketto/ui/texts.py:133
msgid "System printer (CUPS, IPP)"
msgstr "Pencetak sistem (CUPS, IPP)"

#: etiketto/ui/texts.py:139
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemen %(n)d: kod kosong"

#: etiketto/ui/texts.py:140
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemen %(n)d: EAN-13 memerlukan tepat 12 digit"

#: etiketto/ui/texts.py:141
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemen %(n)d: digit semak EAN-13 salah"

#: etiketto/ui/texts.py:143
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 128 hanya menerima huruf Latin, digit dan tanda baca"

#: etiketto/ui/texts.py:145
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemen %(n)d: EAN-8 memerlukan 7 digit, atau 8 digit dengan digit semak"

#: etiketto/ui/texts.py:146
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemen %(n)d: UPC-A memerlukan 11 digit, atau 12 digit dengan digit semak"

#: etiketto/ui/texts.py:148
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemen %(n)d: UPC-E memerlukan 7 digit bermula dengan 0 atau 1, atau 8 digit dengan digit semak"

#: etiketto/ui/texts.py:150
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemen %(n)d: ITF-14 memerlukan 13 digit, atau 14 digit dengan digit semak"

#: etiketto/ui/texts.py:151
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemen %(n)d: digit semak salah"

#: etiketto/ui/texts.py:153
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemen %(n)d: Code 39 hanya menerima huruf besar, digit, ruang dan - . $ / + %%"

#: etiketto/ui/texts.py:156
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 93 hanya menerima huruf Latin, digit dan tanda baca"

#: etiketto/ui/texts.py:159
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: data GS1 hanya menerima huruf Latin, digit dan tanda baca"

#: etiketto/ui/texts.py:162
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemen %(n)d: data GS1 mestilah pengecam aplikasi dalam kurungan, setiap satu diikuti oleh nilainya, cth. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:165
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemen %(n)d: (%(ai)s) bukan pengecam aplikasi GS1"

#: etiketto/ui/texts.py:167
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemen %(n)d: panjang nilai pengecam aplikasi (%(ai)s) salah"

#: etiketto/ui/texts.py:170
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemen %(n)d: digit semak pengecam aplikasi (%(ai)s) salah"

#: etiketto/ui/texts.py:173
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemen %(n)d: nilai pengecam aplikasi (%(ai)s) tidak sah: mengandungi tarikh, nombor atau aksara yang tidak dibenarkan"

#: etiketto/ui/texts.py:177
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemen %(n)d: tiada nombor UPC-A yang dipendekkan kepada digit UPC-E ini – semak atau gunakan UPC-A"

#: etiketto/ui/texts.py:181
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemen %(n)d: pengimbas yang ditetapkan kepada Full ASCII membaca $, /, + atau %% sebelum huruf besar sebagai aksara lain"

#: etiketto/ui/texts.py:184
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemen %(n)d: kandungan terlalu panjang untuk jenis kod ini"

#: etiketto/ui/texts.py:185
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemen %(n)d: kandungan tidak dapat dikodkan dalam jenis kod ini"

#: etiketto/ui/texts.py:187
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemen %(n)d: jenis kod ini memerlukan pustaka Zint (zint-bindings), yang tidak dipasang"

#: etiketto/ui/texts.py:190
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemen %(n)d: imej tidak dapat dibaca"

#: etiketto/ui/texts.py:191
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemen %(n)d: simbol ini tiada dalam pustaka simbol"

#: etiketto/ui/texts.py:192
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Elemen %(n)d tidak dapat dilukis"

#: etiketto/ui/texts.py:193
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Jidar keselamatan, sempadan dan jarak tepi tidak meninggalkan ruang – kurangkan nilainya"

#: etiketto/ui/texts.py:194
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Panjang tetap lebih pendek daripada jarak – tambahkan panjangnya"

#: etiketto/ui/texts.py:195
msgid "The background image cannot be read"
msgstr "Imej latar tidak dapat dibaca"

#: etiketto/ui/texts.py:197
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemen %(n)d: modul kod hanya selebar satu titik cetak dan mungkin tidak dapat diimbas – besarkan kod"

#: etiketto/ui/texts.py:201
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemen %(n)d: ruang kosong yang diperlukan di sekeliling kod tidak muat – besarkan kod"

#: etiketto/ui/texts.py:205
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemen %(n)d: kod tidak muat di ruangnya, walaupun dengan satu titik cetak setiap modul – besarkan label atau pendekkan kandungan"

#: etiketto/ui/texts.py:220
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Helaian yang sudah dicetak: %(n)d daripada %(total)d."

#: etiketto/ui/texts.py:222
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Label yang sudah dicetak: %(n)d daripada %(total)d."

#: etiketto/ui/texts.py:226
msgid "The sheets still waiting in the queue were canceled."
msgstr "Helaian yang masih menunggu dalam baris gilir telah dibatalkan."

#: etiketto/ui/texts.py:228
msgid "The labels still waiting in the queue were canceled."
msgstr "Label yang masih menunggu dalam baris gilir telah dibatalkan."

#: etiketto/ui/texts.py:237
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Pencetak tidak ditemui. Pastikan pencetak dihidupkan dan berada dalam rangkaian yang sama, atau masukkan alamat IP-nya."

#: etiketto/ui/texts.py:241
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Pencetak tidak ditemui melalui USB. Semak kabel dan pastikan pencetak dihidupkan dan tidak dalam mod tidur, kemudian cari semula."

#: etiketto/ui/texts.py:244
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Pencetak tidak menjawab. Pastikan pencetak dihidupkan dan tidak dalam mod tidur."

#: etiketto/ui/texts.py:246
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Pencetak berhenti menerima data. Semak sama ada pencetak menunjukkan masalah, seperti label habis atau penutup terbuka, kemudian cuba lagi."

#: etiketto/ui/texts.py:250
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Pencetak menolak sambungan. Matikan dan hidupkan semula. Jika antara muka webnya menawarkan pilihan “Port 9100”, hidupkan pilihan itu."

#: etiketto/ui/texts.py:253
msgid "No cassette is inserted. Insert one and try again."
msgstr "Tiada kaset dimasukkan. Masukkan kaset dan cuba lagi."

#: etiketto/ui/texts.py:254
msgid "The printer's cover is open. Close it and try again."
msgstr "Penutup pencetak terbuka. Tutup penutup dan cuba lagi."

#: etiketto/ui/texts.py:255
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Label tersekat. Buka penutup, keluarkan label dan cuba lagi."

#: etiketto/ui/texts.py:256
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tidak dikenali. Masukkan semula atau cuba kaset lain."

#: etiketto/ui/texts.py:257
msgid "The printer is busy. Wait a moment and try again."
msgstr "Pencetak sedang sibuk. Tunggu sebentar dan cuba lagi."

#: etiketto/ui/texts.py:258
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Label terlalu panjang untuk pencetak ini: maksimum %(max)s."

#: etiketto/ui/texts.py:259
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Label terlalu lebar untuk pencetak ini: maksimum %(max)s."

#: etiketto/ui/texts.py:260
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Label pencetak telah habis. Masukkan gulungan baharu dan cuba lagi."

#: etiketto/ui/texts.py:261
msgid "The print head is open. Close it and try again."
msgstr "Kepala cetak terbuka. Tutupkannya dan cuba lagi."

#: etiketto/ui/texts.py:263
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Pencetak tidak dapat mencari label seterusnya. Semak bahawa label dimuatkan dengan betul dan melalui penderia label."

#: etiketto/ui/texts.py:267
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Terdapat masalah dengan reben. Semak bahawa ia dimasukkan dengan betul dan sepadan dengan kaedah cetakan yang ditetapkan pada pencetak."

#: etiketto/ui/texts.py:270
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Pencetak dijeda. Sambungkannya pada paparannya dan cuba lagi."

#: etiketto/ui/texts.py:271
msgid "The printer is out of paper. Load paper and try again."
msgstr "Pencetak kehabisan kertas. Masukkan kertas dan cuba lagi."

#: etiketto/ui/texts.py:273
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Kertas tersekat. Keluarkan seperti yang ditunjukkan pada paparan pencetak dan cuba lagi."

#: etiketto/ui/texts.py:275
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Pencetak kehabisan toner atau dakwat. Gantikannya dan cuba lagi."

#: etiketto/ui/texts.py:276
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Pencetak tidak dapat mencetak saiz ini. Pilih saiz kertas yang ditawarkannya."

#: etiketto/ui/texts.py:278
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Pencetak tidak menerima mana-mana format yang boleh dihantar oleh Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:281
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Baris gilir pencetak dijeda. Sambungkannya dalam tetapan pencetak sistem dan cuba lagi."

#: etiketto/ui/texts.py:285
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Kerja cetak ditahan dalam baris gilir, contohnya sehingga ia dilepaskan atau kata laluan dimasukkan. Semak baris gilir dalam tetapan pencetak sistem dan cuba lagi."

#: etiketto/ui/texts.py:289
msgid "The print job was canceled at the printer or in the queue."
msgstr "Kerja cetak telah dibatalkan pada pencetak atau dalam baris gilir."

#: etiketto/ui/texts.py:291
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto tidak dibenarkan menggunakan port USB pencetak. Tambahkan pengguna anda ke kumpulan “lp” (sudo usermod -aG lp $USER), kemudian log keluar dan log masuk semula."

#: etiketto/ui/texts.py:295
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Pada resolusi pencetak ini, kod tidak muat pada label dan akan terpotong. Besarkan label atau pendekkan kandungan kod."

#: etiketto/ui/texts.py:299
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Pencetak melaporkan masalah. Matikan dan hidupkan semula, kemudian cuba sekali lagi."

#: etiketto/ui/texts.py:311
msgid "Warming up…"
msgstr "Memanaskan…"

#: etiketto/ui/texts.py:312
msgid "Cooling down…"
msgstr "Menyejukkan…"

#: etiketto/ui/texts.py:313
msgid "Cleaning…"
msgstr "Membersihkan…"

#: etiketto/ui/texts.py:314
msgid "Swipe the printer's panel to cut the label"
msgstr "Leret panel pencetak untuk memotong label"

#: etiketto/ui/texts.py:316
msgid "Out of paper – load paper to continue"
msgstr "Kehabisan kertas – masukkan kertas untuk meneruskan"

#: etiketto/ui/texts.py:317
msgid "Cover open – close it to continue"
msgstr "Penutup terbuka – tutup untuk meneruskan"

#: etiketto/ui/texts.py:318
msgid "Paper jammed – remove it to continue"
msgstr "Kertas tersekat – keluarkan untuk meneruskan"

#: etiketto/ui/texts.py:329
msgid "This label needs a newer version of Etiketto"
msgstr "Label ini memerlukan versi Etiketto yang lebih baharu"

#: etiketto/ui/texts.py:331
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s bukan label Etiketto"

#: etiketto/ui/texts.py:332
#, python-format
msgid "The file is damaged: %s"
msgstr "Fail rosak: %s"

#: etiketto/ui/texts.py:338
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Tidak dapat menyimpan %s: tiada kebenaran untuk menulis di situ"

#: etiketto/ui/texts.py:340
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Tidak dapat menyimpan %s: cakera penuh"

#: etiketto/ui/texts.py:341
#, python-format
msgid "Cannot save %s"
msgstr "Tidak dapat menyimpan %s"

#: etiketto/ui/texts.py:350
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kaset ini nampaknya dibuat pada %(month)s %(year)d. Kertas ZINK lama mencetak warna yang lebih pudar."

