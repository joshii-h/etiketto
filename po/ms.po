msgstr "Di permulaan"

#: tavletta/ui/texts.py:188
msgid "At the end"
msgstr "Di penghujung"

#: tavletta/ui/texts.py:189
msgid "At both ends"
msgstr "Di kedua-dua hujung"

#: tavletta/ui/texts.py:192
msgctxt "fill"
msgid "None"
msgstr "Tiada isian"

#: tavletta/ui/texts.py:193
msgctxt "fill"
msgid "Solid"
msgstr "Padu"

#: tavletta/ui/texts.py:194
msgid "Hatched"
msgstr "Berlorek"

#: tavletta/ui/texts.py:196
msgid "Grid"
msgstr "Grid"

