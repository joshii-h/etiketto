#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Kotak dan bingkai"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Reka dan cetak label"

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:222
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Idea untuk pemboleh ubah (pembilang, tarikh, UUID), tanpa kod"

#: tavletta/app.py:233
msgid "Protocol knowledge"
msgstr "Pengetahuan protokol"

#: tavletta/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Daripada %(projects)s dan manual pengeluar, ditulis semula tanpa kod mereka; lihat THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "dijangka NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "dijangka nombor bulat dari %(min)d hingga %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "dijangka baris seperti 3-10, 5 atau 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Tanpa arahan, aplikasi dimulakan; fail label yang diberi dibuka di dalamnya."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "cetak fail label tanpa membuka tetingkap"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Cetak fail label tanpa membuka tetingkap."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "label (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "model pencetak, secara lalai milik label: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "alamat pencetak, secara lalai yang ditetapkan dalam aplikasi"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "bilangan salinan"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "teks elemen NAME, atau nilai pemboleh ubah {=NAME}; pemboleh ubah dalam teks diisi; boleh diulang"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "seperti --set, tetapi nilai digunakan seadanya: tanda kurung kerinting bukan pemboleh ubah"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "pembilang label pertama, bukan yang disimpan dalam label"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "cetak dengan lalai model pencetak, bukan potongan, warna, kualiti, tambahan (cetakan berantai, resolusi tinggi, suapan pita), tetapan pencetak dan garis tepi helaian label yang terakhir dipilih dalam aplikasi; alamat dan jidar keselamatan kekal"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "kaedah cetakan pencetak terma yang mempunyai tetapan ini: printer (seperti ditetapkan pada pencetak), transfer (dengan reben) atau direct (terma terus, tanpa reben); secara lalai kaedah yang dipilih dalam aplikasi, juga dengan --printer-defaults"

#: tavletta/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "jangan tanya pencetak sebelum memaparkan (model, pita dan resolusinya)"

#: tavletta/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "jangan simpan nilai pembilang seterusnya dalam label (fail baca sahaja); cetakan seterusnya bermula dari nombor yang sama"

#: tavletta/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "label bersiri: satu label bagi setiap baris fail CSV, ODS atau XLSX ini; secara lalai fail data label"

#: tavletta/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "helaian fail data, secara lalai yang pertama"

#: tavletta/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "hanya baris-baris fail data ini, cth. 3-10, 5 atau 7- (dikira dari 1)"

#: tavletta/cli.py:267
msgid "check and render only, do not print"
msgstr "semak dan render sahaja, jangan cetak"

#: tavletta/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "dengan --dry-run: simpan setiap label sebagai PNG seperti yang dieksport oleh tetingkap, paling tinggi 600 dpi (- untuk stdout: yang pertama sahaja)"

#: tavletta/cli.py:279
msgid "list the printers found on the network"
msgstr "senaraikan pencetak yang ditemui dalam rangkaian"

#: tavletta/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Senaraikan pencetak yang ditemui dalam rangkaian: model, alamat, nama."

#: tavletta/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "hanya model pencetak ini: %s"

#: tavletta/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "dijangka alamat atau rangkaian seperti 172.16.0.0/12: %s"

#: tavletta/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "folder dengan fail label yang boleh digunakan oleh pelayan"

#: tavletta/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "cetak hanya pada alamat pencetak ini (* sepadan dengan apa sahaja); boleh diulang"

#: tavletta/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: pencetak yang boleh digunakan oleh klien, mengikut nama"

#: tavletta/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "label paling banyak dalam satu kerja cetak, salinan darab baris (lalai 10000)"

#: tavletta/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "cari pencetak dalam rangkaian (dimatikan secara lalai)"

#: tavletta/cli.py:336
msgid "run a print server with a REST API"
msgstr "jalankan pelayan cetak dengan REST API"

#: tavletta/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Jalankan pelayan cetak: REST API dan, dengan --mcp, MCP untuk klien AI."

#: tavletta/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "alamat untuk mendengar (lalai 127.0.0.1)"

#: tavletta/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "port untuk mendengar (lalai %d)"

#: tavletta/cli.py:352
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "fail dengan token akses; jika tidak, pemboleh ubah persekitaran TAVLETTA_TOKEN"

#: tavletta/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: token akses bernama dengan peranan"

#: tavletta/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "turut sediakan MCP di /mcp"

#: tavletta/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "saiz badan permintaan terbesar dalam MB (lalai 4)"

#: tavletta/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "proksi songsang yang pengepala X-Forwarded-For menamakan klien, cth. 172.16.0.0/12; boleh diulang"

#: tavletta/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "benarkan permintaan daripada halaman web asal ini; boleh diulang"

#: tavletta/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "sediakan MCP pada input dan output standard"

#: tavletta/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Sediakan MCP pada input dan output standard, untuk klien AI seperti Claude Desktop."

#: tavletta/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "urus token akses pelayan cetak"

#: tavletta/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Urus token akses pelayan cetak."

#: tavletta/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "buat token dan tambah cincangannya ke tokens.toml"

#: tavletta/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Buat token, tambah cincangannya ke tokens.toml dan tunjukkan token sekali sahaja."

#: tavletta/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "nama token, cth. peranti"

#: tavletta/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: lihat sahaja; print: juga cetak; admin: juga semua kerja cetak"

#: tavletta/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml untuk menambahnya"

#: tavletta/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "hanya pencetak ini daripada printers.toml; boleh diulang"

#: tavletta/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, untuk menyemak --printer"

#: tavletta/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "sah sehingga, cth. 2027-12-31"

#: tavletta/cli.py:429
msgid "a note for people"
msgstr "nota untuk manusia"

#: tavletta/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "simpan cincangan dengan scrypt dan bukan SHA-256"

#: tavletta/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ambil token pilihan anda daripada input standard (disimpan dengan scrypt) dan bukan membuat token baharu"

#: tavletta/cli.py:457 tavletta/server/config.py:220
#: tavletta/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Model pencetak tidak diketahui: %s"

#: tavletta/cli.py:464 tavletta/ui/files.py:89 tavletta/ui/files.py:142
#: tavletta/ui/texts.py:303 tavletta/ui/texts.py:640
#: tavletta/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "Tidak dapat membuka %s"

#: tavletta/cli.py:486 tavletta/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bukan tarikh, dijangka cth. 2026-12-31 atau 2026-12-31T08:30"

#: tavletta/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} diisi semasa mencetak dan tidak boleh ditetapkan"

#: tavletta/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Label tidak mempunyai elemen atau pemboleh ubah bernama %s"

#: tavletta/cli.py:551 tavletta/ui/printing.py:123
#: tavletta/server/service.py:963
msgid "The label is empty"
msgstr "Label kosong"

#: tavletta/cli.py:588
msgid "Cannot write the output"
msgstr "Tidak dapat menulis output"

#: tavletta/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output menulis imej PNG: berikan nama yang berakhir dengan .png"

#: tavletta/cli.py:644 tavletta/cli.py:853 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:891
#: tavletta/server/service.py:1118 tavletta/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "Label tidak dapat disediakan untuk dicetak."

#: tavletta/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "Tiada pencetak ditemui – berikan alamatnya dengan --host"

#: tavletta/cli.py:733
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Beberapa pencetak ditemui – pilih satu dengan --host (tavletta list-printers)"

#: tavletta/cli.py:744 tavletta/ui/texts.py:683 tavletta/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "Tidak dapat menyimpan %s"

#: tavletta/cli.py:746 tavletta/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "label telah dicetak, tetapi nilai pembilang seterusnya tidak disimpan"

#: tavletta/cli.py:761 tavletta/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "tiada apa-apa dicetak: nilai pembilang seterusnya tidak dapat disimpan"

#: tavletta/cli.py:821 tavletta/cli.py:848 tavletta/cli.py:1209
msgid "Interrupted"
msgstr "Diganggu"

#: tavletta/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: model pencetak ini tiada tetapan kaedah cetakan: %s"

#: tavletta/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet dan --rows memerlukan fail data (--data)"

#: tavletta/cli.py:972 tavletta/ui/printing.py:585
#: tavletta/server/service.py:764
msgid "No rows to print"
msgstr "Tiada baris untuk dicetak"

#: tavletta/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Label menggunakan fail data di luar foldernya: berikan dengan --data"

#: tavletta/cli.py:1009 tavletta/ui/window.py:844
#: tavletta/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "Tiada lajur sedemikian: %s"

#: tavletta/cli.py:1014 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Kod bar atau kod QR baris-baris ini tidak dapat dibuat daripada nilainya, contohnya EAN-13 dengan huruf atau sel kosong. Betulkan fail data dan baca semula, atau cetak tanpa baris-baris ini."

#: tavletta/cli.py:1019 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Baris: %s"

#: tavletta/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Menunggu cetakan lain bagi %s selesai…"

#: tavletta/cli.py:1034 tavletta/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s masih dikunci oleh cetakan lain – cuba lagi kemudian"

#: tavletta/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output memerlukan --dry-run"

#: tavletta/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nilai pembilang seterusnya tidak disimpan: cetakan seterusnya mengulang nombor-nombor itu"

#: tavletta/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "Menunggu jawapan pencetak…"

#: tavletta/cli.py:1180 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Tiada pencetak ditemui"

