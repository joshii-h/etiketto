msgid "Element %(n)d: the code is empty"
msgstr "Elemen %(n)d: kod kosong"

#: etiketto/app.py:236
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemen %(n)d: EAN-13 memerlukan tepat 12 digit"

