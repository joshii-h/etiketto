#: etiketto/ui/texts.py:177
msgid "Separator"
msgstr "Scheidingslijn"

#: etiketto/ui/texts.py:180
msgid "Horizontal"
msgstr "Horizontaal"

#: etiketto/ui/texts.py:181
msgid "Vertical"
msgstr "Verticaal"

#: etiketto/ui/texts.py:182
msgid "Diagonal, rising"
msgstr "Diagonaal, stijgend"

#: etiketto/ui/texts.py:183
msgid "Diagonal, falling"
msgstr "Diagonaal, dalend"

#: etiketto/ui/texts.py:186
msgctxt "arrows"
msgid "None"
msgstr "Geen"

#: etiketto/ui/texts.py:187
msgid "At the start"
msgstr "Aan het begin"

#: etiketto/ui/texts.py:188
msgid "At the end"
msgstr "Aan het einde"

#: etiketto/ui/texts.py:189
msgid "At both ends"
msgstr "Aan beide uiteinden"

#: etiketto/ui/texts.py:192
msgctxt "fill"
msgid "None"
msgstr "Geen"

#: etiketto/ui/texts.py:193
msgctxt "fill"
msgid "Solid"
msgstr "Egaal"

#: etiketto/ui/texts.py:194
msgid "Hatched"
msgstr "Gearceerd"

#: etiketto/ui/texts.py:196
msgid "Grid"
msgstr "Raster"

#: etiketto/ui/texts.py:211
#, python-format
msgid "Not an image: %s"
msgstr "Geen afbeelding: %s"

#. translators: the print density a NIIMBOT model uses by default
#: etiketto/ui/texts.py:229
msgctxt "print density"
msgid "Default"
msgstr "Standaard"

#: etiketto/ui/texts.py:233
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:236
#, python-format
msgid "%d in/s"
msgstr "%d inch/s"

#: etiketto/ui/texts.py:245
msgid "Image"
msgstr "Afbeelding"

#: etiketto/ui/texts.py:280
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Doorlopend, %(width)s breed"

#: etiketto/ui/texts.py:290
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Controleer of het hele etiket binnen de selectie valt. Sleep om de selectie of haar randen te verplaatsen, of teken een nieuwe."

#: etiketto/ui/texts.py:294
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Meerdere gebieden kunnen het etiket zijn. Controleer de selectie of probeer de volgende."

#: etiketto/ui/texts.py:296
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Alles wat op de pagina gedrukt is, is geselecteerd. Sleep om het etiket te kiezen."

#: etiketto/ui/texts.py:297
msgid "Nothing is printed on this page."
msgstr "Op deze pagina is niets gedrukt."

#: etiketto/ui/texts.py:302
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF-bestanden hebben Poppler (poppler-glib) nodig, dat niet is geïnstalleerd"

#: etiketto/ui/texts.py:313
msgid "System printer (CUPS, IPP)"
msgstr "Systeemprinter (CUPS, IPP)"

#: etiketto/ui/texts.py:314
msgid "Receipt printer (ESC/POS)"
msgstr "Bonprinter (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:316
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, doorlopende rollen"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:318
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, gestanste etiketten"

#: etiketto/ui/texts.py:325
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Element %(n)d: de code is leeg"

#: etiketto/ui/texts.py:326
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Element %(n)d: EAN-13 vereist precies 12 cijfers"

#: etiketto/ui/texts.py:327
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: het EAN-13-controlecijfer klopt niet"

#: etiketto/ui/texts.py:328
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Element %(n)d: Code 128 bevat hoogstens %(max)d tekens"

#: etiketto/ui/texts.py:330
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Element %(n)d: de streepjes zijn te dun om betrouwbaar te scannen – gebruik een langer of groter etiket, of kortere inhoud"

#: etiketto/ui/texts.py:334
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 accepteert alleen Latijnse letters, cijfers en leestekens"

#: etiketto/ui/texts.py:336
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Element %(n)d: EAN-8 vereist 7 cijfers, of 8 met het controlecijfer"

#: etiketto/ui/texts.py:337
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Element %(n)d: UPC-A vereist 11 cijfers, of 12 met het controlecijfer"

#: etiketto/ui/texts.py:339
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Element %(n)d: UPC-E vereist 7 cijfers die met 0 of 1 beginnen, of 8 met het controlecijfer"

#: etiketto/ui/texts.py:341
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Element %(n)d: ITF-14 vereist 13 cijfers, of 14 met het controlecijfer"

#: etiketto/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Element %(n)d: het controlecijfer klopt niet"

#: etiketto/ui/texts.py:344
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Element %(n)d: Code 39 accepteert alleen hoofdletters, cijfers, spaties en - . $ / + %%"

#: etiketto/ui/texts.py:347
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 93 accepteert alleen Latijnse letters, cijfers en leestekens"

#: etiketto/ui/texts.py:350
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: GS1-gegevens accepteren alleen Latijnse letters, cijfers en leestekens"

#: etiketto/ui/texts.py:353
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Element %(n)d: GS1-gegevens moeten application identifiers tussen haakjes zijn, elk gevolgd door de waarde, bijv. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:356
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Element %(n)d: (%(ai)s) is geen GS1-application identifier"

#: etiketto/ui/texts.py:358
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Element %(n)d: de waarde van application identifier (%(ai)s) heeft de verkeerde lengte"

#: etiketto/ui/texts.py:361
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Element %(n)d: het controlecijfer van application identifier (%(ai)s) klopt niet"

#: etiketto/ui/texts.py:364
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Element %(n)d: de waarde van application identifier (%(ai)s) is ongeldig: een datum, getal of teken dat niet is toegestaan"

#: etiketto/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Element %(n)d: geen UPC-A-nummer wordt tot deze UPC-E-cijfers ingekort – controleer ze of gebruik UPC-A"

#: etiketto/ui/texts.py:372
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Element %(n)d: scanners ingesteld op Full ASCII lezen een $, /, + of %% vóór een hoofdletter als een ander teken"

#: etiketto/ui/texts.py:375
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Element %(n)d: de inhoud is te lang voor dit type code"

#: etiketto/ui/texts.py:376
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Element %(n)d: de inhoud kan niet in dit type code worden gecodeerd"

#: etiketto/ui/texts.py:378
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Element %(n)d: dit type code vereist de Zint-bibliotheek (zint-bindings), die niet is geïnstalleerd"

#: etiketto/ui/texts.py:381
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: de afbeelding kan niet worden gelezen"

#: etiketto/ui/texts.py:382
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Element %(n)d: dit symbool staat niet in de symboolbibliotheek"

#: etiketto/ui/texts.py:383
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: het document kan niet worden gelezen"

#: etiketto/ui/texts.py:385
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: PDF-bestanden hebben Poppler (poppler-glib) nodig, dat niet is geïnstalleerd"

#: etiketto/ui/texts.py:387
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Element %(n)d kan niet worden getekend"

#: etiketto/ui/texts.py:389
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Veiligheidsmarge, rand, de inzet ervan en randafstand laten geen ruimte over – verklein ze"

#: etiketto/ui/texts.py:391
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "De vaste lengte is korter dan de afstand – vergroot die"

#: etiketto/ui/texts.py:392
msgid "The background image cannot be read"
msgstr "De achtergrondafbeelding kan niet worden gelezen"

#: etiketto/ui/texts.py:394
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: de modules van de code zijn maar één printpunt breed en worden misschien niet gescand – maak de code groter"

#: etiketto/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: de lege ruimte die de code om zich heen nodig heeft, past niet – maak de code groter"

#: etiketto/ui/texts.py:402
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: de code past niet in zijn ruimte, zelfs niet met één printpunt per module – maak het etiket groter of de inhoud korter"

#: etiketto/ui/texts.py:405
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Element %(n)d: %(name)s is geen bekende variabele"

#: etiketto/ui/texts.py:407
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Element %(n)d: de datum van %(name)s ligt vóór het jaar 1 of na 9999"

#: etiketto/ui/texts.py:410
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Element %(n)d: de variabele %(name)s… is niet gesloten – sluit hem af met }"

#: etiketto/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Element %(n)d: op een zwart-witprinter valt het nauwelijks op tegen wat erachter ligt, geheel of gedeeltelijk – kies een andere kleur of verplaats het"

#: etiketto/ui/texts.py:416
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Element %(n)d: de vorm heeft geen lijn en geen vulling"

#: etiketto/ui/texts.py:418
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "Element %(n)d steekt buiten de rand van het etiket en wordt daar afgesneden – verplaats het of maak het kleiner"

#: etiketto/ui/texts.py:422
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Element %(n)d: binnenmarge, kader, omtrek of schaduw laten geen ruimte over voor de tekst – verklein ze"

#: etiketto/ui/texts.py:437
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Al afgedrukte vellen: %(n)d van %(total)d."

#: etiketto/ui/texts.py:439
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Al afgedrukte etiketten: %(n)d van %(total)d."

#: etiketto/ui/texts.py:443
msgid "The sheets still waiting in the queue were canceled."
msgstr "De vellen die nog in de wachtrij stonden, zijn geannuleerd."

#: etiketto/ui/texts.py:445
msgid "The labels still waiting in the queue were canceled."
msgstr "De etiketten die nog in de wachtrij stonden, zijn geannuleerd."

#: etiketto/ui/texts.py:452
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Het etiket is %(size)s met een tussenruimte van %(gap)s, dus er begint elke %(pitch)s een nieuw. De printer mat een etiket om de %(measured)s. Controleer het etiketformaat en de tussenruimte."

#: etiketto/ui/texts.py:468
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "De printer is niet gevonden. Controleer of hij aan staat en in hetzelfde netwerk zit, of voer zijn IP-adres in."

#: etiketto/ui/texts.py:472
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "De printer is niet te vinden via USB. Controleer de kabel en of de printer aan staat en niet in de slaapstand is, en zoek dan opnieuw."

#: etiketto/ui/texts.py:475
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "De printer reageert niet. Controleer of hij aan staat en niet in de slaapstand is."

#: etiketto/ui/texts.py:477
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "De printer neemt geen gegevens meer aan. Controleer of hij een probleem meldt, zoals geen etiketten of een open klep, en probeer het dan opnieuw."

#: etiketto/ui/texts.py:481
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "De printer weigert de verbinding. Zet hem uit en weer aan. Biedt zijn webinterface een optie ‘Port 9100’, schakel die dan in."

#: etiketto/ui/texts.py:484
msgid "No cassette is inserted. Insert one and try again."
msgstr "Er is geen cassette geplaatst. Plaats er een en probeer het opnieuw."

#: etiketto/ui/texts.py:485
msgid "The printer's cover is open. Close it and try again."
msgstr "De klep van de printer is open. Sluit hem en probeer het opnieuw."

#: etiketto/ui/texts.py:486
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Het etiket zit vast. Open de klep, verwijder het en probeer het opnieuw."

#: etiketto/ui/texts.py:487
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "De cassette wordt niet herkend. Plaats hem opnieuw of probeer een andere."

#: etiketto/ui/texts.py:488
msgid "The printer is busy. Wait a moment and try again."
msgstr "De printer is bezig. Wacht even en probeer het opnieuw."

#: etiketto/ui/texts.py:489
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Het etiket is te lang voor deze printer: maximaal %(max)s."

#: etiketto/ui/texts.py:490
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Het etiket is te breed voor deze printer: maximaal %(max)s."

#: etiketto/ui/texts.py:491
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "De printer heeft geen etiketten meer. Plaats een nieuwe rol en probeer het opnieuw."

#: etiketto/ui/texts.py:492
msgid "The print head is open. Close it and try again."
msgstr "De printkop is open. Sluit hem en probeer het opnieuw."

#: etiketto/ui/texts.py:494
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "De printer kan het volgende etiket niet vinden. Controleer of de etiketten goed zijn geplaatst en door de etiketsensor lopen."

#: etiketto/ui/texts.py:498
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Er is een probleem met het lint. Controleer of het goed is geplaatst en overeenkomt met de printmethode die op de printer is ingesteld."

#: etiketto/ui/texts.py:504
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "De printer vindt geen lint. Plaats een lint en probeer het opnieuw. Etiketten die zonder lint printen, hebben „%(direct)s” nodig onder „%(method)s”."

#: etiketto/ui/texts.py:511
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Er is een lint geplaatst, maar de printer print zonder (direct thermisch). Kies voor etiketten die het lint nodig hebben „%(transfer)s” onder „%(method)s”, of verwijder het lint."

#: etiketto/ui/texts.py:516
msgid "The printer is paused. Resume it on its display and try again."
msgstr "De printer is gepauzeerd. Hervat hem op het display en probeer het opnieuw."

#: etiketto/ui/texts.py:517
msgid "The printer is out of paper. Load paper and try again."
msgstr "De printer heeft geen papier meer. Plaats papier en probeer het opnieuw."

#: etiketto/ui/texts.py:519
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Het papier is vastgelopen. Verwijder het zoals het display van de printer aangeeft en probeer het opnieuw."

#: etiketto/ui/texts.py:521
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "De printer heeft geen toner of inkt meer. Vervang het en probeer het opnieuw."

#: etiketto/ui/texts.py:522
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "De printer kan dit formaat niet afdrukken. Kies een papierformaat dat de printer aanbiedt."

#: etiketto/ui/texts.py:524
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "De printer accepteert geen van de formaten die Etiketto kan sturen (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:527
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "De wachtrij van de printer is gepauzeerd. Hervat hem in de printerinstellingen van het systeem en probeer het opnieuw."

#: etiketto/ui/texts.py:531
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "De afdruktaak is in de wachtrij vastgehouden, bijvoorbeeld tot hij wordt vrijgegeven of er een wachtwoord wordt ingevoerd. Controleer de wachtrij in de printerinstellingen van het systeem en probeer het opnieuw."

#: etiketto/ui/texts.py:535
msgid "The print job was canceled at the printer or in the queue."
msgstr "De afdruktaak is op de printer of in de wachtrij geannuleerd."

#: etiketto/ui/texts.py:536
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "De printer heeft zijn resolutie niet op tijd gemeld. Kies die onder „%s”."

#: etiketto/ui/texts.py:539
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "De geplaatste rol past niet bij het etiket. Plaats een passende rol, of kies het etiketformaat of het printermodel van de geplaatste rol."

#: etiketto/ui/texts.py:542
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "De batterij van de printer is bijna leeg – laad hem op of sluit de netadapter aan."

#: etiketto/ui/texts.py:543
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "De printkop is te heet. Wacht tot hij is afgekoeld en probeer het opnieuw."

#: etiketto/ui/texts.py:545
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto kan niet afdrukken op dit printermodel: het neemt de rasterafbeeldingen die Etiketto stuurt niet aan."

#: etiketto/ui/texts.py:549
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto kent dit printermodel niet en kan er nog niet op afdrukken."

#: etiketto/ui/texts.py:552
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "De printer staat in de modus Editor Lite en verschijnt als USB-station. Zet Editor Lite op de printer uit (het lampje gaat uit) en zoek opnieuw."

#: etiketto/ui/texts.py:556
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto mag de USB-poort van de printer niet gebruiken. Voeg je gebruiker toe aan de groep „lp” (sudo usermod -aG lp $USER) en meld je daarna af en weer aan."

#: etiketto/ui/texts.py:560
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "De pagina is te groot om te maken in de resolutie die de printer aanneemt. Kies een kleiner papierformaat of druk af op een printer die PDF aanneemt."

#: etiketto/ui/texts.py:564
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
