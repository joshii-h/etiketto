#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Vlak en kader"

#: etiketto/app.py:217 etiketto/cli.py:170
msgid "Design and print labels"
msgstr "Etiketten ontwerpen en afdrukken"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideeën voor de variabelen (teller, datum, UUID), geen code"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Protocolkennis"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Uit %(projects)s en de handleidingen van de fabrikanten, opnieuw geschreven zonder hun code; zie THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "verwacht NAME=VALUE: %s"

#: etiketto/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "verwacht een geheel getal van %(min)d tot %(max)d: %(value)s"

#: etiketto/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "rijen verwacht zoals 3-10, 5 of 7-: %s"

#: etiketto/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Zonder opdracht start de app; opgegeven etiketbestanden worden erin geopend."

#: etiketto/cli.py:177
msgid "print a label file without opening a window"
msgstr "een etiketbestand afdrukken zonder een venster te openen"

#: etiketto/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Een etiketbestand afdrukken zonder een venster te openen."

#: etiketto/cli.py:180
msgid "the label (.etiketto)"
msgstr "het etiket (.etiketto)"

#: etiketto/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "printermodel, standaard dat van het etiket: %s"

#: etiketto/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "printeradres, standaard het in de app ingestelde adres"

#: etiketto/cli.py:189
msgid "number of copies"
msgstr "aantal exemplaren"

#: etiketto/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "tekst van het element NAME, of waarde van de variabele {=NAME}; variabelen in een tekst worden ingevuld; herhaalbaar"

#: etiketto/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "zoals --set, maar de waarde wordt ongewijzigd gebruikt: accolades zijn geen variabelen"

#: etiketto/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "teller van het eerste etiket, in plaats van de in het etiket opgeslagen teller"

#: etiketto/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "afdrukken met de standaardwaarden van het printermodel in plaats van de snijwijze, kleuren, kwaliteit, extra’s (kettingprint, hoge resolutie, tapetoevoer), printerinstellingen en omtrekken op etikettenvellen die laatst in de app zijn gekozen; adres en veiligheidsmarge blijven"

#: etiketto/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "printmethode van een thermische printer die deze instelling heeft: printer (zoals ingesteld op de printer), transfer (met lint) of direct (direct thermisch, zonder lint); standaard de in de app gekozen methode, ook met --printer-defaults"

#: etiketto/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "de printer niet bevragen vóór het renderen (model, tape en resolutie)"

#: etiketto/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "de volgende tellerwaarde niet in het etiket opslaan (een alleen-lezen bestand); de volgende afdruk begint bij hetzelfde nummer"

#: etiketto/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "serie-etiketten: één etiket voor elke rij van dit CSV-, ODS- of XLSX-bestand; standaard het gegevensbestand van het etiket"

#: etiketto/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "het blad van het gegevensbestand, standaard het eerste"

#: etiketto/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "alleen deze rijen van het gegevensbestand, bijv. 3-10, 5 of 7- (geteld vanaf 1)"

#: etiketto/cli.py:267
msgid "check and render only, do not print"
msgstr "alleen controleren en renderen, niet afdrukken"

#: etiketto/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "met --dry-run: elk etiket als PNG opslaan zoals het venster het exporteert, hoogstens 600 dpi (- voor stdout: alleen het eerste)"

#: etiketto/cli.py:279
msgid "list the printers found on the network"
msgstr "de printers tonen die op het netwerk zijn gevonden"

#: etiketto/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "De printers tonen die op het netwerk zijn gevonden: model, adres, naam."

#: etiketto/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "alleen dit printermodel: %s"

#: etiketto/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "adres of netwerk verwacht zoals 172.16.0.0/12: %s"

#: etiketto/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "de map met de etiketbestanden die de server mag gebruiken"

#: etiketto/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "alleen afdrukken op dit printeradres (* komt overeen met alles); herhaalbaar"

#: etiketto/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: de printers die clients mogen gebruiken, op naam"

#: etiketto/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "maximaal aantal etiketten in één afdruktaak, exemplaren maal rijen (standaard 10000)"

#: etiketto/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "het netwerk naar printers doorzoeken (standaard uit)"

#: etiketto/cli.py:336
msgid "run a print server with a REST API"
msgstr "een afdrukserver met een REST API starten"

#: etiketto/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Een afdrukserver starten: een REST API en, met --mcp, MCP voor AI-clients."

#: etiketto/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "adres om op te luisteren (standaard 127.0.0.1)"

#: etiketto/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "poort om op te luisteren (standaard %d)"

#: etiketto/cli.py:352
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "bestand met het toegangstoken; anders de omgevingsvariabele ETIKETTO_TOKEN"

#: etiketto/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: toegangstokens met naam en rol"

#: etiketto/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "ook MCP aanbieden op /mcp"

#: etiketto/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "grootste verzoekinhoud in MB (standaard 4)"

#: etiketto/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "een reverse proxy waarvan de header X-Forwarded-For de client noemt, bijv. 172.16.0.0/12; herhaalbaar"

#: etiketto/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "verzoeken van webpagina’s met deze oorsprong toestaan; herhaalbaar"

#: etiketto/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "MCP aanbieden via standaardinvoer en -uitvoer"

#: etiketto/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP aanbieden via standaardinvoer en -uitvoer, voor AI-clients zoals Claude Desktop."

#: etiketto/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "de toegangstokens van de afdrukserver beheren"

#: etiketto/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "De toegangstokens van de afdrukserver beheren."

#: etiketto/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "een token maken en de hash ervan aan tokens.toml toevoegen"

#: etiketto/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Een token maken, de hash ervan aan tokens.toml toevoegen en het token eenmalig tonen."

#: etiketto/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "naam van het token, bijv. het apparaat"

#: etiketto/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: alleen bekijken; print: ook afdrukken; admin: ook alle afdruktaken"

#: etiketto/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml om het aan toe te voegen"

#: etiketto/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "alleen deze printer uit printers.toml; herhaalbaar"

#: etiketto/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, om --printer te controleren"

#: etiketto/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "geldig tot, bijv. 2027-12-31"

#: etiketto/cli.py:429
msgid "a note for people"
msgstr "een notitie voor mensen"

#: etiketto/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "de hash met scrypt opslaan in plaats van SHA-256"

#: etiketto/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "een zelfgekozen token van de standaardinvoer nemen (opgeslagen met scrypt) in plaats van er een te maken"

#: etiketto/cli.py:457 etiketto/server/config.py:220
#: etiketto/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Onbekend printermodel: %s"

#: etiketto/cli.py:464 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:303 etiketto/ui/texts.py:640
