#: etiketto/app.py:136 etiketto/cli.py:118
msgid "Design and print labels"
msgstr "Etiketten ontwerpen en afdrukken"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:91
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "verwacht NAME=VALUE: %s"

#: etiketto/cli.py:107
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "verwacht een geheel getal van %(min)d tot %(max)d: %(value)s"

#: etiketto/cli.py:119
msgid "Without a command the application starts; label files given open in it."
msgstr "Zonder opdracht start de app; opgegeven etiketbestanden worden erin geopend."

#: etiketto/cli.py:125
msgid "print a label file without opening a window"
msgstr "een etiketbestand afdrukken zonder een venster te openen"

#: etiketto/cli.py:126
msgid "Print a label file without opening a window."
msgstr "Een etiketbestand afdrukken zonder een venster te openen."

#: etiketto/cli.py:128
msgid "the label (.etiketto)"
msgstr "het etiket (.etiketto)"

#: etiketto/cli.py:131
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "printermodel, standaard dat van het etiket: %s"

#: etiketto/cli.py:134
msgid "printer address, by default the one set in the app"
msgstr "printeradres, standaard het in de app ingestelde adres"

#: etiketto/cli.py:137
msgid "number of copies"
msgstr "aantal exemplaren"

#: etiketto/cli.py:147
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "tekst van het element NAME, of waarde van de variabele {=NAME}; variabelen in een tekst worden ingevuld; herhaalbaar"

#: etiketto/cli.py:157
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "zoals --set, maar de waarde wordt ongewijzigd gebruikt: accolades zijn geen variabelen"

#: etiketto/cli.py:163
msgid "counter of the first label, instead of the one saved in the label"
msgstr "teller van het eerste etiket, in plaats van de in het etiket opgeslagen teller"

#: etiketto/cli.py:169
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "de volgende tellerwaarde niet in het etiket opslaan (een alleen-lezen bestand); de volgende afdruk begint bij hetzelfde nummer"

#: etiketto/cli.py:174
msgid "check and render only, do not print"
msgstr "alleen controleren en renderen, niet afdrukken"

#: etiketto/cli.py:180
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "met --dry-run: de afbeeldingen als PNG opslaan zoals de printer ze zou krijgen (- voor stdout: alleen de eerste)"

#: etiketto/cli.py:186
msgid "list the printers found on the network"
msgstr "de printers tonen die op het netwerk zijn gevonden"

#: etiketto/cli.py:187
msgid "List the printers found on the network: model, address, name."
msgstr "De printers tonen die op het netwerk zijn gevonden: model, adres, naam."

