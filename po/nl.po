#: etiketto/server/service.py:506
#, python-format
msgid "The file is damaged: %s"
msgstr "Het bestand is beschadigd: %s"

#: etiketto/ui/texts.py:235
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Het gegevensbestand %s is er niet meer. Kies het opnieuw of verwijder het."

#: etiketto/ui/texts.py:239
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s heeft geen blad met de naam %(sheet)s"

#: etiketto/ui/texts.py:241
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s is geen tabel. Gebruik een CSV-, ODS- of XLSX-bestand."

#: etiketto/ui/texts.py:243
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s is te groot voor serie-etiketten. Splits het in kleinere bestanden of verwijder rijen en kolommen die niet nodig zijn."

#: etiketto/ui/texts.py:246
#, python-format
msgid "%s contains no data."
msgstr "%s bevat geen gegevens."

#: etiketto/ui/texts.py:254
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Het afdrukken is gestopt bij rij %(row)d. Druk opnieuw af vanaf rij %(row)d om verder te gaan."

#: etiketto/ui/texts.py:258
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Al afgedrukte exemplaren van rij %(row)d: %(copies)d."

