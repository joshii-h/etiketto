#: etiketto/app.py:200 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Etiketten ontwerpen en afdrukken"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideeën voor de variabelen (teller, datum, UUID), geen code"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "Protocolkennis"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Uit %(projects)s en de handleidingen van de fabrikanten, opnieuw geschreven zonder hun code; zie THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "verwacht NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "verwacht een geheel getal van %(min)d tot %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "rijen verwacht zoals 3-10, 5 of 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Zonder opdracht start de app; opgegeven etiketbestanden worden erin geopend."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "een etiketbestand afdrukken zonder een venster te openen"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Een etiketbestand afdrukken zonder een venster te openen."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "het etiket (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "printermodel, standaard dat van het etiket: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "printeradres, standaard het in de app ingestelde adres"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "aantal exemplaren"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "tekst van het element NAME, of waarde van de variabele {=NAME}; variabelen in een tekst worden ingevuld; herhaalbaar"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "zoals --set, maar de waarde wordt ongewijzigd gebruikt: accolades zijn geen variabelen"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "teller van het eerste etiket, in plaats van de in het etiket opgeslagen teller"

#: etiketto/cli.py:204
msgid ""
"print with the printer model's defaults instead of the cut, mode, quality "
"and printer settings last chosen in the app"
msgstr "afdrukken met de standaardwaarden van het printermodel in plaats van de snijwijze, modus, kwaliteit en printerinstellingen die laatst in de app zijn gekozen"

#: etiketto/cli.py:211
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "de printer niet bevragen vóór het renderen (model, tape en resolutie)"

#: etiketto/cli.py:217
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "de volgende tellerwaarde niet in het etiket opslaan (een alleen-lezen bestand); de volgende afdruk begint bij hetzelfde nummer"

#: etiketto/cli.py:226
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "serie-etiketten: één etiket voor elke rij van dit CSV-, ODS- of XLSX-bestand; standaard het gegevensbestand van het etiket"

#: etiketto/cli.py:231
msgid "the sheet of the data file, by default the first"
msgstr "het blad van het gegevensbestand, standaard het eerste"

#: etiketto/cli.py:237
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "alleen deze rijen van het gegevensbestand, bijv. 3-10, 5 of 7- (geteld vanaf 1)"

#: etiketto/cli.py:240
msgid "check and render only, do not print"
msgstr "alleen controleren en renderen, niet afdrukken"

#: etiketto/cli.py:246
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "met --dry-run: de afbeeldingen als PNG opslaan zoals de printer ze zou krijgen (- voor stdout: alleen de eerste)"

#: etiketto/cli.py:252
msgid "list the printers found on the network"
msgstr "de printers tonen die op het netwerk zijn gevonden"

#: etiketto/cli.py:253
msgid "List the printers found on the network: model, address, name."
msgstr "De printers tonen die op het netwerk zijn gevonden: model, adres, naam."

#: etiketto/cli.py:255
#, python-format
msgid "only this printer model: %s"
msgstr "alleen dit printermodel: %s"

#: etiketto/cli.py:274
#, python-format
msgid "Unknown printer model: %s"
msgstr "Onbekend printermodel: %s"

#: etiketto/cli.py:281 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:240 etiketto/ui/texts.py:528
#, python-format
msgid "Cannot open %s"
msgstr "Kan %s niet openen"

#: etiketto/cli.py:303
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s is geen datum, verwacht bijv. 2026-12-31 of 2026-12-31T08:30"

#: etiketto/cli.py:333
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} wordt bij het afdrukken ingevuld en kan niet worden ingesteld"

#: etiketto/cli.py:338
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Het etiket heeft geen element of variabele met de naam %s"

#: etiketto/cli.py:362 etiketto/ui/printing.py:99
msgid "The label is empty"
msgstr "Het etiket is leeg"

#: etiketto/cli.py:395
msgid "Cannot write the output"
msgstr "Kan de uitvoer niet schrijven"

#: etiketto/cli.py:426
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output schrijft PNG-afbeeldingen: geef een naam die eindigt op .png"

#: etiketto/cli.py:450 etiketto/cli.py:654 etiketto/ui/printing.py:540
#: etiketto/ui/printing.py:702
msgid "The label cannot be prepared for printing."
msgstr "Het etiket kan niet worden voorbereid voor afdrukken."

#: etiketto/cli.py:532
msgid "No printer found – give its address with --host"
msgstr "Geen printer gevonden – geef het adres op met --host"

#: etiketto/cli.py:534
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Meerdere printers gevonden – kies er een met --host (etiketto list-printers)"

#: etiketto/cli.py:545 etiketto/ui/texts.py:571
#, python-format
msgid "Cannot save %s"
msgstr "Kan %s niet opslaan"

#: etiketto/cli.py:547
msgid "the labels were printed, but the next counter value was not saved"
msgstr "de etiketten zijn afgedrukt, maar de volgende tellerwaarde is niet opgeslagen"

#: etiketto/cli.py:562
msgid "nothing was printed: the next counter value could not be saved"
msgstr "er is niets afgedrukt: de volgende tellerwaarde zou niet kunnen worden opgeslagen"

#: etiketto/cli.py:622 etiketto/cli.py:649 etiketto/cli.py:947
msgid "Interrupted"
msgstr "Onderbroken"

#: etiketto/cli.py:745
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Het etiket gebruikt een gegevensbestand buiten zijn map: geef het op met --data"

#: etiketto/cli.py:751
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet en --rows vereisen een gegevensbestand (--data)"

#: etiketto/cli.py:771 etiketto/ui/printing.py:572
msgid "No rows to print"
msgstr "Geen rijen om af te drukken"

#: etiketto/cli.py:780 etiketto/ui/window.py:598
#, python-format
msgid "No such column: %s"
msgstr "Onbekende kolom: %s"

#: etiketto/cli.py:785 etiketto/ui/printing.py:651
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "De streepjescode of QR-code van deze rijen kan niet uit hun waarden worden gemaakt, bijvoorbeeld een EAN-13 met letters of een lege cel. Corrigeer het gegevensbestand en lees het opnieuw, of druk af zonder deze rijen."

#: etiketto/cli.py:790 etiketto/ui/printing.py:656
#, python-format
msgid "Rows: %s"
msgstr "Rijen: %s"

#: etiketto/cli.py:798
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Wachten tot een andere afdruk van %s klaar is…"

#: etiketto/cli.py:805
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s is nog vergrendeld door een andere afdruk – probeer het later opnieuw"

#: etiketto/cli.py:811
msgid "--output needs --dry-run"
msgstr "--output vereist --dry-run"

#: etiketto/cli.py:828
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "De volgende tellerwaarde wordt niet opgeslagen: de volgende afdruk herhaalt de nummers"

#: etiketto/cli.py:905
msgid "Waiting for the printer's answer…"
msgstr "Wachten op het antwoord van de printer…"

#: etiketto/cli.py:923 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "Geen printer gevonden"

