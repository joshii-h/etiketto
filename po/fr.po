msgstr "Lettres latines, chiffres et ponctuation ; plus court que Code 39"

#: etiketto/ui/texts.py:132
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 chiffres, la clé de contrôle est ajoutée (ou 13 avec elle)"

#: etiketto/ui/texts.py:133
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 chiffres, la clé de contrôle est ajoutée (ou 8 avec elle)"

#: etiketto/ui/texts.py:134
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 chiffres, la clé de contrôle est ajoutée (ou 12 avec elle)"

#: etiketto/ui/texts.py:135
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 chiffres commençant par 0 ou 1, la clé de contrôle est ajoutée (ou 8 avec elle)"

#: etiketto/ui/texts.py:136
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 chiffres du GTIN d’un carton d’expédition, la clé de contrôle est ajoutée (ou 14 avec elle)"

#: etiketto/ui/texts.py:142
msgid "Whole area, centred"
msgstr "Zone entière, centrée"

#: etiketto/ui/texts.py:142
msgid "Fill the label, edges cut off"
msgstr "Remplir l’étiquette, bords coupés"

#: etiketto/ui/texts.py:156
#, python-format
msgid "Not an image: %s"
msgstr "Pas une image : %s"

#: etiketto/ui/texts.py:174
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:177
#, python-format
msgid "%d in/s"
msgstr "%d po/s"

#: etiketto/ui/texts.py:186
msgid "Image"
msgstr "Image"

#: etiketto/ui/texts.py:213
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Continu, %(width)s de large"

#: etiketto/ui/texts.py:223
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Vérifiez que toute l’étiquette se trouve dans la sélection. Faites glisser pour la déplacer ou déplacer ses bords, ou tracez-en une nouvelle."

#: etiketto/ui/texts.py:227
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Plusieurs zones pourraient être l’étiquette. Vérifiez la sélection ou essayez la suivante."

#: etiketto/ui/texts.py:229
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Tout ce qui est imprimé sur la page est sélectionné. Faites glisser pour choisir l’étiquette."

#: etiketto/ui/texts.py:230
msgid "Nothing is printed on this page."
msgstr "Rien n’est imprimé sur cette page."

#: etiketto/ui/texts.py:235
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Les fichiers PDF nécessitent Poppler (poppler-glib), qui n’est pas installé"

#: etiketto/ui/texts.py:246
msgid "System printer (CUPS, IPP)"
msgstr "Imprimante système (CUPS, IPP)"

#: etiketto/ui/texts.py:247
msgid "Receipt printer (ESC/POS)"
msgstr "Imprimante de tickets (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:249
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, rouleaux continus"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:251
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, étiquettes prédécoupées"

#: etiketto/ui/texts.py:258
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Élément %(n)d : le code est vide"

#: etiketto/ui/texts.py:259
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Élément %(n)d : EAN-13 exige exactement 12 chiffres"

#: etiketto/ui/texts.py:260
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Élément %(n)d : la clé de contrôle EAN-13 est fausse"

#: etiketto/ui/texts.py:262
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Élément %(n)d : Code 128 n’accepte que les lettres latines, les chiffres et la ponctuation"

#: etiketto/ui/texts.py:264
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Élément %(n)d : EAN-8 exige 7 chiffres, ou 8 avec la clé de contrôle"

#: etiketto/ui/texts.py:265
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Élément %(n)d : UPC-A exige 11 chiffres, ou 12 avec la clé de contrôle"

#: etiketto/ui/texts.py:267
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Élément %(n)d : UPC-E exige 7 chiffres commençant par 0 ou 1, ou 8 avec la clé de contrôle"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Élément %(n)d : ITF-14 exige 13 chiffres, ou 14 avec la clé de contrôle"

#: etiketto/ui/texts.py:270
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Élément %(n)d : la clé de contrôle est fausse"

#: etiketto/ui/texts.py:272
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Élément %(n)d : Code 39 n’accepte que les majuscules, les chiffres, les espaces et - . $ / + %%"

#: etiketto/ui/texts.py:275
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Élément %(n)d : Code 93 n’accepte que les lettres latines, les chiffres et la ponctuation"

#: etiketto/ui/texts.py:278
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Élément %(n)d : les données GS1 n’acceptent que les lettres latines, les chiffres et la ponctuation"

#: etiketto/ui/texts.py:281
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Élément %(n)d : les données GS1 doivent être des identifiants d’application entre parenthèses, chacun suivi de sa valeur, p. ex. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:284
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Élément %(n)d : (%(ai)s) n’est pas un identifiant d’application GS1"

#: etiketto/ui/texts.py:286
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Élément %(n)d : la valeur de l’identifiant d’application (%(ai)s) n’a pas la bonne longueur"

#: etiketto/ui/texts.py:289
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Élément %(n)d : la clé de contrôle de l’identifiant d’application (%(ai)s) est fausse"

#: etiketto/ui/texts.py:292
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Élément %(n)d : la valeur de l’identifiant d’application (%(ai)s) n’est pas valide : une date, un nombre ou un caractère qu’il n’autorise pas"

#: etiketto/ui/texts.py:296
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Élément %(n)d : aucun numéro UPC-A ne se réduit à ces chiffres UPC-E – vérifiez-les ou utilisez UPC-A"

#: etiketto/ui/texts.py:300
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Élément %(n)d : les lecteurs réglés sur Full ASCII lisent un $, /, + ou %% devant une majuscule comme un autre caractère"

#: etiketto/ui/texts.py:303
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Élément %(n)d : le contenu est trop long pour ce type de code"

#: etiketto/ui/texts.py:304
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Élément %(n)d : le contenu ne peut pas être encodé dans ce type de code"

#: etiketto/ui/texts.py:306
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Élément %(n)d : ce type de code nécessite la bibliothèque Zint (zint-bindings), qui n’est pas installée"

#: etiketto/ui/texts.py:309
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Élément %(n)d : l’image est illisible"

#: etiketto/ui/texts.py:310
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Élément %(n)d : ce symbole n’est pas dans la bibliothèque de symboles"

#: etiketto/ui/texts.py:311
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Élément %(n)d : le document est illisible"

#: etiketto/ui/texts.py:313
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Élément %(n)d : les fichiers PDF nécessitent Poppler (poppler-glib), qui n’est pas installé"

#: etiketto/ui/texts.py:315
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Impossible de dessiner l’élément %(n)d"

#: etiketto/ui/texts.py:316
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "La marge de sécurité, la bordure et la marge latérale ne laissent aucune place – réduisez-les"

#: etiketto/ui/texts.py:317
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "La longueur fixe est plus courte que l’espacement – augmentez-la"

#: etiketto/ui/texts.py:318
msgid "The background image cannot be read"
msgstr "L’image de fond est illisible"

#: etiketto/ui/texts.py:320
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Élément %(n)d : les modules du code n’ont qu’un point d’impression de large et risquent de ne pas être lus – agrandissez le code"

#: etiketto/ui/texts.py:324
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Élément %(n)d : l’espace vide dont le code a besoin autour de lui ne tient pas – agrandissez le code"

#: etiketto/ui/texts.py:328
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Élément %(n)d : le code ne tient pas dans son espace, même avec un point d’impression par module – agrandissez l’étiquette ou raccourcissez le contenu"

#: etiketto/ui/texts.py:331
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Élément %(n)d : %(name)s n’est pas une variable connue"

#: etiketto/ui/texts.py:333
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Élément %(n)d : la date de %(name)s est antérieure à l’an 1 ou postérieure à 9999"

#: etiketto/ui/texts.py:336
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Élément %(n)d : la variable %(name)s… n’est pas fermée – terminez-la par }"

#: etiketto/ui/texts.py:350
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Planches déjà imprimées : %(n)d sur %(total)d."

#: etiketto/ui/texts.py:352
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Étiquettes déjà imprimées : %(n)d sur %(total)d."

#: etiketto/ui/texts.py:356
msgid "The sheets still waiting in the queue were canceled."
msgstr "Les planches encore en attente dans la file ont été annulées."

#: etiketto/ui/texts.py:358
msgid "The labels still waiting in the queue were canceled."
msgstr "Les étiquettes encore en attente dans la file ont été annulées."

#: etiketto/ui/texts.py:367
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Imprimante introuvable. Vérifiez qu’elle est allumée et sur le même réseau, ou saisissez son adresse IP."

#: etiketto/ui/texts.py:371
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "L’imprimante est introuvable sur USB. Vérifiez le câble et que l’imprimante est allumée et sortie de veille, puis relancez la recherche."

#: etiketto/ui/texts.py:374
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "L’imprimante ne répond pas. Vérifiez qu’elle est allumée et sortie de veille."

#: etiketto/ui/texts.py:376
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "L’imprimante n’accepte plus de données. Vérifiez si elle signale un problème, par exemple plus d’étiquettes ou un capot ouvert, puis réessayez."

#: etiketto/ui/texts.py:380
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "L’imprimante refuse la connexion. Éteignez-la puis rallumez-la. Si son interface web propose une option « Port 9100 », activez-la."

#: etiketto/ui/texts.py:383
msgid "No cassette is inserted. Insert one and try again."
msgstr "Aucune cassette insérée. Insérez-en une et réessayez."

#: etiketto/ui/texts.py:384
msgid "The printer's cover is open. Close it and try again."
msgstr "Le capot de l’imprimante est ouvert. Fermez-le et réessayez."

#: etiketto/ui/texts.py:385
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "L’étiquette est coincée. Ouvrez le capot, retirez-la et réessayez."

#: etiketto/ui/texts.py:386
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "La cassette n’est pas reconnue. Réinsérez-la ou essayez-en une autre."

#: etiketto/ui/texts.py:387
msgid "The printer is busy. Wait a moment and try again."
msgstr "L’imprimante est occupée. Patientez un instant et réessayez."

#: etiketto/ui/texts.py:388
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "L’étiquette est trop longue pour cette imprimante : %(max)s au maximum."

#: etiketto/ui/texts.py:389
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "L’étiquette est trop large pour cette imprimante : %(max)s au maximum."

#: etiketto/ui/texts.py:390
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "L’imprimante n’a plus d’étiquettes. Chargez un nouveau rouleau et réessayez."

#: etiketto/ui/texts.py:391
msgid "The print head is open. Close it and try again."
msgstr "La tête d’impression est ouverte. Fermez-la et réessayez."

#: etiketto/ui/texts.py:393
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "L’imprimante ne trouve pas l’étiquette suivante. Vérifiez que les étiquettes sont bien chargées et passent correctement dans le capteur d’étiquettes."

#: etiketto/ui/texts.py:397
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Il y a un problème avec le ruban. Vérifiez qu’il est bien inséré et qu’il correspond au mode d’impression réglé sur l’imprimante."

#: etiketto/ui/texts.py:400
msgid "The printer is paused. Resume it on its display and try again."
msgstr "L’imprimante est en pause. Reprenez l’impression depuis son écran et réessayez."

#: etiketto/ui/texts.py:401
msgid "The printer is out of paper. Load paper and try again."
msgstr "L’imprimante n’a plus de papier. Chargez du papier et réessayez."

#: etiketto/ui/texts.py:403
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Le papier est coincé. Retirez-le comme l’indique l’écran de l’imprimante et réessayez."

#: etiketto/ui/texts.py:405
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "L’imprimante n’a plus de toner ou d’encre. Remplacez la cartouche et réessayez."

#: etiketto/ui/texts.py:406
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "L’imprimante ne peut pas imprimer ce format. Choisissez un format de papier qu’elle propose."

#: etiketto/ui/texts.py:408
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "L’imprimante n’accepte aucun des formats qu’Etiketto peut envoyer (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:411
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "La file d’attente de l’imprimante est en pause. Reprenez-la dans les paramètres d’imprimante du système et réessayez."

#: etiketto/ui/texts.py:415
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "La tâche d’impression a été retenue dans la file d’attente, par exemple jusqu’à ce qu’elle soit libérée ou qu’un mot de passe soit saisi. Vérifiez la file d’attente dans les paramètres d’imprimante du système et réessayez."

#: etiketto/ui/texts.py:419
msgid "The print job was canceled at the printer or in the queue."
msgstr "La tâche d’impression a été annulée sur l’imprimante ou dans la file d’attente."

#: etiketto/ui/texts.py:420
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "L’imprimante n’a pas indiqué sa résolution à temps. Choisissez-la sous « %s »."

#: etiketto/ui/texts.py:423
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Le rouleau chargé ne correspond pas à l’étiquette. Chargez un rouleau adapté, ou choisissez la taille d’étiquette ou le modèle d’imprimante du rouleau chargé."

#: etiketto/ui/texts.py:426
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "La batterie de l’imprimante est faible – rechargez-la ou branchez l’adaptateur secteur."

#: etiketto/ui/texts.py:427
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "La tête d’impression est trop chaude. Attendez qu’elle ait refroidi, puis réessayez."

#: etiketto/ui/texts.py:429
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto ne peut pas imprimer sur ce modèle d’imprimante : il n’accepte pas les images matricielles qu’Etiketto envoie."

#: etiketto/ui/texts.py:433
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto ne connaît pas ce modèle d’imprimante et ne peut pas encore imprimer dessus."

#: etiketto/ui/texts.py:436
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "L’imprimante est en mode Editor Lite et apparaît comme un lecteur USB. Désactivez Editor Lite sur l’imprimante (son voyant s’éteint), puis relancez la recherche."

#: etiketto/ui/texts.py:440
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto n’est pas autorisé à utiliser le port USB de l’imprimante. Ajoutez votre utilisateur au groupe « lp » (sudo usermod -aG lp $USER), puis fermez et rouvrez votre session."

#: etiketto/ui/texts.py:444
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "La page est trop grande pour être produite à la résolution que l’imprimante accepte. Choisissez un format de papier plus petit ou imprimez sur une imprimante qui accepte le PDF."

#: etiketto/ui/texts.py:448
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Un code ne tient pas sur l’étiquette à la résolution de cette imprimante et serait coupé. Agrandissez l’étiquette ou raccourcissez le contenu du code."

#: etiketto/ui/texts.py:452
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto n’est pas autorisé à utiliser le port série de l’imprimante. Ajoutez votre utilisateur au groupe « dialout » (sudo usermod -aG dialout $USER ; sous Arch Linux, le groupe s’appelle « uucp »), puis fermez et rouvrez votre session."

#: etiketto/ui/texts.py:457
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "L’imprimante a signalé un problème. Éteignez-la puis rallumez-la, puis réessayez."

#: etiketto/ui/texts.py:468
msgid "Printed"
msgstr "Imprimé"

#: etiketto/ui/texts.py:474
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Envoyé à l’imprimante – il sera imprimé quand son tour viendra"

#: etiketto/ui/texts.py:476
msgid "Sent to the printer – it did not confirm printing"
msgstr "Envoyé à l’imprimante – elle n’a pas confirmé l’impression"

#: etiketto/ui/texts.py:480
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Imprimé en « %(used)s », comme l’exige le rouleau chargé"

#: etiketto/ui/texts.py:484
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Le mode couleur « %(wanted)s » n’est pas disponible sur cette imprimante, impression en « %(used)s »"

#: etiketto/ui/texts.py:494
msgid "Warming up…"
msgstr "Préchauffage…"

#: etiketto/ui/texts.py:495
msgid "Cooling down…"
msgstr "Refroidissement…"

#: etiketto/ui/texts.py:496
msgid "Cleaning…"
msgstr "Nettoyage…"

#: etiketto/ui/texts.py:497
msgid "Swipe the printer's panel to cut the label"
msgstr "Faites glisser le panneau de l’imprimante pour couper l’étiquette"

#: etiketto/ui/texts.py:499
msgid "Out of paper – load paper to continue"
msgstr "Plus de papier – chargez du papier pour continuer"

#: etiketto/ui/texts.py:500
msgid "Cover open – close it to continue"
msgstr "Capot ouvert – fermez-le pour continuer"

#: etiketto/ui/texts.py:501
msgid "Paper jammed – remove it to continue"
msgstr "Papier coincé – retirez-le pour continuer"

#: etiketto/ui/texts.py:512
msgid "This label needs a newer version of Etiketto"
msgstr "Cette étiquette nécessite une version plus récente d’Etiketto"

#: etiketto/ui/texts.py:514
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s n’est pas une étiquette Etiketto"

#: etiketto/ui/texts.py:515 etiketto/ui/texts.py:535
#, python-format
msgid "The file is damaged: %s"
msgstr "Le fichier est endommagé : %s"

#: etiketto/ui/texts.py:522
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Le fichier de données %s n’existe plus. Choisissez-le à nouveau ou retirez-le."

#: etiketto/ui/texts.py:526
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s n’a pas de feuille nommée %(sheet)s"

#: etiketto/ui/texts.py:528
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s n’est pas un tableau. Utilisez un fichier CSV, ODS ou XLSX."

#: etiketto/ui/texts.py:530
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s est trop volumineux pour des étiquettes en série. Divisez-le en fichiers plus petits ou supprimez les lignes et les colonnes inutiles."

#: etiketto/ui/texts.py:533
#, python-format
msgid "%s contains no data."
msgstr "%s ne contient aucune donnée."

#: etiketto/ui/texts.py:541
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "L’impression s’est arrêtée à la ligne %(row)d. Pour continuer, relancez l’impression à partir de la ligne %(row)d."

#: etiketto/ui/texts.py:545
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Copies de la ligne %(row)d déjà imprimées : %(copies)d."

#: etiketto/ui/texts.py:555
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Impossible d’enregistrer %s : pas d’autorisation d’écriture"

#: etiketto/ui/texts.py:557
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Impossible d’enregistrer %s : le disque est plein"

#: etiketto/ui/texts.py:567
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Cette cassette semble dater de %(month)s %(year)d. Le papier ZINK ancien imprime des couleurs plus pâles."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Date"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "À consommer avant (dans 30 jours)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "Heure"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "Compteur"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Compteur avec zéros initiaux"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "Numéro de copie"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "Nombre de copies"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "ID aléatoire"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "Insérer une variable"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Les variables sont remplies à l’impression. Chaque étiquette imprimée reçoit la valeur suivante du compteur, y compris d’une copie à l’autre. L’aperçu montre les valeurs de la prochaine impression."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "En savoir plus sur les variables"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Augmente à chaque étiquette imprimée, du pas"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "Numéro suivant"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "Pas"

