#: etiketto/app.py:136 etiketto/cli.py:149
msgid "Design and print labels"
msgstr "Créer et imprimer des étiquettes"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:104
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE attendu : %s"

#: etiketto/cli.py:120
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "nombre entier de %(min)d à %(max)d attendu : %(value)s"

#: etiketto/cli.py:138 etiketto/cli.py:142
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "lignes attendues, p. ex. 3-10, 5 ou 7- : %s"

#: etiketto/cli.py:150
msgid "Without a command the application starts; label files given open in it."
msgstr "Sans commande, l’application démarre ; les fichiers d’étiquette indiqués s’y ouvrent."

#: etiketto/cli.py:156
msgid "print a label file without opening a window"
msgstr "imprime un fichier d’étiquette sans ouvrir de fenêtre"

#: etiketto/cli.py:157
msgid "Print a label file without opening a window."
msgstr "Imprime un fichier d’étiquette sans ouvrir de fenêtre."

#: etiketto/cli.py:159
msgid "the label (.etiketto)"
msgstr "l’étiquette (.etiketto)"

#: etiketto/cli.py:162
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modèle d’imprimante, par défaut celui de l’étiquette : %s"

#: etiketto/cli.py:165
msgid "printer address, by default the one set in the app"
msgstr "adresse de l’imprimante, par défaut celle réglée dans l’application"

#: etiketto/cli.py:168
msgid "number of copies"
msgstr "nombre de copies"

#: etiketto/cli.py:178
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texte de l’élément NAME, ou valeur de la variable {=NAME} ; les variables d’un texte sont remplies ; répétable"

#: etiketto/cli.py:188
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "comme --set, mais la valeur est prise telle quelle : les accolades ne sont pas des variables"

#: etiketto/cli.py:194
msgid "counter of the first label, instead of the one saved in the label"
msgstr "compteur de la première étiquette, au lieu de celui enregistré dans l’étiquette"

#: etiketto/cli.py:200
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ne pas enregistrer la prochaine valeur du compteur dans l’étiquette (un fichier en lecture seule) ; la prochaine impression reprend au même numéro"

#: etiketto/cli.py:209
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "étiquettes en série : une étiquette pour chaque ligne de ce fichier CSV, ODS ou XLSX ; par défaut le fichier de données de l’étiquette"

#: etiketto/cli.py:214
msgid "the sheet of the data file, by default the first"
msgstr "la feuille du fichier de données, par défaut la première"

#: etiketto/cli.py:220
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "seulement ces lignes du fichier de données, p. ex. 3-10, 5 ou 7- (comptées à partir de 1)"

#: etiketto/cli.py:223
msgid "check and render only, do not print"
msgstr "vérifier et générer seulement, sans imprimer"

#: etiketto/cli.py:229
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "avec --dry-run : enregistre les images en PNG telles que l’imprimante les recevrait (- pour la sortie standard : la première seulement)"

#: etiketto/cli.py:235
msgid "list the printers found on the network"
msgstr "liste les imprimantes trouvées sur le réseau"

#: etiketto/cli.py:236
msgid "List the printers found on the network: model, address, name."
msgstr "Liste les imprimantes trouvées sur le réseau : modèle, adresse, nom."

#: etiketto/cli.py:238
#, python-format
msgid "only this printer model: %s"
msgstr "uniquement ce modèle d’imprimante : %s"

#: etiketto/cli.py:257
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modèle d’imprimante inconnu : %s"

#: etiketto/cli.py:264 etiketto/ui/files.py:66 etiketto/ui/texts.py:237
#, python-format
msgid "Cannot open %s"
msgstr "Impossible d’ouvrir %s"

#: etiketto/cli.py:286
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s n’est pas une date, attendu p. ex. 2026-12-31 ou 2026-12-31T08:30"

#: etiketto/cli.py:313
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} est rempli à l’impression et ne peut pas être défini"

#: etiketto/cli.py:318
#, python-format
msgid "The label has no element or variable named %s"
msgstr "L’étiquette n’a aucun élément ni variable nommé %s"

#: etiketto/cli.py:342 etiketto/ui/printing.py:84
msgid "The label is empty"
msgstr "L’étiquette est vide"

#: etiketto/cli.py:375
msgid "Cannot write the output"
msgstr "Impossible d’écrire la sortie"

#: etiketto/cli.py:406
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output écrit des images PNG : indiquez un nom se terminant par .png"

#: etiketto/cli.py:442 etiketto/cli.py:473 etiketto/cli.py:592
#: etiketto/cli.py:619 etiketto/ui/printing.py:329 etiketto/ui/printing.py:467
msgid "The label cannot be prepared for printing."
msgstr "Impossible de préparer l’étiquette pour l’impression."

#: etiketto/cli.py:500
msgid "No printer found – give its address with --host"
msgstr "Aucune imprimante trouvée – indiquez son adresse avec --host"

#: etiketto/cli.py:502
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Plusieurs imprimantes trouvées – choisissez-en une avec --host (etiketto list-printers)"

#: etiketto/cli.py:513 etiketto/ui/texts.py:255
#, python-format
msgid "Cannot save %s"
msgstr "Impossible d’enregistrer %s"

#: etiketto/cli.py:515
msgid "the labels were printed, but the next counter value was not saved"
msgstr "les étiquettes ont été imprimées, mais la prochaine valeur du compteur n’a pas été enregistrée"

#: etiketto/cli.py:530
msgid "nothing was printed: the next counter value could not be saved"
msgstr "rien n’a été imprimé : la prochaine valeur du compteur ne pourrait pas être enregistrée"

#: etiketto/cli.py:590 etiketto/cli.py:616 etiketto/cli.py:817
msgid "Interrupted"
msgstr "Interrompu"

#: etiketto/cli.py:623 etiketto/ui/printing.py:470
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "L’impression s’est arrêtée à la ligne %(row)d. Pour continuer, relancez l’impression à partir de la ligne %(row)d."

#: etiketto/cli.py:694
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "L’étiquette utilise un fichier de données hors de son dossier : indiquez-le avec --data"

#: etiketto/cli.py:700
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet et --rows exigent un fichier de données (--data)"

#: etiketto/cli.py:709
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s n’a pas de feuille nommée %(sheet)s"

#: etiketto/cli.py:717 etiketto/ui/printing.py:345
msgid "No rows to print"
msgstr "Aucune ligne à imprimer"

#: etiketto/cli.py:726 etiketto/ui/window.py:389
#, python-format
msgid "No such column: %s"
msgstr "Colonne inconnue : %s"

#: etiketto/cli.py:731 etiketto/ui/printing.py:418
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Le code-barres ou le code QR de ces lignes ne peut pas être créé à partir de leurs valeurs, par exemple un EAN-13 avec des lettres ou une cellule vide. Corrigez le fichier de données et relisez-le, ou imprimez sans ces lignes."

#: etiketto/cli.py:736 etiketto/ui/printing.py:423
#, python-format
msgid "Rows: %s"
msgstr "Lignes : %s"

#: etiketto/cli.py:744
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Attente de la fin d’une autre impression de %s…"

#: etiketto/cli.py:751
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s est encore verrouillé par une autre impression – réessayez plus tard"

#: etiketto/cli.py:757
msgid "--output needs --dry-run"
msgstr "--output exige --dry-run"

#: etiketto/cli.py:766
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "La prochaine valeur du compteur n’est pas enregistrée : la prochaine impression répétera les numéros"

#: etiketto/cli.py:793 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Aucune imprimante trouvée"

