#: etiketto/app.py:136 etiketto/cli.py:118
msgid "Design and print labels"
msgstr "Créer et imprimer des étiquettes"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:91
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE attendu : %s"

#: etiketto/cli.py:107
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "nombre entier de %(min)d à %(max)d attendu : %(value)s"

#: etiketto/cli.py:119
msgid "Without a command the application starts; label files given open in it."
msgstr "Sans commande, l’application démarre ; les fichiers d’étiquette indiqués s’y ouvrent."

#: etiketto/cli.py:125
msgid "print a label file without opening a window"
msgstr "imprime un fichier d’étiquette sans ouvrir de fenêtre"

#: etiketto/cli.py:126
msgid "Print a label file without opening a window."
msgstr "Imprime un fichier d’étiquette sans ouvrir de fenêtre."

#: etiketto/cli.py:128
msgid "the label (.etiketto)"
msgstr "l’étiquette (.etiketto)"

#: etiketto/cli.py:131
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modèle d’imprimante, par défaut celui de l’étiquette : %s"

#: etiketto/cli.py:134
msgid "printer address, by default the one set in the app"
msgstr "adresse de l’imprimante, par défaut celle réglée dans l’application"

#: etiketto/cli.py:137
msgid "number of copies"
msgstr "nombre de copies"

#: etiketto/cli.py:147
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texte de l’élément NAME, ou valeur de la variable {=NAME} ; les variables d’un texte sont remplies ; répétable"

#: etiketto/cli.py:157
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "comme --set, mais la valeur est prise telle quelle : les accolades ne sont pas des variables"

#: etiketto/cli.py:163
msgid "counter of the first label, instead of the one saved in the label"
msgstr "compteur de la première étiquette, au lieu de celui enregistré dans l’étiquette"

#: etiketto/cli.py:169
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ne pas enregistrer la prochaine valeur du compteur dans l’étiquette (un fichier en lecture seule) ; la prochaine impression reprend au même numéro"

#: etiketto/cli.py:174
msgid "check and render only, do not print"
msgstr "vérifier et générer seulement, sans imprimer"

#: etiketto/cli.py:180
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "avec --dry-run : enregistre les images en PNG telles que l’imprimante les recevrait (- pour la sortie standard : la première seulement)"

#: etiketto/cli.py:186
msgid "list the printers found on the network"
msgstr "liste les imprimantes trouvées sur le réseau"

#: etiketto/cli.py:187
msgid "List the printers found on the network: model, address, name."
msgstr "Liste les imprimantes trouvées sur le réseau : modèle, adresse, nom."

