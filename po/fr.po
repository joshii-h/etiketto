msgid "the labels were printed, but the next counter value was not saved"
msgstr "les étiquettes ont été imprimées, mais la prochaine valeur du compteur n’a pas été enregistrée"

#: etiketto/cli.py:460
msgid "nothing was printed: the next counter value could not be saved"
msgstr "rien n’a été imprimé : la prochaine valeur du compteur ne pourrait pas être enregistrée"

#: etiketto/cli.py:520 etiketto/cli.py:641
msgid "Interrupted"
msgstr "Interrompu"

#: etiketto/cli.py:573
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Attente de la fin d’une autre impression de %s…"

