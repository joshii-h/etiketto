#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Encadré et cadre"

#: etiketto/app.py:217 etiketto/cli.py:170
msgid "Design and print labels"
msgstr "Créer et imprimer des étiquettes"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Idées pour les variables (compteur, date, UUID), sans code"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Connaissance des protocoles"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "D’après %(projects)s et les manuels des fabricants, réécrit sans leur code ; voir THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE attendu : %s"

#: etiketto/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "nombre entier de %(min)d à %(max)d attendu : %(value)s"

#: etiketto/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "lignes attendues, p. ex. 3-10, 5 ou 7- : %s"

#: etiketto/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Sans commande, l’application démarre ; les fichiers d’étiquette indiqués s’y ouvrent."

#: etiketto/cli.py:177
msgid "print a label file without opening a window"
msgstr "imprime un fichier d’étiquette sans ouvrir de fenêtre"

#: etiketto/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Imprime un fichier d’étiquette sans ouvrir de fenêtre."

#: etiketto/cli.py:180
msgid "the label (.etiketto)"
msgstr "l’étiquette (.etiketto)"

#: etiketto/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modèle d’imprimante, par défaut celui de l’étiquette : %s"

#: etiketto/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "adresse de l’imprimante, par défaut celle réglée dans l’application"

#: etiketto/cli.py:189
msgid "number of copies"
msgstr "nombre de copies"

#: etiketto/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texte de l’élément NAME, ou valeur de la variable {=NAME} ; les variables d’un texte sont remplies ; répétable"

#: etiketto/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "comme --set, mais la valeur est prise telle quelle : les accolades ne sont pas des variables"

#: etiketto/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "compteur de la première étiquette, au lieu de celui enregistré dans l’étiquette"

#: etiketto/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "imprimer avec les valeurs par défaut du modèle d’imprimante au lieu de la coupe, des couleurs, de la qualité, des options (impression en chaîne, haute résolution, avance du ruban), des réglages d’imprimante et des contours des planches d’étiquettes choisis en dernier dans l’application ; l’adresse et la marge de sécurité restent"

#: etiketto/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "mode d’impression d’une imprimante thermique qui a ce réglage : printer (comme réglé sur l’imprimante), transfer (avec ruban) ou direct (thermique direct, sans ruban) ; par défaut celui choisi dans l’application, même avec --printer-defaults"

#: etiketto/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "ne pas interroger l’imprimante avant le rendu (son modèle, son ruban et sa résolution)"

#: etiketto/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ne pas enregistrer la prochaine valeur du compteur dans l’étiquette (un fichier en lecture seule) ; la prochaine impression reprend au même numéro"

#: etiketto/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "étiquettes en série : une étiquette pour chaque ligne de ce fichier CSV, ODS ou XLSX ; par défaut le fichier de données de l’étiquette"

#: etiketto/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "la feuille du fichier de données, par défaut la première"

#: etiketto/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "seulement ces lignes du fichier de données, p. ex. 3-10, 5 ou 7- (comptées à partir de 1)"

#: etiketto/cli.py:267
msgid "check and render only, do not print"
msgstr "vérifier et générer seulement, sans imprimer"

#: etiketto/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "avec --dry-run : enregistre chaque étiquette en PNG comme la fenêtre l’exporte, 600 dpi au plus (- pour la sortie standard : la première seulement)"

#: etiketto/cli.py:279
msgid "list the printers found on the network"
msgstr "liste les imprimantes trouvées sur le réseau"

#: etiketto/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Liste les imprimantes trouvées sur le réseau : modèle, adresse, nom."

#: etiketto/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "uniquement ce modèle d’imprimante : %s"

#: etiketto/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "adresse ou réseau attendu, p. ex. 172.16.0.0/12 : %s"

#: etiketto/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "le dossier contenant les fichiers d’étiquette que le serveur peut utiliser"

#: etiketto/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "imprimer uniquement sur cette adresse d’imprimante (* correspond à tout) ; répétable"

#: etiketto/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml : les imprimantes que les clients peuvent utiliser, par leur nom"

#: etiketto/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "nombre maximal d’étiquettes dans une tâche d’impression, copies multipliées par lignes (par défaut 10000)"

#: etiketto/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "chercher des imprimantes sur le réseau (désactivé par défaut)"

#: etiketto/cli.py:336
msgid "run a print server with a REST API"
msgstr "lance un serveur d’impression avec une REST API"

#: etiketto/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Lance un serveur d’impression : une REST API et, avec --mcp, MCP pour les clients d’IA."

#: etiketto/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "adresse d’écoute (par défaut 127.0.0.1)"

#: etiketto/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "port d’écoute (par défaut %d)"

#: etiketto/cli.py:352
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "fichier contenant le jeton d’accès ; sinon la variable d’environnement ETIKETTO_TOKEN"

#: etiketto/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml : jetons d’accès nommés, avec leurs rôles"

#: etiketto/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "servir aussi MCP sur /mcp"

#: etiketto/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "taille maximale du corps de la requête en MB (par défaut 4)"

#: etiketto/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "un proxy inverse dont l’en-tête X-Forwarded-For indique le client, p. ex. 172.16.0.0/12 ; répétable"

#: etiketto/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "autoriser les requêtes des pages web de cette origine ; répétable"

#: etiketto/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "sert MCP sur l’entrée et la sortie standard"

#: etiketto/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Sert MCP sur l’entrée et la sortie standard, pour des clients d’IA comme Claude Desktop."

#: etiketto/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "gère les jetons d’accès du serveur d’impression"

#: etiketto/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Gère les jetons d’accès du serveur d’impression."

#: etiketto/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "crée un jeton et ajoute son hachage à tokens.toml"

#: etiketto/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Crée un jeton, ajoute son hachage à tokens.toml et affiche le jeton une seule fois."

#: etiketto/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "nom du jeton, p. ex. l’appareil"

#: etiketto/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview : consulter seulement ; print : imprimer aussi ; admin : aussi toutes les tâches"

#: etiketto/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml auquel l’ajouter"

#: etiketto/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "uniquement cette imprimante de printers.toml ; répétable"

#: etiketto/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, pour vérifier --printer"

#: etiketto/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "valable jusqu’au, p. ex. 2027-12-31"

#: etiketto/cli.py:429
msgid "a note for people"
msgstr "une note pour les humains"

#: etiketto/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "enregistrer le hachage avec scrypt au lieu de SHA-256"

#: etiketto/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "lire sur l’entrée standard un jeton de votre choix (enregistré avec scrypt) au lieu d’en créer un"

#: etiketto/cli.py:457 etiketto/server/config.py:220
#: etiketto/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modèle d’imprimante inconnu : %s"

#: etiketto/cli.py:464 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:303 etiketto/ui/texts.py:640
#: etiketto/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "Impossible d’ouvrir %s"

#: etiketto/cli.py:486 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s n’est pas une date, attendu p. ex. 2026-12-31 ou 2026-12-31T08:30"

#: etiketto/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} est rempli à l’impression et ne peut pas être défini"

#: etiketto/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "L’étiquette n’a aucun élément ni variable nommé %s"

#: etiketto/cli.py:551 etiketto/ui/printing.py:123
#: etiketto/server/service.py:963
msgid "The label is empty"
msgstr "L’étiquette est vide"

#: etiketto/cli.py:588
msgid "Cannot write the output"
msgstr "Impossible d’écrire la sortie"

#: etiketto/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output écrit des images PNG : indiquez un nom se terminant par .png"

#: etiketto/cli.py:644 etiketto/cli.py:853 etiketto/ui/printing.py:553
#: etiketto/ui/printing.py:715 etiketto/server/service.py:891
#: etiketto/server/service.py:1118 etiketto/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "Impossible de préparer l’étiquette pour l’impression."

#: etiketto/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "Aucune imprimante trouvée – indiquez son adresse avec --host"

#: etiketto/cli.py:733
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Plusieurs imprimantes trouvées – choisissez-en une avec --host (etiketto list-printers)"

#: etiketto/cli.py:744 etiketto/ui/texts.py:683 etiketto/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "Impossible d’enregistrer %s"

#: etiketto/cli.py:746 etiketto/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "les étiquettes ont été imprimées, mais la prochaine valeur du compteur n’a pas été enregistrée"

#: etiketto/cli.py:761 etiketto/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "rien n’a été imprimé : la prochaine valeur du compteur ne pourrait pas être enregistrée"

#: etiketto/cli.py:821 etiketto/cli.py:848 etiketto/cli.py:1209
msgid "Interrupted"
msgstr "Interrompu"

#: etiketto/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method : ce modèle d’imprimante n’a pas de réglage de mode d’impression : %s"

#: etiketto/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet et --rows exigent un fichier de données (--data)"

#: etiketto/cli.py:972 etiketto/ui/printing.py:585
#: etiketto/server/service.py:764
msgid "No rows to print"
msgstr "Aucune ligne à imprimer"

#: etiketto/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "L’étiquette utilise un fichier de données hors de son dossier : indiquez-le avec --data"

#: etiketto/cli.py:1009 etiketto/ui/window.py:844
#: etiketto/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "Colonne inconnue : %s"

#: etiketto/cli.py:1014 etiketto/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Le code-barres ou le code QR de ces lignes ne peut pas être créé à partir de leurs valeurs, par exemple un EAN-13 avec des lettres ou une cellule vide. Corrigez le fichier de données et relisez-le, ou imprimez sans ces lignes."

#: etiketto/cli.py:1019 etiketto/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Lignes : %s"

#: etiketto/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Attente de la fin d’une autre impression de %s…"

#: etiketto/cli.py:1034 etiketto/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s est encore verrouillé par une autre impression – réessayez plus tard"

#: etiketto/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output exige --dry-run"

#: etiketto/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "La prochaine valeur du compteur n’est pas enregistrée : la prochaine impression répétera les numéros"

#: etiketto/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "En attente de la réponse de l’imprimante…"

#: etiketto/cli.py:1180 etiketto/ui/printer.py:199
msgid "No printer found"
msgstr "Aucune imprimante trouvée"

