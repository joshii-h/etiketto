#: tavletta/app.py:147 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Caixa e moldura"

#: tavletta/app.py:221 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Crie e imprima etiquetas"

#: tavletta/app.py:224
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta significa «tabuinha» em romanche (de tavla, tábua). Pronuncia-se tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:230
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:238
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideias para as variáveis (contador, data, UUID), sem código"

#: tavletta/app.py:241
msgid "Protocol knowledge"
msgstr "Conhecimento de protocolos"

#: tavletta/app.py:246
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "De %(projects)s e dos manuais dos fabricantes, reescrito sem o respetivo código; ver THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "esperado NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "esperado um número inteiro de %(min)d a %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "esperavam-se linhas como 3-10, 5 ou 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Sem comando, a aplicação inicia; os ficheiros de etiqueta indicados abrem-se nela."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "imprime um ficheiro de etiqueta sem abrir uma janela"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Imprime um ficheiro de etiqueta sem abrir uma janela."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "a etiqueta (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modelo de impressora, por predefinição o da etiqueta: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "endereço da impressora, por predefinição o definido na aplicação"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "número de cópias"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texto do elemento NAME, ou valor da variável {=NAME}; as variáveis num texto são preenchidas; repetível"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "como --set, mas o valor é usado tal como está: as chavetas não são variáveis"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contador da primeira etiqueta, em vez do guardado na etiqueta"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "imprimir com as predefinições do modelo de impressora em vez do corte, cores, qualidade, extras (impressão em cadeia, alta resolução, avanço da fita), definições da impressora e contornos das folhas de etiquetas escolhidos por último na aplicação; o endereço e a margem de segurança mantêm-se"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "método de impressão de uma impressora térmica que tenha esta definição: printer (conforme definido na impressora), transfer (com fita) ou direct (térmica direta, sem fita); por predefinição o escolhido na aplicação; com --printer-defaults, o definido na impressora"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "não consultar a impressora antes de desenhar (modelo, fita e resolução)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "não guardar o próximo valor do contador na etiqueta (um ficheiro só de leitura); a próxima impressão começa no mesmo número"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etiquetas em série: uma etiqueta por cada linha deste ficheiro CSV, ODS ou XLSX; por omissão o ficheiro de dados da etiqueta"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "a folha do ficheiro de dados, por omissão a primeira"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "apenas estas linhas do ficheiro de dados, p. ex. 3-10, 5 ou 7- (contadas a partir de 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "apenas verificar e gerar, não imprimir"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "com --dry-run: guarda cada etiqueta em PNG como a janela a exporta, no máximo 600 dpi (- para stdout: só a primeira)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "lista as impressoras encontradas na rede"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "Lista as impressoras encontradas na rede: modelo, endereço, nome."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "apenas este modelo de impressora: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "esperava-se um endereço ou rede como 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "a pasta com os ficheiros de etiqueta que o servidor pode utilizar"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "imprimir apenas neste endereço de impressora (* corresponde a qualquer coisa); repetível"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: as impressoras que os clientes podem utilizar, por nome"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "máximo de etiquetas num trabalho de impressão, cópias vezes linhas (predefinição 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "procurar impressoras na rede (desativado por omissão)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "permitir páginas de documento (PDF, imagens) nas etiquetas enviadas com o pedido; os PDF são então desenhados num processo separado com limites (desativado por predefinição)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "executar um servidor de impressão com uma REST API"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Executa um servidor de impressão: uma REST API e, com --mcp, MCP para clientes de IA."

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "endereço onde escutar (predefinição 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "porta onde escutar (predefinição %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "ficheiro com o token de acesso; caso contrário, a variável de ambiente TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: tokens de acesso com nome e funções"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "disponibilizar também MCP em /mcp"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "tamanho máximo do corpo do pedido em MB (predefinição 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "um proxy inverso cujo cabeçalho X-Forwarded-For indica o cliente, p. ex. 172.16.0.0/12; repetível"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "permitir pedidos de páginas web desta origem; repetível"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "disponibilizar MCP na entrada e saída padrão"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Disponibiliza MCP na entrada e saída padrão, para clientes de IA como o Claude Desktop."

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "gerir os tokens de acesso do servidor de impressão"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "Gere os tokens de acesso do servidor de impressão."

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "criar um token e adicionar o respetivo hash ao tokens.toml"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Cria um token, adiciona o respetivo hash ao tokens.toml e mostra o token uma única vez."

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "nome do token, p. ex. o dispositivo"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: apenas ver; print: também imprimir; admin: também todos os trabalhos de impressão"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "tokens.toml ao qual o adicionar"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "apenas esta impressora do printers.toml; repetível"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml, para verificar --printer"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "válido até, p. ex. 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "uma nota para pessoas"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "guardar o hash com scrypt em vez de SHA-256"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ler da entrada padrão um token escolhido por si (guardado com scrypt) em vez de criar um"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:538
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modelo de impressora desconhecido: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:658
#: tavletta/server/service.py:686
#, python-format
msgid "Cannot open %s"
msgstr "Não é possível abrir %s"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s não é uma data, esperado p. ex. 2026-12-31 ou 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} é preenchido ao imprimir e não pode ser definido"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "A etiqueta não tem nenhum elemento ou variável com o nome %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1015
msgid "The label is empty"
msgstr "A etiqueta está vazia"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "Não é possível escrever a saída"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output escreve imagens PNG: indique um nome terminado em .png"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:920
#: tavletta/server/service.py:943 tavletta/server/service.py:1192
#: tavletta/server/service.py:1347
msgid "The label cannot be prepared for printing."
msgstr "Não é possível preparar a etiqueta para impressão."

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "Nenhuma impressora encontrada – indique o endereço com --host"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Várias impressoras encontradas – escolha uma com --host (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:701 tavletta/server/service.py:1337
#, python-format
msgid "Cannot save %s"
msgstr "Não é possível guardar %s"

#: tavletta/cli.py:757 tavletta/server/service.py:1340
msgid "the labels were printed, but the next counter value was not saved"
msgstr "as etiquetas foram impressas, mas o próximo valor do contador não foi guardado"

#: tavletta/cli.py:772 tavletta/server/service.py:1044
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nada foi impresso: o próximo valor do contador não poderia ser guardado"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "Interrompido"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: este modelo de impressora não tem definição de método de impressão: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows exigem um ficheiro de dados (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:783
msgid "No rows to print"
msgstr "Não há linhas para imprimir"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A etiqueta usa um ficheiro de dados fora da sua pasta: indique-o com --data"

#: tavletta/cli.py:1020 tavletta/ui/window.py:849
#: tavletta/server/service.py:837
#, python-format
msgid "No such column: %s"
msgstr "Coluna inexistente: %s"

#: tavletta/cli.py:1025 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "O código de barras ou o código QR destas linhas não pode ser criado a partir dos seus valores, por exemplo um EAN-13 com letras ou uma célula vazia. Corrija o ficheiro de dados e leia-o novamente, ou imprima sem estas linhas."

#: tavletta/cli.py:1030 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Linhas: %s"

#: tavletta/cli.py:1038
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "A aguardar que termine outra impressão de %s…"

#: tavletta/cli.py:1045 tavletta/server/service.py:1186
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ainda está bloqueado por outra impressão – tente mais tarde"

#: tavletta/cli.py:1051
msgid "--output needs --dry-run"
msgstr "--output requer --dry-run"

#: tavletta/cli.py:1068
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "O próximo valor do contador não é guardado: a próxima impressão repetirá os números"

#: tavletta/cli.py:1163
msgid "Waiting for the printer's answer…"
msgstr "A aguardar a resposta da impressora…"

#: tavletta/cli.py:1191 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Nenhuma impressora encontrada"

