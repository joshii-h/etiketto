msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabelas (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Escolher ficheiro de dados"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "Só é possível utilizar ficheiros locais"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "O Tavletta volta a perguntar antes de ler ficheiros de dados fora da pasta de uma etiqueta"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Ler o ficheiro de dados?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Esta etiqueta utiliza um ficheiro de dados fora da sua pasta:\n\n%s\n\nLeia-o apenas se souber de onde vem a etiqueta."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Agora não"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Ler ficheiro de dados"

#: tavletta/ui/data.py:265
