msgstr "A aquecer…"

#: tavletta/ui/texts.py:629
msgid "Cooling down…"
msgstr "A arrefecer…"

#: tavletta/ui/texts.py:630
msgid "Cleaning…"
msgstr "A limpar…"

#: tavletta/ui/texts.py:631
