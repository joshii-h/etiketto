msgstr "A impressão parou na linha %(row)d. Para continuar, imprima novamente a partir da linha %(row)d."

#: etiketto/ui/texts.py:258
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Cópias da linha %(row)d já impressas: %(copies)d."

