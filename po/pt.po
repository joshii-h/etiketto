msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Letras latinas, dígitos e pontuação; mais curto que o Code 39"

#: tavletta/ui/texts.py:149
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 dígitos, o dígito de controlo é acrescentado (ou 13 com ele)"

#: tavletta/ui/texts.py:150
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 dígitos, o dígito de controlo é acrescentado (ou 8 com ele)"

#: tavletta/ui/texts.py:151
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 dígitos, o dígito de controlo é acrescentado (ou 12 com ele)"

#: tavletta/ui/texts.py:152
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 dígitos a começar por 0 ou 1, o dígito de controlo é acrescentado (ou 8 com ele)"

#: tavletta/ui/texts.py:153
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 dígitos do GTIN de uma caixa de expedição, o dígito de controlo é acrescentado (ou 14 com ele)"

#: tavletta/ui/texts.py:159
msgid "Whole area, centred"
msgstr "Área inteira, centrada"

#: tavletta/ui/texts.py:159
msgid "Fill the label, edges cut off"
msgstr "Preencher a etiqueta, margens cortadas"

#: tavletta/ui/texts.py:161
msgid "Middle"
msgstr "Meio"

#: tavletta/ui/texts.py:161
msgid "Bottom"
msgstr "Baixo"

#: tavletta/ui/texts.py:163
msgid "Automatic"
msgstr "Automático"

#: tavletta/ui/texts.py:164
msgid "Threshold (drawings, logos)"
msgstr "Limiar (desenhos, logótipos)"

#: tavletta/ui/texts.py:165
msgid "Dithering (photos)"
msgstr "Difusão (fotografias)"

#: tavletta/ui/texts.py:166
msgid "Ordered pattern"
msgstr "Padrão ordenado"

#: tavletta/ui/texts.py:169
msgctxt "line style"
msgid "Solid"
msgstr "Contínuo"

#: tavletta/ui/texts.py:170
msgid "Dashed"
msgstr "Tracejado"

#: tavletta/ui/texts.py:171 tavletta/ui/texts.py:196
msgid "Dotted"
msgstr "Pontilhado"

#: tavletta/ui/texts.py:173
msgid "Double"
msgstr "Duplo"

#: tavletta/ui/texts.py:175
msgid "Line"
msgstr "Linha"

#: tavletta/ui/texts.py:176
msgid "Rectangle"
msgstr "Retângulo"

#: tavletta/ui/texts.py:177
msgid "Ellipse"
msgstr "Elipse"

#: tavletta/ui/texts.py:178
msgid "Separator"
msgstr "Separador"

#: tavletta/ui/texts.py:181
msgid "Horizontal"
msgstr "Horizontal"

#: tavletta/ui/texts.py:182
msgid "Vertical"
msgstr "Vertical"

#: tavletta/ui/texts.py:183
msgid "Diagonal, rising"
msgstr "Diagonal ascendente"

#: tavletta/ui/texts.py:184
msgid "Diagonal, falling"
msgstr "Diagonal descendente"

#: tavletta/ui/texts.py:187
msgctxt "arrows"
msgid "None"
msgstr "Nenhuma"

#: tavletta/ui/texts.py:188
msgid "At the start"
msgstr "No início"

#: tavletta/ui/texts.py:189
msgid "At the end"
msgstr "No fim"

#: tavletta/ui/texts.py:190
msgid "At both ends"
msgstr "Em ambas as extremidades"

#: tavletta/ui/texts.py:193
msgctxt "fill"
msgid "None"
msgstr "Nenhum"

#: tavletta/ui/texts.py:194
msgctxt "fill"
msgid "Solid"
msgstr "Sólido"

#: tavletta/ui/texts.py:195
msgid "Hatched"
msgstr "Hachurado"

#: tavletta/ui/texts.py:197
msgid "Grid"
msgstr "Grelha"

#. translators: %(formats)s is a list of file formats: PNG, JPEG, …
#: tavletta/ui/texts.py:218
#, python-format
msgid ""
"%(name)s is not an image Tavletta can use. Images in %(formats)s can be used."
msgstr "%(name)s não é uma imagem que o Tavletta possa usar. Podem ser usadas imagens em %(formats)s."

#: tavletta/ui/texts.py:226
#, python-format
msgid "%(name)s is not a label, an image or a data file"
msgstr "%(name)s não é uma etiqueta, uma imagem nem um ficheiro de dados"

#. translators: the print density a NIIMBOT model uses by default
#: tavletta/ui/texts.py:244
msgctxt "print density"
msgid "Default"
msgstr "Predefinida"

#: tavletta/ui/texts.py:248
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:251
#, python-format
msgid "%d in/s"
msgstr "%d pol./s"

#: tavletta/ui/texts.py:260
msgid "Image"
msgstr "Imagem"

#: tavletta/ui/texts.py:295
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Contínua, %(width)s de largura"

#: tavletta/ui/texts.py:305
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Verifique se toda a etiqueta está dentro da seleção. Arraste para a mover ou mover as suas margens, ou desenhe uma nova."

#: tavletta/ui/texts.py:309
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Várias áreas podem ser a etiqueta. Verifique a seleção ou experimente a seguinte."

#: tavletta/ui/texts.py:311
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Está selecionado tudo o que está impresso na página. Arraste para escolher a etiqueta."

#: tavletta/ui/texts.py:312
msgid "Nothing is printed on this page."
msgstr "Não há nada impresso nesta página."

#: tavletta/ui/texts.py:317
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Os ficheiros PDF precisam do Poppler (poppler-glib), que não está instalado"

#: tavletta/ui/texts.py:328
msgid "System printer (CUPS, IPP)"
msgstr "Impressora do sistema (CUPS, IPP)"

#: tavletta/ui/texts.py:329
msgid "Receipt printer (ESC/POS)"
msgstr "Impressora de talões (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:331
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, rolos contínuos"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:333
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, etiquetas pré-cortadas"

#: tavletta/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemento %(n)d: o código está vazio"

#: tavletta/ui/texts.py:341
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemento %(n)d: o EAN-13 precisa de exatamente 12 dígitos"

#: tavletta/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemento %(n)d: o dígito de controlo do EAN-13 está errado"

#: tavletta/ui/texts.py:343
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Elemento %(n)d: o Code 128 comporta no máximo %(max)d caracteres"

#: tavletta/ui/texts.py:345
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Elemento %(n)d: as barras são demasiado finas para uma leitura fiável – use uma etiqueta mais comprida ou maior, ou um conteúdo mais curto"

#: tavletta/ui/texts.py:349
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: o Code 128 só aceita letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:351
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemento %(n)d: o EAN-8 precisa de 7 dígitos, ou 8 com o dígito de controlo"

#: tavletta/ui/texts.py:352
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemento %(n)d: o UPC-A precisa de 11 dígitos, ou 12 com o dígito de controlo"

#: tavletta/ui/texts.py:354
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemento %(n)d: o UPC-E precisa de 7 dígitos a começar por 0 ou 1, ou 8 com o dígito de controlo"

#: tavletta/ui/texts.py:356
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemento %(n)d: o ITF-14 precisa de 13 dígitos, ou 14 com o dígito de controlo"

#: tavletta/ui/texts.py:357
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemento %(n)d: o dígito de controlo está errado"

#: tavletta/ui/texts.py:359
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemento %(n)d: o Code 39 só aceita maiúsculas, dígitos, espaços e - . $ / + %%"

#: tavletta/ui/texts.py:362
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: o Code 93 só aceita letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:365
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: os dados GS1 só aceitam letras latinas, dígitos e pontuação"

#: tavletta/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemento %(n)d: os dados GS1 têm de ser identificadores de aplicação entre parênteses, cada um seguido do seu valor, p. ex. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:371
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemento %(n)d: (%(ai)s) não é um identificador de aplicação GS1"

#: tavletta/ui/texts.py:373
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemento %(n)d: o valor do identificador de aplicação (%(ai)s) tem o comprimento errado"

#: tavletta/ui/texts.py:376
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemento %(n)d: o dígito de controlo do identificador de aplicação (%(ai)s) está errado"

#: tavletta/ui/texts.py:379
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemento %(n)d: o valor do identificador de aplicação (%(ai)s) não é válido: contém uma data, um número ou um carácter que não é permitido"

#: tavletta/ui/texts.py:383
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemento %(n)d: nenhum número UPC-A se abrevia para estes dígitos UPC-E – verifique-os ou use UPC-A"

#: tavletta/ui/texts.py:387
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemento %(n)d: os leitores configurados para Full ASCII leem um $, /, + ou %% antes de uma maiúscula como outro carácter"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemento %(n)d: o conteúdo é demasiado longo para este tipo de código"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemento %(n)d: o conteúdo não pode ser codificado neste tipo de código"

#: tavletta/ui/texts.py:393
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemento %(n)d: este tipo de código precisa da biblioteca Zint (zint-bindings), que não está instalada"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: não é possível ler a imagem"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemento %(n)d: este símbolo não está na biblioteca de símbolos"

#: tavletta/ui/texts.py:398
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemento %(n)d: não é possível ler o documento"

#: tavletta/ui/texts.py:400
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemento %(n)d: os ficheiros PDF precisam do Poppler (poppler-glib), que não está instalado"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Não é possível desenhar o elemento %(n)d"

#: tavletta/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: the font %(font)s is not installed – another font is used"
msgstr "Elemento %(n)d: o tipo de letra %(font)s não está instalado – é usado outro"

#: tavletta/ui/texts.py:407
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "A margem de segurança, o contorno, o seu recuo e a margem lateral não deixam espaço – reduza-os"

#: tavletta/ui/texts.py:409
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "O comprimento fixo é menor que o espaçamento – aumente-o"

#: tavletta/ui/texts.py:410
msgid "The background image cannot be read"
msgstr "Não é possível ler a imagem de fundo"

#: tavletta/ui/texts.py:412
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemento %(n)d: os módulos do código têm apenas um ponto de impressão de largura e podem não ser lidos – aumente o código"

#: tavletta/ui/texts.py:416
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemento %(n)d: o espaço em branco de que o código precisa à volta não cabe – aumente o código"

#: tavletta/ui/texts.py:420
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemento %(n)d: o código não cabe no seu espaço, nem com um ponto de impressão por módulo – aumente a etiqueta ou encurte o conteúdo"

#: tavletta/ui/texts.py:423
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemento %(n)d: %(name)s não é uma variável conhecida"

#: tavletta/ui/texts.py:425
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemento %(n)d: a data de %(name)s é anterior ao ano 1 ou posterior a 9999"

#: tavletta/ui/texts.py:428
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemento %(n)d: a variável %(name)s… não está fechada – termine-a com }"

#: tavletta/ui/texts.py:431
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Elemento %(n)d: numa impressora a preto e branco mal se distingue do que está por trás, no todo ou em parte – escolha outra cor ou mova-o"

#: tavletta/ui/texts.py:434
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Elemento %(n)d: a forma não tem linha nem preenchimento"

#: tavletta/ui/texts.py:436
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "O elemento %(n)d ultrapassa a margem da etiqueta e é cortado aí – mova-o ou torne-o mais pequeno"

#: tavletta/ui/texts.py:440
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Elemento %(n)d: a margem interior, a moldura, o contorno ou a sombra não deixam espaço para o texto – reduza-os"

#: tavletta/ui/texts.py:455
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Folhas já impressas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:457
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etiquetas já impressas: %(n)d de %(total)d."

#: tavletta/ui/texts.py:461
msgid "The sheets still waiting in the queue were canceled."
msgstr "As folhas que ainda aguardavam na fila foram canceladas."

#: tavletta/ui/texts.py:463
msgid "The labels still waiting in the queue were canceled."
msgstr "As etiquetas que ainda aguardavam na fila foram canceladas."

#: tavletta/ui/texts.py:470
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "A etiqueta tem %(size)s com um espaço de %(gap)s, por isso começa uma nova a cada %(pitch)s. A impressora mediu uma etiqueta a cada %(measured)s. Verifique o tamanho da etiqueta e o espaço."

#: tavletta/ui/texts.py:486
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Não é possível encontrar a impressora. Verifique se está ligada e na mesma rede, ou introduza o endereço IP."

#: tavletta/ui/texts.py:490
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "A impressora não foi encontrada por USB. Verifique o cabo e se a impressora está ligada e ativa, depois procure novamente."

#: tavletta/ui/texts.py:493
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "A impressora não responde. Verifique se está ligada e ativa."

#: tavletta/ui/texts.py:495
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "A impressora deixou de aceitar dados. Verifique se indica algum problema, como falta de etiquetas ou uma tampa aberta, e tente novamente."

#: tavletta/ui/texts.py:499
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "A impressora recusa a ligação. Desligue-a e volte a ligá-la. Se a interface web tiver uma opção “Port 9100”, ative-a."

#: tavletta/ui/texts.py:502
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nenhuma cassete inserida. Insira uma e tente novamente."

#: tavletta/ui/texts.py:503
msgid "The printer's cover is open. Close it and try again."
msgstr "A tampa da impressora está aberta. Feche-a e tente novamente."

#: tavletta/ui/texts.py:504
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "A etiqueta está encravada. Abra a tampa, retire-a e tente novamente."

#: tavletta/ui/texts.py:505
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "A cassete não é reconhecida. Volte a inseri-la ou experimente outra."

#: tavletta/ui/texts.py:506
msgid "The printer is busy. Wait a moment and try again."
msgstr "A impressora está ocupada. Aguarde um momento e tente novamente."

#: tavletta/ui/texts.py:507
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "A etiqueta é demasiado comprida para esta impressora: no máximo %(max)s."

#: tavletta/ui/texts.py:508
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "A etiqueta é demasiado larga para esta impressora: no máximo %(max)s."

#: tavletta/ui/texts.py:509
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "A impressora ficou sem etiquetas. Carregue um rolo novo e tente novamente."

#: tavletta/ui/texts.py:510
msgid "The print head is open. Close it and try again."
msgstr "A cabeça de impressão está aberta. Feche-a e tente novamente."

#: tavletta/ui/texts.py:512
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "A impressora não encontra a etiqueta seguinte. Verifique se as etiquetas estão bem carregadas e passam pelo sensor de etiquetas."

#: tavletta/ui/texts.py:516
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Há um problema com a fita. Verifique se está bem colocada e se corresponde ao método de impressão definido na impressora."

#: tavletta/ui/texts.py:522
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "A impressora não encontra fita. Coloque uma fita e tente novamente. As etiquetas que imprimem sem fita precisam de “%(direct)s” em “%(method)s”."

#: tavletta/ui/texts.py:529
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Está colocada uma fita, mas a impressora imprime sem ela (térmica direta). Para etiquetas que precisam da fita, escolha “%(transfer)s” em “%(method)s”, ou retire a fita."

#: tavletta/ui/texts.py:534
msgid "The printer is paused. Resume it on its display and try again."
msgstr "A impressora está em pausa. Retome-a no respetivo ecrã e tente novamente."

#: tavletta/ui/texts.py:535
msgid "The printer is out of paper. Load paper and try again."
msgstr "A impressora está sem papel. Coloque papel e tente novamente."

#: tavletta/ui/texts.py:537
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "O papel está encravado. Retire-o como indicado no ecrã da impressora e tente novamente."

#: tavletta/ui/texts.py:539
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "A impressora está sem toner ou tinta. Substitua-o e tente novamente."

#: tavletta/ui/texts.py:540
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "A impressora não consegue imprimir este tamanho. Escolha um tamanho de papel que ela ofereça."

#: tavletta/ui/texts.py:542
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "A impressora não aceita nenhum dos formatos que o Tavletta pode enviar (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:545
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "A fila da impressora está em pausa. Retome-a nas definições de impressora do sistema e tente novamente."

#: tavletta/ui/texts.py:549
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "O trabalho de impressão ficou retido na fila, por exemplo até ser libertado ou até ser introduzida uma palavra-passe. Verifique a fila nas definições de impressora do sistema e tente novamente."

#: tavletta/ui/texts.py:553
msgid "The print job was canceled at the printer or in the queue."
msgstr "O trabalho de impressão foi cancelado na impressora ou na fila."

#: tavletta/ui/texts.py:554
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "A impressora não indicou a resolução a tempo. Escolha-a em “%s”."

#: tavletta/ui/texts.py:557
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "O rolo carregado não corresponde à etiqueta. Carregue um rolo adequado ou escolha o tamanho da etiqueta ou o modelo da impressora do rolo carregado."

#: tavletta/ui/texts.py:560
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "A bateria da impressora está fraca – carregue-a ou ligue o transformador."

#: tavletta/ui/texts.py:561
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "A cabeça de impressão está demasiado quente. Aguarde até arrefecer e tente novamente."

#: tavletta/ui/texts.py:563
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "O Tavletta não consegue imprimir neste modelo de impressora: não aceita as imagens raster que o Tavletta envia."

#: tavletta/ui/texts.py:567
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "O Tavletta não conhece este modelo de impressora e ainda não consegue imprimir nele."

#: tavletta/ui/texts.py:570
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "A impressora está no modo Editor Lite e aparece como unidade USB. Desligue o Editor Lite na impressora (a luz apaga-se) e procure novamente."

#: tavletta/ui/texts.py:574
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "O Tavletta não tem permissão para usar a porta USB da impressora. Adicione o seu utilizador ao grupo “lp” (sudo usermod -aG lp $USER) e, em seguida, termine a sessão e inicie-a novamente."

#: tavletta/ui/texts.py:578
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "A página é demasiado grande para ser criada na resolução que a impressora aceita. Escolha um tamanho de papel mais pequeno ou imprima numa impressora que aceite PDF."

#: tavletta/ui/texts.py:582
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Um código não cabe na etiqueta com a resolução desta impressora e seria cortado. Aumente a etiqueta ou encurte o conteúdo do código."

#: tavletta/ui/texts.py:586
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "O Tavletta não tem permissão para usar a porta série da impressora. Adicione o seu utilizador ao grupo “dialout” (sudo usermod -aG dialout $USER; no Arch Linux o grupo chama-se “uucp”) e, em seguida, termine a sessão e inicie-a novamente."

#: tavletta/ui/texts.py:591
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "A impressora comunicou um problema. Desligue-a e volte a ligá-la e tente novamente."

#: tavletta/ui/texts.py:602
msgid "Printed"
msgstr "Impressa"

#: tavletta/ui/texts.py:608
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Enviado para a impressora – será impresso quando chegar a sua vez"

#: tavletta/ui/texts.py:610
msgid "Sent to the printer – it did not confirm printing"
msgstr "Enviado para a impressora – não confirmou a impressão"

#: tavletta/ui/texts.py:614
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Impresso com “%(used)s”, como o rolo carregado exige"

#: tavletta/ui/texts.py:618
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "O modo de cor “%(wanted)s” não está disponível nesta impressora, impresso com “%(used)s”"

