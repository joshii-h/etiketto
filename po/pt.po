#: etiketto/server/service.py:881
msgid "The label is empty"
msgstr "A etiqueta está vazia"

#: etiketto/cli.py:539
msgid "Cannot write the output"
msgstr "Não é possível escrever a saída"

#: etiketto/cli.py:570
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output escreve imagens PNG: indique um nome terminado em .png"

#: etiketto/cli.py:606 etiketto/cli.py:640 etiketto/cli.py:759
#: etiketto/cli.py:787 etiketto/ui/printing.py:340 etiketto/ui/printing.py:478
#: etiketto/server/service.py:821 etiketto/server/service.py:1030
#: etiketto/server/service.py:1175
msgid "The label cannot be prepared for printing."
msgstr "Não é possível preparar a etiqueta para impressão."

#: etiketto/cli.py:667
msgid "No printer found – give its address with --host"
msgstr "Nenhuma impressora encontrada – indique o endereço com --host"

#: etiketto/cli.py:669
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Várias impressoras encontradas – escolha uma com --host (etiketto list-printers)"

#: etiketto/cli.py:680 etiketto/ui/texts.py:272 etiketto/server/service.py:1165
#, python-format
msgid "Cannot save %s"
msgstr "Não é possível guardar %s"

#: etiketto/cli.py:682 etiketto/server/service.py:1168
msgid "the labels were printed, but the next counter value was not saved"
msgstr "as etiquetas foram impressas, mas o próximo valor do contador não foi guardado"

#: etiketto/cli.py:697 etiketto/server/service.py:905
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nada foi impresso: o próximo valor do contador não poderia ser guardado"

#: etiketto/cli.py:757 etiketto/cli.py:784 etiketto/cli.py:986
msgid "Interrupted"
msgstr "Interrompido"

#: etiketto/cli.py:860
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "A etiqueta usa um ficheiro de dados fora da sua pasta: indique-o com --data"

#: etiketto/cli.py:866
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows exigem um ficheiro de dados (--data)"

#: etiketto/cli.py:881 etiketto/ui/printing.py:356
#: etiketto/server/service.py:709
msgid "No rows to print"
msgstr "Não há linhas para imprimir"

#: etiketto/cli.py:890 etiketto/ui/window.py:389 etiketto/server/service.py:762
#, python-format
msgid "No such column: %s"
msgstr "Coluna inexistente: %s"

#: etiketto/cli.py:895 etiketto/ui/printing.py:429
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "O código de barras ou o código QR destas linhas não pode ser criado a partir dos seus valores, por exemplo um EAN-13 com letras ou uma célula vazia. Corrija o ficheiro de dados e leia-o novamente, ou imprima sem estas linhas."

#: etiketto/cli.py:900 etiketto/ui/printing.py:434
#, python-format
msgid "Rows: %s"
msgstr "Linhas: %s"

#: etiketto/cli.py:908
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "A aguardar que termine outra impressão de %s…"

#: etiketto/cli.py:915 etiketto/server/service.py:1024
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ainda está bloqueado por outra impressão – tente mais tarde"

#: etiketto/cli.py:921
msgid "--output needs --dry-run"
msgstr "--output requer --dry-run"

#: etiketto/cli.py:930
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "O próximo valor do contador não é guardado: a próxima impressão repetirá os números"

#: etiketto/cli.py:957 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Nenhuma impressora encontrada"

