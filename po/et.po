msgstr "Tavletta küsib uuesti, enne kui loeb sildi kaustast väljaspool olevaid andmefaile"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Kas lugeda andmefail?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "See silt kasutab andmefaili, mis asub väljaspool selle kausta:\n\n%s\n\nLoe seda ainult siis, kui tead, kust silt pärineb."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Mitte praegu"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Loe andmefail"

