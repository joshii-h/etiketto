#: etiketto/ui/texts.py:365
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: dokumenti ei saa lugeda"

#: etiketto/ui/texts.py:367
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: PDF-failid vajavad Popplerit (poppler-glib), mis pole paigaldatud"

#: etiketto/ui/texts.py:369
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Elementi %(n)d ei saa joonistada"

#: etiketto/ui/texts.py:370
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Ohutusvaru, ääris ja servavahe ei jäta ruumi – vähenda neid"

#: etiketto/ui/texts.py:371
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Fikseeritud pikkus on vahest lühem – suurenda seda"

#: etiketto/ui/texts.py:372
msgid "The background image cannot be read"
msgstr "Taustapilti ei saa lugeda"

#: etiketto/ui/texts.py:374
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: koodi moodulid on ainult ühe printimispunkti laiused ega pruugi skannida – suurendage koodi"

#: etiketto/ui/texts.py:378
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: koodi ümber vajalik tühi ala ei mahu – suurendage koodi"

#: etiketto/ui/texts.py:382
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: kood ei mahu oma kohale isegi ühe printimispunktiga mooduli kohta – suurendage silti või lühendage sisu"

#: etiketto/ui/texts.py:385
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Element %(n)d: %(name)s ei ole tuntud muutuja"

#: etiketto/ui/texts.py:387
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Element %(n)d: %(name)s kuupäev on enne aastat 1 või pärast aastat 9999"

#: etiketto/ui/texts.py:390
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Element %(n)d: muutuja %(name)s… ei ole suletud – lõpeta see märgiga }"

#: etiketto/ui/texts.py:393
#, python-format
msgid ""
"Element %(n)d: a black-and-white printer prints it in the colour of the "
"background – choose a darker or lighter colour"
msgstr "Element %(n)d: mustvalge printer prindib selle taustavärviga – valige tumedam või heledam värv"

#: etiketto/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Element %(n)d: kujundil pole joont ega täidet"

#: etiketto/ui/texts.py:398
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Element %(n)d: sisevahe, raam, kontuur või vari ei jäta tekstile ruumi – vähenda neid"

#: etiketto/ui/texts.py:413
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Juba prinditud lehti: %(n)d/%(total)d."

#: etiketto/ui/texts.py:415
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Juba prinditud silte: %(n)d/%(total)d."

#: etiketto/ui/texts.py:419
msgid "The sheets still waiting in the queue were canceled."
msgstr "Järjekorras veel oodanud lehed tühistati."

#: etiketto/ui/texts.py:421
msgid "The labels still waiting in the queue were canceled."
msgstr "Järjekorras veel oodanud sildid tühistati."

#: etiketto/ui/texts.py:430
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Printerit ei leitud. Veendu, et see on sisse lülitatud ja samas võrgus, või sisesta selle IP-aadress."

#: etiketto/ui/texts.py:434
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Printerit ei leita USB kaudu. Kontrolli kaablit ning et printer on sisse lülitatud ja ärkvel, seejärel otsi uuesti."

#: etiketto/ui/texts.py:437
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Printer ei vasta. Veendu, et see on sisse lülitatud ja ärkvel."

#: etiketto/ui/texts.py:439
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Printer ei võta enam andmeid vastu. Kontrolli, kas see näitab mõnda probleemi, näiteks sildid on otsas või kaas on lahti, ja proovi siis uuesti."

#: etiketto/ui/texts.py:443
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Printer keeldub ühendusest. Lülita see välja ja uuesti sisse. Kui selle veebiliideses on valik „Port 9100“, lülita see sisse."

#: etiketto/ui/texts.py:446
msgid "No cassette is inserted. Insert one and try again."
msgstr "Kassetti pole sisestatud. Sisesta kassett ja proovi uuesti."

#: etiketto/ui/texts.py:447
msgid "The printer's cover is open. Close it and try again."
msgstr "Printeri kaas on lahti. Sulge see ja proovi uuesti."

#: etiketto/ui/texts.py:448
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Silt on kinni jäänud. Ava kaas, eemalda silt ja proovi uuesti."

#: etiketto/ui/texts.py:449
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kassetti ei tuvastatud. Sisesta see uuesti või proovi teist."

#: etiketto/ui/texts.py:450
msgid "The printer is busy. Wait a moment and try again."
msgstr "Printer on hõivatud. Oota hetk ja proovi uuesti."

#: etiketto/ui/texts.py:451
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Silt on selle printeri jaoks liiga pikk: kuni %(max)s."

#: etiketto/ui/texts.py:452
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Silt on sellele printerile liiga lai: kuni %(max)s."

#: etiketto/ui/texts.py:453
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Printeril on sildid otsas. Pane sisse uus rull ja proovi uuesti."

#: etiketto/ui/texts.py:454
msgid "The print head is open. Close it and try again."
msgstr "Prindipea on lahti. Sulge see ja proovi uuesti."

#: etiketto/ui/texts.py:456
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Printer ei leia järgmist silti. Kontrolli, et sildid on õigesti sisse pandud ja jooksevad läbi siltidetektori."

#: etiketto/ui/texts.py:460
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Värvilindiga on probleem. Kontrolli, et see on õigesti paigaldatud ja vastab printeris seatud prindimeetodile."

#: etiketto/ui/texts.py:463
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Printer on peatatud. Jätka selle ekraanilt ja proovi uuesti."

#: etiketto/ui/texts.py:464
msgid "The printer is out of paper. Load paper and try again."
msgstr "Printeril on paber otsas. Pane paberit juurde ja proovi uuesti."

#: etiketto/ui/texts.py:466
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Paber on kinni jäänud. Eemalda see, nagu printeri ekraan näitab, ja proovi uuesti."

#: etiketto/ui/texts.py:468
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Printeril on toonier või tint otsas. Vaheta see välja ja proovi uuesti."

#: etiketto/ui/texts.py:469
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Printer ei saa seda suurust printida. Vali paberisuurus, mida ta pakub."

#: etiketto/ui/texts.py:471
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Printer ei võta vastu ühtegi vormingut, mida Etiketto saata oskab (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:474
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Printeri järjekord on peatatud. Jätka seda süsteemi printeriseadetes ja proovi uuesti."

#: etiketto/ui/texts.py:478
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Prinditöö peeti järjekorras kinni, näiteks kuni see vabastatakse või sisestatakse parool. Kontrolli järjekorda süsteemi printeriseadetes ja proovi uuesti."

#: etiketto/ui/texts.py:482
msgid "The print job was canceled at the printer or in the queue."
msgstr "Prinditöö tühistati printeris või järjekorras."

#: etiketto/ui/texts.py:483
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Printer ei teatanud oma eraldusvõimet õigel ajal. Vali see jaotises „%s“."

#: etiketto/ui/texts.py:486
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Sisestatud rull ei sobi sildiga. Pane sisse sobiv rull või vali sisestatud rulli sildi suurus või printeri mudel."

#: etiketto/ui/texts.py:489
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Printeri aku on tühjenemas – lae seda või ühenda toiteadapter."

#: etiketto/ui/texts.py:490
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Prindipea on liiga kuum. Oota, kuni see on jahtunud, ja proovi siis uuesti."

#: etiketto/ui/texts.py:492
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto ei saa sellel printerimudelil printida: see ei võta vastu Etiketto saadetavaid rasterpilte."

#: etiketto/ui/texts.py:496
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto ei tunne seda printerimudelit ega saa sellel veel printida."

#: etiketto/ui/texts.py:499
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Printer on Editor Lite režiimis ja paistab USB-kettana. Lülita printeril Editor Lite välja (selle tuli kustub) ja otsi siis uuesti."

#: etiketto/ui/texts.py:503
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto ei tohi printeri USB-porti kasutada. Lisa oma kasutaja gruppi „lp“ (sudo usermod -aG lp $USER) ning logi seejärel välja ja uuesti sisse."

#: etiketto/ui/texts.py:507
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Leht on liiga suur, et seda printeri toetatud eraldusvõimega luua. Vali väiksem paberisuurus või prindi printeriga, mis võtab vastu PDF-i."

#: etiketto/ui/texts.py:511
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Selle printeri eraldusvõimega ei mahu kood sildile ja lõigataks ära. Suurendage silti või lühendage koodi sisu."

#: etiketto/ui/texts.py:515
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto ei tohi printeri jadaporti kasutada. Lisa oma kasutaja gruppi „dialout“ (sudo usermod -aG dialout $USER; Arch Linuxis on grupi nimi „uucp“) ning logi seejärel välja ja uuesti sisse."

#: etiketto/ui/texts.py:520
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Printer teatas probleemist. Lülita see välja ja uuesti sisse ning proovi siis veel kord."

#: etiketto/ui/texts.py:531
msgid "Printed"
msgstr "Prinditud"

#: etiketto/ui/texts.py:537
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Saadetud printerile – prinditakse, kui selle järg kätte jõuab"

#: etiketto/ui/texts.py:539
msgid "Sent to the printer – it did not confirm printing"
msgstr "Saadetud printerisse – printer ei kinnitanud printimist"

#: etiketto/ui/texts.py:543
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Prinditi režiimiga „%(used)s“, sest sisestatud rull nõuab seda"

#: etiketto/ui/texts.py:547
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Värvirežiim „%(wanted)s“ pole selles printeris saadaval, prinditi režiimiga „%(used)s“"

#: etiketto/ui/texts.py:557
msgid "Warming up…"
msgstr "Soojenemine…"

#: etiketto/ui/texts.py:558
msgid "Cooling down…"
msgstr "Jahtumine…"

#: etiketto/ui/texts.py:559
msgid "Cleaning…"
msgstr "Puhastamine…"

#: etiketto/ui/texts.py:560
msgid "Swipe the printer's panel to cut the label"
msgstr "Sildi lõikamiseks libista printeri paneelil"

#: etiketto/ui/texts.py:562
msgid "Out of paper – load paper to continue"
msgstr "Paber on otsas – jätkamiseks pane paberit juurde"

#: etiketto/ui/texts.py:563
msgid "Cover open – close it to continue"
msgstr "Kaas on lahti – jätkamiseks sulge see"

#: etiketto/ui/texts.py:564
msgid "Paper jammed – remove it to continue"
msgstr "Paber on kinni jäänud – jätkamiseks eemalda see"

#: etiketto/ui/texts.py:575
msgid "This label needs a newer version of Etiketto"
msgstr "See silt vajab Etiketto uuemat versiooni"

#: etiketto/ui/texts.py:577
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s pole Etiketto silt"

#: etiketto/ui/texts.py:578 etiketto/ui/texts.py:598
#, python-format
msgid "The file is damaged: %s"
msgstr "Fail on rikutud: %s"

#: etiketto/ui/texts.py:585
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Andmefaili %s enam pole. Vali see uuesti või eemalda."

#: etiketto/ui/texts.py:589
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "Failis %(file)s pole lehte nimega %(sheet)s"

#: etiketto/ui/texts.py:591
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s ei ole tabel. Kasuta CSV-, ODS- või XLSX-faili."

#: etiketto/ui/texts.py:593
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s on seeriasiltide jaoks liiga suur. Jaga see väiksemateks failideks või eemalda read ja veerud, mida pole vaja."

#: etiketto/ui/texts.py:596
#, python-format
msgid "%s contains no data."
msgstr "%s ei sisalda andmeid."

#: etiketto/ui/texts.py:604
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Printimine peatus real %(row)d. Jätkamiseks prindi uuesti alates reast %(row)d."

#: etiketto/ui/texts.py:608
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Rea %(row)d juba prinditud koopiad: %(copies)d."

#: etiketto/ui/texts.py:618
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Ei saa salvestada: %s – sinna kirjutamise õigus puudub"

#: etiketto/ui/texts.py:620
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Ei saa salvestada: %s – ketas on täis"

#: etiketto/ui/texts.py:630
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kasseti arvatav valmistusaeg: %(month)s %(year)d. Vana ZINK-paber prindib kahvatumaid värve."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Kuupäev"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Parim enne (30 päeva pärast)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "Kellaaeg"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "Loendur"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Loendur eesnullidega"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "Koopia number"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "Koopiate arv"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "Juhuslik ID"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "Lisa muutuja"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Muutujad täidetakse printimisel. Iga prinditud silt saab loenduri järgmise väärtuse, ka koopialt koopiale. Eelvaade näitab järgmise printimise väärtusi."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "Rohkem muutujatest"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Suureneb iga prinditud sildiga sammu võrra"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "Järgmine number"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "Samm"

#: etiketto/ui/window.py:141
msgid "Templates"
msgstr "Mallid"

#: etiketto/ui/window.py:172
msgid "Shipping label…"
msgstr "Saatesilt…"

#: etiketto/ui/window.py:175
msgid "Data for serial labels…"
msgstr "Seeriasiltide andmed…"

#: etiketto/ui/window.py:176
msgid "Forget allowed data files"
msgstr "Unusta lubatud andmefailid"

#: etiketto/ui/window.py:177
msgid "Export PNG…"
msgstr "Ekspordi PNG-na…"

#: etiketto/ui/window.py:181
msgid "Report a problem…"
msgstr "Teata probleemist…"

#: etiketto/ui/window.py:182
msgid "About Etiketto"
msgstr "Etiketto teave"

#: etiketto/ui/window.py:635
msgid "Unsaved label"
msgstr "Salvestamata silt"

#: etiketto/ui/window.py:709
msgid "content scaled down to fit"
msgstr "sisu vähendati mahutamiseks"

#: etiketto/ui/window.py:713
#, python-format
msgid "Problem: %s"
msgstr "Probleem: %s"

#: etiketto/ui/window.py:732
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Selle printeri jaoks liiga pikk: kuni %s"

#: etiketto/ui/window.py:736
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Sellele printerile liiga lai: kuni %s"

#: etiketto/ui/window.py:808
msgid "The browser cannot be opened"
msgstr "Brauserit ei saa avada"

#: etiketto/ui/window.py:810
msgid "Copy link"
msgstr "Kopeeri link"

#: etiketto/ui/window.py:881
msgid "Only local files can be dropped"
msgstr "Lohistada saab ainult kohalikke faile"

#: etiketto/ui/window.py:902
msgid "Please wait until printing has finished"
msgstr "Oota, kuni printimine lõpeb"
