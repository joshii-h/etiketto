#: etiketto/app.py:136 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Kujunda ja prindi silte"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "oodatud NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "oodatud täisarv vahemikus %(min)d kuni %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "oodati ridu, nt 3-10, 5 või 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Ilma käsuta käivitub rakendus; antud sildifailid avatakse selles."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "prindib sildifaili ilma akent avamata"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Prindib sildifaili ilma akent avamata."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "silt (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "printeri mudel, vaikimisi sildi oma: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "printeri aadress, vaikimisi rakenduses määratud aadress"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "koopiate arv"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "elemendi NAME tekst või muutuja {=NAME} väärtus; tekstis olevad muutujad täidetakse; korratav"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "nagu --set, kuid väärtust kasutatakse muutmata kujul: loogelised sulud ei ole muutujad"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "esimese sildi loendur sildis salvestatu asemel"

#: etiketto/cli.py:204
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ära salvesta järgmist loenduri väärtust sildile (kirjutuskaitstud fail); järgmine printimine algab samast numbrist"

#: etiketto/cli.py:213
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "seeriasildid: üks silt selle CSV-, ODS- või XLSX-faili iga rea kohta; vaikimisi sildi andmefail"

#: etiketto/cli.py:218
msgid "the sheet of the data file, by default the first"
msgstr "andmefaili leht, vaikimisi esimene"

#: etiketto/cli.py:224
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "ainult need andmefaili read, nt 3-10, 5 või 7- (loendatakse alates 1-st)"

#: etiketto/cli.py:227
msgid "check and render only, do not print"
msgstr "ainult kontrolli ja renderda, ära prindi"

#: etiketto/cli.py:233
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "koos --dry-run: salvestab pildid PNG-na sellisena, nagu printer need saaks (- stdout jaoks: ainult esimene)"

#: etiketto/cli.py:239
msgid "list the printers found on the network"
msgstr "loetleb võrgust leitud printerid"

#: etiketto/cli.py:240
msgid "List the printers found on the network: model, address, name."
msgstr "Loetleb võrgust leitud printerid: mudel, aadress, nimi."

#: etiketto/cli.py:242
#, python-format
msgid "only this printer model: %s"
msgstr "ainult see printeri mudel: %s"

#: etiketto/cli.py:253
msgid "the folder with the label files the server may use"
msgstr "kaust sildifailidega, mida server tohib kasutada"

#: etiketto/cli.py:260
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "prindi ainult sellele printeri aadressile (* sobib kõigega); korratav"

#: etiketto/cli.py:266
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: printerid, mida kliendid tohivad kasutada, nime järgi"

#: etiketto/cli.py:271
msgid "search the network for printers (off by default)"
msgstr "otsi võrgust printereid (vaikimisi väljas)"

#: etiketto/cli.py:278
msgid "run a print server with a REST API"
msgstr "käivitab REST API-ga prindiserveri"

#: etiketto/cli.py:279
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Käivitab prindiserveri: REST API ja --mcp korral MCP TI-klientidele."

#: etiketto/cli.py:282
msgid "address to listen on (default 127.0.0.1)"
msgstr "aadress, mida kuulata (vaikimisi 127.0.0.1)"

#: etiketto/cli.py:288
#, python-format
msgid "port to listen on (default %d)"
msgstr "port, mida kuulata (vaikimisi %d)"

#: etiketto/cli.py:294
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "pääsuloaga fail; muidu keskkonnamuutuja ETIKETTO_TOKEN"

#: etiketto/cli.py:300
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: nimega pääsuload koos rollidega"

#: etiketto/cli.py:302
msgid "also serve MCP at /mcp"
msgstr "paku MCP-d ka aadressil /mcp"

#: etiketto/cli.py:308
msgid "allow requests from web pages of this origin; repeatable"
msgstr "luba päringud selle päritoluga veebilehtedelt; korratav"

#: etiketto/cli.py:313
msgid "serve MCP on standard input and output"
msgstr "pakub MCP-d standardsisendis ja -väljundis"

#: etiketto/cli.py:315
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Pakub MCP-d standardsisendis ja -väljundis TI-klientidele, nagu Claude Desktop."

#: etiketto/cli.py:325
msgid "manage the access tokens of the print server"
msgstr "haldab prindiserveri pääsulubasid"

#: etiketto/cli.py:326
msgid "Manage the access tokens of the print server."
msgstr "Haldab prindiserveri pääsulubasid."

#: etiketto/cli.py:331
msgid "make a token and add its hash to tokens.toml"
msgstr "loob pääsuloa ja lisab selle räsi faili tokens.toml"

#: etiketto/cli.py:332
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Loob pääsuloa, lisab selle räsi faili tokens.toml ja näitab pääsuluba ühe korra."

#: etiketto/cli.py:334
msgid "name of the token, e.g. the device"
msgstr "pääsuloa nimi, nt seade"

#: etiketto/cli.py:339
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: ainult vaatamine; print: ka printimine; admin: ka kõik tööd"

#: etiketto/cli.py:341
msgid "tokens.toml to add it to"
msgstr "tokens.toml, kuhu see lisada"

#: etiketto/cli.py:347
msgid "only this printer of printers.toml; repeatable"
msgstr "ainult see printer failist printers.toml; korratav"

#: etiketto/cli.py:350
msgid "printers.toml, to check --printer"
msgstr "printers.toml, --printer kontrollimiseks"

#: etiketto/cli.py:352
msgid "valid until, e.g. 2027-12-31"
msgstr "kehtib kuni, nt 2027-12-31"

#: etiketto/cli.py:353
msgid "a note for people"
msgstr "märkus inimestele"

#: etiketto/cli.py:355
msgid "store the hash with scrypt instead of SHA-256"
msgstr "salvesta räsi algoritmiga scrypt, mitte SHA-256"

#: etiketto/cli.py:374 etiketto/server/config.py:213
#: etiketto/server/service.py:297
#, python-format
msgid "Unknown printer model: %s"
msgstr "Tundmatu printeri mudel: %s"

#: etiketto/cli.py:381 etiketto/ui/files.py:66 etiketto/ui/texts.py:237
#: etiketto/server/service.py:443
#, python-format
msgid "Cannot open %s"
msgstr "Ei saa avada: %s"

#: etiketto/cli.py:403 etiketto/server/main.py:168
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ei ole kuupäev, oodatud nt 2026-12-31 või 2026-12-31T08:30"

#: etiketto/cli.py:433
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} täidetakse printimisel ja seda ei saa määrata"

#: etiketto/cli.py:438
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Sildil ei ole elementi ega muutujat nimega %s"

#: etiketto/cli.py:462 etiketto/ui/printing.py:85
#: etiketto/server/service.py:641
msgid "The label is empty"
msgstr "Silt on tühi"

#: etiketto/cli.py:495
msgid "Cannot write the output"
msgstr "Väljundit ei saa kirjutada"

#: etiketto/cli.py:526
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output kirjutab PNG-pilte: anna nimi, mis lõpeb laiendiga .png"

#: etiketto/cli.py:562 etiketto/cli.py:596 etiketto/cli.py:715
#: etiketto/cli.py:743 etiketto/ui/printing.py:330 etiketto/ui/printing.py:468
#: etiketto/server/service.py:591 etiketto/server/service.py:775
#: etiketto/server/service.py:846
msgid "The label cannot be prepared for printing."
msgstr "Silti ei saa printimiseks ette valmistada."

#: etiketto/cli.py:623
msgid "No printer found – give its address with --host"
msgstr "Printerit ei leitud – anna selle aadress valikuga --host"

#: etiketto/cli.py:625
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Leiti mitu printerit – vali üks valikuga --host (etiketto list-printers)"

#: etiketto/cli.py:636 etiketto/ui/texts.py:271 etiketto/server/service.py:836
#, python-format
msgid "Cannot save %s"
msgstr "Ei saa salvestada: %s"

#: etiketto/cli.py:638 etiketto/server/service.py:839
msgid "the labels were printed, but the next counter value was not saved"
msgstr "sildid prinditi, kuid järgmist loenduri väärtust ei salvestatud"

#: etiketto/cli.py:653 etiketto/server/service.py:665
msgid "nothing was printed: the next counter value could not be saved"
msgstr "midagi ei prinditud: järgmist loenduri väärtust ei saaks salvestada"

#: etiketto/cli.py:713 etiketto/cli.py:740 etiketto/cli.py:942
msgid "Interrupted"
msgstr "Katkestatud"

#: etiketto/cli.py:816
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Silt kasutab andmefaili väljaspool oma kausta: anna see võtmega --data"

#: etiketto/cli.py:822
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet ja --rows vajavad andmefaili (--data)"

#: etiketto/cli.py:837 etiketto/ui/printing.py:346
#: etiketto/server/service.py:529
msgid "No rows to print"
msgstr "Pole ridu, mida printida"

#: etiketto/cli.py:846 etiketto/ui/window.py:389 etiketto/server/service.py:582
#, python-format
msgid "No such column: %s"
msgstr "Tundmatu veerg: %s"

#: etiketto/cli.py:851 etiketto/ui/printing.py:419
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Nende ridade ribakoodi või QR-koodi ei saa nende väärtustest luua, näiteks tähtedega EAN-13 või tühi lahter. Paranda andmefail ja loe see uuesti või prindi ilma nende ridadeta."

#: etiketto/cli.py:856 etiketto/ui/printing.py:424
#, python-format
msgid "Rows: %s"
msgstr "Read: %s"

#: etiketto/cli.py:864
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Ootan, kuni faili %s teine printimine lõpeb…"

#: etiketto/cli.py:871 etiketto/server/service.py:769
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s on endiselt teise printimise poolt lukus – proovi hiljem uuesti"

#: etiketto/cli.py:877
msgid "--output needs --dry-run"
msgstr "--output nõuab --dry-run"

#: etiketto/cli.py:886
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Järgmist loenduri väärtust ei salvestata: järgmine printimine kordab numbreid"

#: etiketto/cli.py:913 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Printerit ei leitud"

