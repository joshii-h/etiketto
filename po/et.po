#: etiketto/app.py:136 etiketto/cli.py:150
msgid "Design and print labels"
msgstr "Kujunda ja prindi silte"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:105
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "oodatud NAME=VALUE: %s"

#: etiketto/cli.py:121
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "oodatud täisarv vahemikus %(min)d kuni %(max)d: %(value)s"

#: etiketto/cli.py:139 etiketto/cli.py:143
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "oodati ridu, nt 3-10, 5 või 7-: %s"

#: etiketto/cli.py:151
msgid "Without a command the application starts; label files given open in it."
msgstr "Ilma käsuta käivitub rakendus; antud sildifailid avatakse selles."

#: etiketto/cli.py:157
msgid "print a label file without opening a window"
msgstr "prindib sildifaili ilma akent avamata"

#: etiketto/cli.py:158
msgid "Print a label file without opening a window."
msgstr "Prindib sildifaili ilma akent avamata."

#: etiketto/cli.py:160
msgid "the label (.etiketto)"
msgstr "silt (.etiketto)"

#: etiketto/cli.py:163
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "printeri mudel, vaikimisi sildi oma: %s"

#: etiketto/cli.py:166
msgid "printer address, by default the one set in the app"
msgstr "printeri aadress, vaikimisi rakenduses määratud aadress"

#: etiketto/cli.py:169
msgid "number of copies"
msgstr "koopiate arv"

#: etiketto/cli.py:179
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "elemendi NAME tekst või muutuja {=NAME} väärtus; tekstis olevad muutujad täidetakse; korratav"

#: etiketto/cli.py:189
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "nagu --set, kuid väärtust kasutatakse muutmata kujul: loogelised sulud ei ole muutujad"

#: etiketto/cli.py:195
msgid "counter of the first label, instead of the one saved in the label"
msgstr "esimese sildi loendur sildis salvestatu asemel"

#: etiketto/cli.py:201
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "ära salvesta järgmist loenduri väärtust sildile (kirjutuskaitstud fail); järgmine printimine algab samast numbrist"

#: etiketto/cli.py:210
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "seeriasildid: üks silt selle CSV-, ODS- või XLSX-faili iga rea kohta; vaikimisi sildi andmefail"

#: etiketto/cli.py:215
msgid "the sheet of the data file, by default the first"
msgstr "andmefaili leht, vaikimisi esimene"

#: etiketto/cli.py:221
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "ainult need andmefaili read, nt 3-10, 5 või 7- (loendatakse alates 1-st)"

#: etiketto/cli.py:224
msgid "check and render only, do not print"
msgstr "ainult kontrolli ja renderda, ära prindi"

#: etiketto/cli.py:230
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "koos --dry-run: salvestab pildid PNG-na sellisena, nagu printer need saaks (- stdout jaoks: ainult esimene)"

#: etiketto/cli.py:236
msgid "list the printers found on the network"
msgstr "loetleb võrgust leitud printerid"

#: etiketto/cli.py:237
msgid "List the printers found on the network: model, address, name."
msgstr "Loetleb võrgust leitud printerid: mudel, aadress, nimi."

#: etiketto/cli.py:239
#, python-format
msgid "only this printer model: %s"
msgstr "ainult see printeri mudel: %s"

#: etiketto/cli.py:258
#, python-format
msgid "Unknown printer model: %s"
msgstr "Tundmatu printeri mudel: %s"

#: etiketto/cli.py:265 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:164 etiketto/ui/texts.py:411
#, python-format
msgid "Cannot open %s"
msgstr "Ei saa avada: %s"

#: etiketto/cli.py:287
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ei ole kuupäev, oodatud nt 2026-12-31 või 2026-12-31T08:30"

#: etiketto/cli.py:317
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} täidetakse printimisel ja seda ei saa määrata"

#: etiketto/cli.py:322
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Sildil ei ole elementi ega muutujat nimega %s"

#: etiketto/cli.py:346 etiketto/ui/printing.py:93
msgid "The label is empty"
msgstr "Silt on tühi"

#: etiketto/cli.py:379
msgid "Cannot write the output"
msgstr "Väljundit ei saa kirjutada"

#: etiketto/cli.py:410
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output kirjutab PNG-pilte: anna nimi, mis lõpeb laiendiga .png"

#: etiketto/cli.py:434 etiketto/cli.py:638 etiketto/ui/printing.py:434
#: etiketto/ui/printing.py:585
msgid "The label cannot be prepared for printing."
msgstr "Silti ei saa printimiseks ette valmistada."

#: etiketto/cli.py:516
msgid "No printer found – give its address with --host"
msgstr "Printerit ei leitud – anna selle aadress valikuga --host"

#: etiketto/cli.py:518
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Leiti mitu printerit – vali üks valikuga --host (etiketto list-printers)"

#: etiketto/cli.py:529 etiketto/ui/texts.py:445
#, python-format
msgid "Cannot save %s"
msgstr "Ei saa salvestada: %s"

#: etiketto/cli.py:531
msgid "the labels were printed, but the next counter value was not saved"
msgstr "sildid prinditi, kuid järgmist loenduri väärtust ei salvestatud"

#: etiketto/cli.py:546
msgid "nothing was printed: the next counter value could not be saved"
msgstr "midagi ei prinditud: järgmist loenduri väärtust ei saaks salvestada"

#: etiketto/cli.py:606 etiketto/cli.py:633 etiketto/cli.py:835
msgid "Interrupted"
msgstr "Katkestatud"

#: etiketto/cli.py:711
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Silt kasutab andmefaili väljaspool oma kausta: anna see võtmega --data"

#: etiketto/cli.py:717
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet ja --rows vajavad andmefaili (--data)"

#: etiketto/cli.py:732 etiketto/ui/printing.py:463
msgid "No rows to print"
msgstr "Pole ridu, mida printida"

#: etiketto/cli.py:741 etiketto/ui/window.py:510
#, python-format
msgid "No such column: %s"
msgstr "Tundmatu veerg: %s"

#: etiketto/cli.py:746 etiketto/ui/printing.py:536
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Nende ridade ribakoodi või QR-koodi ei saa nende väärtustest luua, näiteks tähtedega EAN-13 või tühi lahter. Paranda andmefail ja loe see uuesti või prindi ilma nende ridadeta."

#: etiketto/cli.py:751 etiketto/ui/printing.py:541
#, python-format
msgid "Rows: %s"
msgstr "Read: %s"

#: etiketto/cli.py:759
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Ootan, kuni faili %s teine printimine lõpeb…"

#: etiketto/cli.py:766
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s on endiselt teise printimise poolt lukus – proovi hiljem uuesti"

#: etiketto/cli.py:772
msgid "--output needs --dry-run"
msgstr "--output nõuab --dry-run"

#: etiketto/cli.py:784
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Järgmist loenduri väärtust ei salvestata: järgmine printimine kordab numbreid"

