msgid "Warming up…"
msgstr "Memanaskan…"

#: etiketto/ui/texts.py:208
msgid "Cooling down…"
msgstr "Mendinginkan…"

#: etiketto/ui/texts.py:209
msgid "Cleaning…"
msgstr "Membersihkan…"

#: etiketto/ui/texts.py:210
