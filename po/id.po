#: etiketto/app.py:200 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Rancang dan cetak label"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ide untuk variabel (penghitung, tanggal, UUID), tanpa kode"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "Pengetahuan protokol"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Dari %(projects)s dan panduan produsen, ditulis ulang tanpa kode mereka; lihat THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "diharapkan NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "diharapkan bilangan bulat dari %(min)d sampai %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "diharapkan baris seperti 3-10, 5 atau 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Tanpa perintah, aplikasi dimulai; berkas label yang diberikan dibuka di dalamnya."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "cetak berkas label tanpa membuka jendela"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Cetak berkas label tanpa membuka jendela."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "label (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "model pencetak, secara bawaan milik label: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "alamat pencetak, secara bawaan yang diatur di aplikasi"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "jumlah salinan"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "teks elemen NAME, atau nilai variabel {=NAME}; variabel dalam teks diisi; dapat diulang"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "seperti --set, tetapi nilai dipakai apa adanya: kurung kurawal bukan variabel"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "penghitung label pertama, bukan yang tersimpan di label"

#: etiketto/cli.py:204
msgid ""
"print with the printer model's defaults instead of the cut, mode, quality "
"and printer settings last chosen in the app"
msgstr "cetak dengan bawaan model printer, bukan potongan, mode, kualitas, dan pengaturan printer yang terakhir dipilih di aplikasi"

#: etiketto/cli.py:211
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "jangan tanyakan printer sebelum merender (model, pita, dan resolusinya)"

#: etiketto/cli.py:217
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "jangan simpan nilai penghitung berikutnya di label (berkas hanya-baca); pencetakan berikutnya mulai dari nomor yang sama"

#: etiketto/cli.py:226
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "label seri: satu label untuk setiap baris berkas CSV, ODS, atau XLSX ini; bawaannya berkas data label"

#: etiketto/cli.py:231
msgid "the sheet of the data file, by default the first"
msgstr "lembar berkas data, bawaannya yang pertama"

#: etiketto/cli.py:237
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "hanya baris-baris berkas data ini, mis. 3-10, 5 atau 7- (dihitung dari 1)"

#: etiketto/cli.py:240
msgid "check and render only, do not print"
msgstr "hanya periksa dan render, jangan cetak"

#: etiketto/cli.py:246
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "dengan --dry-run: simpan gambar sebagai PNG seperti yang akan diterima pencetak (- untuk stdout: hanya yang pertama)"

#: etiketto/cli.py:252
msgid "list the printers found on the network"
msgstr "tampilkan daftar pencetak yang ditemukan di jaringan"

#: etiketto/cli.py:253
msgid "List the printers found on the network: model, address, name."
msgstr "Menampilkan daftar pencetak yang ditemukan di jaringan: model, alamat, nama."

#: etiketto/cli.py:255
#, python-format
msgid "only this printer model: %s"
msgstr "hanya model pencetak ini: %s"

#: etiketto/cli.py:274
#, python-format
msgid "Unknown printer model: %s"
msgstr "Model pencetak tidak dikenal: %s"

#: etiketto/cli.py:281 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:240 etiketto/ui/texts.py:528
#, python-format
msgid "Cannot open %s"
msgstr "Tidak dapat membuka %s"

#: etiketto/cli.py:303
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bukan tanggal, diharapkan mis. 2026-12-31 atau 2026-12-31T08:30"

#: etiketto/cli.py:333
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} diisi saat pencetakan dan tidak dapat diatur"

#: etiketto/cli.py:338
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Label tidak memiliki elemen atau variabel bernama %s"

#: etiketto/cli.py:362 etiketto/ui/printing.py:99
msgid "The label is empty"
msgstr "Label kosong"

#: etiketto/cli.py:395
msgid "Cannot write the output"
msgstr "Tidak dapat menulis keluaran"

#: etiketto/cli.py:426
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output menulis gambar PNG: berikan nama yang berakhiran .png"

#: etiketto/cli.py:450 etiketto/cli.py:654 etiketto/ui/printing.py:540
#: etiketto/ui/printing.py:702
msgid "The label cannot be prepared for printing."
msgstr "Label tidak dapat disiapkan untuk dicetak."

#: etiketto/cli.py:532
msgid "No printer found – give its address with --host"
msgstr "Pencetak tidak ditemukan – berikan alamatnya dengan --host"

#: etiketto/cli.py:534
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Beberapa pencetak ditemukan – pilih satu dengan --host (etiketto list-printers)"

#: etiketto/cli.py:545 etiketto/ui/texts.py:571
#, python-format
msgid "Cannot save %s"
msgstr "Tidak dapat menyimpan %s"

#: etiketto/cli.py:547
msgid "the labels were printed, but the next counter value was not saved"
msgstr "label sudah dicetak, tetapi nilai penghitung berikutnya tidak tersimpan"

#: etiketto/cli.py:562
msgid "nothing was printed: the next counter value could not be saved"
msgstr "tidak ada yang dicetak: nilai penghitung berikutnya tidak akan dapat disimpan"

#: etiketto/cli.py:622 etiketto/cli.py:649 etiketto/cli.py:947
msgid "Interrupted"
msgstr "Dihentikan"

#: etiketto/cli.py:745
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Label menggunakan berkas data di luar foldernya: berikan dengan --data"

#: etiketto/cli.py:751
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet dan --rows memerlukan berkas data (--data)"

#: etiketto/cli.py:771 etiketto/ui/printing.py:572
msgid "No rows to print"
msgstr "Tidak ada baris untuk dicetak"

#: etiketto/cli.py:780 etiketto/ui/window.py:598
#, python-format
msgid "No such column: %s"
msgstr "Kolom tidak ada: %s"

#: etiketto/cli.py:785 etiketto/ui/printing.py:651
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Kode batang atau kode QR baris-baris ini tidak dapat dibuat dari nilainya, misalnya EAN-13 dengan huruf atau sel kosong. Perbaiki berkas data lalu baca lagi, atau cetak tanpa baris-baris ini."

#: etiketto/cli.py:790 etiketto/ui/printing.py:656
#, python-format
msgid "Rows: %s"
msgstr "Baris: %s"

#: etiketto/cli.py:798
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Menunggu pencetakan lain dari %s selesai…"

#: etiketto/cli.py:805
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s masih dikunci oleh pencetakan lain – coba lagi nanti"

#: etiketto/cli.py:811
msgid "--output needs --dry-run"
msgstr "--output memerlukan --dry-run"

#: etiketto/cli.py:828
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nilai penghitung berikutnya tidak disimpan: pencetakan berikutnya mengulang nomor-nomornya"

#: etiketto/cli.py:905
msgid "Waiting for the printer's answer…"
msgstr "Menunggu jawaban printer…"

#: etiketto/cli.py:923 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "Pencetak tidak ditemukan"

