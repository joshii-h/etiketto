msgstr "7 digit, digit pemeriksa ditambahkan otomatis (atau 8 digit dengan digit pemeriksa)"

#: etiketto/ui/texts.py:134
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 digit, digit pemeriksa ditambahkan otomatis (atau 12 digit dengan digit pemeriksa)"

#: etiketto/ui/texts.py:135
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 digit yang diawali 0 atau 1, digit pemeriksa ditambahkan otomatis (atau 8 digit dengan digit pemeriksa)"

#: etiketto/ui/texts.py:136
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 digit GTIN karton pengiriman, digit pemeriksa ditambahkan otomatis (atau 14 digit dengan digit pemeriksa)"

#: etiketto/ui/texts.py:142
msgid "Whole area, centred"
msgstr "Seluruh area, di tengah"

#: etiketto/ui/texts.py:142
msgid "Fill the label, edges cut off"
msgstr "Penuhi label, tepi terpotong"

#: etiketto/ui/texts.py:156
#, python-format
msgid "Not an image: %s"
msgstr "Bukan gambar: %s"

#. translators: the print density a NIIMBOT model uses by default
#: etiketto/ui/texts.py:174
msgctxt "print density"
msgid "Default"
msgstr "Bawaan"

#: etiketto/ui/texts.py:178
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:181
#, python-format
msgid "%d in/s"
msgstr "%d inci/dtk"

#: etiketto/ui/texts.py:190
msgid "Image"
msgstr "Gambar"

#: etiketto/ui/texts.py:217
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Kontinu, lebar %(width)s"

#: etiketto/ui/texts.py:227
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Periksa bahwa seluruh label ada di dalam pilihan. Seret untuk memindahkan pilihan atau tepinya, atau gambar yang baru."

#: etiketto/ui/texts.py:231
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Beberapa area bisa jadi label. Periksa pilihan atau coba yang berikutnya."

#: etiketto/ui/texts.py:233
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Semua yang tercetak di halaman dipilih. Seret untuk memilih label."

#: etiketto/ui/texts.py:234
msgid "Nothing is printed on this page."
msgstr "Tidak ada yang tercetak di halaman ini."

#: etiketto/ui/texts.py:239
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "File PDF memerlukan Poppler (poppler-glib), yang belum terpasang"

#: etiketto/ui/texts.py:250
msgid "System printer (CUPS, IPP)"
msgstr "Pencetak sistem (CUPS, IPP)"

#: etiketto/ui/texts.py:251
msgid "Receipt printer (ESC/POS)"
msgstr "Printer struk (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:253
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, gulungan bersambung"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:255
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, label potong"

#: etiketto/ui/texts.py:262
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemen %(n)d: kode kosong"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemen %(n)d: EAN-13 memerlukan tepat 12 digit"

#: etiketto/ui/texts.py:264
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemen %(n)d: digit pemeriksa EAN-13 salah"

#: etiketto/ui/texts.py:266
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 128 hanya menerima huruf Latin, angka, dan tanda baca"

#: etiketto/ui/texts.py:268
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemen %(n)d: EAN-8 memerlukan 7 digit, atau 8 digit dengan digit pemeriksa"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemen %(n)d: UPC-A memerlukan 11 digit, atau 12 digit dengan digit pemeriksa"

#: etiketto/ui/texts.py:271
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemen %(n)d: UPC-E memerlukan 7 digit yang diawali 0 atau 1, atau 8 digit dengan digit pemeriksa"

#: etiketto/ui/texts.py:273
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemen %(n)d: ITF-14 memerlukan 13 digit, atau 14 digit dengan digit pemeriksa"

#: etiketto/ui/texts.py:274
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemen %(n)d: digit pemeriksa salah"

#: etiketto/ui/texts.py:276
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemen %(n)d: Code 39 hanya menerima huruf kapital, angka, spasi, dan - . $ / + %%"

#: etiketto/ui/texts.py:279
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: Code 93 hanya menerima huruf Latin, angka, dan tanda baca"

#: etiketto/ui/texts.py:282
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemen %(n)d: data GS1 hanya menerima huruf Latin, angka, dan tanda baca"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemen %(n)d: data GS1 harus berupa pengenal aplikasi dalam tanda kurung, masing-masing diikuti nilainya, mis. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:288
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemen %(n)d: (%(ai)s) bukan pengenal aplikasi GS1"

#: etiketto/ui/texts.py:290
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemen %(n)d: panjang nilai pengenal aplikasi (%(ai)s) salah"

#: etiketto/ui/texts.py:293
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemen %(n)d: digit pemeriksa pengenal aplikasi (%(ai)s) salah"

#: etiketto/ui/texts.py:296
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemen %(n)d: nilai pengenal aplikasi (%(ai)s) tidak valid: berisi tanggal, angka, atau karakter yang tidak diizinkan"

#: etiketto/ui/texts.py:300
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemen %(n)d: tidak ada nomor UPC-A yang dipendekkan menjadi digit UPC-E ini – periksa atau gunakan UPC-A"

#: etiketto/ui/texts.py:304
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemen %(n)d: pemindai yang diatur ke Full ASCII membaca $, /, + atau %% sebelum huruf kapital sebagai karakter lain"

#: etiketto/ui/texts.py:307
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemen %(n)d: isi terlalu panjang untuk jenis kode ini"

#: etiketto/ui/texts.py:308
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemen %(n)d: isi tidak dapat dikodekan dalam jenis kode ini"

#: etiketto/ui/texts.py:310
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemen %(n)d: jenis kode ini memerlukan pustaka Zint (zint-bindings), yang belum terpasang"

#: etiketto/ui/texts.py:313
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemen %(n)d: gambar tidak dapat dibaca"

#: etiketto/ui/texts.py:314
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemen %(n)d: simbol ini tidak ada di pustaka simbol"

#: etiketto/ui/texts.py:315
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemen %(n)d: dokumen tidak dapat dibaca"

#: etiketto/ui/texts.py:317
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemen %(n)d: file PDF memerlukan Poppler (poppler-glib), yang belum terpasang"

#: etiketto/ui/texts.py:319
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Elemen %(n)d tidak dapat digambar"

#: etiketto/ui/texts.py:320
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Margin aman, bingkai, dan jarak tepi tidak menyisakan ruang – kurangi nilainya"

#: etiketto/ui/texts.py:321
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Panjang tetap lebih pendek dari jarak – perbesar panjangnya"

#: etiketto/ui/texts.py:322
msgid "The background image cannot be read"
msgstr "Gambar latar tidak dapat dibaca"

#: etiketto/ui/texts.py:324
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemen %(n)d: modul kode hanya selebar satu titik cetak dan mungkin tidak dapat dipindai – perbesar kodenya"

#: etiketto/ui/texts.py:328
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemen %(n)d: ruang kosong yang diperlukan di sekitar kode tidak muat – perbesar kodenya"

#: etiketto/ui/texts.py:332
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemen %(n)d: kode tidak muat di tempatnya, bahkan dengan satu titik cetak per modul – perbesar label atau persingkat isinya"

#: etiketto/ui/texts.py:335
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemen %(n)d: %(name)s bukan variabel yang dikenal"

#: etiketto/ui/texts.py:337
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemen %(n)d: tanggal %(name)s sebelum tahun 1 atau setelah 9999"

#: etiketto/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemen %(n)d: variabel %(name)s… tidak ditutup – akhiri dengan }"

#: etiketto/ui/texts.py:354
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Lembar yang sudah dicetak: %(n)d dari %(total)d."

#: etiketto/ui/texts.py:356
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Label yang sudah dicetak: %(n)d dari %(total)d."

#: etiketto/ui/texts.py:360
msgid "The sheets still waiting in the queue were canceled."
msgstr "Lembar yang masih menunggu dalam antrean telah dibatalkan."

#: etiketto/ui/texts.py:362
msgid "The labels still waiting in the queue were canceled."
msgstr "Label yang masih menunggu dalam antrean telah dibatalkan."

#: etiketto/ui/texts.py:371
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Pencetak tidak ditemukan. Pastikan pencetak menyala dan berada di jaringan yang sama, atau masukkan alamat IP-nya."

#: etiketto/ui/texts.py:375
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Pencetak tidak ditemukan melalui USB. Periksa kabel dan pastikan pencetak menyala dan tidak dalam mode tidur, lalu cari lagi."

#: etiketto/ui/texts.py:378
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Pencetak tidak menjawab. Pastikan pencetak menyala dan tidak dalam mode tidur."

#: etiketto/ui/texts.py:380
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Printer berhenti menerima data. Periksa apakah printer menampilkan masalah, misalnya label habis atau penutup terbuka, lalu coba lagi."

#: etiketto/ui/texts.py:384
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Pencetak menolak koneksi. Matikan lalu nyalakan lagi. Jika antarmuka webnya menyediakan opsi “Port 9100”, aktifkan opsi itu."

#: etiketto/ui/texts.py:387
msgid "No cassette is inserted. Insert one and try again."
msgstr "Tidak ada kaset terpasang. Pasang kaset, lalu coba lagi."

#: etiketto/ui/texts.py:388
msgid "The printer's cover is open. Close it and try again."
msgstr "Penutup pencetak terbuka. Tutup, lalu coba lagi."

#: etiketto/ui/texts.py:389
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Label macet. Buka penutup, keluarkan label, lalu coba lagi."

#: etiketto/ui/texts.py:390
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tidak dikenali. Pasang ulang atau coba kaset lain."

#: etiketto/ui/texts.py:391
msgid "The printer is busy. Wait a moment and try again."
msgstr "Pencetak sedang sibuk. Tunggu sebentar, lalu coba lagi."

#: etiketto/ui/texts.py:392
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Label terlalu panjang untuk pencetak ini: maksimal %(max)s."

#: etiketto/ui/texts.py:393
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Label terlalu lebar untuk pencetak ini: maksimal %(max)s."

#: etiketto/ui/texts.py:394
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Label pada pencetak habis. Pasang gulungan baru dan coba lagi."

#: etiketto/ui/texts.py:395
msgid "The print head is open. Close it and try again."
msgstr "Kepala cetak terbuka. Tutup lalu coba lagi."

#: etiketto/ui/texts.py:397
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Pencetak tidak dapat menemukan label berikutnya. Periksa apakah label terpasang dengan benar dan melewati sensor label."

#: etiketto/ui/texts.py:401
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Ada masalah pada pita tinta. Periksa apakah terpasang dengan benar dan sesuai dengan metode cetak yang diatur pada pencetak."

#: etiketto/ui/texts.py:404
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Pencetak dijeda. Lanjutkan dari layarnya lalu coba lagi."

#: etiketto/ui/texts.py:405
msgid "The printer is out of paper. Load paper and try again."
msgstr "Kertas pencetak habis. Isi kertas lalu coba lagi."

#: etiketto/ui/texts.py:407
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Kertas macet. Keluarkan seperti yang ditunjukkan layar pencetak, lalu coba lagi."

#: etiketto/ui/texts.py:409
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Toner atau tinta pencetak habis. Ganti, lalu coba lagi."

#: etiketto/ui/texts.py:410
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Pencetak tidak dapat mencetak ukuran ini. Pilih ukuran kertas yang tersedia di pencetak."

#: etiketto/ui/texts.py:412
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Pencetak tidak menerima satu pun format yang dapat dikirim Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:415
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Antrean pencetak dijeda. Lanjutkan di pengaturan pencetak sistem lalu coba lagi."

#: etiketto/ui/texts.py:419
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Tugas cetak ditahan di antrean, misalnya sampai dilepaskan atau kata sandi dimasukkan. Periksa antrean di pengaturan pencetak sistem lalu coba lagi."

#: etiketto/ui/texts.py:423
msgid "The print job was canceled at the printer or in the queue."
msgstr "Tugas cetak dibatalkan di pencetak atau di antrean."

#: etiketto/ui/texts.py:424
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Printer tidak melaporkan resolusinya tepat waktu. Pilih di “%s”."

#: etiketto/ui/texts.py:427
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Gulungan yang terpasang tidak cocok dengan label. Pasang gulungan yang cocok, atau pilih ukuran label atau model pencetak untuk gulungan yang terpasang."

#: etiketto/ui/texts.py:430
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Baterai printer lemah – isi daya atau sambungkan adaptor daya."

#: etiketto/ui/texts.py:431
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Kepala cetak terlalu panas. Tunggu sampai dingin, lalu coba lagi."

#: etiketto/ui/texts.py:433
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto tidak dapat mencetak pada model printer ini: printer tidak menerima gambar raster yang dikirim Etiketto."

#: etiketto/ui/texts.py:437
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto belum mengenal model printer ini dan belum dapat mencetak padanya."

#: etiketto/ui/texts.py:440
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Printer dalam mode Editor Lite dan tampil sebagai drive USB. Matikan Editor Lite pada printer (lampunya padam), lalu cari lagi."

#: etiketto/ui/texts.py:444
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto tidak diizinkan menggunakan port USB pencetak. Tambahkan pengguna Anda ke grup “lp” (sudo usermod -aG lp $USER), lalu keluar dan masuk kembali."

#: etiketto/ui/texts.py:448
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Halaman terlalu besar untuk dibuat pada resolusi yang diterima printer. Pilih ukuran kertas yang lebih kecil, atau cetak pada printer yang menerima PDF."

#: etiketto/ui/texts.py:452
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Pada resolusi printer ini, kode tidak muat di label dan akan terpotong. Perbesar label atau persingkat isi kode."

#: etiketto/ui/texts.py:456
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto tidak diizinkan menggunakan port serial pencetak. Tambahkan pengguna Anda ke grup “dialout” (sudo usermod -aG dialout $USER; di Arch Linux nama grupnya “uucp”), lalu keluar dan masuk kembali."

#: etiketto/ui/texts.py:461
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Pencetak melaporkan masalah. Matikan lalu nyalakan lagi, kemudian coba sekali lagi."

#: etiketto/ui/texts.py:472
msgid "Printed"
msgstr "Telah dicetak"

#: etiketto/ui/texts.py:478
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Terkirim ke pencetak – akan dicetak saat tiba gilirannya"

#: etiketto/ui/texts.py:480
msgid "Sent to the printer – it did not confirm printing"
msgstr "Dikirim ke printer – printer tidak mengonfirmasi pencetakan"

#: etiketto/ui/texts.py:484
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Dicetak dengan “%(used)s” karena gulungan yang terpasang memerlukannya"

#: etiketto/ui/texts.py:488
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Mode warna “%(wanted)s” tidak tersedia pada pencetak ini, dicetak dengan “%(used)s”"

#: etiketto/ui/texts.py:498
msgid "Warming up…"
msgstr "Memanaskan…"

#: etiketto/ui/texts.py:499
msgid "Cooling down…"
msgstr "Mendinginkan…"

#: etiketto/ui/texts.py:500
msgid "Cleaning…"
msgstr "Membersihkan…"

#: etiketto/ui/texts.py:501
msgid "Swipe the printer's panel to cut the label"
msgstr "Usap panel pencetak untuk memotong label"

#: etiketto/ui/texts.py:503
msgid "Out of paper – load paper to continue"
msgstr "Kertas habis – isi kertas untuk melanjutkan"

#: etiketto/ui/texts.py:504
msgid "Cover open – close it to continue"
msgstr "Penutup terbuka – tutup untuk melanjutkan"

#: etiketto/ui/texts.py:505
msgid "Paper jammed – remove it to continue"
msgstr "Kertas macet – keluarkan untuk melanjutkan"

#: etiketto/ui/texts.py:516
msgid "This label needs a newer version of Etiketto"
msgstr "Label ini memerlukan Etiketto versi yang lebih baru"

#: etiketto/ui/texts.py:518
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s bukan label Etiketto"

#: etiketto/ui/texts.py:519 etiketto/ui/texts.py:539
#, python-format
msgid "The file is damaged: %s"
msgstr "Berkas rusak: %s"

#: etiketto/ui/texts.py:526
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Berkas data %s sudah tidak ada. Pilih lagi atau hapus."

#: etiketto/ui/texts.py:530
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s tidak memiliki lembar bernama %(sheet)s"

#: etiketto/ui/texts.py:532
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s bukan tabel. Gunakan berkas CSV, ODS, atau XLSX."

#: etiketto/ui/texts.py:534
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s terlalu besar untuk label seri. Bagi menjadi berkas yang lebih kecil atau hapus baris dan kolom yang tidak diperlukan."

#: etiketto/ui/texts.py:537
#, python-format
msgid "%s contains no data."
msgstr "%s tidak berisi data."

#: etiketto/ui/texts.py:548
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Pencetakan berhenti di baris %(row)d. Untuk melanjutkan, cetak lagi mulai dari baris %(row)d."

#: etiketto/ui/texts.py:552
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Salinan baris %(row)d yang sudah dicetak: %(copies)d."

#: etiketto/ui/texts.py:557
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Baris %(row)d berada di posisi %(position)d pada lembar %(sheet)d."

#: etiketto/ui/texts.py:568
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Tidak dapat menyimpan %s: tidak ada izin menulis di sana"

#: etiketto/ui/texts.py:570
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Tidak dapat menyimpan %s: diska penuh"

#: etiketto/ui/texts.py:580
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kaset ini tampaknya dibuat pada %(month)s %(year)d. Kertas ZINK lama mencetak warna yang lebih pucat."

