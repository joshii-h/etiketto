#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Label ini menggunakan berkas data di luar foldernya:\n\n%s\n\nBaca hanya jika Anda tahu dari mana label ini berasal."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Jangan sekarang"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Baca berkas data"

#: tavletta/ui/data.py:265
