msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabel (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Pilih berkas data"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:109 tavletta/ui/files.py:131
#: tavletta/ui/files.py:212 tavletta/ui/texts.py:205
msgid "Only local files can be used"
msgstr "Hanya berkas lokal yang dapat dipakai"

#: tavletta/ui/data.py:167
