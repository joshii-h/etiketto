#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Kotak dan bingkai"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Rancang dan cetak label"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta adalah bahasa Romansh untuk papan kecil (dari tavla, papan/meja). Dibaca tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ide untuk variabel (penghitung, tanggal, UUID), tanpa kode"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "Pengetahuan protokol"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Dari %(projects)s dan panduan produsen, ditulis ulang tanpa kode mereka; lihat THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "diharapkan NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "diharapkan bilangan bulat dari %(min)d sampai %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "diharapkan baris seperti 3-10, 5 atau 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Tanpa perintah, aplikasi dimulai; berkas label yang diberikan dibuka di dalamnya."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "cetak berkas label tanpa membuka jendela"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Cetak berkas label tanpa membuka jendela."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "label (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "model pencetak, secara bawaan milik label: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "alamat pencetak, secara bawaan yang diatur di aplikasi"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "jumlah salinan"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "teks elemen NAME, atau nilai variabel {=NAME}; variabel dalam teks diisi; dapat diulang"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "seperti --set, tetapi nilai dipakai apa adanya: kurung kurawal bukan variabel"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "penghitung label pertama, bukan yang tersimpan di label"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "cetak dengan bawaan model printer, bukan potongan, warna, kualitas, tambahan (cetak berantai, resolusi tinggi, umpan pita), pengaturan printer, dan garis luar lembar label yang terakhir dipilih di aplikasi; alamat dan margin aman tetap"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "metode cetak printer termal yang memiliki pengaturan ini: printer (sesuai pengaturan printer), transfer (dengan pita) atau direct (termal langsung, tanpa pita); secara bawaan metode yang dipilih di aplikasi, dengan --printer-defaults metode yang diatur di printer"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "jangan tanyakan printer sebelum merender (model, pita, dan resolusinya)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "jangan simpan nilai penghitung berikutnya di label (berkas hanya-baca); pencetakan berikutnya mulai dari nomor yang sama"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "label seri: satu label untuk setiap baris berkas CSV, ODS, atau XLSX ini; bawaannya berkas data label"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "lembar berkas data, bawaannya yang pertama"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "hanya baris-baris berkas data ini, mis. 3-10, 5 atau 7- (dihitung dari 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "hanya periksa dan render, jangan cetak"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "dengan --dry-run: simpan setiap label sebagai PNG seperti yang diekspor jendela, paling tinggi 600 dpi (- untuk stdout: hanya yang pertama)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "tampilkan daftar pencetak yang ditemukan di jaringan"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "Menampilkan daftar pencetak yang ditemukan di jaringan: model, alamat, nama."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "hanya model pencetak ini: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "diharapkan alamat atau jaringan seperti 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "folder berisi berkas label yang boleh digunakan server"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "hanya cetak ke alamat pencetak ini (* cocok dengan apa saja); dapat diulang"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: pencetak yang boleh digunakan klien, berdasarkan nama"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "label terbanyak dalam satu tugas cetak, salinan kali baris (bawaan 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "cari pencetak di jaringan (mati secara bawaan)"

#: tavletta/cli.py:337
msgid "run a print server with a REST API"
msgstr "jalankan server cetak dengan REST API"

#: tavletta/cli.py:338
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Jalankan server cetak: REST API dan, dengan --mcp, MCP untuk klien AI."

#: tavletta/cli.py:341
msgid "address to listen on (default 127.0.0.1)"
msgstr "alamat untuk mendengarkan (bawaan 127.0.0.1)"

#: tavletta/cli.py:347
#, python-format
msgid "port to listen on (default %d)"
msgstr "port untuk mendengarkan (bawaan %d)"

#: tavletta/cli.py:353
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "berkas berisi token akses; jika tidak ada, variabel lingkungan TAVLETTA_TOKEN"

#: tavletta/cli.py:359
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: token akses bernama beserta perannya"

#: tavletta/cli.py:361
msgid "also serve MCP at /mcp"
msgstr "sajikan juga MCP di /mcp"

#: tavletta/cli.py:367
msgid "largest request body in MB (default 4)"
msgstr "ukuran badan permintaan terbesar dalam MB (bawaan 4)"

#: tavletta/cli.py:376
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "proksi balik yang header X-Forwarded-For-nya menyebutkan klien, mis. 172.16.0.0/12; dapat diulang"

#: tavletta/cli.py:385
msgid "allow requests from web pages of this origin; repeatable"
msgstr "izinkan permintaan dari halaman web dengan asal ini; dapat diulang"

#: tavletta/cli.py:390
msgid "serve MCP on standard input and output"
msgstr "sajikan MCP melalui input dan output standar"

#: tavletta/cli.py:392
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Sajikan MCP melalui input dan output standar, untuk klien AI seperti Claude Desktop."

#: tavletta/cli.py:402
msgid "manage the access tokens of the print server"
msgstr "kelola token akses server cetak"

#: tavletta/cli.py:403
msgid "Manage the access tokens of the print server."
msgstr "Kelola token akses server cetak."

#: tavletta/cli.py:408
msgid "make a token and add its hash to tokens.toml"
msgstr "buat token dan tambahkan hash-nya ke tokens.toml"

#: tavletta/cli.py:409
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Buat token, tambahkan hash-nya ke tokens.toml, dan tampilkan token sekali saja."

#: tavletta/cli.py:411
msgid "name of the token, e.g. the device"
msgstr "nama token, mis. perangkatnya"

#: tavletta/cli.py:416
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: hanya melihat; print: juga mencetak; admin: juga semua tugas"

#: tavletta/cli.py:418
msgid "tokens.toml to add it to"
msgstr "berkas tokens.toml tempat menambahkannya"

#: tavletta/cli.py:424
msgid "only this printer of printers.toml; repeatable"
msgstr "hanya pencetak ini dari printers.toml; dapat diulang"

#: tavletta/cli.py:427
msgid "printers.toml, to check --printer"
msgstr "printers.toml, untuk memeriksa --printer"

#: tavletta/cli.py:429
msgid "valid until, e.g. 2027-12-31"
msgstr "berlaku sampai, mis. 2027-12-31"

#: tavletta/cli.py:430
msgid "a note for people"
msgstr "catatan untuk manusia"

#: tavletta/cli.py:432
msgid "store the hash with scrypt instead of SHA-256"
msgstr "simpan hash dengan scrypt alih-alih SHA-256"

#: tavletta/cli.py:438
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ambil token pilihan Anda dari input standar (disimpan dengan scrypt) alih-alih membuat token baru"

#: tavletta/cli.py:458 tavletta/server/config.py:219
#: tavletta/server/service.py:533
#, python-format
msgid "Unknown printer model: %s"
msgstr "Model pencetak tidak dikenal: %s"

#: tavletta/cli.py:465 tavletta/ui/files.py:89 tavletta/ui/files.py:142
#: tavletta/ui/texts.py:303 tavletta/ui/texts.py:640
#: tavletta/server/service.py:681
#, python-format
msgid "Cannot open %s"
msgstr "Tidak dapat membuka %s"

#: tavletta/cli.py:487 tavletta/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bukan tanggal, diharapkan mis. 2026-12-31 atau 2026-12-31T08:30"

#: tavletta/cli.py:524
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} diisi saat pencetakan dan tidak dapat diatur"

#: tavletta/cli.py:528
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Label tidak memiliki elemen atau variabel bernama %s"

#: tavletta/cli.py:554 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1003
msgid "The label is empty"
msgstr "Label kosong"

#: tavletta/cli.py:591
msgid "Cannot write the output"
msgstr "Tidak dapat menulis keluaran"

#: tavletta/cli.py:622
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output menulis gambar PNG: berikan nama yang berakhiran .png"

#: tavletta/cli.py:647 tavletta/cli.py:856 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:908
#: tavletta/server/service.py:931 tavletta/server/service.py:1180
#: tavletta/server/service.py:1325
msgid "The label cannot be prepared for printing."
msgstr "Label tidak dapat disiapkan untuk dicetak."

#: tavletta/cli.py:734
msgid "No printer found – give its address with --host"
msgstr "Pencetak tidak ditemukan – berikan alamatnya dengan --host"

#: tavletta/cli.py:736
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Beberapa pencetak ditemukan – pilih satu dengan --host (tavletta list-printers)"

#: tavletta/cli.py:747 tavletta/ui/texts.py:683 tavletta/server/service.py:1315
#, python-format
msgid "Cannot save %s"
msgstr "Tidak dapat menyimpan %s"

#: tavletta/cli.py:749 tavletta/server/service.py:1318
msgid "the labels were printed, but the next counter value was not saved"
msgstr "label sudah dicetak, tetapi nilai penghitung berikutnya tidak tersimpan"

#: tavletta/cli.py:764 tavletta/server/service.py:1032
msgid "nothing was printed: the next counter value could not be saved"
msgstr "tidak ada yang dicetak: nilai penghitung berikutnya tidak akan dapat disimpan"

#: tavletta/cli.py:824 tavletta/cli.py:851 tavletta/cli.py:1212
msgid "Interrupted"
msgstr "Dihentikan"

#: tavletta/cli.py:924
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: model printer ini tidak memiliki pengaturan metode cetak: %s"

#: tavletta/cli.py:966
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet dan --rows memerlukan berkas data (--data)"

#: tavletta/cli.py:975 tavletta/ui/printing.py:585
#: tavletta/server/service.py:772
msgid "No rows to print"
msgstr "Tidak ada baris untuk dicetak"

#: tavletta/cli.py:985
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Label menggunakan berkas data di luar foldernya: berikan dengan --data"

#: tavletta/cli.py:1012 tavletta/ui/window.py:844
#: tavletta/server/service.py:825
#, python-format
msgid "No such column: %s"
msgstr "Kolom tidak ada: %s"

#: tavletta/cli.py:1017 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Kode batang atau kode QR baris-baris ini tidak dapat dibuat dari nilainya, misalnya EAN-13 dengan huruf atau sel kosong. Perbaiki berkas data lalu baca lagi, atau cetak tanpa baris-baris ini."

#: tavletta/cli.py:1022 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Baris: %s"

#: tavletta/cli.py:1030
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Menunggu pencetakan lain dari %s selesai…"

#: tavletta/cli.py:1037 tavletta/server/service.py:1174
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s masih dikunci oleh pencetakan lain – coba lagi nanti"

#: tavletta/cli.py:1043
msgid "--output needs --dry-run"
msgstr "--output memerlukan --dry-run"

#: tavletta/cli.py:1060
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nilai penghitung berikutnya tidak disimpan: pencetakan berikutnya mengulang nomor-nomornya"

#: tavletta/cli.py:1155
msgid "Waiting for the printer's answer…"
msgstr "Menunggu jawaban printer…"

#: tavletta/cli.py:1183 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Pencetak tidak ditemukan"

