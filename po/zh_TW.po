msgid "None"
msgstr "無"

#: tavletta/ui/texts.py:194
msgctxt "fill"
msgid "Solid"
msgstr "實心"

#: tavletta/ui/texts.py:195
msgid "Hatched"
msgstr "斜線網紋"

#: tavletta/ui/texts.py:197
