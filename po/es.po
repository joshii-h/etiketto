#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Recuadro y marco"

#: etiketto/app.py:217 etiketto/cli.py:170
msgid "Design and print labels"
msgstr "Diseñe e imprima etiquetas"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideas para las variables (contador, fecha, UUID), sin código"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Conocimiento de protocolos"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "De %(projects)s y de los manuales de los fabricantes, escrito de nuevo sin su código; véase THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "se esperaba NAME=VALUE: %s"

#: etiketto/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "se esperaba un número entero de %(min)d a %(max)d: %(value)s"

#: etiketto/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "se esperaban filas como 3-10, 5 o 7-: %s"

#: etiketto/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Sin orden se inicia la aplicación; los archivos de etiqueta indicados se abren en ella."

#: etiketto/cli.py:177
msgid "print a label file without opening a window"
msgstr "imprime un archivo de etiqueta sin abrir una ventana"

#: etiketto/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Imprime un archivo de etiqueta sin abrir una ventana."

#: etiketto/cli.py:180
msgid "the label (.etiketto)"
msgstr "la etiqueta (.etiketto)"

#: etiketto/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modelo de impresora, por defecto el de la etiqueta: %s"

#: etiketto/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "dirección de la impresora, por defecto la configurada en la aplicación"

#: etiketto/cli.py:189
msgid "number of copies"
msgstr "número de copias"

#: etiketto/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "texto del elemento NAME, o valor de la variable {=NAME}; las variables de un texto se rellenan; repetible"

#: etiketto/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "como --set, pero el valor se usa tal cual: las llaves no son variables"

#: etiketto/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contador de la primera etiqueta, en lugar del guardado en la etiqueta"

#: etiketto/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "imprimir con los valores predeterminados del modelo de impresora en lugar del corte, los colores, la calidad, los extras (impresión en cadena, alta resolución, avance de cinta), los ajustes de impresora y los contornos de las hojas de etiquetas elegidos por última vez en la aplicación; la dirección y el margen de seguridad se mantienen"

#: etiketto/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "método de impresión de una impresora térmica que tenga este ajuste: printer (según la configuración de la impresora), transfer (con cinta) o direct (térmica directa, sin cinta); por defecto el elegido en la aplicación, también con --printer-defaults"

#: etiketto/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "no consultar la impresora antes de generar la imagen (su modelo, cinta y resolución)"

#: etiketto/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "no guardar el siguiente valor del contador en la etiqueta (un archivo de solo lectura); la próxima impresión empieza por el mismo número"

#: etiketto/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etiquetas en serie: una etiqueta por cada fila de este archivo CSV, ODS o XLSX; por defecto el archivo de datos de la etiqueta"

#: etiketto/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "la hoja del archivo de datos, por defecto la primera"

#: etiketto/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "solo estas filas del archivo de datos, p. ej. 3-10, 5 o 7- (contadas desde 1)"

#: etiketto/cli.py:267
msgid "check and render only, do not print"
msgstr "solo comprobar y generar la imagen, no imprimir"

#: etiketto/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "con --dry-run: guarda cada etiqueta en PNG tal como la exporta la ventana, a 600 dpi como máximo (- para la salida estándar: solo la primera)"

#: etiketto/cli.py:279
msgid "list the printers found on the network"
msgstr "lista las impresoras encontradas en la red"

#: etiketto/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Lista las impresoras encontradas en la red: modelo, dirección, nombre."

#: etiketto/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "solo este modelo de impresora: %s"

#: etiketto/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "se esperaba una dirección o red como 172.16.0.0/12: %s"

#: etiketto/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "la carpeta con los archivos de etiqueta que puede usar el servidor"

#: etiketto/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "imprimir solo en esta dirección de impresora (* coincide con todo); repetible"

#: etiketto/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: las impresoras que pueden usar los clientes, por nombre"

#: etiketto/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "máximo de etiquetas en un trabajo de impresión, copias por filas (por defecto 10000)"

#: etiketto/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "buscar impresoras en la red (desactivado por defecto)"

#: etiketto/cli.py:336
msgid "run a print server with a REST API"
msgstr "ejecuta un servidor de impresión con una REST API"

#: etiketto/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Ejecuta un servidor de impresión: una REST API y, con --mcp, MCP para clientes de IA."

#: etiketto/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "dirección en la que escuchar (por defecto 127.0.0.1)"

#: etiketto/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "puerto en el que escuchar (por defecto %d)"

#: etiketto/cli.py:352
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "archivo con el token de acceso; si no, la variable de entorno ETIKETTO_TOKEN"

#: etiketto/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: tokens de acceso con nombre y roles"

#: etiketto/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "servir también MCP en /mcp"

#: etiketto/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "tamaño máximo del cuerpo de la solicitud en MB (por defecto 4)"

#: etiketto/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "un proxy inverso cuya cabecera X-Forwarded-For indica el cliente, p. ej. 172.16.0.0/12; repetible"

#: etiketto/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "permitir solicitudes desde páginas web de este origen; repetible"

#: etiketto/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "sirve MCP por la entrada y la salida estándar"

#: etiketto/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Sirve MCP por la entrada y la salida estándar, para clientes de IA como Claude Desktop."

#: etiketto/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "gestiona los tokens de acceso del servidor de impresión"

#: etiketto/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Gestiona los tokens de acceso del servidor de impresión."

#: etiketto/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "crea un token y añade su hash a tokens.toml"

#: etiketto/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Crea un token, añade su hash a tokens.toml y muestra el token una sola vez."

#: etiketto/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "nombre del token, p. ej. el dispositivo"

#: etiketto/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: solo ver; print: también imprimir; admin: también todos los trabajos"

#: etiketto/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml al que añadirlo"

#: etiketto/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "solo esta impresora de printers.toml; repetible"

#: etiketto/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, para comprobar --printer"

#: etiketto/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "válido hasta, p. ej. 2027-12-31"

#: etiketto/cli.py:429
msgid "a note for people"
msgstr "una nota para personas"

#: etiketto/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "guardar el hash con scrypt en lugar de SHA-256"

#: etiketto/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "tomar de la entrada estándar un token elegido por usted (guardado con scrypt) en lugar de crear uno"

#: etiketto/cli.py:457 etiketto/server/config.py:220
#: etiketto/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modelo de impresora desconocido: %s"

#: etiketto/cli.py:464 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:303 etiketto/ui/texts.py:640
#: etiketto/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "No se puede abrir %s"

#: etiketto/cli.py:486 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s no es una fecha, se esperaba p. ej. 2026-12-31 o 2026-12-31T08:30"

#: etiketto/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} se rellena al imprimir y no se puede establecer"

#: etiketto/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "La etiqueta no tiene ningún elemento ni variable llamado %s"

#: etiketto/cli.py:551 etiketto/ui/printing.py:123
#: etiketto/server/service.py:963
msgid "The label is empty"
msgstr "La etiqueta está vacía"

#: etiketto/cli.py:588
msgid "Cannot write the output"
msgstr "No se puede escribir la salida"

#: etiketto/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output escribe imágenes PNG: indica un nombre que termine en .png"

#: etiketto/cli.py:644 etiketto/cli.py:853 etiketto/ui/printing.py:553
#: etiketto/ui/printing.py:715 etiketto/server/service.py:891
#: etiketto/server/service.py:1118 etiketto/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "No se puede preparar la etiqueta para imprimir."

#: etiketto/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "No se encontró ninguna impresora – indique su dirección con --host"

#: etiketto/cli.py:733
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Se encontraron varias impresoras – elija una con --host (etiketto list-printers)"

#: etiketto/cli.py:744 etiketto/ui/texts.py:683 etiketto/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "No se puede guardar %s"

#: etiketto/cli.py:746 etiketto/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "las etiquetas se imprimieron, pero no se guardó el siguiente valor del contador"

#: etiketto/cli.py:761 etiketto/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "no se imprimió nada: el siguiente valor del contador no se podría guardar"

#: etiketto/cli.py:821 etiketto/cli.py:848 etiketto/cli.py:1209
msgid "Interrupted"
msgstr "Interrumpido"

#: etiketto/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: este modelo de impresora no tiene ajuste de método de impresión: %s"

#: etiketto/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet y --rows requieren un archivo de datos (--data)"

#: etiketto/cli.py:972 etiketto/ui/printing.py:585
#: etiketto/server/service.py:764
msgid "No rows to print"
msgstr "No hay filas para imprimir"

#: etiketto/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "La etiqueta usa un archivo de datos fuera de su carpeta: indíquelo con --data"

#: etiketto/cli.py:1009 etiketto/ui/window.py:844
#: etiketto/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "No existe la columna: %s"

#: etiketto/cli.py:1014 etiketto/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "El código de barras o el código QR de estas filas no se puede crear con sus valores, por ejemplo un EAN-13 con letras o una celda vacía. Corrija el archivo de datos y vuelva a leerlo, o imprima sin estas filas."

#: etiketto/cli.py:1019 etiketto/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Filas: %s"

#: etiketto/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Esperando a que termine otra impresión de %s…"

#: etiketto/cli.py:1034 etiketto/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s sigue bloqueado por otra impresión – inténtalo más tarde"

#: etiketto/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output requiere --dry-run"

#: etiketto/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "El siguiente valor del contador no se guarda: la próxima impresión repetirá los números"

#: etiketto/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "Esperando la respuesta de la impresora…"

#: etiketto/cli.py:1180 etiketto/ui/printer.py:199
msgid "No printer found"
msgstr "No se encontró ninguna impresora"

