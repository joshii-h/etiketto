#: etiketto/app.py:235
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemento %(n)d: el código está vacío"

#: etiketto/app.py:236
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemento %(n)d: EAN-13 necesita exactamente 12 dígitos"

#: etiketto/app.py:237
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemento %(n)d: el dígito de control EAN-13 es incorrecto"

#: etiketto/app.py:239
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 128 solo admite letras latinas, dígitos y signos de puntuación"

#: etiketto/app.py:241
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: no se puede leer la imagen"

#: etiketto/app.py:242
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "No se puede dibujar el elemento %(n)d"

#: etiketto/app.py:243
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "El margen de seguridad, el borde y el margen lateral no dejan espacio: redúzcalos"

#: etiketto/app.py:244
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "La longitud fija es menor que el espaciado: auméntela"

#: etiketto/app.py:245
msgid "The background image cannot be read"
msgstr "No se puede leer la imagen de fondo"

#: etiketto/app.py:254
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "No se encuentra la impresora. Compruebe que esté encendida y en la misma red, o escriba su dirección IP."

#: etiketto/app.py:257
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "La impresora no responde. Compruebe que esté encendida y activa."

#: etiketto/app.py:259
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "La impresora rechaza la conexión. Apáguela y vuelva a encenderla. Si su interfaz web ofrece una opción «Port 9100», actívela."

#: etiketto/app.py:262
msgid "No cassette is inserted. Insert one and try again."
msgstr "No hay ningún casete insertado. Inserte uno e inténtelo de nuevo."

#: etiketto/app.py:263
msgid "The printer's cover is open. Close it and try again."
msgstr "La tapa de la impresora está abierta. Ciérrela e inténtelo de nuevo."

#: etiketto/app.py:264
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "La etiqueta está atascada. Abra la tapa, retírela e inténtelo de nuevo."

#: etiketto/app.py:265
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "No se reconoce el casete. Vuelva a insertarlo o pruebe con otro."

#: etiketto/app.py:266
msgid "The printer is busy. Wait a moment and try again."
msgstr "La impresora está ocupada. Espere un momento e inténtelo de nuevo."

#: etiketto/app.py:267
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "La etiqueta es demasiado larga para esta impresora: como máximo %(max)s."

#: etiketto/app.py:269
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "La impresora informó de un problema. Apáguela y vuelva a encenderla, y luego inténtelo otra vez."

