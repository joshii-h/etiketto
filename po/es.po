msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemento %(n)d: el dígito de control es incorrecto"

#: etiketto/ui/texts.py:238
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemento %(n)d: Code 39 solo admite mayúsculas, dígitos, espacios y - . $ / + %%"

#: etiketto/ui/texts.py:241
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 93 solo admite letras latinas, dígitos y signos de puntuación"

#: etiketto/ui/texts.py:244
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: los datos GS1 solo admiten letras latinas, dígitos y signos de puntuación"

#: etiketto/ui/texts.py:247
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemento %(n)d: los datos GS1 deben ser identificadores de aplicación entre paréntesis, cada uno seguido de su valor, p. ej. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:250
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemento %(n)d: (%(ai)s) no es un identificador de aplicación GS1"

#: etiketto/ui/texts.py:252
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemento %(n)d: el valor del identificador de aplicación (%(ai)s) tiene una longitud incorrecta"

#: etiketto/ui/texts.py:255
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemento %(n)d: el dígito de control del identificador de aplicación (%(ai)s) es incorrecto"

#: etiketto/ui/texts.py:258
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemento %(n)d: el valor del identificador de aplicación (%(ai)s) no es válido: contiene una fecha, un número o un carácter no permitido"

#: etiketto/ui/texts.py:262
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemento %(n)d: ningún número UPC-A se abrevia a estos dígitos UPC-E – revíselos o use UPC-A"

#: etiketto/ui/texts.py:266
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemento %(n)d: los escáneres en modo Full ASCII leen un $, /, + o %% delante de una mayúscula como otro carácter"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemento %(n)d: el contenido es demasiado largo para este tipo de código"

#: etiketto/ui/texts.py:270
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemento %(n)d: el contenido no se puede codificar en este tipo de código"

#: etiketto/ui/texts.py:272
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemento %(n)d: este tipo de código necesita la biblioteca Zint (zint-bindings), que no está instalada"

#: etiketto/ui/texts.py:275
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: no se puede leer la imagen"

#: etiketto/ui/texts.py:276
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemento %(n)d: este símbolo no está en la biblioteca de símbolos"

#: etiketto/ui/texts.py:277
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemento %(n)d: no se puede leer el documento"

#: etiketto/ui/texts.py:279
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemento %(n)d: los archivos PDF necesitan Poppler (poppler-glib), que no está instalado"

#: etiketto/ui/texts.py:281
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "No se puede dibujar el elemento %(n)d"

#: etiketto/ui/texts.py:282
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "El margen de seguridad, el borde y el margen lateral no dejan espacio: redúzcalos"

#: etiketto/ui/texts.py:283
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "La longitud fija es menor que el espaciado: auméntela"

#: etiketto/ui/texts.py:284
msgid "The background image cannot be read"
msgstr "No se puede leer la imagen de fondo"

#: etiketto/ui/texts.py:286
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemento %(n)d: los módulos del código tienen solo un punto de impresión de ancho y quizá no se puedan escanear – amplía el código"

#: etiketto/ui/texts.py:290
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemento %(n)d: el espacio en blanco que el código necesita a su alrededor no cabe – amplía el código"

#: etiketto/ui/texts.py:294
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemento %(n)d: el código no cabe en su espacio, ni siquiera con un punto de impresión por módulo – amplía la etiqueta o acorta el contenido"

#: etiketto/ui/texts.py:297
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemento %(n)d: %(name)s no es una variable conocida"

#: etiketto/ui/texts.py:299
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemento %(n)d: la fecha de %(name)s es anterior al año 1 o posterior a 9999"

#: etiketto/ui/texts.py:302
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemento %(n)d: la variable %(name)s… no está cerrada – termínala con }"

#: etiketto/ui/texts.py:316
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Hojas ya impresas: %(n)d de %(total)d."

#: etiketto/ui/texts.py:318
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etiquetas ya impresas: %(n)d de %(total)d."

#: etiketto/ui/texts.py:322
msgid "The sheets still waiting in the queue were canceled."
msgstr "Se cancelaron las hojas que aún esperaban en la cola."

#: etiketto/ui/texts.py:324
msgid "The labels still waiting in the queue were canceled."
msgstr "Se cancelaron las etiquetas que aún esperaban en la cola."

#: etiketto/ui/texts.py:333
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "No se encuentra la impresora. Compruebe que esté encendida y en la misma red, o escriba su dirección IP."

#: etiketto/ui/texts.py:337
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "No se encuentra la impresora por USB. Compruebe el cable y que la impresora esté encendida y activa, y vuelva a buscar."

#: etiketto/ui/texts.py:340
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "La impresora no responde. Compruebe que esté encendida y activa."

#: etiketto/ui/texts.py:342
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "La impresora ha dejado de aceptar datos. Compruebe si muestra algún problema, como falta de etiquetas o una tapa abierta, y vuelva a intentarlo."

#: etiketto/ui/texts.py:346
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "La impresora rechaza la conexión. Apáguela y vuelva a encenderla. Si su interfaz web ofrece una opción «Port 9100», actívela."

#: etiketto/ui/texts.py:349
msgid "No cassette is inserted. Insert one and try again."
msgstr "No hay ningún casete insertado. Inserte uno e inténtelo de nuevo."

#: etiketto/ui/texts.py:350
msgid "The printer's cover is open. Close it and try again."
msgstr "La tapa de la impresora está abierta. Ciérrela e inténtelo de nuevo."

#: etiketto/ui/texts.py:351
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "La etiqueta está atascada. Abra la tapa, retírela e inténtelo de nuevo."

#: etiketto/ui/texts.py:352
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "No se reconoce el casete. Vuelva a insertarlo o pruebe con otro."

#: etiketto/ui/texts.py:353
msgid "The printer is busy. Wait a moment and try again."
msgstr "La impresora está ocupada. Espere un momento e inténtelo de nuevo."

#: etiketto/ui/texts.py:354
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "La etiqueta es demasiado larga para esta impresora: como máximo %(max)s."

#: etiketto/ui/texts.py:355
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "La etiqueta es demasiado ancha para esta impresora: máximo %(max)s."

#: etiketto/ui/texts.py:356
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "La impresora se ha quedado sin etiquetas. Cargue un rollo nuevo e inténtelo de nuevo."

#: etiketto/ui/texts.py:357
msgid "The print head is open. Close it and try again."
msgstr "El cabezal de impresión está abierto. Ciérrelo e inténtelo de nuevo."

#: etiketto/ui/texts.py:359
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "La impresora no encuentra la siguiente etiqueta. Compruebe que las etiquetas estén bien cargadas y pasen por el sensor de etiquetas."

#: etiketto/ui/texts.py:363
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Hay un problema con la cinta de transferencia térmica. Compruebe que esté bien colocada y que coincida con el método de impresión configurado en la impresora."

#: etiketto/ui/texts.py:366
msgid "The printer is paused. Resume it on its display and try again."
msgstr "La impresora está en pausa. Reanúdela desde su pantalla e inténtelo de nuevo."

#: etiketto/ui/texts.py:367
msgid "The printer is out of paper. Load paper and try again."
msgstr "La impresora se ha quedado sin papel. Cargue papel e inténtelo de nuevo."

#: etiketto/ui/texts.py:369
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Hay un atasco de papel. Retírelo como indica la pantalla de la impresora e inténtelo de nuevo."

#: etiketto/ui/texts.py:371
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "La impresora se ha quedado sin tóner o tinta. Sustitúyalo e inténtelo de nuevo."

#: etiketto/ui/texts.py:372
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "La impresora no puede imprimir este tamaño. Elija un tamaño de papel que ofrezca."

#: etiketto/ui/texts.py:374
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "La impresora no acepta ninguno de los formatos que Etiketto puede enviar (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:377
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "La cola de la impresora está en pausa. Reanúdela en los ajustes de impresoras del sistema e inténtelo de nuevo."

#: etiketto/ui/texts.py:381
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "El trabajo de impresión quedó retenido en la cola, por ejemplo hasta que se libere o se introduzca una contraseña. Revise la cola en los ajustes de impresoras del sistema e inténtelo de nuevo."

#: etiketto/ui/texts.py:385
msgid "The print job was canceled at the printer or in the queue."
msgstr "El trabajo de impresión se canceló en la impresora o en la cola."

#: etiketto/ui/texts.py:386
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "La impresora no ha informado de su resolución a tiempo. Elíjala en «%s»."

#: etiketto/ui/texts.py:389
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto no tiene permiso para usar el puerto USB de la impresora. Añada su usuario al grupo «lp» (sudo usermod -aG lp $USER) y vuelva a iniciar sesión."

#: etiketto/ui/texts.py:393
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Un código no cabe en la etiqueta con la resolución de esta impresora y quedaría cortado. Amplía la etiqueta o acorta el contenido del código."

#: etiketto/ui/texts.py:397
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "La impresora informó de un problema. Apáguela y vuelva a encenderla, y luego inténtelo otra vez."

#: etiketto/ui/texts.py:408
msgid "Printed"
msgstr "Impreso"

#: etiketto/ui/texts.py:414
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Enviado a la impresora: se imprimirá cuando le llegue el turno"

#: etiketto/ui/texts.py:418
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "El modo de color «%(wanted)s» no está disponible en esta impresora; se imprimió con «%(used)s»"

#: etiketto/ui/texts.py:428
msgid "Warming up…"
msgstr "Calentando…"

#: etiketto/ui/texts.py:429
msgid "Cooling down…"
msgstr "Enfriando…"

#: etiketto/ui/texts.py:430
msgid "Cleaning…"
msgstr "Limpiando…"

#: etiketto/ui/texts.py:431
msgid "Swipe the printer's panel to cut the label"
msgstr "Deslice el panel de la impresora para cortar la etiqueta"

#: etiketto/ui/texts.py:433
msgid "Out of paper – load paper to continue"
msgstr "Sin papel: cargue papel para continuar"

#: etiketto/ui/texts.py:434
msgid "Cover open – close it to continue"
msgstr "Tapa abierta: ciérrela para continuar"

#: etiketto/ui/texts.py:435
msgid "Paper jammed – remove it to continue"
msgstr "Atasco de papel: retírelo para continuar"

#: etiketto/ui/texts.py:446
msgid "This label needs a newer version of Etiketto"
msgstr "Esta etiqueta necesita una versión más reciente de Etiketto"

#: etiketto/ui/texts.py:448
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s no es una etiqueta de Etiketto"

#: etiketto/ui/texts.py:449 etiketto/ui/texts.py:469
#, python-format
msgid "The file is damaged: %s"
msgstr "El archivo está dañado: %s"

#: etiketto/ui/texts.py:456
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "El archivo de datos %s ya no está. Vuelva a elegirlo o quítelo."

#: etiketto/ui/texts.py:460
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s no tiene ninguna hoja llamada %(sheet)s"

#: etiketto/ui/texts.py:462
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s no es una tabla. Use un archivo CSV, ODS o XLSX."

#: etiketto/ui/texts.py:464
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s es demasiado grande para etiquetas en serie. Divídalo en archivos más pequeños o quite las filas y columnas que no necesite."

#: etiketto/ui/texts.py:467
#, python-format
msgid "%s contains no data."
msgstr "%s no contiene datos."

#: etiketto/ui/texts.py:475
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "La impresión se detuvo en la fila %(row)d. Para continuar, vuelva a imprimir desde la fila %(row)d."

#: etiketto/ui/texts.py:479
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Copias de la fila %(row)d ya impresas: %(copies)d."

#: etiketto/ui/texts.py:489
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "No se puede guardar %s: no tiene permiso de escritura"

#: etiketto/ui/texts.py:491
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "No se puede guardar %s: el disco está lleno"

#: etiketto/ui/texts.py:501
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Este casete parece ser de %(month)s %(year)d. El papel ZINK antiguo imprime colores más pálidos."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Fecha"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Consumir preferentemente antes de (en 30 días)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "Hora"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "Contador"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Contador con ceros a la izquierda"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "Número de copia"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "Número de copias"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "ID aleatorio"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "Insertar variable"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Las variables se rellenan al imprimir. Cada etiqueta impresa recibe el siguiente valor del contador, también de copia en copia. La vista previa muestra los valores de la siguiente impresión."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "Más información sobre las variables"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Aumenta con cada etiqueta impresa, según el paso"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "Siguiente número"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "Paso"

#: etiketto/ui/window.py:116
msgid "Open"
msgstr "Abrir"

#: etiketto/ui/window.py:123
msgid "Templates"
msgstr "Plantillas"

#: etiketto/ui/window.py:129
msgid "Save"
msgstr "Guardar"

#: etiketto/ui/window.py:146
msgid "New label"
msgstr "Etiqueta nueva"

#: etiketto/ui/window.py:147
msgid "Shipping label…"
msgstr "Etiqueta de envío…"

#: etiketto/ui/window.py:148
msgid "Save as…"
msgstr "Guardar como…"

#: etiketto/ui/window.py:150
msgid "Data for serial labels…"
msgstr "Datos para etiquetas en serie…"

#: etiketto/ui/window.py:151
msgid "Forget allowed data files"
msgstr "Olvidar los archivos de datos permitidos"

#: etiketto/ui/window.py:152
msgid "Export PNG…"
msgstr "Exportar como PNG…"

#: etiketto/ui/window.py:153
msgid "Help"
msgstr "Ayuda"

#: etiketto/ui/window.py:154
msgid "Report a problem…"
msgstr "Informar de un problema…"

#: etiketto/ui/window.py:155
msgid "About Etiketto"
msgstr "Acerca de Etiketto"

#: etiketto/ui/window.py:439
msgid "Unsaved label"
msgstr "Etiqueta sin guardar"

#: etiketto/ui/window.py:508
msgid "content scaled down to fit"
msgstr "contenido reducido para que quepa"

#: etiketto/ui/window.py:512
#, python-format
msgid "Problem: %s"
msgstr "Problema: %s"

#: etiketto/ui/window.py:531
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Demasiado larga para esta impresora: como máximo %s"

#: etiketto/ui/window.py:535
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Demasiado ancha para esta impresora: máximo %s"

#: etiketto/ui/window.py:603
msgid "The browser cannot be opened"
msgstr "No se puede abrir el navegador"

#: etiketto/ui/window.py:605
msgid "Copy link"
msgstr "Copiar enlace"

#: etiketto/ui/window.py:660
msgid "Only local files can be dropped"
msgstr "Solo se pueden soltar archivos locales"

#: etiketto/ui/window.py:681
msgid "Please wait until printing has finished"
msgstr "Espere a que termine la impresión"
