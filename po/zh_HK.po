msgstr "無法儲存 %s：沒有寫入權限"

#: etiketto/ui/texts.py:268
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "無法儲存 %s：磁碟已滿"

#: etiketto/ui/texts.py:269
#, python-format
msgid "Cannot save %s"
msgstr "無法儲存 %s"

#: etiketto/ui/texts.py:278
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "此卡匣似乎是 %(year)d 年%(month)s製造。舊的 ZINK 相紙印出的顏色會較淡。"

