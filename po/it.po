#: etiketto/ui/texts.py:71
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Identificatori di applicazione tra parentesi, ad es. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:74
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Link, testo, accesso Wi-Fi; leggibile dai telefoni"

#: etiketto/ui/texts.py:75
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Testo o numeri in poco spazio, ad es. su piccoli componenti"

#: etiketto/ui/texts.py:76
msgid "Much text, e.g. an address or a document number"
msgstr "Molto testo, ad es. un indirizzo o un numero di documento"

#: etiketto/ui/texts.py:77
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Testo o numeri; non richiede margine bianco, ad es. sui biglietti"

#: etiketto/ui/texts.py:78
msgid "Latin letters, digits and punctuation"
msgstr "Lettere latine, cifre e punteggiatura"

#: etiketto/ui/texts.py:79
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Lettere maiuscole, cifre, spazi e - . $ / + %"

#: etiketto/ui/texts.py:80
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Lettere latine, cifre e punteggiatura; più corto di Code 39"

#: etiketto/ui/texts.py:81
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 cifre, la cifra di controllo viene aggiunta (o 13 compresa)"

#: etiketto/ui/texts.py:82
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 cifre, la cifra di controllo viene aggiunta (o 8 compresa)"

#: etiketto/ui/texts.py:83
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 cifre, la cifra di controllo viene aggiunta (o 12 compresa)"

#: etiketto/ui/texts.py:84
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 cifre che iniziano con 0 o 1, la cifra di controllo viene aggiunta (o 8 compresa)"

#: etiketto/ui/texts.py:85
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 cifre del GTIN di un cartone di spedizione, la cifra di controllo viene aggiunta (o 14 compresa)"

#: etiketto/ui/texts.py:91
msgid "Whole area, centred"
msgstr "Area intera, centrata"

#: etiketto/ui/texts.py:91
msgid "Fill the label, edges cut off"
msgstr "Riempi l’etichetta, bordi tagliati"

#: etiketto/ui/texts.py:105
#, python-format
msgid "Not an image: %s"
msgstr "Non è un’immagine: %s"

#: etiketto/ui/texts.py:113
msgid "Image"
msgstr "Immagine"

#: etiketto/ui/texts.py:140
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Continua, larga %(width)s"

#: etiketto/ui/texts.py:150
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Controlla che tutta l’etichetta sia nella selezione. Trascina per spostarla o spostarne i bordi, oppure disegnane una nuova."

#: etiketto/ui/texts.py:154
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Più aree potrebbero essere l’etichetta. Controlla la selezione o prova la successiva."

#: etiketto/ui/texts.py:156
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "È selezionato tutto ciò che è stampato sulla pagina. Trascina per scegliere l’etichetta."

#: etiketto/ui/texts.py:157
msgid "Nothing is printed on this page."
msgstr "Su questa pagina non è stampato nulla."

#: etiketto/ui/texts.py:162
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "I file PDF richiedono Poppler (poppler-glib), che non è installato"

#: etiketto/ui/texts.py:172
msgid "System printer (CUPS, IPP)"
msgstr "Stampante di sistema (CUPS, IPP)"

#: etiketto/ui/texts.py:178
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Elemento %(n)d: il codice è vuoto"

#: etiketto/ui/texts.py:179
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Elemento %(n)d: EAN-13 richiede esattamente 12 cifre"

#: etiketto/ui/texts.py:180
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Elemento %(n)d: la cifra di controllo EAN-13 è errata"

#: etiketto/ui/texts.py:182
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 128 accetta solo lettere latine, cifre e punteggiatura"

#: etiketto/ui/texts.py:184
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Elemento %(n)d: EAN-8 richiede 7 cifre, o 8 con la cifra di controllo"

#: etiketto/ui/texts.py:185
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Elemento %(n)d: UPC-A richiede 11 cifre, o 12 con la cifra di controllo"

#: etiketto/ui/texts.py:187
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Elemento %(n)d: UPC-E richiede 7 cifre che iniziano con 0 o 1, o 8 con la cifra di controllo"

#: etiketto/ui/texts.py:189
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Elemento %(n)d: ITF-14 richiede 13 cifre, o 14 con la cifra di controllo"

#: etiketto/ui/texts.py:190
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Elemento %(n)d: la cifra di controllo è errata"

#: etiketto/ui/texts.py:192
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Elemento %(n)d: Code 39 accetta solo lettere maiuscole, cifre, spazi e - . $ / + %%"

#: etiketto/ui/texts.py:195
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: Code 93 accetta solo lettere latine, cifre e punteggiatura"

#: etiketto/ui/texts.py:198
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Elemento %(n)d: i dati GS1 accettano solo lettere latine, cifre e punteggiatura"

#: etiketto/ui/texts.py:201
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Elemento %(n)d: i dati GS1 devono essere identificatori di applicazione tra parentesi, ciascuno seguito dal suo valore, ad es. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:204
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Elemento %(n)d: (%(ai)s) non è un identificatore di applicazione GS1"

#: etiketto/ui/texts.py:206
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Elemento %(n)d: il valore dell’identificatore di applicazione (%(ai)s) ha la lunghezza sbagliata"

#: etiketto/ui/texts.py:209
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Elemento %(n)d: la cifra di controllo dell’identificatore di applicazione (%(ai)s) è errata"

#: etiketto/ui/texts.py:212
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Elemento %(n)d: il valore dell’identificatore di applicazione (%(ai)s) non è valido: contiene una data, un numero o un carattere non consentito"

#: etiketto/ui/texts.py:216
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Elemento %(n)d: nessun numero UPC-A si abbrevia in queste cifre UPC-E – controllale o usa UPC-A"

#: etiketto/ui/texts.py:220
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Elemento %(n)d: gli scanner impostati su Full ASCII leggono un $, /, + o %% prima di una maiuscola come un altro carattere"

#: etiketto/ui/texts.py:223
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Elemento %(n)d: il contenuto è troppo lungo per questo tipo di codice"

#: etiketto/ui/texts.py:224
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Elemento %(n)d: il contenuto non può essere codificato in questo tipo di codice"

#: etiketto/ui/texts.py:226
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Elemento %(n)d: questo tipo di codice richiede la libreria Zint (zint-bindings), che non è installata"

#: etiketto/ui/texts.py:229
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Elemento %(n)d: impossibile leggere l’immagine"

#: etiketto/ui/texts.py:230
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Elemento %(n)d: questo simbolo non è nella libreria dei simboli"

#: etiketto/ui/texts.py:231
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Elemento %(n)d: impossibile leggere il documento"

#: etiketto/ui/texts.py:233
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Elemento %(n)d: i file PDF richiedono Poppler (poppler-glib), che non è installato"

#: etiketto/ui/texts.py:235
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Impossibile disegnare l’elemento %(n)d"

#: etiketto/ui/texts.py:236
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Margine di sicurezza, bordo e margine laterale non lasciano spazio – riducili"

#: etiketto/ui/texts.py:237
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "La lunghezza fissa è minore della spaziatura – aumentala"

#: etiketto/ui/texts.py:238
msgid "The background image cannot be read"
msgstr "Impossibile leggere l’immagine di sfondo"

#: etiketto/ui/texts.py:240
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Elemento %(n)d: i moduli del codice sono larghi un solo punto di stampa e potrebbero non essere letti – ingrandisci il codice"

#: etiketto/ui/texts.py:244
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Elemento %(n)d: lo spazio vuoto di cui il codice ha bisogno intorno non ci sta – ingrandisci il codice"

#: etiketto/ui/texts.py:248
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Elemento %(n)d: il codice non ci sta nel suo spazio, nemmeno con un punto di stampa per modulo – ingrandisci l’etichetta o accorcia il contenuto"

#: etiketto/ui/texts.py:251
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Elemento %(n)d: %(name)s non è una variabile nota"

#: etiketto/ui/texts.py:253
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Elemento %(n)d: la data di %(name)s è prima dell’anno 1 o dopo il 9999"

#: etiketto/ui/texts.py:256
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Elemento %(n)d: la variabile %(name)s… non è chiusa – terminala con }"

#: etiketto/ui/texts.py:270
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Fogli già stampati: %(n)d di %(total)d."

#: etiketto/ui/texts.py:272
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Etichette già stampate: %(n)d di %(total)d."

#: etiketto/ui/texts.py:276
msgid "The sheets still waiting in the queue were canceled."
msgstr "I fogli ancora in attesa nella coda sono stati annullati."

#: etiketto/ui/texts.py:278
msgid "The labels still waiting in the queue were canceled."
msgstr "Le etichette ancora in attesa nella coda sono state annullate."

#: etiketto/ui/texts.py:287
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Stampante non trovata. Verifica che sia accesa e nella stessa rete, oppure inserisci il suo indirizzo IP."

#: etiketto/ui/texts.py:291
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "La stampante non si trova su USB. Verifica il cavo e che la stampante sia accesa e non in standby, poi cerca di nuovo."

#: etiketto/ui/texts.py:294
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "La stampante non risponde. Verifica che sia accesa e non in standby."

#: etiketto/ui/texts.py:296
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "La stampante non accetta più dati. Controlla se segnala un problema, ad esempio etichette esaurite o un coperchio aperto, poi riprova."

#: etiketto/ui/texts.py:300
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "La stampante rifiuta la connessione. Spegnila e riaccendila. Se la sua interfaccia web offre un’opzione «Port 9100», attivala."

#: etiketto/ui/texts.py:303
msgid "No cassette is inserted. Insert one and try again."
msgstr "Nessuna cassetta inserita. Inseriscine una e riprova."

#: etiketto/ui/texts.py:304
msgid "The printer's cover is open. Close it and try again."
msgstr "Il coperchio della stampante è aperto. Chiudilo e riprova."

#: etiketto/ui/texts.py:305
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "L’etichetta è inceppata. Apri il coperchio, rimuovila e riprova."

#: etiketto/ui/texts.py:306
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Cassetta non riconosciuta. Reinseriscila o provane un’altra."

#: etiketto/ui/texts.py:307
msgid "The printer is busy. Wait a moment and try again."
msgstr "La stampante è occupata. Attendi un momento e riprova."

#: etiketto/ui/texts.py:308
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "L’etichetta è troppo lunga per questa stampante: al massimo %(max)s."

#: etiketto/ui/texts.py:309
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "L’etichetta è troppo larga per questa stampante: al massimo %(max)s."

#: etiketto/ui/texts.py:310
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "La stampante ha finito le etichette. Inserisci un nuovo rotolo e riprova."

#: etiketto/ui/texts.py:311
msgid "The print head is open. Close it and try again."
msgstr "La testina di stampa è aperta. Chiudila e riprova."

#: etiketto/ui/texts.py:313
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "La stampante non trova l’etichetta successiva. Controlla che le etichette siano caricate correttamente e passino attraverso il sensore etichette."

#: etiketto/ui/texts.py:317
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "C’è un problema con il nastro inchiostrato. Controlla che sia inserito correttamente e corrisponda al metodo di stampa impostato sulla stampante."

#: etiketto/ui/texts.py:320
msgid "The printer is paused. Resume it on its display and try again."
msgstr "La stampante è in pausa. Riprendi dal suo display e riprova."

#: etiketto/ui/texts.py:321
msgid "The printer is out of paper. Load paper and try again."
msgstr "La stampante ha finito la carta. Carica la carta e riprova."

#: etiketto/ui/texts.py:323
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "La carta è inceppata. Rimuovila come indicato sul display della stampante e riprova."

#: etiketto/ui/texts.py:325
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "La stampante ha esaurito toner o inchiostro. Sostituiscilo e riprova."

#: etiketto/ui/texts.py:326
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "La stampante non può stampare questa dimensione. Scegli un formato carta che supporta."

#: etiketto/ui/texts.py:328
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "La stampante non accetta nessuno dei formati che Etiketto può inviare (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:331
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "La coda della stampante è in pausa. Riprendila nelle impostazioni della stampante del sistema e riprova."

#: etiketto/ui/texts.py:335
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Il lavoro di stampa è stato trattenuto nella coda, per esempio finché non viene rilasciato o non viene inserita una password. Controlla la coda nelle impostazioni della stampante del sistema e riprova."

#: etiketto/ui/texts.py:339
msgid "The print job was canceled at the printer or in the queue."
msgstr "Il lavoro di stampa è stato annullato sulla stampante o nella coda."

#: etiketto/ui/texts.py:341
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto non è autorizzato a usare la porta USB della stampante. Aggiungi il tuo utente al gruppo «lp» (sudo usermod -aG lp $USER), poi esci e accedi di nuovo."

#: etiketto/ui/texts.py:345
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Un codice non ci sta sull’etichetta alla risoluzione di questa stampante e verrebbe tagliato. Ingrandisci l’etichetta o accorcia il contenuto del codice."

#: etiketto/ui/texts.py:349
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "La stampante ha segnalato un problema. Spegnila e riaccendila, poi riprova."

#: etiketto/ui/texts.py:360
msgid "Printed"
msgstr "Stampato"

#: etiketto/ui/texts.py:366
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Inviato alla stampante – verrà stampato quando sarà il suo turno"

#: etiketto/ui/texts.py:370
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "La modalità colore «%(wanted)s» non è disponibile su questa stampante, stampato con «%(used)s»"

#: etiketto/ui/texts.py:380
msgid "Warming up…"
msgstr "Riscaldamento…"

#: etiketto/ui/texts.py:381
msgid "Cooling down…"
msgstr "Raffreddamento…"

#: etiketto/ui/texts.py:382
msgid "Cleaning…"
msgstr "Pulizia…"

#: etiketto/ui/texts.py:383
msgid "Swipe the printer's panel to cut the label"
msgstr "Scorri il pannello della stampante per tagliare l’etichetta"

#: etiketto/ui/texts.py:385
msgid "Out of paper – load paper to continue"
msgstr "Carta esaurita – carica la carta per continuare"

#: etiketto/ui/texts.py:386
msgid "Cover open – close it to continue"
msgstr "Coperchio aperto – chiudilo per continuare"

#: etiketto/ui/texts.py:387
msgid "Paper jammed – remove it to continue"
msgstr "Carta inceppata – rimuovila per continuare"

#: etiketto/ui/texts.py:398
msgid "This label needs a newer version of Etiketto"
msgstr "Questa etichetta richiede una versione più recente di Etiketto"

#: etiketto/ui/texts.py:400
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s non è un’etichetta Etiketto"

#: etiketto/ui/texts.py:401
#, python-format
msgid "The file is damaged: %s"
msgstr "Il file è danneggiato: %s"

#: etiketto/ui/texts.py:407
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Impossibile salvare %s: nessun permesso di scrittura"

#: etiketto/ui/texts.py:409
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Impossibile salvare %s: il disco è pieno"

#: etiketto/ui/texts.py:419
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Questa cassetta sembra di %(month)s %(year)d. La carta ZINK vecchia stampa colori più tenui."

