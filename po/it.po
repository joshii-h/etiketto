#: etiketto/app.py:200 etiketto/cli.py:157
msgid "Design and print labels"
msgstr "Crea e stampa etichette"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:205
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:213
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Idee per le variabili (contatore, data, UUID), nessun codice"

#: etiketto/app.py:216
msgid "Protocol knowledge"
msgstr "Conoscenza dei protocolli"

#: etiketto/app.py:221
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Da %(projects)s e dai manuali dei produttori, riscritto senza il loro codice; vedi THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:112
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "atteso NAME=VALUE: %s"

#: etiketto/cli.py:128
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "atteso un numero intero da %(min)d a %(max)d: %(value)s"

#: etiketto/cli.py:146 etiketto/cli.py:150
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "righe attese, ad es. 3-10, 5 o 7-: %s"

#: etiketto/cli.py:158
msgid "Without a command the application starts; label files given open in it."
msgstr "Senza comando si avvia l’applicazione; i file di etichetta indicati vi vengono aperti."

#: etiketto/cli.py:164
msgid "print a label file without opening a window"
msgstr "stampa un file di etichetta senza aprire una finestra"

#: etiketto/cli.py:165
msgid "Print a label file without opening a window."
msgstr "Stampa un file di etichetta senza aprire una finestra."

#: etiketto/cli.py:167
msgid "the label (.etiketto)"
msgstr "l’etichetta (.etiketto)"

#: etiketto/cli.py:170
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modello di stampante, per impostazione predefinita quello dell’etichetta: %s"

#: etiketto/cli.py:173
msgid "printer address, by default the one set in the app"
msgstr "indirizzo della stampante, per impostazione predefinita quello impostato nell’app"

#: etiketto/cli.py:176
msgid "number of copies"
msgstr "numero di copie"

#: etiketto/cli.py:186
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "testo dell’elemento NAME, o valore della variabile {=NAME}; le variabili in un testo vengono compilate; ripetibile"

#: etiketto/cli.py:196
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "come --set, ma il valore è usato così com’è: le parentesi graffe non sono variabili"

#: etiketto/cli.py:202
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contatore della prima etichetta, invece di quello salvato nell’etichetta"

#: etiketto/cli.py:208
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed) and printer "
"settings last chosen in the app; the address and the safety margin stay"
msgstr "stampa con i valori predefiniti del modello di stampante invece di taglio, colori, qualità, extra (stampa a catena, alta risoluzione, avanzamento del nastro) e impostazioni scelti per ultimi nell’app; indirizzo e margine di sicurezza restano"

#: etiketto/cli.py:217
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "metodo di stampa di una stampante termica che ha questa impostazione: printer (come impostato sulla stampante), transfer (con nastro) o direct (termico diretto, senza nastro); per impostazione predefinita quello scelto nell’app, anche con --printer-defaults"

#: etiketto/cli.py:225
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "non interrogare la stampante prima del rendering (modello, nastro e risoluzione)"

#: etiketto/cli.py:231
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "non salvare il prossimo valore del contatore nell’etichetta (un file di sola lettura); la prossima stampa riparte dallo stesso numero"

#: etiketto/cli.py:240
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etichette in serie: un’etichetta per ogni riga di questo file CSV, ODS o XLSX; per impostazione predefinita il file di dati dell’etichetta"

#: etiketto/cli.py:245
msgid "the sheet of the data file, by default the first"
msgstr "il foglio del file di dati, per impostazione predefinita il primo"

#: etiketto/cli.py:251
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "solo queste righe del file di dati, ad es. 3-10, 5 o 7- (contate da 1)"

#: etiketto/cli.py:254
msgid "check and render only, do not print"
msgstr "controlla e genera soltanto, non stampare"

#: etiketto/cli.py:260
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "con --dry-run: salva le immagini in PNG come le riceverebbe la stampante (- per stdout: solo la prima)"

#: etiketto/cli.py:266
msgid "list the printers found on the network"
msgstr "elenca le stampanti trovate in rete"

#: etiketto/cli.py:267
msgid "List the printers found on the network: model, address, name."
msgstr "Elenca le stampanti trovate in rete: modello, indirizzo, nome."

#: etiketto/cli.py:269
#, python-format
msgid "only this printer model: %s"
msgstr "solo questo modello di stampante: %s"

#: etiketto/cli.py:288
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modello di stampante sconosciuto: %s"

#: etiketto/cli.py:295 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:249 etiketto/ui/texts.py:566
#, python-format
msgid "Cannot open %s"
msgstr "Impossibile aprire %s"

#: etiketto/cli.py:317
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s non è una data, atteso ad es. 2026-12-31 o 2026-12-31T08:30"

#: etiketto/cli.py:347
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} viene compilato durante la stampa e non può essere impostato"

#: etiketto/cli.py:352
#, python-format
msgid "The label has no element or variable named %s"
msgstr "L’etichetta non ha alcun elemento o variabile chiamato %s"

#: etiketto/cli.py:376 etiketto/ui/printing.py:105
msgid "The label is empty"
msgstr "L’etichetta è vuota"

#: etiketto/cli.py:413
msgid "Cannot write the output"
msgstr "Impossibile scrivere l’output"

#: etiketto/cli.py:444
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output scrive immagini PNG: indica un nome che termina con .png"

#: etiketto/cli.py:469 etiketto/cli.py:674 etiketto/ui/printing.py:536
#: etiketto/ui/printing.py:698
msgid "The label cannot be prepared for printing."
msgstr "Impossibile preparare l’etichetta per la stampa."

#: etiketto/cli.py:552
msgid "No printer found – give its address with --host"
msgstr "Nessuna stampante trovata – indica il suo indirizzo con --host"

#: etiketto/cli.py:554
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Trovate più stampanti – scegline una con --host (etiketto list-printers)"

#: etiketto/cli.py:565 etiketto/ui/texts.py:609
#, python-format
msgid "Cannot save %s"
msgstr "Impossibile salvare %s"

#: etiketto/cli.py:567
msgid "the labels were printed, but the next counter value was not saved"
msgstr "le etichette sono state stampate, ma il prossimo valore del contatore non è stato salvato"

#: etiketto/cli.py:582
msgid "nothing was printed: the next counter value could not be saved"
msgstr "non è stato stampato nulla: il prossimo valore del contatore non potrebbe essere salvato"

#: etiketto/cli.py:642 etiketto/cli.py:669 etiketto/cli.py:1015
msgid "Interrupted"
msgstr "Interrotto"

#: etiketto/cli.py:743
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: questo modello di stampante non ha un’impostazione del metodo di stampa: %s"

#: etiketto/cli.py:785
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "L’etichetta usa un file di dati fuori dalla sua cartella: indicalo con --data"

#: etiketto/cli.py:791
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows richiedono un file di dati (--data)"

#: etiketto/cli.py:811 etiketto/ui/printing.py:568
msgid "No rows to print"
msgstr "Nessuna riga da stampare"

#: etiketto/cli.py:820 etiketto/ui/window.py:597
#, python-format
msgid "No such column: %s"
msgstr "Colonna inesistente: %s"

#: etiketto/cli.py:825 etiketto/ui/printing.py:647
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Il codice a barre o il codice QR di queste righe non può essere creato dai loro valori, ad esempio un EAN-13 con lettere o una cella vuota. Correggi il file di dati e rileggilo, oppure stampa senza queste righe."

#: etiketto/cli.py:830 etiketto/ui/printing.py:652
#, python-format
msgid "Rows: %s"
msgstr "Righe: %s"

#: etiketto/cli.py:838
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "In attesa che finisca un’altra stampa di %s…"

#: etiketto/cli.py:845
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s è ancora bloccato da un’altra stampa – riprova più tardi"

#: etiketto/cli.py:851
msgid "--output needs --dry-run"
msgstr "--output richiede --dry-run"

#: etiketto/cli.py:868
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Il prossimo valore del contatore non viene salvato: la prossima stampa ripeterà i numeri"

#: etiketto/cli.py:963
msgid "Waiting for the printer's answer…"
msgstr "In attesa della risposta della stampante…"

#: etiketto/cli.py:991 etiketto/ui/printer.py:199
msgid "No printer found"
msgstr "Nessuna stampante trovata"

