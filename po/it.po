msgstr "%(unit)s, 0 = riempi l’altezza del nastro"

#: etiketto/ui/elements.py:374
msgid ""
"Black-and-white printers print symbols in black, or in white if the colour "
"is light"
msgstr "Le stampanti in bianco e nero stampano i simboli in nero, o in bianco se il colore è chiaro"

#: etiketto/ui/elements.py:381 etiketto/ui/freelayout.py:159
#: etiketto/ui/styles.py:113
msgid "Rotation"
msgstr "Rotazione"

#: etiketto/ui/elements.py:394
msgid "Type"
msgstr "Tipo"

#: etiketto/ui/elements.py:398
msgid "Content (link, text, number)"
msgstr "Contenuto (link, testo, numero)"

