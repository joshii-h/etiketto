#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Riquadro e cornice"

#: etiketto/app.py:217 etiketto/cli.py:170
msgid "Design and print labels"
msgstr "Crea e stampa etichette"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Idee per le variabili (contatore, data, UUID), nessun codice"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Conoscenza dei protocolli"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Da %(projects)s e dai manuali dei produttori, riscritto senza il loro codice; vedi THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "atteso NAME=VALUE: %s"

#: etiketto/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "atteso un numero intero da %(min)d a %(max)d: %(value)s"

#: etiketto/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "righe attese, ad es. 3-10, 5 o 7-: %s"

#: etiketto/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Senza comando si avvia l’applicazione; i file di etichetta indicati vi vengono aperti."

#: etiketto/cli.py:177
msgid "print a label file without opening a window"
msgstr "stampa un file di etichetta senza aprire una finestra"

#: etiketto/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Stampa un file di etichetta senza aprire una finestra."

#: etiketto/cli.py:180
msgid "the label (.etiketto)"
msgstr "l’etichetta (.etiketto)"

#: etiketto/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "modello di stampante, per impostazione predefinita quello dell’etichetta: %s"

#: etiketto/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "indirizzo della stampante, per impostazione predefinita quello impostato nell’app"

#: etiketto/cli.py:189
msgid "number of copies"
msgstr "numero di copie"

#: etiketto/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "testo dell’elemento NAME, o valore della variabile {=NAME}; le variabili in un testo vengono compilate; ripetibile"

#: etiketto/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "come --set, ma il valore è usato così com’è: le parentesi graffe non sono variabili"

#: etiketto/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "contatore della prima etichetta, invece di quello salvato nell’etichetta"

#: etiketto/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "stampa con i valori predefiniti del modello di stampante invece di taglio, colori, qualità, extra (stampa a catena, alta risoluzione, avanzamento del nastro), impostazioni della stampante e contorni dei fogli di etichette scelti per ultimi nell’app; indirizzo e margine di sicurezza restano"

#: etiketto/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "metodo di stampa di una stampante termica che ha questa impostazione: printer (come impostato sulla stampante), transfer (con nastro) o direct (termico diretto, senza nastro); per impostazione predefinita quello scelto nell’app, anche con --printer-defaults"

#: etiketto/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "non interrogare la stampante prima del rendering (modello, nastro e risoluzione)"

#: etiketto/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "non salvare il prossimo valore del contatore nell’etichetta (un file di sola lettura); la prossima stampa riparte dallo stesso numero"

#: etiketto/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "etichette in serie: un’etichetta per ogni riga di questo file CSV, ODS o XLSX; per impostazione predefinita il file di dati dell’etichetta"

#: etiketto/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "il foglio del file di dati, per impostazione predefinita il primo"

#: etiketto/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "solo queste righe del file di dati, ad es. 3-10, 5 o 7- (contate da 1)"

#: etiketto/cli.py:267
msgid "check and render only, do not print"
msgstr "controlla e genera soltanto, non stampare"

#: etiketto/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "con --dry-run: salva ogni etichetta in PNG come la esporta la finestra, al massimo 600 dpi (- per stdout: solo la prima)"

#: etiketto/cli.py:279
msgid "list the printers found on the network"
msgstr "elenca le stampanti trovate in rete"

#: etiketto/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Elenca le stampanti trovate in rete: modello, indirizzo, nome."

#: etiketto/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "solo questo modello di stampante: %s"

#: etiketto/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "atteso un indirizzo o una rete come 172.16.0.0/12: %s"

#: etiketto/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "la cartella con i file di etichetta che il server può usare"

#: etiketto/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "stampa solo su questo indirizzo di stampante (* corrisponde a qualsiasi cosa); ripetibile"

#: etiketto/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: le stampanti che i client possono usare, per nome"

#: etiketto/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "numero massimo di etichette in un lavoro di stampa, copie per righe (predefinito 10000)"

#: etiketto/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "cerca stampanti in rete (disattivato per impostazione predefinita)"

#: etiketto/cli.py:336
msgid "run a print server with a REST API"
msgstr "avvia un server di stampa con una REST API"

#: etiketto/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Avvia un server di stampa: una REST API e, con --mcp, MCP per i client IA."

#: etiketto/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "indirizzo su cui restare in ascolto (predefinito 127.0.0.1)"

#: etiketto/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "porta su cui restare in ascolto (predefinita %d)"

#: etiketto/cli.py:352
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "file con il token di accesso; altrimenti la variabile d’ambiente ETIKETTO_TOKEN"

#: etiketto/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: token di accesso con nome e ruolo"

#: etiketto/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "offri anche MCP su /mcp"

#: etiketto/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "dimensione massima del corpo della richiesta in MB (predefinita 4)"

#: etiketto/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "un reverse proxy la cui intestazione X-Forwarded-For indica il client, ad es. 172.16.0.0/12; ripetibile"

#: etiketto/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "consenti le richieste dalle pagine web di questa origine; ripetibile"

#: etiketto/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "offri MCP su standard input e output"

#: etiketto/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Offri MCP su standard input e output, per client IA come Claude Desktop."

#: etiketto/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "gestisci i token di accesso del server di stampa"

#: etiketto/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Gestisci i token di accesso del server di stampa."

#: etiketto/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "crea un token e aggiungi il suo hash a tokens.toml"

#: etiketto/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Crea un token, aggiungi il suo hash a tokens.toml e mostra il token una sola volta."

#: etiketto/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "nome del token, ad es. il dispositivo"

#: etiketto/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: solo visualizzare; print: anche stampare; admin: anche tutti i lavori di stampa"

#: etiketto/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml a cui aggiungerlo"

#: etiketto/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "solo questa stampante di printers.toml; ripetibile"

#: etiketto/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, per verificare --printer"

#: etiketto/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "valido fino al, ad es. 2027-12-31"

#: etiketto/cli.py:429
msgid "a note for people"
msgstr "una nota per le persone"

#: etiketto/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "memorizza l’hash con scrypt invece di SHA-256"

#: etiketto/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "leggi da standard input un token scelto da te (memorizzato con scrypt) invece di crearne uno"

#: etiketto/cli.py:457 etiketto/server/config.py:220
#: etiketto/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Modello di stampante sconosciuto: %s"

#: etiketto/cli.py:464 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:303 etiketto/ui/texts.py:640
#: etiketto/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "Impossibile aprire %s"

#: etiketto/cli.py:486 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s non è una data, atteso ad es. 2026-12-31 o 2026-12-31T08:30"

#: etiketto/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} viene compilato durante la stampa e non può essere impostato"

#: etiketto/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "L’etichetta non ha alcun elemento o variabile chiamato %s"

#: etiketto/cli.py:551 etiketto/ui/printing.py:123
#: etiketto/server/service.py:963
msgid "The label is empty"
msgstr "L’etichetta è vuota"

#: etiketto/cli.py:588
msgid "Cannot write the output"
msgstr "Impossibile scrivere l’output"

#: etiketto/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output scrive immagini PNG: indica un nome che termina con .png"

#: etiketto/cli.py:644 etiketto/cli.py:853 etiketto/ui/printing.py:553
#: etiketto/ui/printing.py:715 etiketto/server/service.py:891
#: etiketto/server/service.py:1118 etiketto/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "Impossibile preparare l’etichetta per la stampa."

#: etiketto/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "Nessuna stampante trovata – indica il suo indirizzo con --host"

#: etiketto/cli.py:733
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Trovate più stampanti – scegline una con --host (etiketto list-printers)"

#: etiketto/cli.py:744 etiketto/ui/texts.py:683 etiketto/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "Impossibile salvare %s"

#: etiketto/cli.py:746 etiketto/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "le etichette sono state stampate, ma il prossimo valore del contatore non è stato salvato"

#: etiketto/cli.py:761 etiketto/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "non è stato stampato nulla: il prossimo valore del contatore non potrebbe essere salvato"

#: etiketto/cli.py:821 etiketto/cli.py:848 etiketto/cli.py:1209
msgid "Interrupted"
msgstr "Interrotto"

#: etiketto/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: questo modello di stampante non ha un’impostazione del metodo di stampa: %s"

#: etiketto/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet e --rows richiedono un file di dati (--data)"

#: etiketto/cli.py:972 etiketto/ui/printing.py:585
#: etiketto/server/service.py:764
msgid "No rows to print"
msgstr "Nessuna riga da stampare"

#: etiketto/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "L’etichetta usa un file di dati fuori dalla sua cartella: indicalo con --data"

#: etiketto/cli.py:1009 etiketto/ui/window.py:844
#: etiketto/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "Colonna inesistente: %s"

#: etiketto/cli.py:1014 etiketto/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Il codice a barre o il codice QR di queste righe non può essere creato dai loro valori, ad esempio un EAN-13 con lettere o una cella vuota. Correggi il file di dati e rileggilo, oppure stampa senza queste righe."

#: etiketto/cli.py:1019 etiketto/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Righe: %s"

#: etiketto/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "In attesa che finisca un’altra stampa di %s…"

#: etiketto/cli.py:1034 etiketto/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s è ancora bloccato da un’altra stampa – riprova più tardi"

#: etiketto/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output richiede --dry-run"

#: etiketto/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Il prossimo valore del contatore non viene salvato: la prossima stampa ripeterà i numeri"

#: etiketto/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "In attesa della risposta della stampante…"

#: etiketto/cli.py:1180 etiketto/ui/printer.py:199
msgid "No printer found"
msgstr "Nessuna stampante trovata"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tabelle (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "Scegli il file di dati"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:109 etiketto/ui/files.py:131
#: etiketto/ui/files.py:212 etiketto/ui/texts.py:205
msgid "Only local files can be used"
msgstr "Sono possibili solo file locali"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto chiederà di nuovo prima di leggere file di dati fuori dalla cartella di un’etichetta"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "Leggere il file di dati?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Questa etichetta usa un file di dati fuori dalla sua cartella:\n\n%s\n\nLeggilo solo se sai da dove proviene l’etichetta."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "Non ora"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "Leggi file di dati"

#: etiketto/ui/data.py:265
msgid "Reading…"
msgstr "Lettura in corso…"

#: etiketto/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Non letto: fuori dalla cartella dell’etichetta"

#: etiketto/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Righe: %(rows)d · Colonne: %(columns)d"

#: etiketto/ui/data.py:281 etiketto/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Etichette in serie"

#: etiketto/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "Un’etichetta per ogni riga di una tabella. Inserisci le colonne nei testi e nei codici; ogni etichetta mostra i valori della sua riga."

#: etiketto/ui/data.py:290
