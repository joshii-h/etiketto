msgid "Out of paper – load paper to continue"
msgstr "Carta esaurita – carica la carta per continuare"

#: etiketto/ui/texts.py:542
msgid "Cover open – close it to continue"
msgstr "Coperchio aperto – chiudilo per continuare"

#: etiketto/ui/texts.py:543
msgid "Paper jammed – remove it to continue"
msgstr "Carta inceppata – rimuovila per continuare"

