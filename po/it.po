msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Trovate più stampanti – scegline una con --host (etiketto list-printers)"

#: etiketto/cli.py:443 etiketto/ui/texts.py:410
#, python-format
msgid "Cannot save %s"
msgstr "Impossibile salvare %s"

#: etiketto/cli.py:445
msgid "the labels were printed, but the next counter value was not saved"
msgstr "le etichette sono state stampate, ma il prossimo valore del contatore non è stato salvato"

#: etiketto/cli.py:460
msgid "nothing was printed: the next counter value could not be saved"
msgstr "non è stato stampato nulla: il prossimo valore del contatore non potrebbe essere salvato"

#: etiketto/cli.py:520 etiketto/cli.py:641
msgid "Interrupted"
msgstr "Interrotto"

#: etiketto/cli.py:573
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "In attesa che finisca un’altra stampa di %s…"

#: etiketto/cli.py:580
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s è ancora bloccato da un’altra stampa – riprova più tardi"

#: etiketto/cli.py:586
msgid "--output needs --dry-run"
msgstr "--output richiede --dry-run"

#: etiketto/cli.py:595
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Il prossimo valore del contatore non viene salvato: la prossima stampa ripeterà i numeri"

