#, python-format
msgid "The file is damaged: %s"
msgstr "Il file è danneggiato: %s"

#: etiketto/ui/texts.py:564
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Il file di dati %s non c’è più. Sceglilo di nuovo o rimuovilo."

#: etiketto/ui/texts.py:568
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s non ha un foglio chiamato %(sheet)s"

#: etiketto/ui/texts.py:570
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s non è una tabella. Usa un file CSV, ODS o XLSX."

#: etiketto/ui/texts.py:572
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s è troppo grande per le etichette in serie. Dividilo in file più piccoli o rimuovi le righe e le colonne non necessarie."

#: etiketto/ui/texts.py:575
#, python-format
msgid "%s contains no data."
msgstr "%s non contiene dati."

#: etiketto/ui/texts.py:586
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "La stampa si è fermata alla riga %(row)d. Per continuare, stampa di nuovo dalla riga %(row)d."

#: etiketto/ui/texts.py:590
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Copie della riga %(row)d già stampate: %(copies)d."

#: etiketto/ui/texts.py:595
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "La riga %(row)d va nella posizione %(position)d del foglio %(sheet)d."

#: etiketto/ui/texts.py:606
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Impossibile salvare %s: nessun permesso di scrittura"

#: etiketto/ui/texts.py:608
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Impossibile salvare %s: il disco è pieno"

#: etiketto/ui/texts.py:618
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Questa cassetta sembra di %(month)s %(year)d. La carta ZINK vecchia stampa colori più tenui."

