#: etiketto/app.py:136 etiketto/cli.py:110
msgid "Design and print labels"
msgstr "Thiết kế và in nhãn"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:83
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "cần NAME=VALUE: %s"

#: etiketto/cli.py:99
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "cần một số nguyên từ %(min)d đến %(max)d: %(value)s"

#: etiketto/cli.py:111
msgid "Without a command the application starts; label files given open in it."
msgstr "Không có lệnh thì ứng dụng khởi động; các tệp nhãn được chỉ định sẽ mở trong đó."

#: etiketto/cli.py:117
msgid "print a label file without opening a window"
msgstr "in tệp nhãn mà không mở cửa sổ"

#: etiketto/cli.py:118
msgid "Print a label file without opening a window."
msgstr "In tệp nhãn mà không mở cửa sổ."

#: etiketto/cli.py:120
msgid "the label (.etiketto)"
msgstr "nhãn (.etiketto)"

#: etiketto/cli.py:123
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "kiểu máy in, mặc định là của nhãn: %s"

#: etiketto/cli.py:126
msgid "printer address, by default the one set in the app"
msgstr "địa chỉ máy in, mặc định là địa chỉ đã đặt trong ứng dụng"

#: etiketto/cli.py:129
msgid "number of copies"
msgstr "số bản"

#: etiketto/cli.py:139
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "văn bản của phần tử NAME, hoặc giá trị của biến {=NAME}; các biến trong văn bản được điền vào; có thể lặp lại"

#: etiketto/cli.py:149
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "như --set, nhưng giá trị được dùng nguyên văn: dấu ngoặc nhọn không phải là biến"

#: etiketto/cli.py:155
msgid "counter of the first label, instead of the one saved in the label"
msgstr "bộ đếm của nhãn đầu tiên, thay cho giá trị đã lưu trong nhãn"

#: etiketto/cli.py:158
msgid "check and render only, do not print"
msgstr "chỉ kiểm tra và dựng ảnh, không in"

#: etiketto/cli.py:164
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "với --dry-run: lưu các ảnh dạng PNG đúng như máy in sẽ nhận (- cho stdout: chỉ ảnh đầu tiên)"

#: etiketto/cli.py:170
msgid "list the printers found on the network"
msgstr "liệt kê các máy in tìm thấy trên mạng"

#: etiketto/cli.py:171
msgid "List the printers found on the network: model, address, name."
msgstr "Liệt kê các máy in tìm thấy trên mạng: kiểu máy, địa chỉ, tên."

