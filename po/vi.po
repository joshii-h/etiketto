msgid "Default"
msgstr "Mặc định"

#: tavletta/ui/texts.py:248
#, python-format
msgid "%d %%"
msgstr "%d%%"

#. translators: print speed in inches per second, as label printers state it
#: tavletta/ui/texts.py:251
#, python-format
msgid "%d in/s"
msgstr "%d inch/giây"

#: tavletta/ui/texts.py:260
msgid "Image"
msgstr "Ảnh"

#: tavletta/ui/texts.py:295
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Liên tục, rộng %(width)s"

#: tavletta/ui/texts.py:305
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Kiểm tra xem toàn bộ nhãn có nằm trong vùng chọn không. Kéo để di chuyển vùng chọn hoặc các cạnh của nó, hoặc vẽ vùng mới."

#: tavletta/ui/texts.py:309
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Nhiều vùng có thể là nhãn. Kiểm tra vùng chọn hoặc thử vùng tiếp theo."

#: tavletta/ui/texts.py:311
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Mọi thứ được in trên trang đã được chọn. Kéo để chọn nhãn."

#: tavletta/ui/texts.py:312
msgid "Nothing is printed on this page."
msgstr "Không có gì được in trên trang này."

#: tavletta/ui/texts.py:317
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Tệp PDF cần Poppler (poppler-glib), nhưng chưa được cài đặt"

#: tavletta/ui/texts.py:328
msgid "System printer (CUPS, IPP)"
msgstr "Máy in hệ thống (CUPS, IPP)"

#: tavletta/ui/texts.py:329
msgid "Receipt printer (ESC/POS)"
msgstr "Máy in hóa đơn (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:331
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, cuộn liên tục"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:333
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, nhãn cắt sẵn"

#: tavletta/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Phần tử %(n)d: mã đang trống"

#: tavletta/ui/texts.py:341
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Phần tử %(n)d: EAN-13 cần đúng 12 chữ số"

#: tavletta/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Phần tử %(n)d: số kiểm tra EAN-13 không đúng"

#: tavletta/ui/texts.py:343
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Phần tử %(n)d: Code 128 chứa tối đa %(max)d ký tự"

#: tavletta/ui/texts.py:345
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Phần tử %(n)d: các vạch quá mảnh để quét ổn định – hãy dùng nhãn dài hơn hoặc lớn hơn, hoặc nội dung ngắn hơn"

#: tavletta/ui/texts.py:349
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Phần tử %(n)d: Code 128 chỉ chấp nhận chữ cái Latinh, chữ số và dấu câu"

#: tavletta/ui/texts.py:351
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Phần tử %(n)d: EAN-8 cần 7 chữ số, hoặc 8 chữ số kèm số kiểm tra"

#: tavletta/ui/texts.py:352
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Phần tử %(n)d: UPC-A cần 11 chữ số, hoặc 12 chữ số kèm số kiểm tra"

#: tavletta/ui/texts.py:354
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Phần tử %(n)d: UPC-E cần 7 chữ số bắt đầu bằng 0 hoặc 1, hoặc 8 chữ số kèm số kiểm tra"

#: tavletta/ui/texts.py:356
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Phần tử %(n)d: ITF-14 cần 13 chữ số, hoặc 14 chữ số kèm số kiểm tra"

#: tavletta/ui/texts.py:357
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Phần tử %(n)d: số kiểm tra không đúng"

#: tavletta/ui/texts.py:359
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Phần tử %(n)d: Code 39 chỉ chấp nhận chữ in hoa, chữ số, dấu cách và - . $ / + %%"

#: tavletta/ui/texts.py:362
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Phần tử %(n)d: Code 93 chỉ chấp nhận chữ cái Latinh, chữ số và dấu câu"

#: tavletta/ui/texts.py:365
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Phần tử %(n)d: dữ liệu GS1 chỉ chấp nhận chữ cái Latinh, chữ số và dấu câu"

#: tavletta/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Phần tử %(n)d: dữ liệu GS1 phải là các số phân định ứng dụng trong ngoặc, mỗi số theo sau là giá trị của nó, ví dụ (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:371
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Phần tử %(n)d: (%(ai)s) không phải là số phân định ứng dụng GS1"

#: tavletta/ui/texts.py:373
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Phần tử %(n)d: giá trị của số phân định ứng dụng (%(ai)s) có độ dài không đúng"

#: tavletta/ui/texts.py:376
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Phần tử %(n)d: số kiểm tra của số phân định ứng dụng (%(ai)s) không đúng"

#: tavletta/ui/texts.py:379
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Phần tử %(n)d: giá trị của số phân định ứng dụng (%(ai)s) không hợp lệ: có ngày, số hoặc ký tự không được phép"

#: tavletta/ui/texts.py:383
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Phần tử %(n)d: không có số UPC-A nào rút gọn thành các chữ số UPC-E này – hãy kiểm tra hoặc dùng UPC-A"

#: tavletta/ui/texts.py:387
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Phần tử %(n)d: máy quét đặt ở chế độ Full ASCII đọc $, /, + hoặc %% đứng trước chữ in hoa thành một ký tự khác"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Phần tử %(n)d: nội dung quá dài cho loại mã này"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Phần tử %(n)d: không thể mã hóa nội dung bằng loại mã này"

#: tavletta/ui/texts.py:393
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Phần tử %(n)d: loại mã này cần thư viện Zint (zint-bindings), nhưng thư viện chưa được cài đặt"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Phần tử %(n)d: không đọc được ảnh"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Phần tử %(n)d: biểu tượng này không có trong thư viện biểu tượng"

#: tavletta/ui/texts.py:398
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Phần tử %(n)d: không đọc được tài liệu"

#: tavletta/ui/texts.py:400
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Phần tử %(n)d: tệp PDF cần Poppler (poppler-glib), nhưng chưa được cài đặt"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Không vẽ được phần tử %(n)d"

#: tavletta/ui/texts.py:404
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Lề an toàn, viền, phần thụt vào của viền và khoảng cách mép không còn chỗ trống – hãy giảm bớt"

#: tavletta/ui/texts.py:406
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Chiều dài cố định ngắn hơn khoảng cách – hãy tăng chiều dài"

#: tavletta/ui/texts.py:407
msgid "The background image cannot be read"
msgstr "Không đọc được ảnh nền"

#: tavletta/ui/texts.py:409
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Phần tử %(n)d: mô-đun của mã chỉ rộng một điểm in và có thể không quét được – hãy phóng to mã"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Phần tử %(n)d: khoảng trống mã cần xung quanh không đủ chỗ – hãy phóng to mã"

#: tavletta/ui/texts.py:417
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Phần tử %(n)d: mã không vừa chỗ của nó, kể cả với một điểm in mỗi mô-đun – hãy phóng to nhãn hoặc rút ngắn nội dung"

#: tavletta/ui/texts.py:420
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Phần tử %(n)d: %(name)s không phải biến đã biết"

#: tavletta/ui/texts.py:422
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Phần tử %(n)d: ngày của %(name)s trước năm 1 hoặc sau năm 9999"

#: tavletta/ui/texts.py:425
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Phần tử %(n)d: biến %(name)s… chưa được đóng – hãy kết thúc bằng }"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Phần tử %(n)d: trên máy in đen trắng, nó hầu như không nổi bật so với những gì phía sau, toàn bộ hoặc một phần – hãy chọn màu khác hoặc di chuyển nó"

#: tavletta/ui/texts.py:431
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Phần tử %(n)d: hình không có cả đường kẻ lẫn phần tô"

#: tavletta/ui/texts.py:433
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "Phần tử %(n)d vượt ra ngoài mép nhãn và bị cắt ở đó – hãy di chuyển hoặc thu nhỏ nó"

#: tavletta/ui/texts.py:437
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Phần tử %(n)d: đệm, khung, viền chữ hoặc bóng không còn chỗ cho chữ – hãy giảm bớt"

#: tavletta/ui/texts.py:452
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Số tờ đã in: %(n)d trên %(total)d."

#: tavletta/ui/texts.py:454
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Số nhãn đã in: %(n)d trên %(total)d."

#: tavletta/ui/texts.py:458
msgid "The sheets still waiting in the queue were canceled."
msgstr "Các tờ còn chờ trong hàng đợi đã bị hủy."

#: tavletta/ui/texts.py:460
msgid "The labels still waiting in the queue were canceled."
msgstr "Các nhãn còn chờ trong hàng đợi đã bị hủy."

#: tavletta/ui/texts.py:467
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Nhãn có kích thước %(size)s với khe hở %(gap)s, nên cứ %(pitch)s lại bắt đầu một nhãn mới. Máy in đo được cứ %(measured)s có một nhãn. Hãy kiểm tra kích thước nhãn và khe hở."

#: tavletta/ui/texts.py:483
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Không tìm thấy máy in. Hãy kiểm tra máy in đã bật và ở cùng mạng, hoặc nhập địa chỉ IP của máy in."

#: tavletta/ui/texts.py:487
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Không tìm thấy máy in qua USB. Hãy kiểm tra cáp và máy in đã bật, không ở chế độ ngủ, rồi tìm lại."

#: tavletta/ui/texts.py:490
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Máy in không phản hồi. Hãy kiểm tra máy in đã bật và không ở chế độ ngủ."

#: tavletta/ui/texts.py:492
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Máy in đã ngừng nhận dữ liệu. Hãy kiểm tra xem máy có báo lỗi không, chẳng hạn hết nhãn hoặc nắp đang mở, rồi thử lại."

#: tavletta/ui/texts.py:496
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Máy in từ chối kết nối. Hãy tắt rồi bật lại máy in. Nếu giao diện web của máy in có tùy chọn “Port 9100”, hãy bật tùy chọn đó."

#: tavletta/ui/texts.py:499
msgid "No cassette is inserted. Insert one and try again."
msgstr "Chưa lắp hộp băng. Hãy lắp hộp băng rồi thử lại."

#: tavletta/ui/texts.py:500
msgid "The printer's cover is open. Close it and try again."
msgstr "Nắp máy in đang mở. Hãy đóng nắp rồi thử lại."

#: tavletta/ui/texts.py:501
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Nhãn bị kẹt. Hãy mở nắp, lấy nhãn ra rồi thử lại."

#: tavletta/ui/texts.py:502
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Không nhận ra hộp băng. Hãy lắp lại hoặc thử hộp băng khác."

#: tavletta/ui/texts.py:503
msgid "The printer is busy. Wait a moment and try again."
msgstr "Máy in đang bận. Hãy chờ một chút rồi thử lại."

#: tavletta/ui/texts.py:504
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Nhãn quá dài cho máy in này: tối đa %(max)s."

#: tavletta/ui/texts.py:505
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Nhãn quá rộng cho máy in này: tối đa %(max)s."

#: tavletta/ui/texts.py:506
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Máy in đã hết nhãn. Hãy lắp cuộn mới và thử lại."

#: tavletta/ui/texts.py:507
msgid "The print head is open. Close it and try again."
msgstr "Đầu in đang mở. Hãy đóng lại và thử lại."

#: tavletta/ui/texts.py:509
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Máy in không tìm thấy nhãn tiếp theo. Hãy kiểm tra nhãn đã được lắp đúng chưa và có đi qua cảm biến nhãn không."

#: tavletta/ui/texts.py:513
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Ruy băng có vấn đề. Hãy kiểm tra ruy băng đã được lắp đúng chưa và có khớp với phương thức in đã đặt trên máy in không."

#: tavletta/ui/texts.py:519
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Máy in không tìm thấy ruy băng. Hãy lắp ruy băng rồi thử lại. Nhãn in không cần ruy băng cần chọn “%(direct)s” trong “%(method)s”."

#: tavletta/ui/texts.py:526
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Đã lắp ruy băng nhưng máy in đang in không dùng ruy băng (in nhiệt trực tiếp). Với nhãn cần ruy băng, hãy chọn “%(transfer)s” trong “%(method)s”, hoặc tháo ruy băng ra."

#: tavletta/ui/texts.py:531
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Máy in đang tạm dừng. Hãy tiếp tục trên màn hình của máy rồi thử lại."

#: tavletta/ui/texts.py:532
msgid "The printer is out of paper. Load paper and try again."
msgstr "Máy in đã hết giấy. Hãy nạp giấy rồi thử lại."

#: tavletta/ui/texts.py:534
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Giấy bị kẹt. Hãy lấy giấy ra theo hướng dẫn trên màn hình của máy in rồi thử lại."

#: tavletta/ui/texts.py:536
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Máy in đã hết mực hoặc toner. Hãy thay rồi thử lại."

#: tavletta/ui/texts.py:537
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Máy in không thể in cỡ này. Hãy chọn cỡ giấy mà máy in hỗ trợ."

#: tavletta/ui/texts.py:539
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Máy in không nhận định dạng nào mà Tavletta có thể gửi (PDF, PWG Raster, JPEG)."

#: tavletta/ui/texts.py:542
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Hàng đợi của máy in đang tạm dừng. Hãy tiếp tục trong phần cài đặt máy in của hệ thống rồi thử lại."

#: tavletta/ui/texts.py:546
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Lệnh in đã bị giữ lại trong hàng đợi, ví dụ cho đến khi được giải phóng hoặc nhập mật khẩu. Hãy kiểm tra hàng đợi trong phần cài đặt máy in của hệ thống rồi thử lại."

#: tavletta/ui/texts.py:550
msgid "The print job was canceled at the printer or in the queue."
msgstr "Lệnh in đã bị hủy trên máy in hoặc trong hàng đợi."

#: tavletta/ui/texts.py:551
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Máy in không báo độ phân giải kịp thời. Hãy chọn trong “%s”."

#: tavletta/ui/texts.py:554
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Cuộn đang lắp không khớp với nhãn. Hãy lắp cuộn phù hợp, hoặc chọn kích thước nhãn hay kiểu máy in theo cuộn đang lắp."

#: tavletta/ui/texts.py:557
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Pin máy in yếu – hãy sạc hoặc cắm bộ đổi nguồn."

#: tavletta/ui/texts.py:558
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Đầu in quá nóng. Hãy đợi đến khi nguội, rồi thử lại."

#: tavletta/ui/texts.py:560
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta không thể in trên mẫu máy in này: máy không nhận ảnh raster mà Tavletta gửi."

#: tavletta/ui/texts.py:564
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta chưa biết mẫu máy in này và chưa thể in trên nó."

#: tavletta/ui/texts.py:567
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Máy in đang ở chế độ Editor Lite và hiện ra như một ổ USB. Hãy tắt Editor Lite trên máy in (đèn của nó tắt), rồi tìm lại."

#: tavletta/ui/texts.py:571
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta không được phép dùng cổng USB của máy in. Hãy thêm người dùng của bạn vào nhóm “lp” (sudo usermod -aG lp $USER), rồi đăng xuất và đăng nhập lại."

#: tavletta/ui/texts.py:575
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Trang quá lớn để tạo ở độ phân giải mà máy in nhận. Hãy chọn khổ giấy nhỏ hơn hoặc in trên máy in nhận PDF."

#: tavletta/ui/texts.py:579
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Ở độ phân giải của máy in này, mã không vừa nhãn và sẽ bị cắt. Hãy phóng to nhãn hoặc rút ngắn nội dung của mã."

#: tavletta/ui/texts.py:583
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta không được phép dùng cổng nối tiếp của máy in. Hãy thêm người dùng của bạn vào nhóm “dialout” (sudo usermod -aG dialout $USER; trên Arch Linux nhóm tên là “uucp”), rồi đăng xuất và đăng nhập lại."

#: tavletta/ui/texts.py:588
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Máy in báo có sự cố. Hãy tắt rồi bật lại máy in, sau đó thử lại lần nữa."

#: tavletta/ui/texts.py:599
msgid "Printed"
msgstr "Đã in"

#: tavletta/ui/texts.py:605
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Đã gửi đến máy in – sẽ được in khi đến lượt"

#: tavletta/ui/texts.py:607
msgid "Sent to the printer – it did not confirm printing"
msgstr "Đã gửi đến máy in – máy in không xác nhận đã in"

#: tavletta/ui/texts.py:611
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Đã in bằng “%(used)s” vì cuộn đang lắp cần như vậy"

#: tavletta/ui/texts.py:615
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Chế độ màu “%(wanted)s” không có trên máy in này, đã in bằng “%(used)s”"

#: tavletta/ui/texts.py:625
msgid "Warming up…"
msgstr "Đang làm nóng…"

#: tavletta/ui/texts.py:626
msgid "Cooling down…"
msgstr "Đang làm nguội…"

#: tavletta/ui/texts.py:627
msgid "Cleaning…"
msgstr "Đang làm sạch…"

#: tavletta/ui/texts.py:628
msgid "Swipe the printer's panel to cut the label"
msgstr "Vuốt trên bảng điều khiển của máy in để cắt nhãn"

#: tavletta/ui/texts.py:630
msgid "Out of paper – load paper to continue"
msgstr "Hết giấy – hãy nạp giấy để tiếp tục"

#: tavletta/ui/texts.py:631
msgid "Cover open – close it to continue"
msgstr "Nắp đang mở – hãy đóng nắp để tiếp tục"

#: tavletta/ui/texts.py:632
msgid "Paper jammed – remove it to continue"
msgstr "Kẹt giấy – hãy lấy giấy ra để tiếp tục"

#: tavletta/ui/texts.py:643
msgid "This label needs a newer version of Tavletta"
msgstr "Nhãn này cần phiên bản Tavletta mới hơn"

#: tavletta/ui/texts.py:645
#, python-format
msgid "%s is not an Tavletta label"
msgstr "%s không phải là nhãn Tavletta"

#: tavletta/ui/texts.py:646 tavletta/ui/texts.py:666
#: tavletta/server/service.py:696
#, python-format
msgid "The file is damaged: %s"
msgstr "Tệp bị hỏng: %s"

#: tavletta/ui/texts.py:653
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Tệp dữ liệu %s không còn nữa. Hãy chọn lại hoặc gỡ bỏ."

#: tavletta/ui/texts.py:657
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s không có trang tính nào tên %(sheet)s"

#: tavletta/ui/texts.py:659
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s không phải là bảng. Hãy dùng tệp CSV, ODS hoặc XLSX."

#: tavletta/ui/texts.py:661
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s quá lớn cho nhãn hàng loạt. Hãy chia thành các tệp nhỏ hơn hoặc xóa các hàng và cột không cần thiết."

#: tavletta/ui/texts.py:664
#, python-format
msgid "%s contains no data."
msgstr "%s không có dữ liệu."

#: tavletta/ui/texts.py:675
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Việc in đã dừng ở hàng %(row)d. Để tiếp tục, hãy in lại từ hàng %(row)d."

#: tavletta/ui/texts.py:679
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Số bản của hàng %(row)d đã in: %(copies)d."

#: tavletta/ui/texts.py:684
#, python-format
