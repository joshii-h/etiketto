#: etiketto/ui/texts.py:86
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Phần tử %(n)d: mã đang trống"

#: etiketto/ui/texts.py:87
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Phần tử %(n)d: EAN-13 cần đúng 12 chữ số"

#: etiketto/ui/texts.py:88
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Phần tử %(n)d: số kiểm tra EAN-13 không đúng"

#: etiketto/ui/texts.py:90
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Phần tử %(n)d: Code 128 chỉ chấp nhận chữ cái Latinh, chữ số và dấu câu"

#: etiketto/ui/texts.py:92
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Phần tử %(n)d: không đọc được ảnh"

#: etiketto/ui/texts.py:93
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Không vẽ được phần tử %(n)d"

#: etiketto/ui/texts.py:94
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Lề an toàn, viền và khoảng cách mép không còn chỗ trống – hãy giảm bớt"

#: etiketto/ui/texts.py:95
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Chiều dài cố định ngắn hơn khoảng cách – hãy tăng chiều dài"

#: etiketto/ui/texts.py:96
msgid "The background image cannot be read"
msgstr "Không đọc được ảnh nền"

#: etiketto/ui/texts.py:97
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Phần tử %(n)d: %(name)s không phải biến đã biết"

#: etiketto/ui/texts.py:99
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Phần tử %(n)d: biến %(name)s… chưa được đóng – hãy kết thúc bằng }"

#: etiketto/ui/texts.py:112
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Số nhãn đã in: %(n)d trên %(total)d."

#: etiketto/ui/texts.py:117
msgid "The labels still waiting in the queue were canceled."
msgstr "Các nhãn còn chờ trong hàng đợi đã bị hủy."

#: etiketto/ui/texts.py:126
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Không tìm thấy máy in. Hãy kiểm tra máy in đã bật và ở cùng mạng, hoặc nhập địa chỉ IP của máy in."

#: etiketto/ui/texts.py:129
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Máy in không phản hồi. Hãy kiểm tra máy in đã bật và không ở chế độ ngủ."

#: etiketto/ui/texts.py:131
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Máy in từ chối kết nối. Hãy tắt rồi bật lại máy in. Nếu giao diện web của máy in có tùy chọn “Port 9100”, hãy bật tùy chọn đó."

#: etiketto/ui/texts.py:134
msgid "No cassette is inserted. Insert one and try again."
msgstr "Chưa lắp hộp băng. Hãy lắp hộp băng rồi thử lại."

#: etiketto/ui/texts.py:135
msgid "The printer's cover is open. Close it and try again."
msgstr "Nắp máy in đang mở. Hãy đóng nắp rồi thử lại."

#: etiketto/ui/texts.py:136
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Nhãn bị kẹt. Hãy mở nắp, lấy nhãn ra rồi thử lại."

#: etiketto/ui/texts.py:137
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Không nhận ra hộp băng. Hãy lắp lại hoặc thử hộp băng khác."

#: etiketto/ui/texts.py:138
msgid "The printer is busy. Wait a moment and try again."
msgstr "Máy in đang bận. Hãy chờ một chút rồi thử lại."

#: etiketto/ui/texts.py:139
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Nhãn quá dài cho máy in này: tối đa %(max)s."

#: etiketto/ui/texts.py:140
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Nhãn quá rộng cho máy in này: tối đa %(max)s."

#: etiketto/ui/texts.py:141
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Máy in đã hết nhãn. Hãy lắp cuộn mới và thử lại."

#: etiketto/ui/texts.py:142
msgid "The print head is open. Close it and try again."
msgstr "Đầu in đang mở. Hãy đóng lại và thử lại."

#: etiketto/ui/texts.py:144
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Máy in không tìm thấy nhãn tiếp theo. Hãy kiểm tra nhãn đã được lắp đúng chưa và có đi qua cảm biến nhãn không."

#: etiketto/ui/texts.py:148
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Ruy băng có vấn đề. Hãy kiểm tra ruy băng đã được lắp đúng chưa và có khớp với phương thức in đã đặt trên máy in không."

#: etiketto/ui/texts.py:151
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Máy in đang tạm dừng. Hãy tiếp tục trên màn hình của máy rồi thử lại."

#: etiketto/ui/texts.py:152
msgid "The printer is out of paper. Load paper and try again."
msgstr "Máy in đã hết giấy. Hãy nạp giấy rồi thử lại."

#: etiketto/ui/texts.py:154
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Giấy bị kẹt. Hãy lấy giấy ra theo hướng dẫn trên màn hình của máy in rồi thử lại."

#: etiketto/ui/texts.py:156
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Máy in đã hết mực hoặc toner. Hãy thay rồi thử lại."

#: etiketto/ui/texts.py:157
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Máy in không thể in cỡ này. Hãy chọn cỡ giấy mà máy in hỗ trợ."

#: etiketto/ui/texts.py:159
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Máy in không nhận định dạng nào mà Etiketto có thể gửi (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:162
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Hàng đợi của máy in đang tạm dừng. Hãy tiếp tục trong phần cài đặt máy in của hệ thống rồi thử lại."

#: etiketto/ui/texts.py:166
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Lệnh in đã bị giữ lại trong hàng đợi, ví dụ cho đến khi được giải phóng hoặc nhập mật khẩu. Hãy kiểm tra hàng đợi trong phần cài đặt máy in của hệ thống rồi thử lại."

#: etiketto/ui/texts.py:170
msgid "The print job was canceled at the printer or in the queue."
msgstr "Lệnh in đã bị hủy trên máy in hoặc trong hàng đợi."

#: etiketto/ui/texts.py:172
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Máy in báo có sự cố. Hãy tắt rồi bật lại máy in, sau đó thử lại lần nữa."

#: etiketto/ui/texts.py:184
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Đã gửi đến máy in – sẽ được in khi đến lượt"

#: etiketto/ui/texts.py:188
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Chế độ màu “%(wanted)s” không có trên máy in này, đã in bằng “%(used)s”"

#: etiketto/ui/texts.py:198
msgid "Warming up…"
msgstr "Đang làm nóng…"

#: etiketto/ui/texts.py:199
msgid "Cooling down…"
msgstr "Đang làm nguội…"

#: etiketto/ui/texts.py:200
msgid "Cleaning…"
msgstr "Đang làm sạch…"

#: etiketto/ui/texts.py:201
msgid "Swipe the printer's panel to cut the label"
msgstr "Vuốt trên bảng điều khiển của máy in để cắt nhãn"

#: etiketto/ui/texts.py:203
msgid "Out of paper – load paper to continue"
msgstr "Hết giấy – hãy nạp giấy để tiếp tục"

#: etiketto/ui/texts.py:204
msgid "Cover open – close it to continue"
msgstr "Nắp đang mở – hãy đóng nắp để tiếp tục"

#: etiketto/ui/texts.py:205
msgid "Paper jammed – remove it to continue"
msgstr "Kẹt giấy – hãy lấy giấy ra để tiếp tục"

#: etiketto/ui/texts.py:216
msgid "This label needs a newer version of Etiketto"
msgstr "Nhãn này cần phiên bản Etiketto mới hơn"

#: etiketto/ui/texts.py:218
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s không phải là nhãn Etiketto"

#: etiketto/ui/texts.py:219
#, python-format
msgid "The file is damaged: %s"
msgstr "Tệp bị hỏng: %s"

#: etiketto/ui/texts.py:225
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Không thể lưu %s: không có quyền ghi vào đó"

#: etiketto/ui/texts.py:227
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Không thể lưu %s: đĩa đã đầy"

#: etiketto/ui/texts.py:237
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Hộp băng này có vẻ được sản xuất vào %(month)s năm %(year)d. Giấy ZINK cũ in ra màu nhạt hơn."

