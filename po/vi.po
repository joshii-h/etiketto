#: tavletta/ui/texts.py:218
#, python-format
msgid ""
"%(name)s is not an image Tavletta can use. Images in %(formats)s can be used."
msgstr "%(name)s không phải là ảnh mà Tavletta có thể dùng. Có thể dùng ảnh dạng %(formats)s."

