#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Hộp và khung"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Thiết kế và in nhãn"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta trong tiếng Romansh nghĩa là tấm bảng nhỏ (từ tavla, bảng/tấm ván). Đọc là tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ý tưởng cho các biến (bộ đếm, ngày, UUID), không dùng mã"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "Kiến thức về giao thức"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Từ %(projects)s và tài liệu hướng dẫn của nhà sản xuất, viết lại mà không dùng mã của họ; xem THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "cần NAME=VALUE: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "cần một số nguyên từ %(min)d đến %(max)d: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "cần các hàng như 3-10, 5 hoặc 7-: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Không có lệnh thì ứng dụng khởi động; các tệp nhãn được chỉ định sẽ mở trong đó."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "in tệp nhãn mà không mở cửa sổ"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "In tệp nhãn mà không mở cửa sổ."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "nhãn (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "kiểu máy in, mặc định là của nhãn: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "địa chỉ máy in, mặc định là địa chỉ đã đặt trong ứng dụng"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "số bản"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "văn bản của phần tử NAME, hoặc giá trị của biến {=NAME}; các biến trong văn bản được điền vào; có thể lặp lại"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "như --set, nhưng giá trị được dùng nguyên văn: dấu ngoặc nhọn không phải là biến"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "bộ đếm của nhãn đầu tiên, thay cho giá trị đã lưu trong nhãn"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "in với giá trị mặc định của kiểu máy in thay vì kiểu cắt, màu, chất lượng, tùy chọn thêm (in nối tiếp, độ phân giải cao, nạp băng), cài đặt máy in và đường viền tờ nhãn đã chọn lần cuối trong ứng dụng; địa chỉ và lề an toàn được giữ nguyên"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "phương thức in của máy in nhiệt có cài đặt này: printer (theo cài đặt trên máy in), transfer (dùng ruy băng) hoặc direct (in nhiệt trực tiếp, không ruy băng); mặc định là phương thức đã chọn trong ứng dụng, với --printer-defaults là phương thức đặt trên máy in"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "không hỏi máy in trước khi kết xuất (kiểu máy, băng và độ phân giải)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "không lưu giá trị bộ đếm tiếp theo vào nhãn (tệp chỉ đọc); lần in tiếp theo bắt đầu từ cùng số đó"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "nhãn hàng loạt: một nhãn cho mỗi hàng của tệp CSV, ODS hoặc XLSX này; mặc định là tệp dữ liệu của nhãn"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "trang tính của tệp dữ liệu, mặc định là trang đầu tiên"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "chỉ các hàng này của tệp dữ liệu, ví dụ 3-10, 5 hoặc 7- (đếm từ 1)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "chỉ kiểm tra và dựng ảnh, không in"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "với --dry-run: lưu mỗi nhãn dạng PNG như cửa sổ xuất ra, tối đa 600 dpi (- cho stdout: chỉ nhãn đầu tiên)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "liệt kê các máy in tìm thấy trên mạng"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "Liệt kê các máy in tìm thấy trên mạng: kiểu máy, địa chỉ, tên."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "chỉ kiểu máy in này: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "cần một địa chỉ hoặc mạng như 172.16.0.0/12: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "thư mục chứa các tệp nhãn mà máy chủ được phép dùng"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "chỉ in trên địa chỉ máy in này (* khớp với mọi thứ); có thể lặp lại"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: các máy in mà ứng dụng khách được dùng, theo tên"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "số nhãn tối đa trong một lệnh in, số bản nhân số hàng (mặc định 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "tìm máy in trên mạng (mặc định tắt)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "cho phép trang tài liệu (PDF, hình ảnh) trong nhãn gửi kèm yêu cầu; khi đó PDF được vẽ trong một tiến trình riêng có giới hạn (mặc định tắt)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "chạy máy chủ in với REST API"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Chạy máy chủ in: REST API và, với --mcp, MCP cho các ứng dụng AI."

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "địa chỉ để lắng nghe (mặc định 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "cổng để lắng nghe (mặc định %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "tệp chứa mã truy cập; nếu không thì dùng biến môi trường TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: các mã truy cập có tên kèm vai trò"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "cũng cung cấp MCP tại /mcp"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "kích thước nội dung yêu cầu tối đa tính bằng MB (mặc định 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "một proxy ngược có tiêu đề X-Forwarded-For cho biết máy khách, ví dụ 172.16.0.0/12; có thể lặp lại"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "cho phép yêu cầu từ các trang web thuộc nguồn gốc này; có thể lặp lại"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "cung cấp MCP qua đầu vào và đầu ra chuẩn"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Cung cấp MCP qua đầu vào và đầu ra chuẩn, cho các ứng dụng AI như Claude Desktop."

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "quản lý mã truy cập của máy chủ in"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "Quản lý mã truy cập của máy chủ in."

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "tạo một mã và thêm giá trị băm của nó vào tokens.toml"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Tạo một mã, thêm giá trị băm của nó vào tokens.toml và hiển thị mã một lần."

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "tên của mã, ví dụ thiết bị"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: chỉ xem; print: được in thêm; admin: được xử lý mọi lệnh in"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "tệp tokens.toml để thêm vào"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "chỉ máy in này trong printers.toml; có thể lặp lại"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml, để kiểm tra --printer"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "có hiệu lực đến, ví dụ 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "ghi chú cho người đọc"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "lưu giá trị băm bằng scrypt thay vì SHA-256"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "lấy mã truy cập do bạn tự chọn từ đầu vào chuẩn (lưu bằng scrypt) thay vì tạo mã mới"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:537
#, python-format
msgid "Unknown printer model: %s"
msgstr "Kiểu máy in không xác định: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:655
#: tavletta/server/service.py:685
#, python-format
msgid "Cannot open %s"
msgstr "Không thể mở %s"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s không phải ngày, cần ví dụ 2026-12-31 hoặc 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} được điền khi in và không thể đặt"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Nhãn không có phần tử hoặc biến nào tên %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1013
msgid "The label is empty"
msgstr "Nhãn đang trống"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "Không thể ghi đầu ra"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output ghi ảnh PNG: hãy đặt tên kết thúc bằng .png"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:918
#: tavletta/server/service.py:941 tavletta/server/service.py:1190
#: tavletta/server/service.py:1335
msgid "The label cannot be prepared for printing."
msgstr "Không thể chuẩn bị nhãn để in."

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "Không tìm thấy máy in – hãy nhập địa chỉ bằng --host"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Tìm thấy nhiều máy in – hãy chọn một máy bằng --host (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:698 tavletta/server/service.py:1325
#, python-format
msgid "Cannot save %s"
msgstr "Không thể lưu %s"

#: tavletta/cli.py:757 tavletta/server/service.py:1328
msgid "the labels were printed, but the next counter value was not saved"
msgstr "các nhãn đã được in, nhưng giá trị bộ đếm tiếp theo chưa được lưu"

#: tavletta/cli.py:772 tavletta/server/service.py:1042
msgid "nothing was printed: the next counter value could not be saved"
msgstr "không có gì được in: giá trị bộ đếm tiếp theo sẽ không lưu được"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "Đã ngắt"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: mẫu máy in này không có cài đặt phương thức in: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet và --rows cần một tệp dữ liệu (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:782
msgid "No rows to print"
msgstr "Không có hàng nào để in"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Nhãn dùng một tệp dữ liệu nằm ngoài thư mục của nó: hãy chỉ định bằng --data"

#: tavletta/cli.py:1020 tavletta/ui/window.py:849
#: tavletta/server/service.py:835
#, python-format
msgid "No such column: %s"
msgstr "Không có cột này: %s"

#: tavletta/cli.py:1025 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Không thể tạo mã vạch hoặc mã QR của các hàng này từ giá trị của chúng, ví dụ EAN-13 có chữ cái hoặc ô trống. Hãy sửa tệp dữ liệu và đọc lại, hoặc in mà không có các hàng này."

#: tavletta/cli.py:1030 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Hàng: %s"

#: tavletta/cli.py:1038
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Đang chờ một lần in khác của %s hoàn tất…"

#: tavletta/cli.py:1045 tavletta/server/service.py:1184
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s vẫn đang bị khóa bởi một lần in khác – hãy thử lại sau"

#: tavletta/cli.py:1051
msgid "--output needs --dry-run"
msgstr "--output cần --dry-run"

#: tavletta/cli.py:1068
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Giá trị bộ đếm tiếp theo không được lưu: lần in tiếp theo sẽ lặp lại các số"

#: tavletta/cli.py:1163
msgid "Waiting for the printer's answer…"
msgstr "Đang chờ máy in trả lời…"

#: tavletta/cli.py:1191 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Không tìm thấy máy in"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Bảng (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Chọn tệp dữ liệu"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "Chỉ dùng được tập tin cục bộ"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "Tavletta sẽ hỏi lại trước khi đọc tệp dữ liệu nằm ngoài thư mục của nhãn"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Đọc tệp dữ liệu?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Nhãn này dùng một tệp dữ liệu nằm ngoài thư mục của nó:\n\n%s\n\nChỉ đọc nếu bạn biết nhãn này đến từ đâu."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Để sau"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Đọc tệp dữ liệu"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "Đang đọc…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Chưa đọc: nằm ngoài thư mục của nhãn"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Hàng: %(rows)d · Cột: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Nhãn hàng loạt"

#: tavletta/ui/data.py:283
