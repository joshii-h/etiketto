#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Các biến được điền khi in. Mỗi nhãn được in nhận giá trị bộ đếm tiếp theo, kể cả từ bản này sang bản khác. Bản xem trước hiển thị giá trị của lần in tiếp theo."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "Tìm hiểu thêm về biến"

#: etiketto/ui/variables.py:108
