#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Hộp và khung"

#: etiketto/app.py:217 etiketto/cli.py:154
msgid "Design and print labels"
msgstr "Thiết kế và in nhãn"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ý tưởng cho các biến (bộ đếm, ngày, UUID), không dùng mã"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Kiến thức về giao thức"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Từ %(projects)s và tài liệu hướng dẫn của nhà sản xuất, viết lại mà không dùng mã của họ; xem THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:109
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "cần NAME=VALUE: %s"

#: etiketto/cli.py:125
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "cần một số nguyên từ %(min)d đến %(max)d: %(value)s"

#: etiketto/cli.py:143 etiketto/cli.py:147
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "cần các hàng như 3-10, 5 hoặc 7-: %s"

#: etiketto/cli.py:155
msgid "Without a command the application starts; label files given open in it."
msgstr "Không có lệnh thì ứng dụng khởi động; các tệp nhãn được chỉ định sẽ mở trong đó."

#: etiketto/cli.py:161
msgid "print a label file without opening a window"
msgstr "in tệp nhãn mà không mở cửa sổ"

#: etiketto/cli.py:162
msgid "Print a label file without opening a window."
msgstr "In tệp nhãn mà không mở cửa sổ."

#: etiketto/cli.py:164
msgid "the label (.etiketto)"
msgstr "nhãn (.etiketto)"

#: etiketto/cli.py:167
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "kiểu máy in, mặc định là của nhãn: %s"

#: etiketto/cli.py:170
msgid "printer address, by default the one set in the app"
msgstr "địa chỉ máy in, mặc định là địa chỉ đã đặt trong ứng dụng"

#: etiketto/cli.py:173
msgid "number of copies"
msgstr "số bản"

#: etiketto/cli.py:183
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "văn bản của phần tử NAME, hoặc giá trị của biến {=NAME}; các biến trong văn bản được điền vào; có thể lặp lại"

#: etiketto/cli.py:193
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "như --set, nhưng giá trị được dùng nguyên văn: dấu ngoặc nhọn không phải là biến"

#: etiketto/cli.py:199
msgid "counter of the first label, instead of the one saved in the label"
msgstr "bộ đếm của nhãn đầu tiên, thay cho giá trị đã lưu trong nhãn"

#: etiketto/cli.py:205
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "in với giá trị mặc định của kiểu máy in thay vì kiểu cắt, màu, chất lượng, tùy chọn thêm (in nối tiếp, độ phân giải cao, nạp băng), cài đặt máy in và đường viền tờ nhãn đã chọn lần cuối trong ứng dụng; địa chỉ và lề an toàn được giữ nguyên"

#: etiketto/cli.py:213
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "không hỏi máy in trước khi kết xuất (kiểu máy, băng và độ phân giải)"

#: etiketto/cli.py:219
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "không lưu giá trị bộ đếm tiếp theo vào nhãn (tệp chỉ đọc); lần in tiếp theo bắt đầu từ cùng số đó"

#: etiketto/cli.py:228
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "nhãn hàng loạt: một nhãn cho mỗi hàng của tệp CSV, ODS hoặc XLSX này; mặc định là tệp dữ liệu của nhãn"

#: etiketto/cli.py:233
msgid "the sheet of the data file, by default the first"
msgstr "trang tính của tệp dữ liệu, mặc định là trang đầu tiên"

#: etiketto/cli.py:239
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "chỉ các hàng này của tệp dữ liệu, ví dụ 3-10, 5 hoặc 7- (đếm từ 1)"

#: etiketto/cli.py:242
msgid "check and render only, do not print"
msgstr "chỉ kiểm tra và dựng ảnh, không in"

#: etiketto/cli.py:248
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "với --dry-run: lưu mỗi nhãn dạng PNG như cửa sổ xuất ra, tối đa 600 dpi (- cho stdout: chỉ nhãn đầu tiên)"

#: etiketto/cli.py:254
msgid "list the printers found on the network"
msgstr "liệt kê các máy in tìm thấy trên mạng"

#: etiketto/cli.py:255
msgid "List the printers found on the network: model, address, name."
msgstr "Liệt kê các máy in tìm thấy trên mạng: kiểu máy, địa chỉ, tên."

#: etiketto/cli.py:257
#, python-format
msgid "only this printer model: %s"
msgstr "chỉ kiểu máy in này: %s"

#: etiketto/cli.py:276
#, python-format
msgid "Unknown printer model: %s"
msgstr "Kiểu máy in không xác định: %s"

#: etiketto/cli.py:283 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:294 etiketto/ui/texts.py:597
#, python-format
msgid "Cannot open %s"
msgstr "Không thể mở %s"

#: etiketto/cli.py:305
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s không phải ngày, cần ví dụ 2026-12-31 hoặc 2026-12-31T08:30"

#: etiketto/cli.py:335
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} được điền khi in và không thể đặt"

#: etiketto/cli.py:340
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Nhãn không có phần tử hoặc biến nào tên %s"

#: etiketto/cli.py:364 etiketto/ui/printing.py:104
msgid "The label is empty"
msgstr "Nhãn đang trống"

#: etiketto/cli.py:401
msgid "Cannot write the output"
msgstr "Không thể ghi đầu ra"

#: etiketto/cli.py:432
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output ghi ảnh PNG: hãy đặt tên kết thúc bằng .png"

#: etiketto/cli.py:457 etiketto/cli.py:666 etiketto/ui/printing.py:550
#: etiketto/ui/printing.py:712
msgid "The label cannot be prepared for printing."
msgstr "Không thể chuẩn bị nhãn để in."

#: etiketto/cli.py:544
msgid "No printer found – give its address with --host"
msgstr "Không tìm thấy máy in – hãy nhập địa chỉ bằng --host"

#: etiketto/cli.py:546
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Tìm thấy nhiều máy in – hãy chọn một máy bằng --host (etiketto list-printers)"

#: etiketto/cli.py:557 etiketto/ui/texts.py:640
#, python-format
msgid "Cannot save %s"
msgstr "Không thể lưu %s"

#: etiketto/cli.py:559
msgid "the labels were printed, but the next counter value was not saved"
msgstr "các nhãn đã được in, nhưng giá trị bộ đếm tiếp theo chưa được lưu"

#: etiketto/cli.py:574
msgid "nothing was printed: the next counter value could not be saved"
msgstr "không có gì được in: giá trị bộ đếm tiếp theo sẽ không lưu được"

#: etiketto/cli.py:634 etiketto/cli.py:661 etiketto/cli.py:974
msgid "Interrupted"
msgstr "Đã ngắt"

#: etiketto/cli.py:759
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Nhãn dùng một tệp dữ liệu nằm ngoài thư mục của nó: hãy chỉ định bằng --data"

#: etiketto/cli.py:765
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet và --rows cần một tệp dữ liệu (--data)"

#: etiketto/cli.py:785 etiketto/ui/printing.py:582
msgid "No rows to print"
msgstr "Không có hàng nào để in"

#: etiketto/cli.py:794 etiketto/ui/window.py:844
#, python-format
msgid "No such column: %s"
msgstr "Không có cột này: %s"

#: etiketto/cli.py:799 etiketto/ui/printing.py:661
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Không thể tạo mã vạch hoặc mã QR của các hàng này từ giá trị của chúng, ví dụ EAN-13 có chữ cái hoặc ô trống. Hãy sửa tệp dữ liệu và đọc lại, hoặc in mà không có các hàng này."

#: etiketto/cli.py:804 etiketto/ui/printing.py:666
#, python-format
msgid "Rows: %s"
msgstr "Hàng: %s"

#: etiketto/cli.py:812
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Đang chờ một lần in khác của %s hoàn tất…"

#: etiketto/cli.py:819
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s vẫn đang bị khóa bởi một lần in khác – hãy thử lại sau"

#: etiketto/cli.py:825
msgid "--output needs --dry-run"
msgstr "--output cần --dry-run"

#: etiketto/cli.py:842
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Giá trị bộ đếm tiếp theo không được lưu: lần in tiếp theo sẽ lặp lại các số"

#: etiketto/cli.py:922
msgid "Waiting for the printer's answer…"
msgstr "Đang chờ máy in trả lời…"

#: etiketto/cli.py:950 etiketto/ui/printer.py:201
msgid "No printer found"
msgstr "Không tìm thấy máy in"

