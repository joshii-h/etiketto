#: etiketto/ui/window.py:470
msgid "The browser cannot be opened"
msgstr "ब्राउज़र खोला नहीं जा सकता"

#: etiketto/ui/window.py:472
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#: etiketto/ui/window.py:525
msgid "Only local files can be dropped"
msgstr "केवल स्थानीय फ़ाइलें छोड़ी जा सकती हैं"

#: etiketto/ui/window.py:543
