msgstr "समस्या की रिपोर्ट करें…"

#: etiketto/ui/window.py:118
msgid "About Etiketto"
msgstr "Etiketto के बारे में"

#: etiketto/ui/window.py:244
msgid "Unsaved label"
msgstr "बिना सहेजा लेबल"

#: etiketto/ui/window.py:283
msgid "content scaled down to fit"
msgstr "फ़िट करने के लिए सामग्री छोटी की गई"

#: etiketto/ui/window.py:285
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "इस प्रिंटर के लिए बहुत लंबा: अधिकतम %s"

#: etiketto/ui/window.py:290
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "इस प्रिंटर के लिए बहुत चौड़ा: अधिकतम %s"

#: etiketto/ui/window.py:295
#, python-format
msgid "Problem: %s"
msgstr "समस्या: %s"

#: etiketto/ui/window.py:363
msgid "The browser cannot be opened"
msgstr "ब्राउज़र खोला नहीं जा सकता"

#: etiketto/ui/window.py:365
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#: etiketto/ui/window.py:409
msgid "Only local files can be dropped"
msgstr "केवल स्थानीय फ़ाइलें छोड़ी जा सकती हैं"

#: etiketto/ui/window.py:424
msgid "Please wait until printing has finished"
msgstr "कृपया प्रिंटिंग पूरी होने तक प्रतीक्षा करें"
