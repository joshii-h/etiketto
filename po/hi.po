#: etiketto/app.py:136 etiketto/cli.py:149
msgid "Design and print labels"
msgstr "लेबल डिज़ाइन और प्रिंट करें"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:104
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE अपेक्षित है: %s"

#: etiketto/cli.py:120
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d से %(max)d तक की पूर्ण संख्या अपेक्षित है: %(value)s"

#: etiketto/cli.py:138 etiketto/cli.py:142
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10, 5 या 7- जैसी पंक्तियाँ अपेक्षित: %s"

#: etiketto/cli.py:150
msgid "Without a command the application starts; label files given open in it."
msgstr "बिना कमांड के ऐप्लिकेशन शुरू होता है; दी गई लेबल फ़ाइलें उसमें खुलती हैं।"

#: etiketto/cli.py:156
msgid "print a label file without opening a window"
msgstr "विंडो खोले बिना लेबल फ़ाइल प्रिंट करें"

#: etiketto/cli.py:157
msgid "Print a label file without opening a window."
msgstr "विंडो खोले बिना लेबल फ़ाइल प्रिंट करें।"

#: etiketto/cli.py:159
msgid "the label (.etiketto)"
msgstr "लेबल (.etiketto)"

#: etiketto/cli.py:162
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "प्रिंटर मॉडल, डिफ़ॉल्ट रूप से लेबल का मॉडल: %s"

#: etiketto/cli.py:165
msgid "printer address, by default the one set in the app"
msgstr "प्रिंटर का पता, डिफ़ॉल्ट रूप से ऐप में सेट किया गया पता"

#: etiketto/cli.py:168
msgid "number of copies"
msgstr "प्रतियों की संख्या"

#: etiketto/cli.py:178
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "तत्व NAME का पाठ, या चर {=NAME} का मान; पाठ के चर भरे जाते हैं; दोहराया जा सकता है"

#: etiketto/cli.py:188
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set की तरह, पर मान जैसा है वैसा ही उपयोग होता है: कोष्ठक चर नहीं हैं"

#: etiketto/cli.py:194
msgid "counter of the first label, instead of the one saved in the label"
msgstr "पहले लेबल का काउंटर, लेबल में सहेजे गए काउंटर के बजाय"

#: etiketto/cli.py:200
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "अगला काउंटर मान लेबल में न सहेजें (केवल-पढ़ने वाली फ़ाइल); अगला प्रिंट उसी संख्या से शुरू होगा"

#: etiketto/cli.py:209
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "सीरियल लेबल: इस CSV, ODS या XLSX फ़ाइल की हर पंक्ति के लिए एक लेबल; डिफ़ॉल्ट रूप से लेबल की डेटा फ़ाइल"

#: etiketto/cli.py:214
msgid "the sheet of the data file, by default the first"
msgstr "डेटा फ़ाइल की शीट, डिफ़ॉल्ट रूप से पहली"

#: etiketto/cli.py:220
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "डेटा फ़ाइल की केवल ये पंक्तियाँ, जैसे 3-10, 5 या 7- (1 से गिनी गईं)"

#: etiketto/cli.py:223
msgid "check and render only, do not print"
msgstr "केवल जाँचें और रेंडर करें, प्रिंट न करें"

#: etiketto/cli.py:229
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run के साथ: चित्रों को PNG के रूप में वैसे सहेजें जैसे प्रिंटर को मिलेंगे (- stdout के लिए: केवल पहला)"

#: etiketto/cli.py:235
msgid "list the printers found on the network"
msgstr "नेटवर्क पर मिले प्रिंटर सूचीबद्ध करें"

#: etiketto/cli.py:236
msgid "List the printers found on the network: model, address, name."
msgstr "नेटवर्क पर मिले प्रिंटर सूचीबद्ध करता है: मॉडल, पता, नाम।"

#: etiketto/cli.py:238
#, python-format
msgid "only this printer model: %s"
msgstr "केवल यह प्रिंटर मॉडल: %s"

#: etiketto/cli.py:257
#, python-format
msgid "Unknown printer model: %s"
msgstr "अज्ञात प्रिंटर मॉडल: %s"

#: etiketto/cli.py:264 etiketto/ui/files.py:66 etiketto/ui/texts.py:237
#, python-format
msgid "Cannot open %s"
msgstr "%s खोला नहीं जा सकता"

#: etiketto/cli.py:286
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s तारीख़ नहीं है, अपेक्षित जैसे 2026-12-31 या 2026-12-31T08:30"

#: etiketto/cli.py:313
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} प्रिंट करते समय भरा जाता है और सेट नहीं किया जा सकता"

#: etiketto/cli.py:318
#, python-format
msgid "The label has no element or variable named %s"
msgstr "लेबल में %s नाम का कोई तत्व या चर नहीं है"

#: etiketto/cli.py:342 etiketto/ui/printing.py:84
msgid "The label is empty"
msgstr "लेबल खाली है"

#: etiketto/cli.py:375
msgid "Cannot write the output"
msgstr "आउटपुट लिखा नहीं जा सकता"

#: etiketto/cli.py:406
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output PNG चित्र लिखता है: .png पर समाप्त होने वाला नाम दें"

#: etiketto/cli.py:442 etiketto/cli.py:473 etiketto/cli.py:592
#: etiketto/cli.py:619 etiketto/ui/printing.py:329 etiketto/ui/printing.py:467
msgid "The label cannot be prepared for printing."
msgstr "लेबल को प्रिंट के लिए तैयार नहीं किया जा सकता।"

#: etiketto/cli.py:500
msgid "No printer found – give its address with --host"
msgstr "कोई प्रिंटर नहीं मिला – --host से उसका पता दें"

#: etiketto/cli.py:502
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "कई प्रिंटर मिले – --host से एक चुनें (etiketto list-printers)"

#: etiketto/cli.py:513 etiketto/ui/texts.py:255
#, python-format
msgid "Cannot save %s"
msgstr "%s सहेजा नहीं जा सकता"

#: etiketto/cli.py:515
msgid "the labels were printed, but the next counter value was not saved"
msgstr "लेबल प्रिंट हो गए, लेकिन अगला काउंटर मान सहेजा नहीं गया"

#: etiketto/cli.py:530
msgid "nothing was printed: the next counter value could not be saved"
msgstr "कुछ भी प्रिंट नहीं हुआ: अगला काउंटर मान सहेजा नहीं जा सकता"

#: etiketto/cli.py:590 etiketto/cli.py:616 etiketto/cli.py:817
msgid "Interrupted"
msgstr "बाधित"

#: etiketto/cli.py:623 etiketto/ui/printing.py:470
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "प्रिंटिंग पंक्ति %(row)d पर रुक गई। जारी रखने के लिए पंक्ति %(row)d से फिर से प्रिंट करें।"

#: etiketto/cli.py:694
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "लेबल अपने फ़ोल्डर के बाहर की डेटा फ़ाइल का उपयोग करता है: उसे --data से दें"

#: etiketto/cli.py:700
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet और --rows के लिए डेटा फ़ाइल (--data) चाहिए"

#: etiketto/cli.py:709
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s में %(sheet)s नाम की कोई शीट नहीं है"

#: etiketto/cli.py:717 etiketto/ui/printing.py:345
msgid "No rows to print"
msgstr "प्रिंट करने के लिए कोई पंक्ति नहीं"

#: etiketto/cli.py:726 etiketto/ui/window.py:389
#, python-format
msgid "No such column: %s"
msgstr "ऐसा कोई स्तंभ नहीं: %s"

#: etiketto/cli.py:731 etiketto/ui/printing.py:418
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "इन पंक्तियों का बारकोड या QR कोड उनके मानों से नहीं बनाया जा सकता, उदाहरण के लिए अक्षरों वाला EAN-13 या खाली सेल। डेटा फ़ाइल ठीक करें और उसे फिर से पढ़ें, या इन पंक्तियों के बिना प्रिंट करें।"

#: etiketto/cli.py:736 etiketto/ui/printing.py:423
#, python-format
msgid "Rows: %s"
msgstr "पंक्तियाँ: %s"

#: etiketto/cli.py:744
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s के दूसरे प्रिंट के पूरा होने की प्रतीक्षा…"

#: etiketto/cli.py:751
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s अभी भी किसी दूसरे प्रिंट द्वारा लॉक है – बाद में फिर कोशिश करें"

#: etiketto/cli.py:757
msgid "--output needs --dry-run"
msgstr "--output के लिए --dry-run ज़रूरी है"

#: etiketto/cli.py:766
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "अगला काउंटर मान सहेजा नहीं जाता: अगला प्रिंट संख्याएँ दोहराएगा"

#: etiketto/cli.py:793 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "कोई प्रिंटर नहीं मिला"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "तालिकाएँ (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "डेटा फ़ाइल चुनें"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:86 etiketto/ui/files.py:120
#: etiketto/ui/texts.py:45
msgid "Only local files can be used"
msgstr "केवल स्थानीय फ़ाइलें इस्तेमाल की जा सकती हैं"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "लेबल के फ़ोल्डर से बाहर की डेटा फ़ाइलें पढ़ने से पहले Etiketto फिर से पूछेगा"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "डेटा फ़ाइल पढ़ें?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "यह लेबल अपने फ़ोल्डर के बाहर की डेटा फ़ाइल का उपयोग करता है:\n\n%s\n\nइसे तभी पढ़ें जब आप जानते हों कि लेबल कहाँ से आया है।"

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "अभी नहीं"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "डेटा फ़ाइल पढ़ें"

#: etiketto/ui/data.py:250
msgid "Reading…"
msgstr "पढ़ा जा रहा है…"

#: etiketto/ui/data.py:252
msgid "Not read: outside the label's folder"
msgstr "नहीं पढ़ी गई: लेबल के फ़ोल्डर से बाहर"

#: etiketto/ui/data.py:255
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "पंक्तियाँ: %(rows)d · स्तंभ: %(columns)d"

#: etiketto/ui/data.py:266
msgid "Serial labels"
msgstr "सीरियल लेबल"

#: etiketto/ui/data.py:268
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "तालिका की हर पंक्ति के लिए एक लेबल। पाठ और कोड में स्तंभ डालें; हर लेबल अपनी पंक्ति के मान दिखाता है।"

#: etiketto/ui/data.py:275
msgid "No data file"
msgstr "कोई डेटा फ़ाइल नहीं"

#: etiketto/ui/data.py:275
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS या XLSX"

#: etiketto/ui/data.py:276 etiketto/ui/elements.py:186
msgid "Choose…"
msgstr "चुनें…"

#: etiketto/ui/data.py:289
msgid "Columns"
msgstr "स्तंभ"

#: etiketto/ui/data.py:305
msgid "Read again"
msgstr "फिर से पढ़ें"

#: etiketto/ui/data.py:309
msgid "Choose another file"
msgstr "दूसरी फ़ाइल चुनें"

#: etiketto/ui/data.py:311
msgid "Remove data file"
msgstr "डेटा फ़ाइल हटाएँ"

#: etiketto/ui/data.py:316
msgid "Sheet"
msgstr "शीट"

#: etiketto/ui/data.py:336
msgid "Insert column"
msgstr "स्तंभ डालें"

