#: etiketto/cli.py:258 etiketto/ui/printing.py:67
msgid "The label is empty"
msgstr "लेबल खाली है"

#: etiketto/cli.py:285
msgid "Cannot write the output"
msgstr "आउटपुट लिखा नहीं जा सकता"

#: etiketto/cli.py:309
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output PNG चित्र लिखता है: .png पर समाप्त होने वाला नाम दें"

#: etiketto/cli.py:344 etiketto/cli.py:459 etiketto/ui/printing.py:255
msgid "The label cannot be prepared for printing."
msgstr "लेबल को प्रिंट के लिए तैयार नहीं किया जा सकता।"

#: etiketto/cli.py:371
msgid "No printer found – give its address with --host"
msgstr "कोई प्रिंटर नहीं मिला – --host से उसका पता दें"

