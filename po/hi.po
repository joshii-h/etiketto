msgid "No content yet"
msgstr "अभी कोई सामग्री नहीं"

#: etiketto/ui/elements.py:43
msgid "Add text, an image or a code"
msgstr "पाठ, छवि या कोड जोड़ें"

#: etiketto/ui/elements.py:52 etiketto/ui/texts.py:57 etiketto/ui/window.py:489
msgid "Text"
msgstr "पाठ"

#: etiketto/ui/elements.py:53
msgid "Image…"
msgstr "छवि…"

#: etiketto/ui/elements.py:54
msgid "QR code / barcode"
msgstr "QR कोड / बारकोड"

#: etiketto/ui/elements.py:56
msgid "Add"
msgstr "जोड़ें"

#: etiketto/ui/elements.py:90 etiketto/ui/label_group.py:125
msgid "Remove"
msgstr "हटाएँ"

#: etiketto/ui/elements.py:93
msgid "Move down"
msgstr "पीछे ले जाएँ"

#: etiketto/ui/elements.py:94
msgid "Move up"
msgstr "आगे ले जाएँ"

#: etiketto/ui/elements.py:107
msgid "Size"
msgstr "आकार"

#: etiketto/ui/elements.py:114
msgid "pt, 0 = fill tape height"
msgstr "pt, 0 = टेप की पूरी ऊँचाई"

#: etiketto/ui/elements.py:119
msgid "Line alignment"
msgstr "पंक्ति संरेखण"

#: etiketto/ui/elements.py:126
msgid "Name for the command line"
msgstr "कमांड लाइन के लिए नाम"

#: etiketto/ui/elements.py:162
msgid "Font"
msgstr "फ़ॉन्ट"

#: etiketto/ui/elements.py:184
msgid "Image file"
msgstr "छवि फ़ाइल"

#: etiketto/ui/elements.py:185 etiketto/ui/label_group.py:113
msgid "None"
msgstr "कोई नहीं"

#: etiketto/ui/elements.py:198
msgid "Type"
msgstr "प्रकार"

#: etiketto/ui/elements.py:200
msgid "Content (link, text, number)"
msgstr "सामग्री (लिंक, पाठ, संख्या)"

#: etiketto/ui/elements.py:209
msgid "Colour"
msgstr "रंग"

#: etiketto/ui/files.py:34
msgid "Etiketto labels"
msgstr "Etiketto लेबल"

#: etiketto/ui/files.py:39
msgid "Images"
msgstr "छवियाँ"

#: etiketto/ui/files.py:42 etiketto/ui/label_group.py:118
msgid "Choose image"
msgstr "छवि चुनें"

#: etiketto/ui/files.py:62
#, python-format
msgid "Cannot open template %(name)s"
msgstr "टेम्पलेट %(name)s खोला नहीं जा सकता"

#: etiketto/ui/files.py:76
msgid "Open label"
msgstr "लेबल खोलें"

#: etiketto/ui/files.py:94
msgid "label"
msgstr "लेबल"

#: etiketto/ui/files.py:138
msgid "Save label"
msgstr "लेबल सहेजें"

#: etiketto/ui/files.py:146 etiketto/ui/window.py:133
msgid "Save as template…"
msgstr "टेम्पलेट के रूप में सहेजें…"

#: etiketto/ui/files.py:155 etiketto/ui/files.py:168
#, python-format
msgid "Saved %s"
msgstr "%s सहेजा गया"

#: etiketto/ui/files.py:181
msgid "Export PNG"
msgstr "PNG में निर्यात करें"

#: etiketto/ui/files.py:189 etiketto/ui/window.py:407
msgid "The preview cannot be drawn"
msgstr "पूर्वावलोकन नहीं बनाया जा सकता"

#: etiketto/ui/files.py:191
msgid "Exported"
msgstr "निर्यात किया गया"

#: etiketto/ui/files.py:201
msgid "No templates yet – use “Save as template…”"
msgstr "अभी कोई टेम्पलेट नहीं – “टेम्पलेट के रूप में सहेजें…” इस्तेमाल करें"

#: etiketto/ui/files.py:228 etiketto/ui/label_group.py:48
#: etiketto/ui/window.py:44
msgid "Label"
msgstr "लेबल"

#: etiketto/ui/files.py:238
msgid "Discard changes?"
msgstr "बदलाव छोड़ें?"

#: etiketto/ui/files.py:239
msgid "The current label has unsaved changes."
msgstr "मौजूदा लेबल में बिना सहेजे बदलाव हैं।"

#: etiketto/ui/files.py:241
msgid "Discard"
msgstr "छोड़ें"

#. translators: a month and a year, e.g. "May 2018"; reorder as your language needs
#: etiketto/ui/i18n.py:65
#, python-format
msgid "%(month)s %(year)d"
msgstr "%(month)s %(year)d"

#: etiketto/ui/i18n.py:70
msgctxt "month name"
msgid "January"
msgstr "जनवरी"

#: etiketto/ui/i18n.py:71
msgctxt "month name"
msgid "February"
msgstr "फ़रवरी"

#: etiketto/ui/i18n.py:72
msgctxt "month name"
msgid "March"
msgstr "मार्च"

#: etiketto/ui/i18n.py:73
msgctxt "month name"
msgid "April"
msgstr "अप्रैल"

#: etiketto/ui/i18n.py:74
msgctxt "month name"
msgid "May"
