msgstr "समस्या की रिपोर्ट करें…"

#: etiketto/ui/window.py:118
msgid "About Etiketto"
msgstr "Etiketto के बारे में"

#: etiketto/ui/window.py:244
msgid "Unsaved label"
msgstr "बिना सहेजा लेबल"

#: etiketto/ui/window.py:283
msgid "content scaled down to fit"
msgstr "फ़िट करने के लिए सामग्री छोटी की गई"

#: etiketto/ui/window.py:285
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "इस प्रिंटर के लिए बहुत लंबा: अधिकतम %s"

#: etiketto/ui/window.py:290
#, python-format
msgid "Too wide for this printer: at most %s"
