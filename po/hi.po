#: etiketto/ui/texts.py:321
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s सहेजा नहीं जा सकता: डिस्क भरी हुई है"

#: etiketto/ui/texts.py:322
#, python-format
msgid "Cannot save %s"
