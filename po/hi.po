msgstr "%(unit)s, 0 = टेप की पूरी ऊँचाई"

#: etiketto/ui/elements.py:263
msgid ""
"Black-and-white printers print symbols in black, or in white if the colour "
"is light"
msgstr "श्वेत-श्याम प्रिंटर प्रतीकों को काले रंग में छापते हैं, या हल्का रंग होने पर सफ़ेद में"

#: etiketto/ui/elements.py:270
msgid "Rotation"
msgstr "घुमाव"

#: etiketto/ui/elements.py:282
msgid "Type"
msgstr "प्रकार"

#: etiketto/ui/elements.py:285
msgid "Content (link, text, number)"
msgstr "सामग्री (लिंक, पाठ, संख्या)"

#: etiketto/ui/elements.py:294
msgid "Colour"
msgstr "रंग"

#: etiketto/ui/files.py:57
msgid "Etiketto labels"
msgstr "Etiketto लेबल"

#: etiketto/ui/files.py:62
msgid "Images"
msgstr "छवियाँ"

#: etiketto/ui/files.py:65 etiketto/ui/label_group.py:132
msgid "Choose image"
msgstr "छवि चुनें"

#: etiketto/ui/files.py:85
#, python-format
msgid "Cannot open template %(name)s"
msgstr "टेम्पलेट %(name)s खोला नहीं जा सकता"

#: etiketto/ui/files.py:99
msgid "Open label"
msgstr "लेबल खोलें"

#: etiketto/ui/files.py:116
msgid "PDF documents and images"
msgstr "PDF दस्तावेज़ और छवियाँ"

#: etiketto/ui/files.py:121
msgid "Open shipping label"
msgstr "शिपिंग लेबल खोलें"

#: etiketto/ui/files.py:186
msgid "label"
msgstr "लेबल"

#: etiketto/ui/files.py:230
msgid "Save label"
msgstr "लेबल सहेजें"

#: etiketto/ui/files.py:238 etiketto/ui/window.py:152
msgid "Save as template…"
msgstr "टेम्पलेट के रूप में सहेजें…"

#: etiketto/ui/files.py:247 etiketto/ui/files.py:260
#, python-format
msgid "Saved %s"
msgstr "%s सहेजा गया"

#: etiketto/ui/files.py:273
msgid "Export PNG"
msgstr "PNG में निर्यात करें"

#: etiketto/ui/files.py:281 etiketto/ui/window.py:543
msgid "The preview cannot be drawn"
msgstr "पूर्वावलोकन नहीं बनाया जा सकता"

#: etiketto/ui/files.py:283
msgid "Exported"
msgstr "निर्यात किया गया"

#: etiketto/ui/files.py:293
msgid "No templates yet – use “Save as template…”"
msgstr "अभी कोई टेम्पलेट नहीं – “टेम्पलेट के रूप में सहेजें…” इस्तेमाल करें"

#: etiketto/ui/files.py:320 etiketto/ui/label_group.py:61
#: etiketto/ui/window.py:58
msgid "Label"
msgstr "लेबल"

#: etiketto/ui/files.py:330
msgid "Discard changes?"
msgstr "बदलाव छोड़ें?"

#: etiketto/ui/files.py:331
