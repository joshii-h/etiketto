msgstr "ब्राउज़र खोला नहीं जा सकता"

#: etiketto/ui/window.py:365
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#: etiketto/ui/window.py:409
msgid "Only local files can be dropped"
msgstr "केवल स्थानीय फ़ाइलें छोड़ी जा सकती हैं"

#: etiketto/ui/window.py:424
msgid "Please wait until printing has finished"
msgstr "कृपया प्रिंटिंग पूरी होने तक प्रतीक्षा करें"
