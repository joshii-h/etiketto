msgid "None"
msgstr "कोई नहीं"

#: etiketto/ui/elements.py:221
msgid "Area"
msgstr "क्षेत्र"

#: etiketto/ui/elements.py:227 etiketto/ui/shipping.py:295
msgid "Scale"
msgstr "स्केल"

#: etiketto/ui/elements.py:233 etiketto/ui/texts.py:193
msgid "Symbol"
msgstr "प्रतीक"

