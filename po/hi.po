msgstr "ऐसे सहेजें…"

#: etiketto/ui/window.py:134
msgid "Data for serial labels…"
msgstr "सीरियल लेबल के लिए डेटा…"

#: etiketto/ui/window.py:135
msgid "Forget allowed data files"
msgstr "अनुमति वाली डेटा फ़ाइलें भूलें"

#: etiketto/ui/window.py:136
msgid "Export PNG…"
msgstr "PNG में निर्यात करें…"

#: etiketto/ui/window.py:137
msgid "Help"
msgstr "सहायता"

#: etiketto/ui/window.py:138
msgid "Report a problem…"
msgstr "समस्या की रिपोर्ट करें…"

#: etiketto/ui/window.py:139
msgid "About Etiketto"
msgstr "Etiketto के बारे में"

#: etiketto/ui/window.py:333
msgid "Unsaved label"
msgstr "बिना सहेजा लेबल"

#: etiketto/ui/window.py:382
msgid "content scaled down to fit"
msgstr "फ़िट करने के लिए सामग्री छोटी की गई"

