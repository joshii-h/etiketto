#: etiketto/ui/window.py:610
msgid "The browser cannot be opened"
msgstr "ब्राउज़र खोला नहीं जा सकता"

#: etiketto/ui/window.py:612
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#: etiketto/ui/window.py:667
