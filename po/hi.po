#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "बॉक्स और फ़्रेम"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "लेबल डिज़ाइन और प्रिंट करें"

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:222
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "वेरिएबल के लिए विचार (काउंटर, तारीख़, UUID), कोई कोड नहीं"

#: tavletta/app.py:233
msgid "Protocol knowledge"
msgstr "प्रोटोकॉल की जानकारी"

#: tavletta/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "%(projects)s और निर्माताओं की पुस्तिकाओं से, उनके कोड के बिना नए सिरे से लिखा गया; देखें THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE अपेक्षित है: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d से %(max)d तक की पूर्ण संख्या अपेक्षित है: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10, 5 या 7- जैसी पंक्तियाँ अपेक्षित: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "बिना कमांड के ऐप्लिकेशन शुरू होता है; दी गई लेबल फ़ाइलें उसमें खुलती हैं।"

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "विंडो खोले बिना लेबल फ़ाइल प्रिंट करें"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "विंडो खोले बिना लेबल फ़ाइल प्रिंट करें।"

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "लेबल (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "प्रिंटर मॉडल, डिफ़ॉल्ट रूप से लेबल का मॉडल: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "प्रिंटर का पता, डिफ़ॉल्ट रूप से ऐप में सेट किया गया पता"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "प्रतियों की संख्या"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "तत्व NAME का पाठ, या चर {=NAME} का मान; पाठ के चर भरे जाते हैं; दोहराया जा सकता है"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set की तरह, पर मान जैसा है वैसा ही उपयोग होता है: कोष्ठक चर नहीं हैं"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "पहले लेबल का काउंटर, लेबल में सहेजे गए काउंटर के बजाय"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "ऐप में पिछली बार चुने गए कट, रंग, गुणवत्ता, अतिरिक्त विकल्पों (चेन प्रिंटिंग, उच्च रिज़ॉल्यूशन, टेप फ़ीड), प्रिंटर सेटिंग और लेबल शीट की रूपरेखा की जगह प्रिंटर मॉडल की डिफ़ॉल्ट सेटिंग से प्रिंट करें; पता और सुरक्षा मार्जिन वही रहते हैं"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "इस सेटिंग वाले थर्मल प्रिंटर की प्रिंट विधि: printer (जैसा प्रिंटर पर सेट है), transfer (रिबन के साथ) या direct (डायरेक्ट थर्मल, बिना रिबन); डिफ़ॉल्ट रूप से ऐप में चुनी गई विधि, --printer-defaults के साथ भी"

#: tavletta/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "रेंडर करने से पहले प्रिंटर से न पूछें (उसका मॉडल, टेप और रिज़ॉल्यूशन)"

#: tavletta/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "अगला काउंटर मान लेबल में न सहेजें (केवल-पढ़ने वाली फ़ाइल); अगला प्रिंट उसी संख्या से शुरू होगा"

#: tavletta/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "सीरियल लेबल: इस CSV, ODS या XLSX फ़ाइल की हर पंक्ति के लिए एक लेबल; डिफ़ॉल्ट रूप से लेबल की डेटा फ़ाइल"

#: tavletta/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "डेटा फ़ाइल की शीट, डिफ़ॉल्ट रूप से पहली"

#: tavletta/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "डेटा फ़ाइल की केवल ये पंक्तियाँ, जैसे 3-10, 5 या 7- (1 से गिनी गईं)"

#: tavletta/cli.py:267
msgid "check and render only, do not print"
msgstr "केवल जाँचें और रेंडर करें, प्रिंट न करें"

#: tavletta/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "--dry-run के साथ: हर लेबल को PNG के रूप में वैसे सहेजें जैसे विंडो उसे निर्यात करती है, अधिकतम 600 dpi (- stdout के लिए: केवल पहला)"

#: tavletta/cli.py:279
msgid "list the printers found on the network"
msgstr "नेटवर्क पर मिले प्रिंटर सूचीबद्ध करें"

#: tavletta/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "नेटवर्क पर मिले प्रिंटर सूचीबद्ध करता है: मॉडल, पता, नाम।"

#: tavletta/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "केवल यह प्रिंटर मॉडल: %s"

#: tavletta/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "172.16.0.0/12 जैसा पता या नेटवर्क अपेक्षित है: %s"

#: tavletta/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "वह फ़ोल्डर जिसमें वे लेबल फ़ाइलें हैं जिनका सर्वर उपयोग कर सकता है"

#: tavletta/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "केवल इसी प्रिंटर पते पर प्रिंट करें (* किसी से भी मेल खाता है); दोहराया जा सकता है"

#: tavletta/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: वे प्रिंटर जिनका क्लाइंट नाम से उपयोग कर सकते हैं"

#: tavletta/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "एक प्रिंट जॉब में अधिकतम लेबल, प्रतियाँ गुणा पंक्तियाँ (डिफ़ॉल्ट 10000)"

#: tavletta/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "नेटवर्क पर प्रिंटर खोजें (डिफ़ॉल्ट रूप से बंद)"

#: tavletta/cli.py:336
msgid "run a print server with a REST API"
msgstr "REST API वाला प्रिंट सर्वर चलाएँ"

#: tavletta/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "प्रिंट सर्वर चलाएँ: एक REST API और, --mcp के साथ, AI क्लाइंट के लिए MCP।"

#: tavletta/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "सुनने का पता (डिफ़ॉल्ट 127.0.0.1)"

#: tavletta/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "सुनने का पोर्ट (डिफ़ॉल्ट %d)"

#: tavletta/cli.py:352
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "एक्सेस टोकन वाली फ़ाइल; अन्यथा पर्यावरण चर TAVLETTA_TOKEN"

#: tavletta/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: भूमिकाओं सहित नामित एक्सेस टोकन"

#: tavletta/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "/mcp पर MCP भी उपलब्ध कराएँ"

#: tavletta/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "अनुरोध बॉडी का अधिकतम आकार MB में (डिफ़ॉल्ट 4)"

#: tavletta/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "एक रिवर्स प्रॉक्सी जिसका X-Forwarded-For हेडर क्लाइंट का नाम बताता है, जैसे 172.16.0.0/12; दोहराया जा सकता है"

#: tavletta/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "इस ऑरिजिन के वेब पेजों से अनुरोधों की अनुमति दें; दोहराया जा सकता है"

#: tavletta/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "मानक इनपुट और आउटपुट पर MCP उपलब्ध कराएँ"

#: tavletta/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "मानक इनपुट और आउटपुट पर MCP उपलब्ध कराएँ, Claude Desktop जैसे AI क्लाइंट के लिए।"

#: tavletta/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "प्रिंट सर्वर के एक्सेस टोकन प्रबंधित करें"

#: tavletta/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "प्रिंट सर्वर के एक्सेस टोकन प्रबंधित करें।"

#: tavletta/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "एक टोकन बनाएँ और उसका हैश tokens.toml में जोड़ें"

#: tavletta/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "एक टोकन बनाएँ, उसका हैश tokens.toml में जोड़ें और टोकन एक बार दिखाएँ।"

#: tavletta/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "टोकन का नाम, जैसे डिवाइस"

#: tavletta/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: केवल देखना; print: प्रिंट भी करना; admin: सभी जॉब भी"

#: tavletta/cli.py:417
msgid "tokens.toml to add it to"
msgstr "वह tokens.toml जिसमें इसे जोड़ना है"

#: tavletta/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "printers.toml का केवल यह प्रिंटर; दोहराया जा सकता है"

#: tavletta/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml, --printer की जाँच के लिए"

#: tavletta/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "इस तारीख़ तक मान्य, जैसे 2027-12-31"

#: tavletta/cli.py:429
msgid "a note for people"
msgstr "लोगों के लिए एक टिप्पणी"

#: tavletta/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "हैश को SHA-256 के बजाय scrypt से सहेजें"

#: tavletta/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "नया टोकन बनाने के बजाय मानक इनपुट से अपना चुना हुआ टोकन लें (scrypt से सहेजा जाता है)"

#: tavletta/cli.py:457 tavletta/server/config.py:220
#: tavletta/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "अज्ञात प्रिंटर मॉडल: %s"

#: tavletta/cli.py:464 tavletta/ui/files.py:89 tavletta/ui/files.py:142
#: tavletta/ui/texts.py:303 tavletta/ui/texts.py:640
#: tavletta/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "%s खोला नहीं जा सकता"

#: tavletta/cli.py:486 tavletta/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s तारीख़ नहीं है, अपेक्षित जैसे 2026-12-31 या 2026-12-31T08:30"

#: tavletta/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} प्रिंट करते समय भरा जाता है और सेट नहीं किया जा सकता"

#: tavletta/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "लेबल में %s नाम का कोई तत्व या चर नहीं है"

#: tavletta/cli.py:551 tavletta/ui/printing.py:123
#: tavletta/server/service.py:963
msgid "The label is empty"
msgstr "लेबल खाली है"

#: tavletta/cli.py:588
msgid "Cannot write the output"
msgstr "आउटपुट लिखा नहीं जा सकता"

#: tavletta/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output PNG चित्र लिखता है: .png पर समाप्त होने वाला नाम दें"

#: tavletta/cli.py:644 tavletta/cli.py:853 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:891
#: tavletta/server/service.py:1118 tavletta/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "लेबल को प्रिंट के लिए तैयार नहीं किया जा सकता।"

#: tavletta/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "कोई प्रिंटर नहीं मिला – --host से उसका पता दें"

#: tavletta/cli.py:733
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "कई प्रिंटर मिले – --host से एक चुनें (tavletta list-printers)"

#: tavletta/cli.py:744 tavletta/ui/texts.py:683 tavletta/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "%s सहेजा नहीं जा सकता"

#: tavletta/cli.py:746 tavletta/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "लेबल प्रिंट हो गए, लेकिन अगला काउंटर मान सहेजा नहीं गया"

#: tavletta/cli.py:761 tavletta/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "कुछ भी प्रिंट नहीं हुआ: अगला काउंटर मान सहेजा नहीं जा सकता"

#: tavletta/cli.py:821 tavletta/cli.py:848 tavletta/cli.py:1209
msgid "Interrupted"
msgstr "बाधित"

#: tavletta/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: इस प्रिंटर मॉडल में प्रिंट विधि की सेटिंग नहीं है: %s"

#: tavletta/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet और --rows के लिए डेटा फ़ाइल (--data) चाहिए"

#: tavletta/cli.py:972 tavletta/ui/printing.py:585
#: tavletta/server/service.py:764
msgid "No rows to print"
msgstr "प्रिंट करने के लिए कोई पंक्ति नहीं"

#: tavletta/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "लेबल अपने फ़ोल्डर के बाहर की डेटा फ़ाइल का उपयोग करता है: उसे --data से दें"

#: tavletta/cli.py:1009 tavletta/ui/window.py:844
#: tavletta/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "ऐसा कोई स्तंभ नहीं: %s"

#: tavletta/cli.py:1014 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "इन पंक्तियों का बारकोड या QR कोड उनके मानों से नहीं बनाया जा सकता, उदाहरण के लिए अक्षरों वाला EAN-13 या खाली सेल। डेटा फ़ाइल ठीक करें और उसे फिर से पढ़ें, या इन पंक्तियों के बिना प्रिंट करें।"

#: tavletta/cli.py:1019 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "पंक्तियाँ: %s"

#: tavletta/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s के दूसरे प्रिंट के पूरा होने की प्रतीक्षा…"

