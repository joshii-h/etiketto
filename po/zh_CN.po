#: etiketto/app.py:136 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "设计并打印标签"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "应为 NAME=VALUE：%s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "应为 %(min)d 到 %(max)d 之间的整数：%(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "应为 3-10、5 或 7- 这样的行：%s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "不带命令时启动应用程序；给出的标签文件在其中打开。"

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "不打开窗口，直接打印标签文件"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "不打开窗口，直接打印标签文件。"

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "标签（.etiketto）"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "打印机型号，默认为标签中的型号：%s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "打印机地址，默认为应用中设置的地址"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "份数"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "元素 NAME 的文本，或变量 {=NAME} 的值；文本中的变量会被填入；可重复使用"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "同 --set，但值按原样使用：花括号不作为变量"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "第一张标签的计数器，代替标签中保存的值"

#: etiketto/cli.py:204
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "不在标签中保存下一个计数器值（只读文件）；下次打印从相同编号开始"

#: etiketto/cli.py:213
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "数据合并标签：此 CSV、ODS 或 XLSX 文件的每一行一个标签；默认为标签的数据文件"

#: etiketto/cli.py:218
msgid "the sheet of the data file, by default the first"
msgstr "数据文件的工作表，默认为第一个"

#: etiketto/cli.py:224
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "仅数据文件的这些行，例如 3-10、5 或 7-（从 1 开始计数）"

#: etiketto/cli.py:227
msgid "check and render only, do not print"
msgstr "只检查并渲染，不打印"

#: etiketto/cli.py:233
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "配合 --dry-run：按打印机收到的样子将图像保存为 PNG（- 表示标准输出：仅第一张）"

#: etiketto/cli.py:239
msgid "list the printers found on the network"
msgstr "列出在网络中找到的打印机"

#: etiketto/cli.py:240
msgid "List the printers found on the network: model, address, name."
msgstr "列出在网络中找到的打印机：型号、地址、名称。"

#: etiketto/cli.py:242
#, python-format
msgid "only this printer model: %s"
msgstr "仅此打印机型号：%s"

#: etiketto/cli.py:254
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "应为地址或网络，例如 172.16.0.0/12：%s"

#: etiketto/cli.py:264
msgid "the folder with the label files the server may use"
msgstr "包含服务器可使用的标签文件的文件夹"

#: etiketto/cli.py:271
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "仅在此打印机地址上打印（* 匹配任意内容）；可重复使用"

#: etiketto/cli.py:277
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml：客户端可按名称使用的打印机"

#: etiketto/cli.py:284
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "一个打印作业中的最大标签数，即份数乘以行数（默认 10000）"

#: etiketto/cli.py:289
msgid "search the network for printers (off by default)"
msgstr "在网络中搜索打印机（默认关闭）"

#: etiketto/cli.py:296
msgid "run a print server with a REST API"
msgstr "运行带 REST API 的打印服务器"

#: etiketto/cli.py:297
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "运行打印服务器：提供 REST API，使用 --mcp 时还为 AI 客户端提供 MCP。"

#: etiketto/cli.py:300
msgid "address to listen on (default 127.0.0.1)"
msgstr "监听的地址（默认 127.0.0.1）"

#: etiketto/cli.py:306
#, python-format
msgid "port to listen on (default %d)"
msgstr "监听的端口（默认 %d）"

#: etiketto/cli.py:312
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "包含访问令牌的文件；否则使用环境变量 ETIKETTO_TOKEN"

#: etiketto/cli.py:318
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml：带角色的具名访问令牌"

#: etiketto/cli.py:320
msgid "also serve MCP at /mcp"
msgstr "同时在 /mcp 提供 MCP"

#: etiketto/cli.py:326
msgid "largest request body in MB (default 4)"
msgstr "请求体的最大大小，单位 MB（默认 4）"

#: etiketto/cli.py:335
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "其 X-Forwarded-For 标头指明客户端的反向代理，例如 172.16.0.0/12；可重复使用"

#: etiketto/cli.py:344
msgid "allow requests from web pages of this origin; repeatable"
msgstr "允许来自此来源网页的请求；可重复使用"

#: etiketto/cli.py:349
msgid "serve MCP on standard input and output"
msgstr "通过标准输入和输出提供 MCP"

#: etiketto/cli.py:351
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "通过标准输入和输出提供 MCP，供 Claude Desktop 等 AI 客户端使用。"

#: etiketto/cli.py:361
msgid "manage the access tokens of the print server"
msgstr "管理打印服务器的访问令牌"

#: etiketto/cli.py:362
msgid "Manage the access tokens of the print server."
msgstr "管理打印服务器的访问令牌。"

#: etiketto/cli.py:367
msgid "make a token and add its hash to tokens.toml"
msgstr "生成令牌并将其哈希添加到 tokens.toml"

#: etiketto/cli.py:368
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "生成令牌，将其哈希添加到 tokens.toml，并仅显示一次令牌。"

#: etiketto/cli.py:370
msgid "name of the token, e.g. the device"
msgstr "令牌名称，例如设备名"

#: etiketto/cli.py:375
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview：仅查看；print：还可打印；admin：还可管理所有作业"

#: etiketto/cli.py:377
msgid "tokens.toml to add it to"
msgstr "要添加到的 tokens.toml"

#: etiketto/cli.py:383
msgid "only this printer of printers.toml; repeatable"
msgstr "仅限 printers.toml 中的此打印机；可重复使用"

#: etiketto/cli.py:386
msgid "printers.toml, to check --printer"
msgstr "printers.toml，用于检查 --printer"

#: etiketto/cli.py:388
msgid "valid until, e.g. 2027-12-31"
msgstr "有效期至，例如 2027-12-31"

#: etiketto/cli.py:389
msgid "a note for people"
msgstr "给人看的备注"

#: etiketto/cli.py:391
msgid "store the hash with scrypt instead of SHA-256"
msgstr "使用 scrypt 而非 SHA-256 存储哈希"

#: etiketto/cli.py:397
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "从标准输入读取你自选的令牌（使用 scrypt 存储），而不是生成一个"

#: etiketto/cli.py:417 etiketto/server/config.py:216
#: etiketto/server/service.py:474
#, python-format
msgid "Unknown printer model: %s"
msgstr "未知的打印机型号：%s"

#: etiketto/cli.py:424 etiketto/ui/files.py:66 etiketto/ui/texts.py:238
#: etiketto/server/service.py:622
#, python-format
msgid "Cannot open %s"
msgstr "无法打开 %s"

#: etiketto/cli.py:446 etiketto/server/main.py:230
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s 不是日期，应类似 2026-12-31 或 2026-12-31T08:30"

#: etiketto/cli.py:476
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} 会在打印时填入，无法设置"

#: etiketto/cli.py:481
#, python-format
msgid "The label has no element or variable named %s"
msgstr "标签中没有名为 %s 的元素或变量"

#: etiketto/cli.py:506 etiketto/ui/printing.py:89
#: etiketto/server/service.py:881
msgid "The label is empty"
msgstr "标签为空"

#: etiketto/cli.py:539
msgid "Cannot write the output"
msgstr "无法写入输出"

#: etiketto/cli.py:570
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output 写入 PNG 图像：请给出以 .png 结尾的名称"

#: etiketto/cli.py:606 etiketto/cli.py:640 etiketto/cli.py:759
#: etiketto/cli.py:787 etiketto/ui/printing.py:340 etiketto/ui/printing.py:478
#: etiketto/server/service.py:821 etiketto/server/service.py:1030
#: etiketto/server/service.py:1175
msgid "The label cannot be prepared for printing."
msgstr "无法准备标签以供打印。"

#: etiketto/cli.py:667
msgid "No printer found – give its address with --host"
msgstr "未找到打印机，请用 --host 指定其地址"

#: etiketto/cli.py:669
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "找到多台打印机，请用 --host 选择一台（etiketto list-printers）"

#: etiketto/cli.py:680 etiketto/ui/texts.py:272 etiketto/server/service.py:1165
#, python-format
msgid "Cannot save %s"
msgstr "无法保存 %s"

#: etiketto/cli.py:682 etiketto/server/service.py:1168
msgid "the labels were printed, but the next counter value was not saved"
msgstr "标签已打印，但下一个计数器值未能保存"

#: etiketto/cli.py:697 etiketto/server/service.py:905
msgid "nothing was printed: the next counter value could not be saved"
msgstr "未打印任何内容：下一个计数器值无法保存"

#: etiketto/cli.py:757 etiketto/cli.py:784 etiketto/cli.py:986
msgid "Interrupted"
msgstr "已中断"

#: etiketto/cli.py:860
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "此标签使用其文件夹之外的数据文件：请用 --data 指定"

#: etiketto/cli.py:866
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet 和 --rows 需要数据文件（--data）"

#: etiketto/cli.py:881 etiketto/ui/printing.py:356
#: etiketto/server/service.py:709
msgid "No rows to print"
msgstr "没有要打印的行"

#: etiketto/cli.py:890 etiketto/ui/window.py:389 etiketto/server/service.py:762
#, python-format
msgid "No such column: %s"
msgstr "没有此列：%s"

#: etiketto/cli.py:895 etiketto/ui/printing.py:429
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "无法根据这些行的值生成条形码或二维码，例如含字母的 EAN-13 或空单元格。请修正数据文件并重新读取，或不打印这些行。"

#: etiketto/cli.py:900 etiketto/ui/printing.py:434
#, python-format
msgid "Rows: %s"
msgstr "行：%s"

#: etiketto/cli.py:908
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "正在等待 %s 的另一个打印任务完成…"

#: etiketto/cli.py:915 etiketto/server/service.py:1024
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s 仍被另一个打印任务锁定 – 请稍后再试"

#: etiketto/cli.py:921
msgid "--output needs --dry-run"
msgstr "--output 需要 --dry-run"

#: etiketto/cli.py:930
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "下一个计数器值不会保存：下次打印会重复这些编号"

#: etiketto/cli.py:957 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "未找到打印机"

