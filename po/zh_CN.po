msgstr "此计算机的所有用户都可以更改 %s：请对其执行 chmod 600"

#: tavletta/server/config.py:447
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "不是令牌哈希：应为 sha256:… 或 scrypt:…"

#: tavletta/server/config.py:473
msgid "expected a list of printer names"
msgstr "应为打印机名称列表"

#: tavletta/server/config.py:477 tavletta/server/main.py:368
msgid "printers can only be limited with --printers"
msgstr "只能通过 --printers 限制打印机"

#: tavletta/server/config.py:479 tavletta/server/service.py:477
#, python-format
msgid "Unknown printer: %s"
msgstr "未知打印机：%s"

