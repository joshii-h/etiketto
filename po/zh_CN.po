#, python-format
msgid "Not a valid printer address pattern: %s"
msgstr "不是有效的打印机地址模式：%s"

#: tavletta/server/main.py:117
#, python-format
msgid ""
"Refusing to listen on %s without an access token: set TAVLETTA_TOKEN or use "
