#: etiketto/app.py:136 etiketto/cli.py:149
msgid "Design and print labels"
msgstr "设计并打印标签"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:104
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "应为 NAME=VALUE：%s"

#: etiketto/cli.py:120
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "应为 %(min)d 到 %(max)d 之间的整数：%(value)s"

#: etiketto/cli.py:138 etiketto/cli.py:142
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "应为 3-10、5 或 7- 这样的行：%s"

#: etiketto/cli.py:150
msgid "Without a command the application starts; label files given open in it."
msgstr "不带命令时启动应用程序；给出的标签文件在其中打开。"

#: etiketto/cli.py:156
msgid "print a label file without opening a window"
msgstr "不打开窗口，直接打印标签文件"

#: etiketto/cli.py:157
msgid "Print a label file without opening a window."
msgstr "不打开窗口，直接打印标签文件。"

#: etiketto/cli.py:159
msgid "the label (.etiketto)"
msgstr "标签（.etiketto）"

#: etiketto/cli.py:162
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "打印机型号，默认为标签中的型号：%s"

#: etiketto/cli.py:165
msgid "printer address, by default the one set in the app"
msgstr "打印机地址，默认为应用中设置的地址"

#: etiketto/cli.py:168
msgid "number of copies"
msgstr "份数"

#: etiketto/cli.py:178
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "元素 NAME 的文本，或变量 {=NAME} 的值；文本中的变量会被填入；可重复使用"

#: etiketto/cli.py:188
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "同 --set，但值按原样使用：花括号不作为变量"

#: etiketto/cli.py:194
msgid "counter of the first label, instead of the one saved in the label"
msgstr "第一张标签的计数器，代替标签中保存的值"

#: etiketto/cli.py:200
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "不在标签中保存下一个计数器值（只读文件）；下次打印从相同编号开始"

#: etiketto/cli.py:209
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "数据合并标签：此 CSV、ODS 或 XLSX 文件的每一行一个标签；默认为标签的数据文件"

#: etiketto/cli.py:214
msgid "the sheet of the data file, by default the first"
msgstr "数据文件的工作表，默认为第一个"

#: etiketto/cli.py:220
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "仅数据文件的这些行，例如 3-10、5 或 7-（从 1 开始计数）"

#: etiketto/cli.py:223
msgid "check and render only, do not print"
msgstr "只检查并渲染，不打印"

#: etiketto/cli.py:229
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "配合 --dry-run：按打印机收到的样子将图像保存为 PNG（- 表示标准输出：仅第一张）"

#: etiketto/cli.py:235
msgid "list the printers found on the network"
msgstr "列出在网络中找到的打印机"

#: etiketto/cli.py:236
msgid "List the printers found on the network: model, address, name."
msgstr "列出在网络中找到的打印机：型号、地址、名称。"

#: etiketto/cli.py:238
#, python-format
msgid "only this printer model: %s"
msgstr "仅此打印机型号：%s"

#: etiketto/cli.py:257
#, python-format
msgid "Unknown printer model: %s"
msgstr "未知的打印机型号：%s"

#: etiketto/cli.py:264 etiketto/ui/files.py:66 etiketto/ui/texts.py:237
#, python-format
msgid "Cannot open %s"
msgstr "无法打开 %s"

#: etiketto/cli.py:286
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s 不是日期，应类似 2026-12-31 或 2026-12-31T08:30"

#: etiketto/cli.py:313
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} 会在打印时填入，无法设置"

#: etiketto/cli.py:318
#, python-format
msgid "The label has no element or variable named %s"
msgstr "标签中没有名为 %s 的元素或变量"

#: etiketto/cli.py:342 etiketto/ui/printing.py:84
msgid "The label is empty"
msgstr "标签为空"

#: etiketto/cli.py:375
msgid "Cannot write the output"
msgstr "无法写入输出"

#: etiketto/cli.py:406
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output 写入 PNG 图像：请给出以 .png 结尾的名称"

#: etiketto/cli.py:442 etiketto/cli.py:473 etiketto/cli.py:592
#: etiketto/cli.py:619 etiketto/ui/printing.py:329 etiketto/ui/printing.py:467
msgid "The label cannot be prepared for printing."
msgstr "无法准备标签以供打印。"

#: etiketto/cli.py:500
msgid "No printer found – give its address with --host"
msgstr "未找到打印机，请用 --host 指定其地址"

#: etiketto/cli.py:502
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "找到多台打印机，请用 --host 选择一台（etiketto list-printers）"

#: etiketto/cli.py:513 etiketto/ui/texts.py:255
#, python-format
msgid "Cannot save %s"
msgstr "无法保存 %s"

#: etiketto/cli.py:515
msgid "the labels were printed, but the next counter value was not saved"
msgstr "标签已打印，但下一个计数器值未能保存"

#: etiketto/cli.py:530
msgid "nothing was printed: the next counter value could not be saved"
msgstr "未打印任何内容：下一个计数器值无法保存"

#: etiketto/cli.py:590 etiketto/cli.py:616 etiketto/cli.py:817
msgid "Interrupted"
msgstr "已中断"

#: etiketto/cli.py:623 etiketto/ui/printing.py:470
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "打印在第 %(row)d 行停止。如需继续，请从第 %(row)d 行重新打印。"

#: etiketto/cli.py:694
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "此标签使用其文件夹之外的数据文件：请用 --data 指定"

#: etiketto/cli.py:700
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet 和 --rows 需要数据文件（--data）"

#: etiketto/cli.py:709
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s 中没有名为 %(sheet)s 的工作表"

#: etiketto/cli.py:717 etiketto/ui/printing.py:345
msgid "No rows to print"
msgstr "没有要打印的行"

#: etiketto/cli.py:726 etiketto/ui/window.py:389
#, python-format
msgid "No such column: %s"
msgstr "没有此列：%s"

#: etiketto/cli.py:731 etiketto/ui/printing.py:418
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "无法根据这些行的值生成条形码或二维码，例如含字母的 EAN-13 或空单元格。请修正数据文件并重新读取，或不打印这些行。"

#: etiketto/cli.py:736 etiketto/ui/printing.py:423
#, python-format
msgid "Rows: %s"
msgstr "行：%s"

#: etiketto/cli.py:744
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "正在等待 %s 的另一个打印任务完成…"

#: etiketto/cli.py:751
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s 仍被另一个打印任务锁定 – 请稍后再试"

#: etiketto/cli.py:757
msgid "--output needs --dry-run"
msgstr "--output 需要 --dry-run"

#: etiketto/cli.py:766
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "下一个计数器值不会保存：下次打印会重复这些编号"

#: etiketto/cli.py:793 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "未找到打印机"

