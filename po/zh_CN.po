msgstr "无法保存 %s：没有写入权限"

#: etiketto/ui/texts.py:255
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "无法保存 %s：磁盘已满"

#: etiketto/ui/texts.py:256
#, python-format
msgid "Cannot save %s"
msgstr "无法保存 %s"

#: etiketto/ui/texts.py:265
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "此色带盒似乎是 %(year)d 年%(month)s生产的。旧的 ZINK 相纸打印出的颜色会偏淡。"

