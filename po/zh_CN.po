msgid "Remove"
msgstr "移除"

#: tavletta/ui/elements.py:207
msgid "Move down"
msgstr "后移"

#: tavletta/ui/elements.py:208
msgid "Move up"
msgstr "前移"

#: tavletta/ui/elements.py:226 tavletta/ui/elements.py:363
#: tavletta/ui/freelayout.py:190
msgid "Size"
msgstr "大小"

#: tavletta/ui/elements.py:233
msgid "pt, 0 = fill tape height"
msgstr "pt，0 = 填满色带高度"

#: tavletta/ui/elements.py:238
msgid "Line alignment"
msgstr "行对齐"

#: tavletta/ui/elements.py:246
msgid "Name for the command line"
msgstr "命令行名称"

#: tavletta/ui/elements.py:285
msgid "Font"
msgstr "字体"

#: tavletta/ui/elements.py:302 tavletta/ui/freelayout.py:214
