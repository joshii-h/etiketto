msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Element %(n)d: inget UPC-A-nummer förkortas till dessa UPC-E-siffror – kontrollera dem eller använd UPC-A"

#: etiketto/ui/texts.py:221
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Element %(n)d: skannrar inställda på Full ASCII läser ett $, /, + eller %% före en versal som ett annat tecken"

#: etiketto/ui/texts.py:224
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Element %(n)d: innehållet är för långt för den här kodtypen"

#: etiketto/ui/texts.py:225
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Element %(n)d: innehållet kan inte kodas i den här kodtypen"

#: etiketto/ui/texts.py:227
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Element %(n)d: den här kodtypen kräver biblioteket Zint (zint-bindings), som inte är installerat"

#: etiketto/ui/texts.py:230
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: bilden kan inte läsas"

#: etiketto/ui/texts.py:231
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Element %(n)d: symbolen finns inte i symbolbiblioteket"

#: etiketto/ui/texts.py:232
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: dokumentet kan inte läsas"

#: etiketto/ui/texts.py:234
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: PDF-filer kräver Poppler (poppler-glib), som inte är installerat"

#: etiketto/ui/texts.py:236
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Element %(n)d kan inte ritas"

#: etiketto/ui/texts.py:237
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Säkerhetsmarginal, kant och kantavstånd lämnar inget utrymme – minska dem"

#: etiketto/ui/texts.py:238
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Den fasta längden är kortare än avståndet – öka den"

#: etiketto/ui/texts.py:239
msgid "The background image cannot be read"
msgstr "Bakgrundsbilden kan inte läsas"

#: etiketto/ui/texts.py:241
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: kodens moduler är bara en skrivarpunkt breda och kanske inte går att skanna – gör koden större"

#: etiketto/ui/texts.py:245
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: det tomma utrymme koden behöver runt sig får inte plats – gör koden större"

#: etiketto/ui/texts.py:249
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: koden får inte plats, inte ens med en skrivarpunkt per modul – gör etiketten större eller innehållet kortare"

#: etiketto/ui/texts.py:252
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Element %(n)d: %(name)s är inte en känd variabel"

#: etiketto/ui/texts.py:254
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Element %(n)d: datumet för %(name)s ligger före år 1 eller efter 9999"

#: etiketto/ui/texts.py:257
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Element %(n)d: variabeln %(name)s… är inte stängd – avsluta den med }"

#: etiketto/ui/texts.py:271
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Redan utskrivna ark: %(n)d av %(total)d."

#: etiketto/ui/texts.py:273
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Redan utskrivna etiketter: %(n)d av %(total)d."

#: etiketto/ui/texts.py:277
msgid "The sheets still waiting in the queue were canceled."
msgstr "Arken som fortfarande väntade i kön avbröts."

#: etiketto/ui/texts.py:279
msgid "The labels still waiting in the queue were canceled."
msgstr "Etiketterna som fortfarande väntade i kön avbröts."

#: etiketto/ui/texts.py:288
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Skrivaren hittas inte. Kontrollera att den är påslagen och i samma nätverk, eller ange dess IP-adress."

#: etiketto/ui/texts.py:292
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Skrivaren hittas inte via USB. Kontrollera kabeln och att skrivaren är påslagen och vaken, och sök sedan igen."

#: etiketto/ui/texts.py:295
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Skrivaren svarar inte. Kontrollera att den är påslagen och vaken."

#: etiketto/ui/texts.py:297
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Skrivaren tar inte emot mer data. Kontrollera om den visar ett problem, till exempel slut på etiketter eller ett öppet lock, och försök sedan igen."

#: etiketto/ui/texts.py:301
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Skrivaren nekar anslutningen. Stäng av den och slå på den igen. Om webbgränssnittet har ett alternativ ”Port 9100”, slå på det."

#: etiketto/ui/texts.py:304
msgid "No cassette is inserted. Insert one and try again."
msgstr "Ingen kassett är isatt. Sätt i en och försök igen."

#: etiketto/ui/texts.py:305
msgid "The printer's cover is open. Close it and try again."
msgstr "Skrivarens lock är öppet. Stäng det och försök igen."

#: etiketto/ui/texts.py:306
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etiketten har fastnat. Öppna locket, ta bort den och försök igen."

#: etiketto/ui/texts.py:307
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kassetten känns inte igen. Sätt i den igen eller prova en annan."

#: etiketto/ui/texts.py:308
msgid "The printer is busy. Wait a moment and try again."
msgstr "Skrivaren är upptagen. Vänta en stund och försök igen."

#: etiketto/ui/texts.py:309
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etiketten är för lång för den här skrivaren: högst %(max)s."

#: etiketto/ui/texts.py:310
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etiketten är för bred för den här skrivaren: högst %(max)s."

#: etiketto/ui/texts.py:311
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Skrivaren har slut på etiketter. Sätt i en ny rulle och försök igen."

#: etiketto/ui/texts.py:312
msgid "The print head is open. Close it and try again."
msgstr "Skrivhuvudet är öppet. Stäng det och försök igen."

#: etiketto/ui/texts.py:314
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Skrivaren hittar inte nästa etikett. Kontrollera att etiketterna är rätt isatta och går igenom etikettsensorn."

#: etiketto/ui/texts.py:318
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Det är något fel på färgbandet. Kontrollera att det sitter rätt och motsvarar den utskriftsmetod som är inställd på skrivaren."

#: etiketto/ui/texts.py:321
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Skrivaren är pausad. Återuppta den på dess display och försök igen."

#: etiketto/ui/texts.py:322
msgid "The printer is out of paper. Load paper and try again."
msgstr "Skrivaren har slut på papper. Fyll på papper och försök igen."

#: etiketto/ui/texts.py:324
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Papperet har fastnat. Ta bort det som skrivarens display visar och försök igen."

#: etiketto/ui/texts.py:326
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Skrivaren har slut på toner eller bläck. Byt ut det och försök igen."

#: etiketto/ui/texts.py:327
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Skrivaren kan inte skriva ut den här storleken. Välj en pappersstorlek som den erbjuder."

#: etiketto/ui/texts.py:329
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Skrivaren tar inte emot något av de format som Etiketto kan skicka (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:332
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Skrivarens kö är pausad. Återuppta den i systemets skrivarinställningar och försök igen."

#: etiketto/ui/texts.py:336
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Utskriftsjobbet hölls kvar i kön, till exempel tills det släpps eller ett lösenord anges. Kontrollera kön i systemets skrivarinställningar och försök igen."

#: etiketto/ui/texts.py:340
msgid "The print job was canceled at the printer or in the queue."
msgstr "Utskriftsjobbet avbröts på skrivaren eller i kön."

#: etiketto/ui/texts.py:342
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto får inte använda skrivarens USB-port. Lägg till din användare i gruppen ”lp” (sudo usermod -aG lp $USER) och logga sedan ut och in igen."

#: etiketto/ui/texts.py:346
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "En kod får inte plats på etiketten med den här skrivarens upplösning och skulle skäras av. Gör etiketten större eller kodens innehåll kortare."

#: etiketto/ui/texts.py:350
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Skrivaren rapporterade ett problem. Stäng av den och slå på den igen och försök sedan en gång till."

#: etiketto/ui/texts.py:361
msgid "Printed"
msgstr "Utskriven"

#: etiketto/ui/texts.py:367
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Skickad till skrivaren – skrivs ut när det är dess tur"

#: etiketto/ui/texts.py:371
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Färgläget ”%(wanted)s” finns inte på den här skrivaren, utskrivet med ”%(used)s”"

#: etiketto/ui/texts.py:381
msgid "Warming up…"
msgstr "Värmer upp…"

#: etiketto/ui/texts.py:382
msgid "Cooling down…"
msgstr "Svalnar…"

#: etiketto/ui/texts.py:383
msgid "Cleaning…"
msgstr "Rengör…"

#: etiketto/ui/texts.py:384
msgid "Swipe the printer's panel to cut the label"
msgstr "Dra över skrivarens panel för att skära av etiketten"

#: etiketto/ui/texts.py:386
msgid "Out of paper – load paper to continue"
msgstr "Slut på papper – fyll på papper för att fortsätta"

#: etiketto/ui/texts.py:387
msgid "Cover open – close it to continue"
msgstr "Locket är öppet – stäng det för att fortsätta"

#: etiketto/ui/texts.py:388
msgid "Paper jammed – remove it to continue"
msgstr "Papperet har fastnat – ta bort det för att fortsätta"

#: etiketto/ui/texts.py:399
msgid "This label needs a newer version of Etiketto"
msgstr "Den här etiketten kräver en nyare version av Etiketto"

#: etiketto/ui/texts.py:401
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s är inte en Etiketto-etikett"

#: etiketto/ui/texts.py:402 etiketto/ui/texts.py:422
#, python-format
msgid "The file is damaged: %s"
msgstr "Filen är skadad: %s"

#: etiketto/ui/texts.py:409
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Datafilen %s finns inte längre. Välj den igen eller ta bort den."

#: etiketto/ui/texts.py:413
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s har inget blad som heter %(sheet)s"

#: etiketto/ui/texts.py:415
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s är ingen tabell. Använd en CSV-, ODS- eller XLSX-fil."

#: etiketto/ui/texts.py:417
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s är för stor för serieetiketter. Dela upp den i mindre filer eller ta bort rader och kolumner som inte behövs."

#: etiketto/ui/texts.py:420
#, python-format
msgid "%s contains no data."
msgstr "%s innehåller inga data."

#: etiketto/ui/texts.py:428
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Utskriften stoppades vid rad %(row)d. Skriv ut igen från rad %(row)d för att fortsätta."

#: etiketto/ui/texts.py:432
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Redan utskrivna kopior av rad %(row)d: %(copies)d."

#: etiketto/ui/texts.py:442
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Kan inte spara %s: behörighet saknas för att skriva där"

#: etiketto/ui/texts.py:444
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Kan inte spara %s: disken är full"

#: etiketto/ui/texts.py:454
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Kassetten verkar vara från %(month)s %(year)d. Gammalt ZINK-papper ger blekare färger."

#: etiketto/ui/variables.py:24
msgid "Date"
msgstr "Datum"

#: etiketto/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Bäst före (om 30 dagar)"

#: etiketto/ui/variables.py:26
msgid "Time"
msgstr "Tid"

#: etiketto/ui/variables.py:27 etiketto/ui/variables.py:113
msgid "Counter"
msgstr "Räknare"

#: etiketto/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Räknare med inledande nollor"

#: etiketto/ui/variables.py:29
msgid "Copy number"
msgstr "Kopienummer"

#: etiketto/ui/variables.py:30
msgid "Number of copies"
msgstr "Antal kopior"

#: etiketto/ui/variables.py:31
msgid "Random ID"
msgstr "Slumpmässigt ID"

#: etiketto/ui/variables.py:41
msgid "Insert variable"
msgstr "Infoga variabel"

#: etiketto/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Variabler fylls i vid utskrift. Varje utskriven etikett får nästa räknarvärde, även från kopia till kopia. Förhandsvisningen visar värdena för nästa utskrift."

#: etiketto/ui/variables.py:77
msgid "More about variables"
msgstr "Mer om variabler"

#: etiketto/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Ökar med varje utskriven etikett, med steget"

#: etiketto/ui/variables.py:119
msgid "Next number"
msgstr "Nästa nummer"

#: etiketto/ui/variables.py:122
msgid "Step"
msgstr "Steg"

#: etiketto/ui/window.py:116
msgid "Open"
msgstr "Öppna"

#: etiketto/ui/window.py:123
msgid "Templates"
msgstr "Mallar"

#: etiketto/ui/window.py:129
msgid "Save"
msgstr "Spara"

#: etiketto/ui/window.py:146
msgid "New label"
msgstr "Ny etikett"

#: etiketto/ui/window.py:147
msgid "Shipping label…"
msgstr "Fraktetikett…"

#: etiketto/ui/window.py:148
msgid "Save as…"
msgstr "Spara som…"

#: etiketto/ui/window.py:150
msgid "Data for serial labels…"
msgstr "Data för serieetiketter…"

#: etiketto/ui/window.py:151
msgid "Forget allowed data files"
msgstr "Glöm tillåtna datafiler"

#: etiketto/ui/window.py:152
msgid "Export PNG…"
msgstr "Exportera som PNG…"

#: etiketto/ui/window.py:153
msgid "Help"
msgstr "Hjälp"

#: etiketto/ui/window.py:154
msgid "Report a problem…"
msgstr "Rapportera ett problem…"

#: etiketto/ui/window.py:155
msgid "About Etiketto"
msgstr "Om Etiketto"

#: etiketto/ui/window.py:439
msgid "Unsaved label"
msgstr "Osparad etikett"

#: etiketto/ui/window.py:503
msgid "content scaled down to fit"
msgstr "innehållet förminskat för att få plats"

#: etiketto/ui/window.py:507
#, python-format
msgid "Problem: %s"
msgstr "Problem: %s"

#: etiketto/ui/window.py:526
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "För lång för den här skrivaren: högst %s"

#: etiketto/ui/window.py:530
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "För bred för den här skrivaren: högst %s"

#: etiketto/ui/window.py:598
msgid "The browser cannot be opened"
msgstr "Webbläsaren kan inte öppnas"

#: etiketto/ui/window.py:600
msgid "Copy link"
msgstr "Kopiera länk"

#: etiketto/ui/window.py:655
msgid "Only local files can be dropped"
msgstr "Endast lokala filer kan släppas"

#: etiketto/ui/window.py:676
msgid "Please wait until printing has finished"
msgstr "Vänta tills utskriften är klar"
