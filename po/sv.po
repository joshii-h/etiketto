#: etiketto/app.py:136 etiketto/cli.py:153
msgid "Design and print labels"
msgstr "Designa och skriv ut etiketter"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "förväntade NAME=VALUE: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "förväntade ett heltal från %(min)d till %(max)d: %(value)s"

#: etiketto/cli.py:142 etiketto/cli.py:146
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "rader förväntades, t.ex. 3-10, 5 eller 7-: %s"

#: etiketto/cli.py:154
msgid "Without a command the application starts; label files given open in it."
msgstr "Utan kommando startar appen; angivna etikettfiler öppnas i den."

#: etiketto/cli.py:160
msgid "print a label file without opening a window"
msgstr "skriv ut en etikettfil utan att öppna något fönster"

#: etiketto/cli.py:161
msgid "Print a label file without opening a window."
msgstr "Skriv ut en etikettfil utan att öppna något fönster."

#: etiketto/cli.py:163
msgid "the label (.etiketto)"
msgstr "etiketten (.etiketto)"

#: etiketto/cli.py:166
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "skrivarmodell, som standard etikettens: %s"

#: etiketto/cli.py:169
msgid "printer address, by default the one set in the app"
msgstr "skrivaradress, som standard den som är inställd i appen"

#: etiketto/cli.py:172
msgid "number of copies"
msgstr "antal kopior"

#: etiketto/cli.py:182
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "text i elementet NAME, eller värdet för variabeln {=NAME}; variabler i en text fylls i; kan upprepas"

#: etiketto/cli.py:192
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "som --set, men värdet används som det är: klammerparenteser är inga variabler"

#: etiketto/cli.py:198
msgid "counter of the first label, instead of the one saved in the label"
msgstr "räknare för den första etiketten, i stället för den som är sparad i etiketten"

#: etiketto/cli.py:204
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "spara inte nästa räknarvärde i etiketten (en skrivskyddad fil); nästa utskrift börjar på samma nummer"

#: etiketto/cli.py:213
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "serieetiketter: en etikett för varje rad i den här CSV-, ODS- eller XLSX-filen; som standard etikettens datafil"

#: etiketto/cli.py:218
msgid "the sheet of the data file, by default the first"
msgstr "datafilens blad, som standard det första"

#: etiketto/cli.py:224
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "bara de här raderna i datafilen, t.ex. 3-10, 5 eller 7- (räknat från 1)"

#: etiketto/cli.py:227
msgid "check and render only, do not print"
msgstr "kontrollera och rendera bara, skriv inte ut"

#: etiketto/cli.py:233
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "med --dry-run: spara bilderna som PNG så som skrivaren skulle få dem (- för stdout: bara den första)"

#: etiketto/cli.py:239
msgid "list the printers found on the network"
msgstr "lista skrivarna som hittas på nätverket"

#: etiketto/cli.py:240
msgid "List the printers found on the network: model, address, name."
msgstr "Lista skrivarna som hittas på nätverket: modell, adress, namn."

#: etiketto/cli.py:242
#, python-format
msgid "only this printer model: %s"
msgstr "bara denna skrivarmodell: %s"

#: etiketto/cli.py:254
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "förväntade en adress eller ett nät som 172.16.0.0/12: %s"

#: etiketto/cli.py:264
msgid "the folder with the label files the server may use"
msgstr "mappen med de etikettfiler som servern får använda"

#: etiketto/cli.py:271
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "skriv bara ut på denna skrivaradress (* matchar vad som helst); kan upprepas"

#: etiketto/cli.py:277
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: skrivarna som klienter får använda, efter namn"

#: etiketto/cli.py:284
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "högst så många etiketter i ett utskriftsjobb, kopior gånger rader (standard 10000)"

#: etiketto/cli.py:289
msgid "search the network for printers (off by default)"
msgstr "sök efter skrivare på nätverket (av som standard)"

#: etiketto/cli.py:296
msgid "run a print server with a REST API"
msgstr "kör en utskriftsserver med ett REST API"

#: etiketto/cli.py:297
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Kör en utskriftsserver: ett REST API och, med --mcp, MCP för AI-klienter."

#: etiketto/cli.py:300
msgid "address to listen on (default 127.0.0.1)"
msgstr "adress att lyssna på (standard 127.0.0.1)"

#: etiketto/cli.py:306
#, python-format
msgid "port to listen on (default %d)"
msgstr "port att lyssna på (standard %d)"

#: etiketto/cli.py:312
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "fil med åtkomsttoken; annars miljövariabeln ETIKETTO_TOKEN"

#: etiketto/cli.py:318
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: namngivna åtkomsttoken med roller"

#: etiketto/cli.py:320
msgid "also serve MCP at /mcp"
msgstr "tillhandahåll även MCP på /mcp"

#: etiketto/cli.py:326
msgid "largest request body in MB (default 4)"
msgstr "största förfrågningsinnehåll i MB (standard 4)"

#: etiketto/cli.py:335
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "en omvänd proxy vars X-Forwarded-For-huvud anger klienten, t.ex. 172.16.0.0/12; kan upprepas"

#: etiketto/cli.py:344
msgid "allow requests from web pages of this origin; repeatable"
msgstr "tillåt förfrågningar från webbsidor med detta ursprung; kan upprepas"

#: etiketto/cli.py:349
msgid "serve MCP on standard input and output"
msgstr "tillhandahåll MCP via standard in och ut"

#: etiketto/cli.py:351
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Tillhandahåll MCP via standard in och ut, för AI-klienter som Claude Desktop."

#: etiketto/cli.py:361
msgid "manage the access tokens of the print server"
msgstr "hantera utskriftsserverns åtkomsttoken"

#: etiketto/cli.py:362
msgid "Manage the access tokens of the print server."
msgstr "Hantera utskriftsserverns åtkomsttoken."

#: etiketto/cli.py:367
msgid "make a token and add its hash to tokens.toml"
msgstr "skapa en token och lägg till dess hash i tokens.toml"

#: etiketto/cli.py:368
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Skapa en token, lägg till dess hash i tokens.toml och visa token en gång."

#: etiketto/cli.py:370
msgid "name of the token, e.g. the device"
msgstr "namn på token, t.ex. enheten"

#: etiketto/cli.py:375
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: bara titta; print: även skriva ut; admin: även alla jobb"

#: etiketto/cli.py:377
msgid "tokens.toml to add it to"
msgstr "tokens.toml att lägga till den i"

#: etiketto/cli.py:383
msgid "only this printer of printers.toml; repeatable"
msgstr "bara denna skrivare från printers.toml; kan upprepas"

#: etiketto/cli.py:386
msgid "printers.toml, to check --printer"
msgstr "printers.toml, för att kontrollera --printer"

#: etiketto/cli.py:388
msgid "valid until, e.g. 2027-12-31"
msgstr "giltig till, t.ex. 2027-12-31"

#: etiketto/cli.py:389
msgid "a note for people"
msgstr "en anteckning för människor"

#: etiketto/cli.py:391
msgid "store the hash with scrypt instead of SHA-256"
msgstr "lagra hashen med scrypt i stället för SHA-256"

#: etiketto/cli.py:397
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ta en egenvald token från standard in (lagras med scrypt) i stället för att skapa en"

#: etiketto/cli.py:417 etiketto/server/config.py:216
#: etiketto/server/service.py:507
#, python-format
msgid "Unknown printer model: %s"
msgstr "Okänd skrivarmodell: %s"

#: etiketto/cli.py:424 etiketto/ui/files.py:66 etiketto/ui/texts.py:242
#: etiketto/server/service.py:655
#, python-format
msgid "Cannot open %s"
msgstr "Kan inte öppna %s"

#: etiketto/cli.py:446 etiketto/server/main.py:251
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s är inget datum, förväntade t.ex. 2026-12-31 eller 2026-12-31T08:30"

#: etiketto/cli.py:476
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} fylls i vid utskrift och kan inte anges"

#: etiketto/cli.py:481
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Etiketten har inget element eller någon variabel med namnet %s"

#: etiketto/cli.py:506 etiketto/ui/printing.py:103
#: etiketto/server/service.py:944
msgid "The label is empty"
msgstr "Etiketten är tom"

#: etiketto/cli.py:539
msgid "Cannot write the output"
msgstr "Det går inte att skriva utdata"

#: etiketto/cli.py:570
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output skriver PNG-bilder: ange ett namn som slutar på .png"

#: etiketto/cli.py:606 etiketto/cli.py:640 etiketto/cli.py:759
#: etiketto/cli.py:787 etiketto/ui/printing.py:345 etiketto/ui/printing.py:483
#: etiketto/server/service.py:872 etiketto/server/service.py:1093
#: etiketto/server/service.py:1238
msgid "The label cannot be prepared for printing."
msgstr "Etiketten kan inte förberedas för utskrift."

#: etiketto/cli.py:667
msgid "No printer found – give its address with --host"
msgstr "Ingen skrivare hittades – ange adressen med --host"

#: etiketto/cli.py:669
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Flera skrivare hittades – välj en med --host (etiketto list-printers)"

#: etiketto/cli.py:680 etiketto/ui/texts.py:276 etiketto/server/service.py:1228
#, python-format
msgid "Cannot save %s"
msgstr "Kan inte spara %s"

#: etiketto/cli.py:682 etiketto/server/service.py:1231
msgid "the labels were printed, but the next counter value was not saved"
msgstr "etiketterna skrevs ut, men nästa räknarvärde sparades inte"

#: etiketto/cli.py:697 etiketto/server/service.py:968
msgid "nothing was printed: the next counter value could not be saved"
msgstr "inget skrevs ut: nästa räknarvärde skulle inte kunna sparas"

#: etiketto/cli.py:757 etiketto/cli.py:784 etiketto/cli.py:986
msgid "Interrupted"
msgstr "Avbruten"

#: etiketto/cli.py:860
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Etiketten använder en datafil utanför sin mapp: ange den med --data"

#: etiketto/cli.py:866
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet och --rows kräver en datafil (--data)"

#: etiketto/cli.py:881 etiketto/ui/printing.py:361
#: etiketto/server/service.py:742
msgid "No rows to print"
msgstr "Inga rader att skriva ut"

#: etiketto/cli.py:890 etiketto/ui/window.py:395 etiketto/server/service.py:795
#, python-format
msgid "No such column: %s"
msgstr "Okänd kolumn: %s"

#: etiketto/cli.py:895 etiketto/ui/printing.py:434
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Streckkoden eller QR-koden för de här raderna kan inte skapas från deras värden, till exempel en EAN-13 med bokstäver eller en tom cell. Rätta datafilen och läs den igen, eller skriv ut utan de här raderna."

#: etiketto/cli.py:900 etiketto/ui/printing.py:439
#, python-format
msgid "Rows: %s"
msgstr "Rader: %s"

#: etiketto/cli.py:908
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Väntar på att en annan utskrift av %s ska bli klar…"

#: etiketto/cli.py:915 etiketto/server/service.py:1087
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s är fortfarande låst av en annan utskrift – försök igen senare"

#: etiketto/cli.py:921
msgid "--output needs --dry-run"
msgstr "--output kräver --dry-run"

#: etiketto/cli.py:930
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Nästa räknarvärde sparas inte: nästa utskrift upprepar numren"

