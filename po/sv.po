msgid "Single label"
msgstr "Enskild etikett"

#: etiketto/ui/texts.py:39
msgid "Label sheet"
msgstr "Etikettark"

#: etiketto/ui/texts.py:42
msgid "Left"
msgstr "Vänster"

#: etiketto/ui/texts.py:42
msgid "Right"
msgstr "Höger"

#: etiketto/ui/texts.py:47
msgid "2D codes"
msgstr "2D-koder"

#: etiketto/ui/texts.py:49
msgid "QR code"
msgstr "QR-kod"

#: etiketto/ui/texts.py:56
msgid "Linear barcodes"
msgstr "Linjära streckkoder"

#: etiketto/ui/texts.py:71
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Applikationsidentifierare inom parentes, t.ex. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:74
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Länkar, text, wifi-åtkomst; kan läsas av mobiler"

#: etiketto/ui/texts.py:75
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Text eller siffror på liten yta, t.ex. på små delar"

#: etiketto/ui/texts.py:76
msgid "Much text, e.g. an address or a document number"
msgstr "Mycket text, t.ex. en adress eller ett dokumentnummer"

#: etiketto/ui/texts.py:77
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Text eller siffror; behöver ingen tom marginal, t.ex. på biljetter"

#: etiketto/ui/texts.py:78
msgid "Latin letters, digits and punctuation"
msgstr "Latinska bokstäver, siffror och skiljetecken"

#: etiketto/ui/texts.py:79
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Versaler, siffror, mellanslag och - . $ / + %"

#: etiketto/ui/texts.py:80
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Latinska bokstäver, siffror och skiljetecken; kortare än Code 39"

#: etiketto/ui/texts.py:81
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 siffror, kontrollsiffran läggs till (eller 13 med den)"

#: etiketto/ui/texts.py:82
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 siffror, kontrollsiffran läggs till (eller 8 med den)"

#: etiketto/ui/texts.py:83
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 siffror, kontrollsiffran läggs till (eller 12 med den)"

#: etiketto/ui/texts.py:84
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 siffror som börjar med 0 eller 1, kontrollsiffran läggs till (eller 8 med den)"

#: etiketto/ui/texts.py:85
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "13 siffror av en transportkartongs GTIN, kontrollsiffran läggs till (eller 14 med den)"

#: etiketto/ui/texts.py:91
msgid "Whole area, centred"
msgstr "Hela området, centrerat"

#: etiketto/ui/texts.py:91
msgid "Fill the label, edges cut off"
msgstr "Fyll etiketten, kanterna beskärs"

#: etiketto/ui/texts.py:105
#, python-format
msgid "Not an image: %s"
msgstr "Inte en bild: %s"

#: etiketto/ui/texts.py:113
msgid "Image"
msgstr "Bild"

#: etiketto/ui/texts.py:140
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Löpande, %(width)s bred"

#: etiketto/ui/texts.py:150
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Kontrollera att hela etiketten ligger inom markeringen. Dra för att flytta den eller dess kanter, eller rita en ny."

#: etiketto/ui/texts.py:154
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Flera områden kan vara etiketten. Kontrollera markeringen eller prova nästa."

#: etiketto/ui/texts.py:156
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Allt som är tryckt på sidan är markerat. Dra för att välja etiketten."

#: etiketto/ui/texts.py:157
msgid "Nothing is printed on this page."
msgstr "Ingenting är tryckt på den här sidan."

#: etiketto/ui/texts.py:162
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF-filer kräver Poppler (poppler-glib), som inte är installerat"

#: etiketto/ui/texts.py:172
msgid "System printer (CUPS, IPP)"
msgstr "Systemskrivare (CUPS, IPP)"

#: etiketto/ui/texts.py:178
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Element %(n)d: koden är tom"

#: etiketto/ui/texts.py:179
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Element %(n)d: EAN-13 kräver exakt 12 siffror"

#: etiketto/ui/texts.py:180
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Element %(n)d: EAN-13-kontrollsiffran är fel"

#: etiketto/ui/texts.py:182
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 128 accepterar endast latinska bokstäver, siffror och skiljetecken"

#: etiketto/ui/texts.py:184
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Element %(n)d: EAN-8 kräver 7 siffror, eller 8 med kontrollsiffran"

#: etiketto/ui/texts.py:185
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Element %(n)d: UPC-A kräver 11 siffror, eller 12 med kontrollsiffran"

#: etiketto/ui/texts.py:187
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Element %(n)d: UPC-E kräver 7 siffror som börjar med 0 eller 1, eller 8 med kontrollsiffran"

#: etiketto/ui/texts.py:189
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Element %(n)d: ITF-14 kräver 13 siffror, eller 14 med kontrollsiffran"

#: etiketto/ui/texts.py:190
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Element %(n)d: kontrollsiffran är fel"

#: etiketto/ui/texts.py:192
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Element %(n)d: Code 39 accepterar endast versaler, siffror, mellanslag och - . $ / + %%"

#: etiketto/ui/texts.py:195
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: Code 93 accepterar endast latinska bokstäver, siffror och skiljetecken"

#: etiketto/ui/texts.py:198
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Element %(n)d: GS1-data accepterar endast latinska bokstäver, siffror och skiljetecken"

#: etiketto/ui/texts.py:201
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Element %(n)d: GS1-data måste vara applikationsidentifierare inom parentes, var och en följd av sitt värde, t.ex. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:204
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Element %(n)d: (%(ai)s) är ingen GS1-applikationsidentifierare"

#: etiketto/ui/texts.py:206
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Element %(n)d: värdet för applikationsidentifierare (%(ai)s) har fel längd"

#: etiketto/ui/texts.py:209
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Element %(n)d: kontrollsiffran för applikationsidentifierare (%(ai)s) är fel"

#: etiketto/ui/texts.py:212
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Element %(n)d: värdet för applikationsidentifierare (%(ai)s) är ogiltigt: ett datum, tal eller tecken som inte är tillåtet"

#: etiketto/ui/texts.py:216
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Element %(n)d: inget UPC-A-nummer förkortas till dessa UPC-E-siffror – kontrollera dem eller använd UPC-A"

#: etiketto/ui/texts.py:220
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Element %(n)d: skannrar inställda på Full ASCII läser ett $, /, + eller %% före en versal som ett annat tecken"

#: etiketto/ui/texts.py:223
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Element %(n)d: innehållet är för långt för den här kodtypen"

#: etiketto/ui/texts.py:224
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Element %(n)d: innehållet kan inte kodas i den här kodtypen"

#: etiketto/ui/texts.py:226
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Element %(n)d: den här kodtypen kräver biblioteket Zint (zint-bindings), som inte är installerat"

#: etiketto/ui/texts.py:229
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Element %(n)d: bilden kan inte läsas"

#: etiketto/ui/texts.py:230
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Element %(n)d: symbolen finns inte i symbolbiblioteket"

#: etiketto/ui/texts.py:231
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Element %(n)d: dokumentet kan inte läsas"

#: etiketto/ui/texts.py:233
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Element %(n)d: PDF-filer kräver Poppler (poppler-glib), som inte är installerat"

#: etiketto/ui/texts.py:235
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Element %(n)d kan inte ritas"

#: etiketto/ui/texts.py:236
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Säkerhetsmarginal, kant och kantavstånd lämnar inget utrymme – minska dem"

#: etiketto/ui/texts.py:237
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Den fasta längden är kortare än avståndet – öka den"

#: etiketto/ui/texts.py:238
msgid "The background image cannot be read"
msgstr "Bakgrundsbilden kan inte läsas"

#: etiketto/ui/texts.py:240
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Element %(n)d: kodens moduler är bara en skrivarpunkt breda och kanske inte går att skanna – gör koden större"

#: etiketto/ui/texts.py:244
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Element %(n)d: det tomma utrymme koden behöver runt sig får inte plats – gör koden större"

#: etiketto/ui/texts.py:248
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Element %(n)d: koden får inte plats, inte ens med en skrivarpunkt per modul – gör etiketten större eller innehållet kortare"

#: etiketto/ui/texts.py:263
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Redan utskrivna ark: %(n)d av %(total)d."

#: etiketto/ui/texts.py:265
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Redan utskrivna etiketter: %(n)d av %(total)d."

#: etiketto/ui/texts.py:269
msgid "The sheets still waiting in the queue were canceled."
msgstr "Arken som fortfarande väntade i kön avbröts."

#: etiketto/ui/texts.py:271
msgid "The labels still waiting in the queue were canceled."
msgstr "Etiketterna som fortfarande väntade i kön avbröts."

#: etiketto/ui/texts.py:280
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Skrivaren hittas inte. Kontrollera att den är påslagen och i samma nätverk, eller ange dess IP-adress."

#: etiketto/ui/texts.py:284
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Skrivaren hittas inte via USB. Kontrollera kabeln och att skrivaren är påslagen och vaken, och sök sedan igen."

#: etiketto/ui/texts.py:287
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Skrivaren svarar inte. Kontrollera att den är påslagen och vaken."

#: etiketto/ui/texts.py:289
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Skrivaren tar inte emot mer data. Kontrollera om den visar ett problem, till exempel slut på etiketter eller ett öppet lock, och försök sedan igen."

#: etiketto/ui/texts.py:293
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Skrivaren nekar anslutningen. Stäng av den och slå på den igen. Om webbgränssnittet har ett alternativ ”Port 9100”, slå på det."

#: etiketto/ui/texts.py:296
msgid "No cassette is inserted. Insert one and try again."
msgstr "Ingen kassett är isatt. Sätt i en och försök igen."

#: etiketto/ui/texts.py:297
msgid "The printer's cover is open. Close it and try again."
msgstr "Skrivarens lock är öppet. Stäng det och försök igen."

#: etiketto/ui/texts.py:298
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etiketten har fastnat. Öppna locket, ta bort den och försök igen."

#: etiketto/ui/texts.py:299
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kassetten känns inte igen. Sätt i den igen eller prova en annan."

#: etiketto/ui/texts.py:300
msgid "The printer is busy. Wait a moment and try again."
msgstr "Skrivaren är upptagen. Vänta en stund och försök igen."

#: etiketto/ui/texts.py:301
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etiketten är för lång för den här skrivaren: högst %(max)s."

#: etiketto/ui/texts.py:302
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etiketten är för bred för den här skrivaren: högst %(max)s."

#: etiketto/ui/texts.py:303
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Skrivaren har slut på etiketter. Sätt i en ny rulle och försök igen."

#: etiketto/ui/texts.py:304
msgid "The print head is open. Close it and try again."
msgstr "Skrivhuvudet är öppet. Stäng det och försök igen."

#: etiketto/ui/texts.py:306
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Skrivaren hittar inte nästa etikett. Kontrollera att etiketterna är rätt isatta och går igenom etikettsensorn."

#: etiketto/ui/texts.py:310
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Det är något fel på färgbandet. Kontrollera att det sitter rätt och motsvarar den utskriftsmetod som är inställd på skrivaren."

#: etiketto/ui/texts.py:313
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Skrivaren är pausad. Återuppta den på dess display och försök igen."

#: etiketto/ui/texts.py:314
msgid "The printer is out of paper. Load paper and try again."
msgstr "Skrivaren har slut på papper. Fyll på papper och försök igen."

#: etiketto/ui/texts.py:316
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Papperet har fastnat. Ta bort det som skrivarens display visar och försök igen."

#: etiketto/ui/texts.py:318
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Skrivaren har slut på toner eller bläck. Byt ut det och försök igen."

#: etiketto/ui/texts.py:319
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Skrivaren kan inte skriva ut den här storleken. Välj en pappersstorlek som den erbjuder."

#: etiketto/ui/texts.py:321
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Skrivaren tar inte emot något av de format som Etiketto kan skicka (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:324
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Skrivarens kö är pausad. Återuppta den i systemets skrivarinställningar och försök igen."

#: etiketto/ui/texts.py:328
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Utskriftsjobbet hölls kvar i kön, till exempel tills det släpps eller ett lösenord anges. Kontrollera kön i systemets skrivarinställningar och försök igen."

#: etiketto/ui/texts.py:332
msgid "The print job was canceled at the printer or in the queue."
msgstr "Utskriftsjobbet avbröts på skrivaren eller i kön."

#: etiketto/ui/texts.py:334
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto får inte använda skrivarens USB-port. Lägg till din användare i gruppen ”lp” (sudo usermod -aG lp $USER) och logga sedan ut och in igen."

#: etiketto/ui/texts.py:338
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "En kod får inte plats på etiketten med den här skrivarens upplösning och skulle skäras av. Gör etiketten större eller kodens innehåll kortare."

#: etiketto/ui/texts.py:342
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Skrivaren rapporterade ett problem. Stäng av den och slå på den igen och försök sedan en gång till."

#: etiketto/ui/texts.py:354
msgid "Warming up…"
msgstr "Värmer upp…"

#: etiketto/ui/texts.py:355
msgid "Cooling down…"
msgstr "Svalnar…"

#: etiketto/ui/texts.py:356
msgid "Cleaning…"
msgstr "Rengör…"

#: etiketto/ui/texts.py:357
msgid "Swipe the printer's panel to cut the label"
msgstr "Dra över skrivarens panel för att skära av etiketten"

#: etiketto/ui/texts.py:359
msgid "Out of paper – load paper to continue"
msgstr "Slut på papper – fyll på papper för att fortsätta"

#: etiketto/ui/texts.py:360
msgid "Cover open – close it to continue"
msgstr "Locket är öppet – stäng det för att fortsätta"

#: etiketto/ui/texts.py:361
msgid "Paper jammed – remove it to continue"
msgstr "Papperet har fastnat – ta bort det för att fortsätta"

#: etiketto/ui/texts.py:372
msgid "This label needs a newer version of Etiketto"
msgstr "Den här etiketten kräver en nyare version av Etiketto"

#: etiketto/ui/texts.py:374
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s är inte en Etiketto-etikett"

#: etiketto/ui/texts.py:375
#, python-format
msgid "The file is damaged: %s"
msgstr "Filen är skadad: %s"

#: etiketto/ui/texts.py:381
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Kan inte spara %s: behörighet saknas för att skriva där"

#: etiketto/ui/texts.py:383
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Kan inte spara %s: disken är full"

#: etiketto/ui/texts.py:384
#, python-format
msgid "Cannot save %s"
msgstr "Kan inte spara %s"

#: etiketto/ui/texts.py:393
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
