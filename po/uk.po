msgstr "Не вдається зберегти %s: немає дозволу на запис"

#: etiketto/ui/texts.py:235
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Не вдається зберегти %s: диск заповнено"

#: etiketto/ui/texts.py:245
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Схоже, дата виготовлення касети: %(month)s %(year)d. Старий папір ZINK друкує блідіші кольори."

