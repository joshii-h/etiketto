#: etiketto/app.py:143 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Плашка й рамка"

#: etiketto/app.py:217 etiketto/cli.py:170
msgid "Design and print labels"
msgstr "Дизайн і друк етикеток"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:222
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/app.py:230
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ідеї для змінних (лічильник, дата, UUID), без коду"

#: etiketto/app.py:233
msgid "Protocol knowledge"
msgstr "Відомості про протоколи"

#: etiketto/app.py:238
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "З %(projects)s і посібників виробників, написано заново без їхнього коду; див. THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "очікується NAME=VALUE: %s"

#: etiketto/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "очікується ціле число від %(min)d до %(max)d: %(value)s"

#: etiketto/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "очікуються рядки на кшталт 3-10, 5 або 7-: %s"

#: etiketto/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Без команди запускається застосунок; вказані файли етикеток відкриваються в ньому."

#: etiketto/cli.py:177
msgid "print a label file without opening a window"
msgstr "друкує файл етикетки без відкриття вікна"

#: etiketto/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Друкує файл етикетки без відкриття вікна."

#: etiketto/cli.py:180
msgid "the label (.etiketto)"
msgstr "етикетка (.etiketto)"

#: etiketto/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "модель принтера, за замовчуванням модель етикетки: %s"

#: etiketto/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "адреса принтера, за замовчуванням задана в застосунку"

#: etiketto/cli.py:189
msgid "number of copies"
msgstr "кількість копій"

#: etiketto/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "текст елемента NAME або значення змінної {=NAME}; змінні в тексті підставляються; можна повторювати"

#: etiketto/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "як --set, але значення використовується як є: фігурні дужки не є змінними"

#: etiketto/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "лічильник першої етикетки замість збереженого в етикетці"

#: etiketto/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "друкувати з типовими значеннями моделі принтера замість обрізання, кольорів, якості, додатків (ланцюговий друк, висока роздільна здатність, подача стрічки), налаштувань принтера та контурів аркушів етикеток, востаннє вибраних у застосунку; адреса і безпечне поле лишаються"

#: etiketto/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "спосіб друку термопринтера, який має це налаштування: printer (як налаштовано на принтері), transfer (зі стрічкою) або direct (прямий термодрук, без стрічки); за замовчуванням вибраний у застосунку, також із --printer-defaults"

#: etiketto/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "не опитувати принтер перед рендерингом (модель, стрічка і роздільна здатність)"

#: etiketto/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "не зберігати наступне значення лічильника в етикетці (файл лише для читання); наступний друк почнеться з того самого номера"

#: etiketto/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "серійні етикетки: по етикетці на кожен рядок цього файлу CSV, ODS або XLSX; типово файл даних етикетки"

#: etiketto/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "аркуш файлу даних, типово перший"

#: etiketto/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "лише ці рядки файлу даних, наприклад 3-10, 5 або 7- (рахуючи від 1)"

#: etiketto/cli.py:267
msgid "check and render only, do not print"
msgstr "лише перевірити та відрендерити, не друкувати"

#: etiketto/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "з --dry-run: зберігає кожну етикетку у PNG так, як її експортує вікно, щонайбільше 600 dpi (- для stdout: лише першу)"

#: etiketto/cli.py:279
msgid "list the printers found on the network"
msgstr "виводить список принтерів, знайдених у мережі"

#: etiketto/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Виводить список принтерів, знайдених у мережі: модель, адреса, назва."

#: etiketto/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "лише ця модель принтера: %s"

#: etiketto/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "очікується адреса або мережа, наприклад 172.16.0.0/12: %s"

#: etiketto/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "тека з файлами етикеток, які може використовувати сервер"

#: etiketto/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "друкувати лише на цій адресі принтера (* відповідає будь-чому); можна повторювати"

#: etiketto/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: принтери, які клієнти можуть використовувати, за назвою"

#: etiketto/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "щонайбільше етикеток в одному завданні друку, копії, помножені на рядки (за замовчуванням 10000)"

#: etiketto/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "шукати принтери в мережі (типово вимкнено)"

#: etiketto/cli.py:336
msgid "run a print server with a REST API"
msgstr "запускає сервер друку з REST API"

#: etiketto/cli.py:337
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Запуск сервера друку: REST API і, з --mcp, MCP для клієнтів ШІ."

#: etiketto/cli.py:340
msgid "address to listen on (default 127.0.0.1)"
msgstr "адреса для прослуховування (за замовчуванням 127.0.0.1)"

#: etiketto/cli.py:346
#, python-format
msgid "port to listen on (default %d)"
msgstr "порт для прослуховування (за замовчуванням %d)"

#: etiketto/cli.py:352
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "файл із токеном доступу; інакше змінна середовища ETIKETTO_TOKEN"

#: etiketto/cli.py:358
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: іменовані токени доступу з ролями"

#: etiketto/cli.py:360
msgid "also serve MCP at /mcp"
msgstr "також надавати MCP за адресою /mcp"

#: etiketto/cli.py:366
msgid "largest request body in MB (default 4)"
msgstr "найбільший розмір тіла запиту в MB (за замовчуванням 4)"

#: etiketto/cli.py:375
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "зворотний проксі, заголовок X-Forwarded-For якого вказує клієнта, наприклад 172.16.0.0/12; можна повторювати"

#: etiketto/cli.py:384
msgid "allow requests from web pages of this origin; repeatable"
msgstr "дозволяти запити з вебсторінок цього джерела; можна повторювати"

#: etiketto/cli.py:389
msgid "serve MCP on standard input and output"
msgstr "надає MCP через стандартне введення й виведення"

#: etiketto/cli.py:391
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "Надає MCP через стандартне введення й виведення для клієнтів ШІ, наприклад Claude Desktop."

#: etiketto/cli.py:401
msgid "manage the access tokens of the print server"
msgstr "керує токенами доступу сервера друку"

#: etiketto/cli.py:402
msgid "Manage the access tokens of the print server."
msgstr "Керування токенами доступу сервера друку."

#: etiketto/cli.py:407
msgid "make a token and add its hash to tokens.toml"
msgstr "створює токен і додає його хеш до tokens.toml"

#: etiketto/cli.py:408
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Створення токена, додавання його хешу до tokens.toml і одноразовий показ токена."

#: etiketto/cli.py:410
msgid "name of the token, e.g. the device"
msgstr "назва токена, наприклад пристрій"

#: etiketto/cli.py:415
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: лише перегляд; print: також друк; admin: також усі завдання"

#: etiketto/cli.py:417
msgid "tokens.toml to add it to"
msgstr "tokens.toml, до якого його додати"

#: etiketto/cli.py:423
msgid "only this printer of printers.toml; repeatable"
msgstr "лише цей принтер із printers.toml; можна повторювати"

#: etiketto/cli.py:426
msgid "printers.toml, to check --printer"
msgstr "printers.toml для перевірки --printer"

#: etiketto/cli.py:428
msgid "valid until, e.g. 2027-12-31"
msgstr "дійсний до, наприклад 2027-12-31"

#: etiketto/cli.py:429
msgid "a note for people"
msgstr "примітка для людей"

#: etiketto/cli.py:431
msgid "store the hash with scrypt instead of SHA-256"
msgstr "зберігати хеш за допомогою scrypt замість SHA-256"

#: etiketto/cli.py:437
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "узяти обраний вами токен зі стандартного введення (зберігається за допомогою scrypt) замість створення нового"

#: etiketto/cli.py:457 etiketto/server/config.py:220
#: etiketto/server/service.py:527
#, python-format
msgid "Unknown printer model: %s"
msgstr "Невідома модель принтера: %s"

#: etiketto/cli.py:464 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:303 etiketto/ui/texts.py:640
#: etiketto/server/service.py:675
#, python-format
msgid "Cannot open %s"
msgstr "Не вдається відкрити %s"

#: etiketto/cli.py:486 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s не є датою, очікується, наприклад, 2026-12-31 або 2026-12-31T08:30"

#: etiketto/cli.py:523
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} підставляється під час друку і не може бути задано"

#: etiketto/cli.py:527
#, python-format
msgid "The label has no element or variable named %s"
msgstr "В етикетці немає елемента чи змінної з назвою %s"

#: etiketto/cli.py:551 etiketto/ui/printing.py:123
#: etiketto/server/service.py:963
msgid "The label is empty"
msgstr "Етикетка порожня"

#: etiketto/cli.py:588
msgid "Cannot write the output"
msgstr "Не вдається записати вивід"

#: etiketto/cli.py:619
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output записує зображення PNG: вкажіть назву із закінченням .png"

#: etiketto/cli.py:644 etiketto/cli.py:853 etiketto/ui/printing.py:553
#: etiketto/ui/printing.py:715 etiketto/server/service.py:891
#: etiketto/server/service.py:1118 etiketto/server/service.py:1263
msgid "The label cannot be prepared for printing."
msgstr "Не вдається підготувати етикетку до друку."

#: etiketto/cli.py:731
msgid "No printer found – give its address with --host"
msgstr "Принтер не знайдено – вкажіть його адресу через --host"

#: etiketto/cli.py:733
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Знайдено кілька принтерів – виберіть один через --host (etiketto list-printers)"

#: etiketto/cli.py:744 etiketto/ui/texts.py:683 etiketto/server/service.py:1253
#, python-format
msgid "Cannot save %s"
msgstr "Не вдається зберегти %s"

#: etiketto/cli.py:746 etiketto/server/service.py:1256
msgid "the labels were printed, but the next counter value was not saved"
msgstr "етикетки надруковано, але наступне значення лічильника не збережено"

#: etiketto/cli.py:761 etiketto/server/service.py:992
msgid "nothing was printed: the next counter value could not be saved"
msgstr "нічого не надруковано: наступне значення лічильника не вдалося б зберегти"

#: etiketto/cli.py:821 etiketto/cli.py:848 etiketto/cli.py:1209
msgid "Interrupted"
msgstr "Перервано"

#: etiketto/cli.py:921
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: ця модель принтера не має налаштування способу друку: %s"

#: etiketto/cli.py:963
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet і --rows потребують файлу даних (--data)"

#: etiketto/cli.py:972 etiketto/ui/printing.py:585
#: etiketto/server/service.py:764
msgid "No rows to print"
msgstr "Немає рядків для друку"

#: etiketto/cli.py:982
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Етикетка використовує файл даних поза своєю текою: вкажіть його через --data"

#: etiketto/cli.py:1009 etiketto/ui/window.py:844
#: etiketto/server/service.py:817
#, python-format
msgid "No such column: %s"
msgstr "Немає такого стовпця: %s"

#: etiketto/cli.py:1014 etiketto/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Штрихкод або QR-код цих рядків неможливо створити з їхніх значень, наприклад EAN-13 з літерами або порожня клітинка. Виправте файл даних і прочитайте його знову або друкуйте без цих рядків."

#: etiketto/cli.py:1019 etiketto/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Рядки: %s"

#: etiketto/cli.py:1027
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Очікування завершення іншого друку %s…"

#: etiketto/cli.py:1034 etiketto/server/service.py:1112
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s усе ще заблоковано іншим друком – спробуйте пізніше"

#: etiketto/cli.py:1040
msgid "--output needs --dry-run"
msgstr "--output потребує --dry-run"

#: etiketto/cli.py:1057
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Наступне значення лічильника не зберігається: наступний друк повторить номери"

#: etiketto/cli.py:1152
msgid "Waiting for the printer's answer…"
msgstr "Очікування відповіді принтера…"

#: etiketto/cli.py:1180 etiketto/ui/printer.py:199
msgid "No printer found"
msgstr "Принтер не знайдено"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Таблиці (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "Вибір файлу даних"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:109 etiketto/ui/files.py:131
#: etiketto/ui/files.py:212 etiketto/ui/texts.py:205
msgid "Only local files can be used"
msgstr "Можна використовувати лише локальні файли"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto знову запитає, перш ніж читати файли даних поза текою етикетки"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "Прочитати файл даних?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Ця етикетка використовує файл даних поза своєю текою:\n\n%s\n\nЧитайте його, лише якщо знаєте, звідки ця етикетка."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "Не зараз"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "Прочитати файл даних"

#: etiketto/ui/data.py:265
msgid "Reading…"
msgstr "Читання…"

#: etiketto/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Не прочитано: поза текою етикетки"

#: etiketto/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Рядків: %(rows)d · Стовпців: %(columns)d"

#: etiketto/ui/data.py:281 etiketto/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Серійні етикетки"

#: etiketto/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "По одній етикетці на кожен рядок таблиці. Вставляйте стовпці в тексти й коди; кожна етикетка показує значення свого рядка."

#: etiketto/ui/data.py:290
msgid "No data file"
msgstr "Немає файлу даних"

#: etiketto/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS або XLSX"

#: etiketto/ui/data.py:291 etiketto/ui/elements.py:316
#: etiketto/ui/elements.py:334 etiketto/ui/elements.py:347
msgid "Choose…"
msgstr "Вибрати…"

#: etiketto/ui/data.py:304
msgid "Columns"
msgstr "Стовпці"

#: etiketto/ui/data.py:320
msgid "Read again"
msgstr "Прочитати знову"

#: etiketto/ui/data.py:324
msgid "Choose another file"
msgstr "Вибрати інший файл"

#: etiketto/ui/data.py:326
msgid "Remove data file"
msgstr "Вилучити файл даних"

#: etiketto/ui/data.py:337
msgid "Sheet"
msgstr "Аркуш"

#: etiketto/ui/data.py:357
msgid "Insert column"
msgstr "Вставити стовпець"

#: etiketto/ui/elements.py:83 etiketto/ui/shortcuts.py:57
msgid "Content"
msgstr "Вміст"

#: etiketto/ui/elements.py:93
msgid "No content yet"
msgstr "Ще немає вмісту"

#: etiketto/ui/elements.py:93
