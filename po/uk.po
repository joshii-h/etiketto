msgstr "Окрема етикетка"

#: etiketto/ui/texts.py:75
msgid "Label sheet"
msgstr "Аркуш етикеток"

#: etiketto/ui/texts.py:78
msgid "Resolution"
msgstr "Роздільна здатність"

#: etiketto/ui/texts.py:79
msgid "Label sensor"
msgstr "Датчик етикеток"

#: etiketto/ui/texts.py:80
