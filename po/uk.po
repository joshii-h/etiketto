#: etiketto/app.py:136 etiketto/cli.py:149
msgid "Design and print labels"
msgstr "Дизайн і друк етикеток"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:104
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "очікується NAME=VALUE: %s"

#: etiketto/cli.py:120
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "очікується ціле число від %(min)d до %(max)d: %(value)s"

#: etiketto/cli.py:138 etiketto/cli.py:142
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "очікуються рядки на кшталт 3-10, 5 або 7-: %s"

#: etiketto/cli.py:150
msgid "Without a command the application starts; label files given open in it."
msgstr "Без команди запускається застосунок; вказані файли етикеток відкриваються в ньому."

#: etiketto/cli.py:156
msgid "print a label file without opening a window"
msgstr "друкує файл етикетки без відкриття вікна"

#: etiketto/cli.py:157
msgid "Print a label file without opening a window."
msgstr "Друкує файл етикетки без відкриття вікна."

#: etiketto/cli.py:159
msgid "the label (.etiketto)"
msgstr "етикетка (.etiketto)"

#: etiketto/cli.py:162
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "модель принтера, за замовчуванням модель етикетки: %s"

#: etiketto/cli.py:165
msgid "printer address, by default the one set in the app"
msgstr "адреса принтера, за замовчуванням задана в застосунку"

#: etiketto/cli.py:168
msgid "number of copies"
msgstr "кількість копій"

#: etiketto/cli.py:178
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "текст елемента NAME або значення змінної {=NAME}; змінні в тексті підставляються; можна повторювати"

#: etiketto/cli.py:188
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "як --set, але значення використовується як є: фігурні дужки не є змінними"

#: etiketto/cli.py:194
msgid "counter of the first label, instead of the one saved in the label"
msgstr "лічильник першої етикетки замість збереженого в етикетці"

#: etiketto/cli.py:200
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "не зберігати наступне значення лічильника в етикетці (файл лише для читання); наступний друк почнеться з того самого номера"

#: etiketto/cli.py:209
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "серійні етикетки: по етикетці на кожен рядок цього файлу CSV, ODS або XLSX; типово файл даних етикетки"

#: etiketto/cli.py:214
msgid "the sheet of the data file, by default the first"
msgstr "аркуш файлу даних, типово перший"

#: etiketto/cli.py:220
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "лише ці рядки файлу даних, наприклад 3-10, 5 або 7- (рахуючи від 1)"

#: etiketto/cli.py:223
msgid "check and render only, do not print"
msgstr "лише перевірити та відрендерити, не друкувати"

#: etiketto/cli.py:229
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "з --dry-run: зберігає зображення у PNG в такому вигляді, в якому їх отримав би принтер (- для stdout: лише перше)"

#: etiketto/cli.py:235
msgid "list the printers found on the network"
msgstr "виводить список принтерів, знайдених у мережі"

#: etiketto/cli.py:236
msgid "List the printers found on the network: model, address, name."
msgstr "Виводить список принтерів, знайдених у мережі: модель, адреса, назва."

#: etiketto/cli.py:238
#, python-format
msgid "only this printer model: %s"
msgstr "лише ця модель принтера: %s"

#: etiketto/cli.py:257
#, python-format
msgid "Unknown printer model: %s"
msgstr "Невідома модель принтера: %s"

#: etiketto/cli.py:264 etiketto/ui/files.py:66 etiketto/ui/texts.py:237
#, python-format
msgid "Cannot open %s"
msgstr "Не вдається відкрити %s"

#: etiketto/cli.py:286
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s не є датою, очікується, наприклад, 2026-12-31 або 2026-12-31T08:30"

#: etiketto/cli.py:313
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} підставляється під час друку і не може бути задано"

#: etiketto/cli.py:318
#, python-format
msgid "The label has no element or variable named %s"
msgstr "В етикетці немає елемента чи змінної з назвою %s"

#: etiketto/cli.py:342 etiketto/ui/printing.py:84
msgid "The label is empty"
msgstr "Етикетка порожня"

#: etiketto/cli.py:375
msgid "Cannot write the output"
msgstr "Не вдається записати вивід"

#: etiketto/cli.py:406
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output записує зображення PNG: вкажіть назву із закінченням .png"

#: etiketto/cli.py:442 etiketto/cli.py:473 etiketto/cli.py:592
#: etiketto/cli.py:619 etiketto/ui/printing.py:329 etiketto/ui/printing.py:467
msgid "The label cannot be prepared for printing."
msgstr "Не вдається підготувати етикетку до друку."

#: etiketto/cli.py:500
msgid "No printer found – give its address with --host"
msgstr "Принтер не знайдено – вкажіть його адресу через --host"

#: etiketto/cli.py:502
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Знайдено кілька принтерів – виберіть один через --host (etiketto list-printers)"

#: etiketto/cli.py:513 etiketto/ui/texts.py:255
#, python-format
msgid "Cannot save %s"
msgstr "Не вдається зберегти %s"

#: etiketto/cli.py:515
msgid "the labels were printed, but the next counter value was not saved"
msgstr "етикетки надруковано, але наступне значення лічильника не збережено"

#: etiketto/cli.py:530
msgid "nothing was printed: the next counter value could not be saved"
msgstr "нічого не надруковано: наступне значення лічильника не вдалося б зберегти"

#: etiketto/cli.py:590 etiketto/cli.py:616 etiketto/cli.py:817
msgid "Interrupted"
msgstr "Перервано"

#: etiketto/cli.py:623 etiketto/ui/printing.py:470
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Друк зупинився на рядку %(row)d. Щоб продовжити, запустіть друк знову з рядка %(row)d."

#: etiketto/cli.py:694
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Етикетка використовує файл даних поза своєю текою: вкажіть його через --data"

#: etiketto/cli.py:700
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet і --rows потребують файлу даних (--data)"

#: etiketto/cli.py:709
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "У %(file)s немає аркуша з назвою %(sheet)s"

#: etiketto/cli.py:717 etiketto/ui/printing.py:345
msgid "No rows to print"
msgstr "Немає рядків для друку"

#: etiketto/cli.py:726 etiketto/ui/window.py:389
#, python-format
msgid "No such column: %s"
msgstr "Немає такого стовпця: %s"

#: etiketto/cli.py:731 etiketto/ui/printing.py:418
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Штрихкод або QR-код цих рядків неможливо створити з їхніх значень, наприклад EAN-13 з літерами або порожня клітинка. Виправте файл даних і прочитайте його знову або друкуйте без цих рядків."

#: etiketto/cli.py:736 etiketto/ui/printing.py:423
#, python-format
msgid "Rows: %s"
msgstr "Рядки: %s"

#: etiketto/cli.py:744
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Очікування завершення іншого друку %s…"

#: etiketto/cli.py:751
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s усе ще заблоковано іншим друком – спробуйте пізніше"

#: etiketto/cli.py:757
msgid "--output needs --dry-run"
msgstr "--output потребує --dry-run"

#: etiketto/cli.py:766
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Наступне значення лічильника не зберігається: наступний друк повторить номери"

#: etiketto/cli.py:793 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Принтер не знайдено"

#: etiketto/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Таблиці (CSV, ODS, XLSX)"

#: etiketto/ui/data.py:98
msgid "Choose data file"
msgstr "Вибір файлу даних"

#: etiketto/ui/data.py:108 etiketto/ui/files.py:86 etiketto/ui/files.py:120
#: etiketto/ui/texts.py:45
msgid "Only local files can be used"
msgstr "Можна використовувати лише локальні файли"

#: etiketto/ui/data.py:167
msgid "Etiketto asks again before reading data files outside a label's folder"
msgstr "Etiketto знову запитає, перш ніж читати файли даних поза текою етикетки"

#: etiketto/ui/data.py:179
msgid "Read the data file?"
msgstr "Прочитати файл даних?"

#: etiketto/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Ця етикетка використовує файл даних поза своєю текою:\n\n%s\n\nЧитайте його, лише якщо знаєте, звідки ця етикетка."

#: etiketto/ui/data.py:186
msgid "Not now"
msgstr "Не зараз"

#: etiketto/ui/data.py:187
msgid "Read data file"
msgstr "Прочитати файл даних"

#: etiketto/ui/data.py:250
msgid "Reading…"
msgstr "Читання…"

#: etiketto/ui/data.py:252
msgid "Not read: outside the label's folder"
msgstr "Не прочитано: поза текою етикетки"

#: etiketto/ui/data.py:255
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Рядків: %(rows)d · Стовпців: %(columns)d"

#: etiketto/ui/data.py:266
msgid "Serial labels"
msgstr "Серійні етикетки"

#: etiketto/ui/data.py:268
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
