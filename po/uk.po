msgstr "11 цифр, контрольна цифра додається (або 12 разом із нею)"

#: etiketto/ui/texts.py:151
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "7 цифр, що починаються з 0 або 1, контрольна цифра додається (або 8 разом із нею)"

#: etiketto/ui/texts.py:152
