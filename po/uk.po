#: etiketto/ui/texts.py:179
msgid "At the end"
msgstr "У кінці"

#: etiketto/ui/texts.py:180
msgid "At both ends"
msgstr "На обох кінцях"

#: etiketto/ui/texts.py:183
msgctxt "fill"
msgid "None"
msgstr "Немає"

#: etiketto/ui/texts.py:184
msgctxt "fill"
msgid "Solid"
msgstr "Суцільна"

#: etiketto/ui/texts.py:185
msgid "Hatched"
msgstr "Штрихування"

#: etiketto/ui/texts.py:187
msgid "Grid"
msgstr "Сітка"

#: etiketto/ui/texts.py:202
#, python-format
msgid "Not an image: %s"
msgstr "Не зображення: %s"

#. translators: the print density a NIIMBOT model uses by default
#: etiketto/ui/texts.py:220
msgctxt "print density"
msgid "Default"
msgstr "Типова"

#: etiketto/ui/texts.py:224
#, python-format
msgid "%d %%"
msgstr "%d %%"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:227
#, python-format
msgid "%d in/s"
msgstr "%d дюйм/с"

#: etiketto/ui/texts.py:236
msgid "Image"
msgstr "Зображення"

#: etiketto/ui/texts.py:271
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Безперервна, ширина %(width)s"

#: etiketto/ui/texts.py:281
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Перевірте, що вся етикетка всередині виділення. Перетягніть, щоб посунути його або його краї, або намалюйте нове."

#: etiketto/ui/texts.py:285
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Етикеткою можуть бути кілька областей. Перевірте виділення або спробуйте наступну."

#: etiketto/ui/texts.py:287
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Виділено все надруковане на сторінці. Перетягніть, щоб вибрати етикетку."

#: etiketto/ui/texts.py:288
msgid "Nothing is printed on this page."
msgstr "На цій сторінці нічого не надруковано."

#: etiketto/ui/texts.py:293
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Для файлів PDF потрібен Poppler (poppler-glib), який не встановлено"

#: etiketto/ui/texts.py:304
msgid "System printer (CUPS, IPP)"
msgstr "Системний принтер (CUPS, IPP)"

#: etiketto/ui/texts.py:305
msgid "Receipt printer (ESC/POS)"
msgstr "Чековий принтер (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:307
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, безперервні рулони"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:309
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, висічні етикетки"

#: etiketto/ui/texts.py:316
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Елемент %(n)d: код порожній"

#: etiketto/ui/texts.py:317
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Елемент %(n)d: для EAN-13 потрібно рівно 12 цифр"

#: etiketto/ui/texts.py:318
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Елемент %(n)d: неправильна контрольна цифра EAN-13"

#: etiketto/ui/texts.py:320
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Елемент %(n)d: Code 128 приймає лише латинські літери, цифри та розділові знаки"

#: etiketto/ui/texts.py:322
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Елемент %(n)d: для EAN-8 потрібно 7 цифр або 8 з контрольною цифрою"

#: etiketto/ui/texts.py:323
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Елемент %(n)d: для UPC-A потрібно 11 цифр або 12 з контрольною цифрою"

#: etiketto/ui/texts.py:325
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Елемент %(n)d: для UPC-E потрібно 7 цифр, що починаються з 0 або 1, або 8 з контрольною цифрою"

#: etiketto/ui/texts.py:327
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Елемент %(n)d: для ITF-14 потрібно 13 цифр або 14 з контрольною цифрою"

#: etiketto/ui/texts.py:328
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Елемент %(n)d: неправильна контрольна цифра"

#: etiketto/ui/texts.py:330
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Елемент %(n)d: Code 39 приймає лише великі літери, цифри, пробіли та - . $ / + %%"

#: etiketto/ui/texts.py:333
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Елемент %(n)d: Code 93 приймає лише латинські літери, цифри та розділові знаки"

#: etiketto/ui/texts.py:336
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Елемент %(n)d: дані GS1 приймають лише латинські літери, цифри та розділові знаки"

#: etiketto/ui/texts.py:339
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Елемент %(n)d: дані GS1 мають складатися з ідентифікаторів застосування в дужках, за кожним з яких іде його значення, наприклад (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:342
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Елемент %(n)d: (%(ai)s) не є ідентифікатором застосування GS1"

#: etiketto/ui/texts.py:344
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Елемент %(n)d: значення ідентифікатора застосування (%(ai)s) має неправильну довжину"

#: etiketto/ui/texts.py:347
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Елемент %(n)d: неправильна контрольна цифра ідентифікатора застосування (%(ai)s)"

#: etiketto/ui/texts.py:350
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Елемент %(n)d: неприпустиме значення ідентифікатора застосування (%(ai)s): дата, число або символ, яких він не дозволяє"

#: etiketto/ui/texts.py:354
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Елемент %(n)d: жоден номер UPC-A не скорочується до цих цифр UPC-E – перевірте їх або використайте UPC-A"

#: etiketto/ui/texts.py:358
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Елемент %(n)d: сканери в режимі Full ASCII читають $, /, + або %% перед великою літерою як інший символ"

#: etiketto/ui/texts.py:361
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Елемент %(n)d: вміст задовгий для цього типу коду"

#: etiketto/ui/texts.py:362
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Елемент %(n)d: вміст неможливо закодувати в цьому типі коду"

#: etiketto/ui/texts.py:364
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Елемент %(n)d: для цього типу коду потрібна бібліотека Zint (zint-bindings), яку не встановлено"

#: etiketto/ui/texts.py:367
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Елемент %(n)d: не вдається прочитати зображення"

#: etiketto/ui/texts.py:368
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Елемент %(n)d: цього символу немає в бібліотеці символів"

#: etiketto/ui/texts.py:369
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Елемент %(n)d: не вдається прочитати документ"

#: etiketto/ui/texts.py:371
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Елемент %(n)d: для файлів PDF потрібен Poppler (poppler-glib), який не встановлено"

#: etiketto/ui/texts.py:373
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Не вдається намалювати елемент %(n)d"

#: etiketto/ui/texts.py:375
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Безпечне поле, рамка, її відступ усередину й відступ від країв не залишають місця – зменште їх"

#: etiketto/ui/texts.py:377
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Фіксована довжина менша за відступи – збільште її"

#: etiketto/ui/texts.py:378
msgid "The background image cannot be read"
msgstr "Не вдається прочитати зображення тла"

#: etiketto/ui/texts.py:380
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Елемент %(n)d: модулі коду завширшки лише одну точку друку й можуть не зчитатися – збільште код"

#: etiketto/ui/texts.py:384
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Елемент %(n)d: вільне поле, потрібне коду навколо, не вміщується – збільште код"

#: etiketto/ui/texts.py:388
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Елемент %(n)d: код не вміщується у своє місце навіть з однією точкою друку на модуль – збільште етикетку або скоротіть вміст"

#: etiketto/ui/texts.py:391
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Елемент %(n)d: %(name)s не є відомою змінною"

#: etiketto/ui/texts.py:393
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Елемент %(n)d: дата %(name)s раніша за 1 рік або пізніша за 9999"

#: etiketto/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Елемент %(n)d: змінна %(name)s… не закрита – завершіть її символом }"

#: etiketto/ui/texts.py:399
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Елемент %(n)d: на чорно-білому принтері він майже не вирізняється на тлі того, що за ним, повністю або частково – виберіть інший колір або пересуньте його"

#: etiketto/ui/texts.py:402
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Елемент %(n)d: фігура не має ні лінії, ні заливки"

#: etiketto/ui/texts.py:404
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Елемент %(n)d: внутрішній відступ, рамка, контур або тінь не залишають місця для тексту – зменште їх"

#: etiketto/ui/texts.py:419
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Уже надруковано аркушів: %(n)d з %(total)d."

#: etiketto/ui/texts.py:421
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Уже надруковано етикеток: %(n)d з %(total)d."

#: etiketto/ui/texts.py:425
msgid "The sheets still waiting in the queue were canceled."
msgstr "Аркуші, що ще чекали в черзі, скасовано."

#: etiketto/ui/texts.py:427
msgid "The labels still waiting in the queue were canceled."
msgstr "Етикетки, що ще чекали в черзі, скасовано."

#: etiketto/ui/texts.py:436
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Принтер не знайдено. Переконайтеся, що його увімкнено й він у тій самій мережі, або введіть його IP-адресу."

#: etiketto/ui/texts.py:440
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Принтер не знайдено через USB. Перевірте кабель і переконайтеся, що принтер увімкнено і він не в режимі сну, потім повторіть пошук."

#: etiketto/ui/texts.py:443
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Принтер не відповідає. Переконайтеся, що його увімкнено і він не в режимі сну."

#: etiketto/ui/texts.py:445
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Принтер перестав приймати дані. Перевірте, чи не повідомляє він про проблему, наприклад закінчені етикетки або відкриту кришку, і спробуйте ще раз."

#: etiketto/ui/texts.py:449
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Принтер відхиляє з’єднання. Вимкніть і знову ввімкніть його. Якщо в його вебінтерфейсі є параметр «Port 9100», увімкніть його."

#: etiketto/ui/texts.py:452
msgid "No cassette is inserted. Insert one and try again."
msgstr "Касету не вставлено. Вставте касету й повторіть спробу."

#: etiketto/ui/texts.py:453
msgid "The printer's cover is open. Close it and try again."
msgstr "Кришку принтера відкрито. Закрийте її й повторіть спробу."

#: etiketto/ui/texts.py:454
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Етикетка застрягла. Відкрийте кришку, вийміть її й повторіть спробу."

#: etiketto/ui/texts.py:455
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Касету не розпізнано. Вставте її ще раз або спробуйте іншу."

#: etiketto/ui/texts.py:456
msgid "The printer is busy. Wait a moment and try again."
msgstr "Принтер зайнятий. Зачекайте трохи й повторіть спробу."

#: etiketto/ui/texts.py:457
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Етикетка задовга для цього принтера: щонайбільше %(max)s."

#: etiketto/ui/texts.py:458
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Етикетка надто широка для цього принтера: максимум %(max)s."

#: etiketto/ui/texts.py:459
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "У принтері закінчилися етикетки. Завантажте новий рулон і повторіть спробу."

#: etiketto/ui/texts.py:460
msgid "The print head is open. Close it and try again."
msgstr "Друкувальна головка відкрита. Закрийте її та повторіть спробу."

#: etiketto/ui/texts.py:462
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Принтер не знаходить наступну етикетку. Перевірте, чи правильно завантажено етикетки та чи проходять вони через датчик етикеток."

#: etiketto/ui/texts.py:466
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Проблема зі стрічкою. Перевірте, чи її правильно вставлено та чи вона відповідає способу друку, заданому в принтері."

#: etiketto/ui/texts.py:469
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Принтер призупинено. Відновіть роботу на його дисплеї та повторіть спробу."

#: etiketto/ui/texts.py:470
msgid "The printer is out of paper. Load paper and try again."
msgstr "У принтері закінчився папір. Завантажте папір і повторіть спробу."

#: etiketto/ui/texts.py:472
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Папір застряг. Вийміть його, як показано на дисплеї принтера, та повторіть спробу."

#: etiketto/ui/texts.py:474
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "У принтері закінчився тонер або чорнило. Замініть його та повторіть спробу."

#: etiketto/ui/texts.py:475
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Принтер не може надрукувати цей розмір. Виберіть розмір паперу, який він підтримує."

#: etiketto/ui/texts.py:477
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Принтер не приймає жодного з форматів, які може надіслати Etiketto (PDF, PWG Raster, JPEG)."

#: etiketto/ui/texts.py:480
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Чергу принтера призупинено. Відновіть її в налаштуваннях принтера системи та повторіть спробу."

#: etiketto/ui/texts.py:484
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Завдання друку було затримано в черзі, наприклад до його звільнення або введення пароля. Перевірте чергу в налаштуваннях принтера системи та повторіть спробу."

#: etiketto/ui/texts.py:488
msgid "The print job was canceled at the printer or in the queue."
msgstr "Завдання друку скасовано на принтері або в черзі."

#: etiketto/ui/texts.py:489
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Принтер не повідомив свою роздільну здатність вчасно. Виберіть її в розділі «%s»."

#: etiketto/ui/texts.py:492
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Завантажений рулон не підходить до етикетки. Завантажте відповідний рулон або виберіть розмір етикетки чи модель принтера для завантаженого рулону."

#: etiketto/ui/texts.py:495
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Батарея принтера розряджена – зарядіть її або під’єднайте блок живлення."

#: etiketto/ui/texts.py:496
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Друкувальна головка надто гаряча. Зачекайте, доки вона охолоне, потім повторіть спробу."

#: etiketto/ui/texts.py:498
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto не може друкувати на цій моделі принтера: вона не приймає растрові зображення, які надсилає Etiketto."

#: etiketto/ui/texts.py:502
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto не знає цієї моделі принтера й поки не може на ній друкувати."

#: etiketto/ui/texts.py:505
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Принтер у режимі Editor Lite і видимий як USB-накопичувач. Вимкніть Editor Lite на принтері (його індикатор згасне), потім повторіть пошук."

#: etiketto/ui/texts.py:509
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto не має доступу до USB-порту принтера. Додайте свого користувача до групи «lp» (sudo usermod -aG lp $USER), потім вийдіть із системи та увійдіть знову."

#: etiketto/ui/texts.py:513
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Сторінка завелика, щоб створити її в роздільній здатності, яку приймає принтер. Виберіть менший формат паперу або друкуйте на принтері, що приймає PDF."

#: etiketto/ui/texts.py:517
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "За роздільності цього принтера код не вміщується на етикетці й буде обрізаний. Збільште етикетку або скоротіть вміст коду."

#: etiketto/ui/texts.py:521
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto не має доступу до послідовного порту принтера. Додайте свого користувача до групи «dialout» (sudo usermod -aG dialout $USER; в Arch Linux група називається «uucp»), потім вийдіть із системи та увійдіть знову."

#: etiketto/ui/texts.py:526
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Принтер повідомив про проблему. Вимкніть і знову ввімкніть його, а потім спробуйте ще раз."

#: etiketto/ui/texts.py:537
msgid "Printed"
msgstr "Надруковано"

#: etiketto/ui/texts.py:543
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Надіслано на принтер – буде надруковано, коли надійде черга"

#: etiketto/ui/texts.py:545
msgid "Sent to the printer – it did not confirm printing"
msgstr "Надіслано на принтер – він не підтвердив друк"

#: etiketto/ui/texts.py:549
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Надруковано в режимі «%(used)s», бо цього потребує завантажений рулон"

#: etiketto/ui/texts.py:553
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "Колірний режим «%(wanted)s» недоступний на цьому принтері, надруковано в режимі «%(used)s»"

#: etiketto/ui/texts.py:563
msgid "Warming up…"
msgstr "Прогрівання…"

#: etiketto/ui/texts.py:564
msgid "Cooling down…"
msgstr "Охолодження…"

#: etiketto/ui/texts.py:565
msgid "Cleaning…"
msgstr "Очищення…"

#: etiketto/ui/texts.py:566
msgid "Swipe the printer's panel to cut the label"
msgstr "Проведіть по панелі принтера, щоб відрізати етикетку"

#: etiketto/ui/texts.py:568
msgid "Out of paper – load paper to continue"
msgstr "Немає паперу – завантажте папір, щоб продовжити"

#: etiketto/ui/texts.py:569
msgid "Cover open – close it to continue"
msgstr "Кришку відкрито – закрийте її, щоб продовжити"

#: etiketto/ui/texts.py:570
msgid "Paper jammed – remove it to continue"
msgstr "Папір застряг – вийміть його, щоб продовжити"

#: etiketto/ui/texts.py:581
msgid "This label needs a newer version of Etiketto"
msgstr "Для цієї етикетки потрібна новіша версія Etiketto"

#: etiketto/ui/texts.py:583
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s не є етикеткою Etiketto"

#: etiketto/ui/texts.py:584 etiketto/ui/texts.py:604
#, python-format
msgid "The file is damaged: %s"
msgstr "Файл пошкоджено: %s"

#: etiketto/ui/texts.py:591
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "Файлу даних %s більше немає. Виберіть його знову або вилучіть."

#: etiketto/ui/texts.py:595
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "У %(file)s немає аркуша з назвою %(sheet)s"

#: etiketto/ui/texts.py:597
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s не є таблицею. Використайте файл CSV, ODS або XLSX."

#: etiketto/ui/texts.py:599
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s завеликий для серійних етикеток. Розділіть його на менші файли або вилучіть непотрібні рядки й стовпці."

#: etiketto/ui/texts.py:602
#, python-format
msgid "%s contains no data."
msgstr "%s не містить даних."

#: etiketto/ui/texts.py:613
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Друк зупинився на рядку %(row)d. Щоб продовжити, запустіть друк знову з рядка %(row)d."

#: etiketto/ui/texts.py:617
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "Уже надруковано копій рядка %(row)d: %(copies)d."

#: etiketto/ui/texts.py:622
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "Рядок %(row)d потрапляє на позицію %(position)d аркуша %(sheet)d."

#: etiketto/ui/texts.py:633
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "Не вдається зберегти %s: немає дозволу на запис"

#: etiketto/ui/texts.py:635
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "Не вдається зберегти %s: диск заповнено"

#: etiketto/ui/texts.py:645
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Схоже, дата виготовлення касети: %(month)s %(year)d. Старий папір ZINK друкує блідіші кольори."

