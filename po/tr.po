msgstr "Yazıcının bildirdiği gibi"

#: etiketto/ui/texts.py:83
msgid "As set on the printer"
msgstr "Yazıcıda ayarlandığı gibi"

#: etiketto/ui/texts.py:84
msgid "Gap between labels"
msgstr "Etiketler arası boşluk"

#: etiketto/ui/texts.py:85
msgid "Black mark"
msgstr "Siyah işaret"

#: etiketto/ui/texts.py:86
msgid "Continuous media"
msgstr "Sürekli malzeme"

#: etiketto/ui/texts.py:87
msgid "Transparent labels"
msgstr "Şeffaf etiketler"

#: etiketto/ui/texts.py:88
msgid "Tear off"
msgstr "Yırtma"

#: etiketto/ui/texts.py:89
msgid "Peel off"
msgstr "Soyma"

#: etiketto/ui/texts.py:90
msgid "Cut off"
msgstr "Kesme"

#: etiketto/ui/texts.py:91
msgid "Thermal transfer (ribbon)"
msgstr "Termal transfer (ribon)"

#: etiketto/ui/texts.py:92
msgid "Thermal direct"
msgstr "Doğrudan termal"

#: etiketto/ui/texts.py:102
msgid "Left"
msgstr "Sol"

#: etiketto/ui/texts.py:102
msgid "Right"
msgstr "Sağ"

#: etiketto/ui/texts.py:107
msgid "2D codes"
msgstr "2D kodlar"

#: etiketto/ui/texts.py:109
msgid "QR code"
msgstr "QR kodu"

#: etiketto/ui/texts.py:116
msgid "Linear barcodes"
msgstr "Doğrusal barkodlar"

#: etiketto/ui/texts.py:131
msgid ""
"Application identifiers in brackets, e.g. "
"(01)09501101530003(17)261231(10)AB12"
msgstr "Parantez içinde uygulama tanımlayıcıları, ör. (01)09501101530003(17)261231(10)AB12"

#: etiketto/ui/texts.py:134
msgid "Links, text, Wi-Fi access; phones read it"
msgstr "Bağlantılar, metin, Wi-Fi erişimi; telefonlar okur"

#: etiketto/ui/texts.py:135
msgid "Text or numbers in little space, e.g. on small parts"
msgstr "Az yerde metin veya sayılar, ör. küçük parçalarda"

#: etiketto/ui/texts.py:136
msgid "Much text, e.g. an address or a document number"
msgstr "Çok metin, ör. bir adres veya belge numarası"

#: etiketto/ui/texts.py:137
msgid "Text or numbers; needs no blank margin, e.g. on tickets"
msgstr "Metin veya sayılar; boş kenar gerektirmez, ör. biletlerde"

#: etiketto/ui/texts.py:138
msgid "Latin letters, digits and punctuation"
msgstr "Latin harfleri, rakamlar ve noktalama işaretleri"

#: etiketto/ui/texts.py:139
msgid "Capital letters, digits, spaces and - . $ / + %"
msgstr "Büyük harfler, rakamlar, boşluklar ve - . $ / + %"

#: etiketto/ui/texts.py:140
msgid "Latin letters, digits and punctuation; shorter than Code 39"
msgstr "Latin harfleri, rakamlar ve noktalama işaretleri; Code 39'dan kısa"

#: etiketto/ui/texts.py:141
msgid "12 digits, the check digit is added (or 13 with it)"
msgstr "12 rakam, denetim basamağı eklenir (veya onunla birlikte 13)"

#: etiketto/ui/texts.py:142
msgid "7 digits, the check digit is added (or 8 with it)"
msgstr "7 rakam, denetim basamağı eklenir (veya onunla birlikte 8)"

#: etiketto/ui/texts.py:143
msgid "11 digits, the check digit is added (or 12 with it)"
msgstr "11 rakam, denetim basamağı eklenir (veya onunla birlikte 12)"

#: etiketto/ui/texts.py:144
msgid "7 digits starting with 0 or 1, the check digit is added (or 8 with it)"
msgstr "0 veya 1 ile başlayan 7 rakam, denetim basamağı eklenir (veya onunla birlikte 8)"

#: etiketto/ui/texts.py:145
msgid ""
"13 digits of a shipping carton's GTIN, the check digit is added (or 14 with "
"it)"
msgstr "Bir sevkiyat kolisinin GTIN'inin 13 rakamı, denetim basamağı eklenir (veya onunla birlikte 14)"

#: etiketto/ui/texts.py:151
msgid "Whole area, centred"
msgstr "Tüm alan, ortalanmış"

#: etiketto/ui/texts.py:151
msgid "Fill the label, edges cut off"
msgstr "Etiketi doldur, kenarlar kesilir"

#: etiketto/ui/texts.py:165
#, python-format
msgid "Not an image: %s"
msgstr "Görüntü değil: %s"

#. translators: the print density a NIIMBOT model uses by default
#: etiketto/ui/texts.py:183
msgctxt "print density"
msgid "Default"
msgstr "Varsayılan"

#: etiketto/ui/texts.py:187
#, python-format
msgid "%d %%"
msgstr "%%%d"

#. translators: print speed in inches per second, as label printers state it
#: etiketto/ui/texts.py:190
#, python-format
msgid "%d in/s"
msgstr "%d inç/sn"

#: etiketto/ui/texts.py:199
msgid "Image"
msgstr "Görüntü"

#: etiketto/ui/texts.py:226
#, python-format
msgid "Endless, %(width)s wide"
msgstr "Sürekli, %(width)s genişliğinde"

#: etiketto/ui/texts.py:236
msgid ""
"Check that all of the label is inside the selection. Drag to move it or its "
"edges, or draw a new one."
msgstr "Etiketin tamamının seçimin içinde olduğunu denetleyin. Seçimi veya kenarlarını taşımak için sürükleyin ya da yenisini çizin."

#: etiketto/ui/texts.py:240
msgid ""
"Several areas could be the label. Check the selection or try the next one."
msgstr "Birden çok alan etiket olabilir. Seçimi denetleyin veya sonrakini deneyin."

#: etiketto/ui/texts.py:242
msgid "Everything printed on the page is selected. Drag to choose the label."
msgstr "Sayfada basılı olan her şey seçili. Etiketi seçmek için sürükleyin."

#: etiketto/ui/texts.py:243
msgid "Nothing is printed on this page."
msgstr "Bu sayfada basılı hiçbir şey yok."

#: etiketto/ui/texts.py:248
msgid "PDF files need Poppler (poppler-glib), which is not installed"
msgstr "PDF dosyaları için Poppler (poppler-glib) gerekir, ancak kurulu değil"

#: etiketto/ui/texts.py:259
msgid "System printer (CUPS, IPP)"
msgstr "Sistem yazıcısı (CUPS, IPP)"

#: etiketto/ui/texts.py:260
msgid "Receipt printer (ESC/POS)"
msgstr "Fiş yazıcısı (ESC/POS)"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:262
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, sürekli rulolar"

#. translators: %s is a printer model, e.g. "Brother QL"
#: etiketto/ui/texts.py:264
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, kesimli etiketler"

#: etiketto/ui/texts.py:271
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Öge %(n)d: kod boş"

#: etiketto/ui/texts.py:272
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Öge %(n)d: EAN-13 tam olarak 12 rakam gerektirir"

#: etiketto/ui/texts.py:273
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Öge %(n)d: EAN-13 denetim basamağı yanlış"

#: etiketto/ui/texts.py:275
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: Code 128 yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: etiketto/ui/texts.py:277
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Öge %(n)d: EAN-8 7 rakam veya denetim basamağıyla 8 rakam gerektirir"

#: etiketto/ui/texts.py:278
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Öge %(n)d: UPC-A 11 rakam veya denetim basamağıyla 12 rakam gerektirir"

#: etiketto/ui/texts.py:280
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Öge %(n)d: UPC-E 0 veya 1 ile başlayan 7 rakam ya da denetim basamağıyla 8 rakam gerektirir"

#: etiketto/ui/texts.py:282
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Öge %(n)d: ITF-14 13 rakam veya denetim basamağıyla 14 rakam gerektirir"

#: etiketto/ui/texts.py:283
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Öge %(n)d: denetim basamağı yanlış"

#: etiketto/ui/texts.py:285
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Öge %(n)d: Code 39 yalnızca büyük harfler, rakamlar, boşluklar ve - . $ / + %% kabul eder"

#: etiketto/ui/texts.py:288
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: Code 93 yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: etiketto/ui/texts.py:291
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: GS1 verileri yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: etiketto/ui/texts.py:294
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Öge %(n)d: GS1 verileri, her birinin ardından değeri gelen, parantez içindeki uygulama tanımlayıcılarından oluşmalıdır, ör. (01)09501101530003(10)AB12"

#: etiketto/ui/texts.py:297
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Öge %(n)d: (%(ai)s) bir GS1 uygulama tanımlayıcısı değil"

#: etiketto/ui/texts.py:299
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) değerinin uzunluğu yanlış"

#: etiketto/ui/texts.py:302
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) denetim basamağı yanlış"

#: etiketto/ui/texts.py:305
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) değeri geçersiz: izin vermediği bir tarih, sayı veya karakter"

#: etiketto/ui/texts.py:309
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Öge %(n)d: hiçbir UPC-A numarası bu UPC-E rakamlarına kısalmıyor – rakamları denetleyin veya UPC-A kullanın"

#: etiketto/ui/texts.py:313
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Öge %(n)d: Full ASCII'ye ayarlı tarayıcılar büyük harften önceki $, /, + veya %% işaretini başka bir karakter olarak okur"

#: etiketto/ui/texts.py:316
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Öge %(n)d: içerik bu kod türü için çok uzun"

#: etiketto/ui/texts.py:317
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Öge %(n)d: içerik bu kod türünde kodlanamıyor"

#: etiketto/ui/texts.py:319
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Öge %(n)d: bu kod türü, yüklü olmayan Zint kitaplığını (zint-bindings) gerektirir"

#: etiketto/ui/texts.py:322
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Öge %(n)d: görüntü okunamıyor"

#: etiketto/ui/texts.py:323
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Öge %(n)d: bu sembol sembol kitaplığında yok"

#: etiketto/ui/texts.py:324
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Öge %(n)d: belge okunamıyor"

#: etiketto/ui/texts.py:326
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Öge %(n)d: PDF dosyaları için Poppler (poppler-glib) gerekir, ancak kurulu değil"

#: etiketto/ui/texts.py:328
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Öge %(n)d çizilemiyor"

#: etiketto/ui/texts.py:329
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Güvenlik payı, kenarlık ve kenar aralığı yer bırakmıyor – bunları azaltın"

#: etiketto/ui/texts.py:330
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Sabit uzunluk aralıktan kısa – uzunluğu artırın"

#: etiketto/ui/texts.py:331
msgid "The background image cannot be read"
msgstr "Arka plan görüntüsü okunamıyor"

#: etiketto/ui/texts.py:333
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Öge %(n)d: kodun modülleri yalnızca bir yazıcı noktası genişliğinde ve taranamayabilir – kodu büyütün"

#: etiketto/ui/texts.py:337
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Öge %(n)d: kodun çevresinde gereken boşluk sığmıyor – kodu büyütün"

#: etiketto/ui/texts.py:341
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Öge %(n)d: kod, modül başına bir yazıcı noktasıyla bile kendi alanına sığmıyor – etiketi büyütün veya içeriği kısaltın"

#: etiketto/ui/texts.py:344
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Öge %(n)d: %(name)s bilinen bir değişken değil"

#: etiketto/ui/texts.py:346
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Öge %(n)d: %(name)s tarihi 1. yıldan önce veya 9999'dan sonra"

#: etiketto/ui/texts.py:349
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Öge %(n)d: %(name)s… değişkeni kapatılmamış – } ile bitirin"

#: etiketto/ui/texts.py:363
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Zaten yazdırılan sayfalar: %(total)d sayfadan %(n)d."

#: etiketto/ui/texts.py:365
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Zaten yazdırılan etiketler: %(total)d etiketten %(n)d."

#: etiketto/ui/texts.py:369
msgid "The sheets still waiting in the queue were canceled."
msgstr "Kuyrukta hâlâ bekleyen sayfalar iptal edildi."

#: etiketto/ui/texts.py:371
msgid "The labels still waiting in the queue were canceled."
msgstr "Kuyrukta hâlâ bekleyen etiketler iptal edildi."

#: etiketto/ui/texts.py:380
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Yazıcı bulunamıyor. Açık ve aynı ağda olduğunu denetleyin ya da IP adresini girin."

#: etiketto/ui/texts.py:384
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Yazıcı USB üzerinden bulunamıyor. Kabloyu ve yazıcının açık ve uyanık olduğunu denetleyin, ardından yeniden arayın."

#: etiketto/ui/texts.py:387
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Yazıcı yanıt vermiyor. Açık ve uyanık olduğunu denetleyin."

#: etiketto/ui/texts.py:389
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Yazıcı veri almayı bıraktı. Etiketin bitmesi veya kapağın açık olması gibi bir sorun gösterip göstermediğini kontrol edin, ardından yeniden deneyin."

#: etiketto/ui/texts.py:393
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Yazıcı bağlantıyı reddediyor. Kapatıp yeniden açın. Web arayüzünde “Port 9100” seçeneği varsa etkinleştirin."

#: etiketto/ui/texts.py:396
msgid "No cassette is inserted. Insert one and try again."
msgstr "Kaset takılı değil. Bir kaset takıp yeniden deneyin."

#: etiketto/ui/texts.py:397
msgid "The printer's cover is open. Close it and try again."
msgstr "Yazıcının kapağı açık. Kapatıp yeniden deneyin."

#: etiketto/ui/texts.py:398
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etiket sıkıştı. Kapağı açın, etiketi çıkarın ve yeniden deneyin."

#: etiketto/ui/texts.py:399
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tanınmıyor. Yeniden takın ya da başka bir kaset deneyin."

#: etiketto/ui/texts.py:400
msgid "The printer is busy. Wait a moment and try again."
msgstr "Yazıcı meşgul. Biraz bekleyip yeniden deneyin."

#: etiketto/ui/texts.py:401
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etiket bu yazıcı için çok uzun: en fazla %(max)s."

#: etiketto/ui/texts.py:402
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etiket bu yazıcı için çok geniş: en fazla %(max)s."

#: etiketto/ui/texts.py:403
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Yazıcının etiketi bitti. Yeni bir rulo takın ve yeniden deneyin."

#: etiketto/ui/texts.py:404
msgid "The print head is open. Close it and try again."
msgstr "Yazdırma kafası açık. Kapatın ve yeniden deneyin."

#: etiketto/ui/texts.py:406
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Yazıcı sonraki etiketi bulamıyor. Etiketlerin doğru takıldığını ve etiket sensöründen geçtiğini kontrol edin."

#: etiketto/ui/texts.py:410
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Ribonda bir sorun var. Doğru takıldığını ve yazıcıda ayarlanan yazdırma yöntemine uygun olduğunu kontrol edin."

#: etiketto/ui/texts.py:416
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Yazıcı ribon bulamıyor. Bir ribon takın ve yeniden deneyin. Ribonsuz yazdırılan etiketler için “%(method)s” altında “%(direct)s” gerekir."

#: etiketto/ui/texts.py:423
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Ribon takılı, ancak yazıcı onsuz yazdırıyor (doğrudan termal). Ribon gerektiren etiketler için “%(method)s” altında “%(transfer)s” seçin veya ribonu çıkarın."

#: etiketto/ui/texts.py:428
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Yazıcı duraklatıldı. Ekranından devam ettirin ve yeniden deneyin."

#: etiketto/ui/texts.py:429
msgid "The printer is out of paper. Load paper and try again."
msgstr "Yazıcının kağıdı bitti. Kağıt yükleyip yeniden deneyin."

#: etiketto/ui/texts.py:431
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Kağıt sıkıştı. Yazıcının ekranında gösterildiği gibi çıkarıp yeniden deneyin."

#: etiketto/ui/texts.py:433
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Yazıcının toneri veya mürekkebi bitti. Değiştirip yeniden deneyin."

#: etiketto/ui/texts.py:434
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Yazıcı bu boyutu yazdıramıyor. Yazıcının sunduğu bir kağıt boyutu seçin."

#: etiketto/ui/texts.py:436
msgid ""
"The printer takes none of the formats Etiketto can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Yazıcı, Etiketto'nun gönderebildiği biçimlerin (PDF, PWG Raster, JPEG) hiçbirini kabul etmiyor."

#: etiketto/ui/texts.py:439
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Yazıcının kuyruğu duraklatıldı. Sistemin yazıcı ayarlarından devam ettirin ve yeniden deneyin."

#: etiketto/ui/texts.py:443
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Yazdırma işi kuyrukta bekletildi, örneğin serbest bırakılana veya bir parola girilene kadar. Sistemin yazıcı ayarlarında kuyruğu kontrol edin ve yeniden deneyin."

#: etiketto/ui/texts.py:447
msgid "The print job was canceled at the printer or in the queue."
msgstr "Yazdırma işi yazıcıda veya kuyrukta iptal edildi."

#: etiketto/ui/texts.py:448
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Yazıcı çözünürlüğünü zamanında bildirmedi. “%s” altında seçin."

#: etiketto/ui/texts.py:451
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Takılı rulo etikete uymuyor. Uygun bir rulo takın ya da takılı rulonun etiket boyutunu veya yazıcı modelini seçin."

#: etiketto/ui/texts.py:454
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Yazıcının pili zayıf – şarj edin veya güç adaptörünü takın."

#: etiketto/ui/texts.py:455
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Yazdırma kafası çok sıcak. Soğuyana kadar bekleyin, ardından yeniden deneyin."

#: etiketto/ui/texts.py:457
msgid ""
"Etiketto cannot print on this printer model: it does not take the raster "
"images Etiketto sends."
msgstr "Etiketto bu yazıcı modelinde yazdıramaz: Etiketto’nun gönderdiği raster görüntüleri kabul etmez."

#: etiketto/ui/texts.py:461
msgid "Etiketto does not know this printer model and cannot print on it yet."
msgstr "Etiketto bu yazıcı modelini tanımıyor ve henüz bu modelde yazdıramıyor."

#: etiketto/ui/texts.py:464
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Yazıcı Editor Lite modunda ve USB sürücüsü olarak görünüyor. Yazıcıda Editor Lite’ı kapatın (ışığı söner), ardından yeniden arayın."

#: etiketto/ui/texts.py:468
msgid ""
"Etiketto is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Etiketto yazıcının USB bağlantı noktasını kullanma iznine sahip değil. Kullanıcınızı “lp” grubuna ekleyin (sudo usermod -aG lp $USER), ardından oturumu kapatıp yeniden açın."

#: etiketto/ui/texts.py:472
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Sayfa, yazıcının kabul ettiği çözünürlükte oluşturulamayacak kadar büyük. Daha küçük bir kâğıt boyutu seçin veya PDF kabul eden bir yazıcıda yazdırın."

#: etiketto/ui/texts.py:476
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Bu yazıcının çözünürlüğünde kod etikete sığmıyor ve kesilir. Etiketi büyütün veya kodun içeriğini kısaltın."

#: etiketto/ui/texts.py:480
msgid ""
"Etiketto is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Etiketto yazıcının seri bağlantı noktasını kullanma iznine sahip değil. Kullanıcınızı “dialout” grubuna ekleyin (sudo usermod -aG dialout $USER; Arch Linux'ta grubun adı “uucp”), ardından oturumu kapatıp yeniden açın."

#: etiketto/ui/texts.py:485
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Yazıcı bir sorun bildirdi. Kapatıp yeniden açın, ardından bir kez daha deneyin."

#: etiketto/ui/texts.py:496
msgid "Printed"
msgstr "Yazdırıldı"

#: etiketto/ui/texts.py:502
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Yazıcıya gönderildi – sırası geldiğinde yazdırılacak"

#: etiketto/ui/texts.py:504
msgid "Sent to the printer – it did not confirm printing"
msgstr "Yazıcıya gönderildi – yazıcı yazdırmayı onaylamadı"

#: etiketto/ui/texts.py:508
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Takılı rulo gerektirdiği için “%(used)s” ile yazdırıldı"

#: etiketto/ui/texts.py:512
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "“%(wanted)s” renk modu bu yazıcıda kullanılamıyor, “%(used)s” ile yazdırıldı"

#: etiketto/ui/texts.py:522
msgid "Warming up…"
msgstr "Isınıyor…"

#: etiketto/ui/texts.py:523
msgid "Cooling down…"
msgstr "Soğuyor…"

#: etiketto/ui/texts.py:524
msgid "Cleaning…"
msgstr "Temizleniyor…"

#: etiketto/ui/texts.py:525
msgid "Swipe the printer's panel to cut the label"
msgstr "Etiketi kesmek için yazıcının paneli üzerinde kaydırın"

#: etiketto/ui/texts.py:527
msgid "Out of paper – load paper to continue"
msgstr "Kağıt bitti – devam etmek için kağıt yükleyin"

#: etiketto/ui/texts.py:528
msgid "Cover open – close it to continue"
msgstr "Kapak açık – devam etmek için kapatın"

#: etiketto/ui/texts.py:529
msgid "Paper jammed – remove it to continue"
msgstr "Kağıt sıkıştı – devam etmek için çıkarın"

#: etiketto/ui/texts.py:540
msgid "This label needs a newer version of Etiketto"
msgstr "Bu etiket için Etiketto'nun daha yeni bir sürümü gerekiyor"

#: etiketto/ui/texts.py:542
#, python-format
msgid "%s is not an Etiketto label"
msgstr "%s bir Etiketto etiketi değil"

#: etiketto/ui/texts.py:543 etiketto/ui/texts.py:563
#, python-format
msgid "The file is damaged: %s"
msgstr "Dosya bozuk: %s"

#: etiketto/ui/texts.py:550
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "%s veri dosyası artık yok. Yeniden seçin ya da kaldırın."

#: etiketto/ui/texts.py:554
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s içinde %(sheet)s adlı sayfa yok"

#: etiketto/ui/texts.py:556
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s bir tablo değil. CSV, ODS veya XLSX dosyası kullanın."

#: etiketto/ui/texts.py:558
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s seri etiketler için çok büyük. Daha küçük dosyalara bölün ya da gerekmeyen satır ve sütunları kaldırın."

#: etiketto/ui/texts.py:561
#, python-format
msgid "%s contains no data."
msgstr "%s veri içermiyor."

#: etiketto/ui/texts.py:572
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Yazdırma %(row)d. satırda durdu. Devam etmek için %(row)d. satırdan itibaren yeniden yazdırın."

#: etiketto/ui/texts.py:576
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "%(row)d. satırın zaten yazdırılan kopyaları: %(copies)d."

#: etiketto/ui/texts.py:581
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "%(row)d. satır %(sheet)d. sayfanın %(position)d. konumuna gelir."

#: etiketto/ui/texts.py:592
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "%s kaydedilemiyor: oraya yazma izni yok"

#: etiketto/ui/texts.py:594
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s kaydedilemiyor: disk dolu"

#: etiketto/ui/texts.py:604
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Bu kasetin üretim tarihi büyük olasılıkla: %(month)s %(year)d. Eski ZINK kağıdı daha soluk renkler basar."

