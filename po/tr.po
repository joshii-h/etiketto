#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: Code 128 yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: etiketto/app.py:241
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Öge %(n)d: görüntü okunamıyor"

#: etiketto/app.py:242
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Öge %(n)d çizilemiyor"

#: etiketto/app.py:243
msgid "Safety margin, border and edge spacing leave no room – reduce them"
msgstr "Güvenlik payı, kenarlık ve kenar aralığı yer bırakmıyor – bunları azaltın"

#: etiketto/app.py:244
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Sabit uzunluk aralıktan kısa – uzunluğu artırın"

#: etiketto/app.py:245
msgid "The background image cannot be read"
msgstr "Arka plan görüntüsü okunamıyor"

#: etiketto/app.py:254
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Yazıcı bulunamıyor. Açık ve aynı ağda olduğunu denetleyin ya da IP adresini girin."

#: etiketto/app.py:257
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Yazıcı yanıt vermiyor. Açık ve uyanık olduğunu denetleyin."

#: etiketto/app.py:259
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Yazıcı bağlantıyı reddediyor. Kapatıp yeniden açın. Web arayüzünde “Port 9100” seçeneği varsa etkinleştirin."

#: etiketto/app.py:262
msgid "No cassette is inserted. Insert one and try again."
msgstr "Kaset takılı değil. Bir kaset takıp yeniden deneyin."

#: etiketto/app.py:263
msgid "The printer's cover is open. Close it and try again."
msgstr "Yazıcının kapağı açık. Kapatıp yeniden deneyin."

#: etiketto/app.py:264
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etiket sıkıştı. Kapağı açın, etiketi çıkarın ve yeniden deneyin."

#: etiketto/app.py:265
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tanınmıyor. Yeniden takın ya da başka bir kaset deneyin."

#: etiketto/app.py:266
msgid "The printer is busy. Wait a moment and try again."
msgstr "Yazıcı meşgul. Biraz bekleyip yeniden deneyin."

#: etiketto/app.py:267
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etiket bu yazıcı için çok uzun: en fazla %(max)s."

#: etiketto/app.py:269
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Yazıcı bir sorun bildirdi. Kapatıp yeniden açın, ardından bir kez daha deneyin."

