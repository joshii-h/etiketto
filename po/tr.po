#: tavletta/ui/texts.py:331
#, python-format
msgid "%s, continuous rolls"
msgstr "%s, sürekli rulolar"

#. translators: %s is a printer model, e.g. "Brother QL"
#: tavletta/ui/texts.py:333
#, python-format
msgid "%s, die-cut labels"
msgstr "%s, kesimli etiketler"

#: tavletta/ui/texts.py:340
#, python-format
msgid "Element %(n)d: the code is empty"
msgstr "Öge %(n)d: kod boş"

#: tavletta/ui/texts.py:341
#, python-format
msgid "Element %(n)d: EAN-13 needs exactly 12 digits"
msgstr "Öge %(n)d: EAN-13 tam olarak 12 rakam gerektirir"

#: tavletta/ui/texts.py:342
#, python-format
msgid "Element %(n)d: the EAN-13 check digit is wrong"
msgstr "Öge %(n)d: EAN-13 denetim basamağı yanlış"

#: tavletta/ui/texts.py:343
#, python-format
msgid "Element %(n)d: Code 128 holds at most %(max)d characters"
msgstr "Öge %(n)d: Code 128 en fazla %(max)d karakter alabilir"

#: tavletta/ui/texts.py:345
#, python-format
msgid ""
"Element %(n)d: the bars are too thin to scan reliably – use a longer or "
"larger label, or shorter content"
msgstr "Öge %(n)d: çubuklar güvenilir biçimde taranamayacak kadar ince – daha uzun veya daha büyük bir etiket ya da daha kısa içerik kullanın"

#: tavletta/ui/texts.py:349
#, python-format
msgid ""
"Element %(n)d: Code 128 only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: Code 128 yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: tavletta/ui/texts.py:351
#, python-format
msgid "Element %(n)d: EAN-8 needs 7 digits, or 8 with the check digit"
msgstr "Öge %(n)d: EAN-8 7 rakam veya denetim basamağıyla 8 rakam gerektirir"

#: tavletta/ui/texts.py:352
#, python-format
msgid "Element %(n)d: UPC-A needs 11 digits, or 12 with the check digit"
msgstr "Öge %(n)d: UPC-A 11 rakam veya denetim basamağıyla 12 rakam gerektirir"

#: tavletta/ui/texts.py:354
#, python-format
msgid ""
"Element %(n)d: UPC-E needs 7 digits starting with 0 or 1, or 8 with the "
"check digit"
msgstr "Öge %(n)d: UPC-E 0 veya 1 ile başlayan 7 rakam ya da denetim basamağıyla 8 rakam gerektirir"

#: tavletta/ui/texts.py:356
#, python-format
msgid "Element %(n)d: ITF-14 needs 13 digits, or 14 with the check digit"
msgstr "Öge %(n)d: ITF-14 13 rakam veya denetim basamağıyla 14 rakam gerektirir"

#: tavletta/ui/texts.py:357
#, python-format
msgid "Element %(n)d: the check digit is wrong"
msgstr "Öge %(n)d: denetim basamağı yanlış"

#: tavletta/ui/texts.py:359
#, python-format
msgid ""
"Element %(n)d: Code 39 only accepts capital letters, digits, spaces and - . "
"$ / + %%"
msgstr "Öge %(n)d: Code 39 yalnızca büyük harfler, rakamlar, boşluklar ve - . $ / + %% kabul eder"

#: tavletta/ui/texts.py:362
#, python-format
msgid ""
"Element %(n)d: Code 93 only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: Code 93 yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: tavletta/ui/texts.py:365
#, python-format
msgid ""
"Element %(n)d: GS1 data only accepts Latin letters, digits and punctuation"
msgstr "Öge %(n)d: GS1 verileri yalnızca Latin harfleri, rakamlar ve noktalama işaretleri kabul eder"

#: tavletta/ui/texts.py:368
#, python-format
msgid ""
"Element %(n)d: GS1 data must be application identifiers in brackets, each "
"followed by its value, e.g. (01)09501101530003(10)AB12"
msgstr "Öge %(n)d: GS1 verileri, her birinin ardından değeri gelen, parantez içindeki uygulama tanımlayıcılarından oluşmalıdır, ör. (01)09501101530003(10)AB12"

#: tavletta/ui/texts.py:371
#, python-format
msgid "Element %(n)d: (%(ai)s) is not a GS1 application identifier"
msgstr "Öge %(n)d: (%(ai)s) bir GS1 uygulama tanımlayıcısı değil"

#: tavletta/ui/texts.py:373
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) has the wrong "
"length"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) değerinin uzunluğu yanlış"

#: tavletta/ui/texts.py:376
#, python-format
msgid ""
"Element %(n)d: the check digit of application identifier (%(ai)s) is wrong"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) denetim basamağı yanlış"

#: tavletta/ui/texts.py:379
#, python-format
msgid ""
"Element %(n)d: the value of application identifier (%(ai)s) is not valid: a "
"date, number or character it does not allow"
msgstr "Öge %(n)d: uygulama tanımlayıcısı (%(ai)s) değeri geçersiz: izin vermediği bir tarih, sayı veya karakter"

#: tavletta/ui/texts.py:383
#, python-format
msgid ""
"Element %(n)d: no UPC-A number shortens to these UPC-E digits – check them "
"or use UPC-A"
msgstr "Öge %(n)d: hiçbir UPC-A numarası bu UPC-E rakamlarına kısalmıyor – rakamları denetleyin veya UPC-A kullanın"

#: tavletta/ui/texts.py:387
#, python-format
msgid ""
"Element %(n)d: scanners set to Full ASCII read a $, /, + or %% before a "
"capital letter as another character"
msgstr "Öge %(n)d: Full ASCII'ye ayarlı tarayıcılar büyük harften önceki $, /, + veya %% işaretini başka bir karakter olarak okur"

#: tavletta/ui/texts.py:390
#, python-format
msgid "Element %(n)d: the content is too long for this type of code"
msgstr "Öge %(n)d: içerik bu kod türü için çok uzun"

#: tavletta/ui/texts.py:391
#, python-format
msgid "Element %(n)d: the content cannot be encoded in this type of code"
msgstr "Öge %(n)d: içerik bu kod türünde kodlanamıyor"

#: tavletta/ui/texts.py:393
#, python-format
msgid ""
"Element %(n)d: this type of code needs the Zint library (zint-bindings), "
"which is not installed"
msgstr "Öge %(n)d: bu kod türü, yüklü olmayan Zint kitaplığını (zint-bindings) gerektirir"

#: tavletta/ui/texts.py:396
#, python-format
msgid "Element %(n)d: the image cannot be read"
msgstr "Öge %(n)d: görüntü okunamıyor"

#: tavletta/ui/texts.py:397
#, python-format
msgid "Element %(n)d: this symbol is not in the symbol library"
msgstr "Öge %(n)d: bu sembol sembol kitaplığında yok"

#: tavletta/ui/texts.py:398
#, python-format
msgid "Element %(n)d: the document cannot be read"
msgstr "Öge %(n)d: belge okunamıyor"

#: tavletta/ui/texts.py:400
#, python-format
msgid ""
"Element %(n)d: PDF files need Poppler (poppler-glib), which is not installed"
msgstr "Öge %(n)d: PDF dosyaları için Poppler (poppler-glib) gerekir, ancak kurulu değil"

#: tavletta/ui/texts.py:402
#, python-format
msgid "Element %(n)d cannot be drawn"
msgstr "Öge %(n)d çizilemiyor"

#: tavletta/ui/texts.py:404
msgid ""
"Safety margin, border, its inset and edge spacing leave no room – reduce them"
msgstr "Güvenlik payı, kenarlık, kenarlığın içe kaydırması ve kenar aralığı yer bırakmıyor – bunları azaltın"

#: tavletta/ui/texts.py:406
msgid "The fixed length is shorter than the spacing – increase it"
msgstr "Sabit uzunluk aralıktan kısa – uzunluğu artırın"

#: tavletta/ui/texts.py:407
msgid "The background image cannot be read"
msgstr "Arka plan görüntüsü okunamıyor"

#: tavletta/ui/texts.py:409
#, python-format
msgid ""
"Element %(n)d: the code's modules are only one printer dot wide and may not "
"scan – make the code larger"
msgstr "Öge %(n)d: kodun modülleri yalnızca bir yazıcı noktası genişliğinde ve taranamayabilir – kodu büyütün"

#: tavletta/ui/texts.py:413
#, python-format
msgid ""
"Element %(n)d: the blank space the code needs around it does not fit – make "
"the code larger"
msgstr "Öge %(n)d: kodun çevresinde gereken boşluk sığmıyor – kodu büyütün"

#: tavletta/ui/texts.py:417
#, python-format
msgid ""
"Element %(n)d: the code does not fit in its space, even at one printer dot "
"per module – make the label larger or the content shorter"
msgstr "Öge %(n)d: kod, modül başına bir yazıcı noktasıyla bile kendi alanına sığmıyor – etiketi büyütün veya içeriği kısaltın"

#: tavletta/ui/texts.py:420
#, python-format
msgid "Element %(n)d: %(name)s is not a known variable"
msgstr "Öge %(n)d: %(name)s bilinen bir değişken değil"

#: tavletta/ui/texts.py:422
#, python-format
msgid "Element %(n)d: the date of %(name)s is before the year 1 or after 9999"
msgstr "Öge %(n)d: %(name)s tarihi 1. yıldan önce veya 9999'dan sonra"

#: tavletta/ui/texts.py:425
#, python-format
msgid "Element %(n)d: the variable %(name)s… is not closed – end it with }"
msgstr "Öge %(n)d: %(name)s… değişkeni kapatılmamış – } ile bitirin"

#: tavletta/ui/texts.py:428
#, python-format
msgid ""
"Element %(n)d: on a black-and-white printer it hardly stands out from what "
"lies behind it, as a whole or in part – choose another colour or move it"
msgstr "Öge %(n)d: siyah beyaz yazıcıda tamamen veya kısmen arkasındakinden neredeyse hiç ayırt edilmiyor – başka bir renk seçin veya ögeyi taşıyın"

#: tavletta/ui/texts.py:431
#, python-format
msgid "Element %(n)d: the shape has neither a line nor a fill"
msgstr "Öge %(n)d: şeklin ne çizgisi ne de dolgusu var"

#: tavletta/ui/texts.py:433
#, python-format
msgid ""
"Element %(n)d reaches beyond the edge of the label and is cut off there – "
"move it or make it smaller"
msgstr "%(n)d. öğe etiketin kenarını aşıyor ve orada kesiliyor – taşıyın veya küçültün"

#: tavletta/ui/texts.py:437
#, python-format
msgid ""
"Element %(n)d: the padding, frame, outline or shadow leave no room for the "
"text – make them smaller"
msgstr "Öge %(n)d: iç boşluk, çerçeve, kontur veya gölge metne yer bırakmıyor – bunları küçültün"

#: tavletta/ui/texts.py:452
#, python-format
msgid "Sheets already printed: %(n)d of %(total)d."
msgstr "Zaten yazdırılan sayfalar: %(total)d sayfadan %(n)d."

#: tavletta/ui/texts.py:454
#, python-format
msgid "Labels already printed: %(n)d of %(total)d."
msgstr "Zaten yazdırılan etiketler: %(total)d etiketten %(n)d."

#: tavletta/ui/texts.py:458
msgid "The sheets still waiting in the queue were canceled."
msgstr "Kuyrukta hâlâ bekleyen sayfalar iptal edildi."

#: tavletta/ui/texts.py:460
msgid "The labels still waiting in the queue were canceled."
msgstr "Kuyrukta hâlâ bekleyen etiketler iptal edildi."

#: tavletta/ui/texts.py:467
#, python-format
msgid ""
"The label is %(size)s with a gap of %(gap)s, so a new one starts every "
"%(pitch)s. The printer measured a label every %(measured)s. Check the label "
"size and the gap."
msgstr "Etiket boyutu %(size)s, boşluk %(gap)s; yani yeni bir etiket her %(pitch)s mesafede başlar. Yazıcı etiketler arasında %(measured)s ölçtü. Etiket boyutunu ve boşluğu kontrol edin."

#: tavletta/ui/texts.py:483
msgid ""
"The printer cannot be found. Check that it is switched on and in the same "
"network, or enter its IP address."
msgstr "Yazıcı bulunamıyor. Açık ve aynı ağda olduğunu denetleyin ya da IP adresini girin."

#: tavletta/ui/texts.py:487
msgid ""
"The printer cannot be found on USB. Check the cable and that the printer is "
"switched on and awake, then search again."
msgstr "Yazıcı USB üzerinden bulunamıyor. Kabloyu ve yazıcının açık ve uyanık olduğunu denetleyin, ardından yeniden arayın."

#: tavletta/ui/texts.py:490
msgid "The printer does not answer. Check that it is switched on and awake."
msgstr "Yazıcı yanıt vermiyor. Açık ve uyanık olduğunu denetleyin."

#: tavletta/ui/texts.py:492
msgid ""
"The printer stopped taking data. Check whether it shows a problem, such as "
"no labels or an open cover, then try again."
msgstr "Yazıcı veri almayı bıraktı. Etiketin bitmesi veya kapağın açık olması gibi bir sorun gösterip göstermediğini kontrol edin, ardından yeniden deneyin."

#: tavletta/ui/texts.py:496
msgid ""
"The printer refuses the connection. Switch it off and on again. If its web "
"interface offers a “Port 9100” option, turn it on."
msgstr "Yazıcı bağlantıyı reddediyor. Kapatıp yeniden açın. Web arayüzünde “Port 9100” seçeneği varsa etkinleştirin."

#: tavletta/ui/texts.py:499
msgid "No cassette is inserted. Insert one and try again."
msgstr "Kaset takılı değil. Bir kaset takıp yeniden deneyin."

#: tavletta/ui/texts.py:500
msgid "The printer's cover is open. Close it and try again."
msgstr "Yazıcının kapağı açık. Kapatıp yeniden deneyin."

#: tavletta/ui/texts.py:501
msgid "The label is jammed. Open the cover, remove it and try again."
msgstr "Etiket sıkıştı. Kapağı açın, etiketi çıkarın ve yeniden deneyin."

#: tavletta/ui/texts.py:502
msgid "The cassette is not recognised. Insert it again or try another one."
msgstr "Kaset tanınmıyor. Yeniden takın ya da başka bir kaset deneyin."

#: tavletta/ui/texts.py:503
msgid "The printer is busy. Wait a moment and try again."
msgstr "Yazıcı meşgul. Biraz bekleyip yeniden deneyin."

#: tavletta/ui/texts.py:504
#, python-format
msgid "The label is too long for this printer: at most %(max)s."
msgstr "Etiket bu yazıcı için çok uzun: en fazla %(max)s."

#: tavletta/ui/texts.py:505
#, python-format
msgid "The label is too wide for this printer: at most %(max)s."
msgstr "Etiket bu yazıcı için çok geniş: en fazla %(max)s."

#: tavletta/ui/texts.py:506
msgid "The printer is out of labels. Load a new roll and try again."
msgstr "Yazıcının etiketi bitti. Yeni bir rulo takın ve yeniden deneyin."

#: tavletta/ui/texts.py:507
msgid "The print head is open. Close it and try again."
msgstr "Yazdırma kafası açık. Kapatın ve yeniden deneyin."

#: tavletta/ui/texts.py:509
msgid ""
"The printer cannot find the next label. Check that the labels are loaded "
"correctly and run through the label sensor."
msgstr "Yazıcı sonraki etiketi bulamıyor. Etiketlerin doğru takıldığını ve etiket sensöründen geçtiğini kontrol edin."

#: tavletta/ui/texts.py:513
msgid ""
"There is a problem with the ribbon. Check that it is inserted correctly and "
"matches the print method set on the printer."
msgstr "Ribonda bir sorun var. Doğru takıldığını ve yazıcıda ayarlanan yazdırma yöntemine uygun olduğunu kontrol edin."

#: tavletta/ui/texts.py:519
#, python-format
msgid ""
"The printer finds no ribbon. Load a ribbon and try again. Labels that print "
"without one need “%(direct)s” under “%(method)s”."
msgstr "Yazıcı ribon bulamıyor. Bir ribon takın ve yeniden deneyin. Ribonsuz yazdırılan etiketler için “%(method)s” altında “%(direct)s” gerekir."

#: tavletta/ui/texts.py:526
#, python-format
msgid ""
"A ribbon is loaded, but the printer prints without it (thermal direct). For "
"labels that need the ribbon choose “%(transfer)s” under “%(method)s”, or "
"remove the ribbon."
msgstr "Ribon takılı, ancak yazıcı onsuz yazdırıyor (doğrudan termal). Ribon gerektiren etiketler için “%(method)s” altında “%(transfer)s” seçin veya ribonu çıkarın."

#: tavletta/ui/texts.py:531
msgid "The printer is paused. Resume it on its display and try again."
msgstr "Yazıcı duraklatıldı. Ekranından devam ettirin ve yeniden deneyin."

#: tavletta/ui/texts.py:532
msgid "The printer is out of paper. Load paper and try again."
msgstr "Yazıcının kağıdı bitti. Kağıt yükleyip yeniden deneyin."

#: tavletta/ui/texts.py:534
msgid ""
"The paper is jammed. Remove it as the printer's display shows and try again."
msgstr "Kağıt sıkıştı. Yazıcının ekranında gösterildiği gibi çıkarıp yeniden deneyin."

#: tavletta/ui/texts.py:536
msgid "The printer is out of toner or ink. Replace it and try again."
msgstr "Yazıcının toneri veya mürekkebi bitti. Değiştirip yeniden deneyin."

#: tavletta/ui/texts.py:537
msgid "The printer cannot print this size. Choose a paper size it offers."
msgstr "Yazıcı bu boyutu yazdıramıyor. Yazıcının sunduğu bir kağıt boyutu seçin."

#: tavletta/ui/texts.py:539
msgid ""
"The printer takes none of the formats Tavletta can send (PDF, PWG Raster, "
"JPEG)."
msgstr "Yazıcı, Tavletta'nın gönderebildiği biçimlerin (PDF, PWG Raster, JPEG) hiçbirini kabul etmiyor."

#: tavletta/ui/texts.py:542
msgid ""
"The printer's queue is paused. Resume it in the system's printer settings "
"and try again."
msgstr "Yazıcının kuyruğu duraklatıldı. Sistemin yazıcı ayarlarından devam ettirin ve yeniden deneyin."

#: tavletta/ui/texts.py:546
msgid ""
"The print job was held in the queue, for example until it is released or a "
"password is entered. Check the queue in the system's printer settings and "
"try again."
msgstr "Yazdırma işi kuyrukta bekletildi, örneğin serbest bırakılana veya bir parola girilene kadar. Sistemin yazıcı ayarlarında kuyruğu kontrol edin ve yeniden deneyin."

#: tavletta/ui/texts.py:550
msgid "The print job was canceled at the printer or in the queue."
msgstr "Yazdırma işi yazıcıda veya kuyrukta iptal edildi."

#: tavletta/ui/texts.py:551
#, python-format
msgid ""
"The printer did not report its resolution in time. Choose it under “%s”."
msgstr "Yazıcı çözünürlüğünü zamanında bildirmedi. “%s” altında seçin."

#: tavletta/ui/texts.py:554
msgid ""
"The loaded roll does not match the label. Load a matching roll, or choose "
"the label size or printer model of the roll that is loaded."
msgstr "Takılı rulo etikete uymuyor. Uygun bir rulo takın ya da takılı rulonun etiket boyutunu veya yazıcı modelini seçin."

#: tavletta/ui/texts.py:557
msgid "The printer's battery is low – charge it or connect the power adapter."
msgstr "Yazıcının pili zayıf – şarj edin veya güç adaptörünü takın."

#: tavletta/ui/texts.py:558
msgid ""
"The print head is too hot. Wait until it has cooled down, then try again."
msgstr "Yazdırma kafası çok sıcak. Soğuyana kadar bekleyin, ardından yeniden deneyin."

#: tavletta/ui/texts.py:560
msgid ""
"Tavletta cannot print on this printer model: it does not take the raster "
"images Tavletta sends."
msgstr "Tavletta bu yazıcı modelinde yazdıramaz: Tavletta’nın gönderdiği raster görüntüleri kabul etmez."

#: tavletta/ui/texts.py:564
msgid "Tavletta does not know this printer model and cannot print on it yet."
msgstr "Tavletta bu yazıcı modelini tanımıyor ve henüz bu modelde yazdıramıyor."

#: tavletta/ui/texts.py:567
msgid ""
"The printer is in Editor Lite mode and shows up as a USB drive. Switch "
"Editor Lite off on the printer (its lamp goes out), then search again."
msgstr "Yazıcı Editor Lite modunda ve USB sürücüsü olarak görünüyor. Yazıcıda Editor Lite’ı kapatın (ışığı söner), ardından yeniden arayın."

#: tavletta/ui/texts.py:571
msgid ""
"Tavletta is not allowed to use the printer's USB port. Add your user to the "
"group “lp” (sudo usermod -aG lp $USER), then log out and in again."
msgstr "Tavletta yazıcının USB bağlantı noktasını kullanma iznine sahip değil. Kullanıcınızı “lp” grubuna ekleyin (sudo usermod -aG lp $USER), ardından oturumu kapatıp yeniden açın."

#: tavletta/ui/texts.py:575
msgid ""
"The page is too large to make at the resolution the printer takes. Choose a "
"smaller paper size, or print on a printer that takes PDF."
msgstr "Sayfa, yazıcının kabul ettiği çözünürlükte oluşturulamayacak kadar büyük. Daha küçük bir kâğıt boyutu seçin veya PDF kabul eden bir yazıcıda yazdırın."

#: tavletta/ui/texts.py:579
msgid ""
"A code does not fit on the label at this printer's resolution and would be "
"cut off. Make the label larger or the code's content shorter."
msgstr "Bu yazıcının çözünürlüğünde kod etikete sığmıyor ve kesilir. Etiketi büyütün veya kodun içeriğini kısaltın."

#: tavletta/ui/texts.py:583
msgid ""
"Tavletta is not allowed to use the printer's serial port. Add your user to "
"the group “dialout” (sudo usermod -aG dialout $USER; on Arch Linux the group "
"is “uucp”), then log out and in again."
msgstr "Tavletta yazıcının seri bağlantı noktasını kullanma iznine sahip değil. Kullanıcınızı “dialout” grubuna ekleyin (sudo usermod -aG dialout $USER; Arch Linux'ta grubun adı “uucp”), ardından oturumu kapatıp yeniden açın."

#: tavletta/ui/texts.py:588
msgid ""
"The printer reported a problem. Switch it off and on again, then try once "
"more."
msgstr "Yazıcı bir sorun bildirdi. Kapatıp yeniden açın, ardından bir kez daha deneyin."

#: tavletta/ui/texts.py:599
msgid "Printed"
msgstr "Yazdırıldı"

#: tavletta/ui/texts.py:605
msgid "Sent to the printer – it prints when its turn comes"
msgstr "Yazıcıya gönderildi – sırası geldiğinde yazdırılacak"

#: tavletta/ui/texts.py:607
msgid "Sent to the printer – it did not confirm printing"
msgstr "Yazıcıya gönderildi – yazıcı yazdırmayı onaylamadı"

#: tavletta/ui/texts.py:611
#, python-format
msgid "Printed with “%(used)s”, as the loaded roll needs it"
msgstr "Takılı rulo gerektirdiği için “%(used)s” ile yazdırıldı"

#: tavletta/ui/texts.py:615
#, python-format
msgid ""
"Colour mode “%(wanted)s” is not available on this printer, printed with "
"“%(used)s”"
msgstr "“%(wanted)s” renk modu bu yazıcıda kullanılamıyor, “%(used)s” ile yazdırıldı"

#: tavletta/ui/texts.py:625
msgid "Warming up…"
msgstr "Isınıyor…"

#: tavletta/ui/texts.py:626
msgid "Cooling down…"
msgstr "Soğuyor…"

#: tavletta/ui/texts.py:627
msgid "Cleaning…"
msgstr "Temizleniyor…"

#: tavletta/ui/texts.py:628
msgid "Swipe the printer's panel to cut the label"
msgstr "Etiketi kesmek için yazıcının paneli üzerinde kaydırın"

#: tavletta/ui/texts.py:630
msgid "Out of paper – load paper to continue"
msgstr "Kağıt bitti – devam etmek için kağıt yükleyin"

#: tavletta/ui/texts.py:631
msgid "Cover open – close it to continue"
msgstr "Kapak açık – devam etmek için kapatın"

#: tavletta/ui/texts.py:632
msgid "Paper jammed – remove it to continue"
msgstr "Kağıt sıkıştı – devam etmek için çıkarın"

#: tavletta/ui/texts.py:643
msgid "This label needs a newer version of Tavletta"
msgstr "Bu etiket için Tavletta'nın daha yeni bir sürümü gerekiyor"

#: tavletta/ui/texts.py:645
#, python-format
msgid "%s is not an Tavletta label"
msgstr "%s bir Tavletta etiketi değil"

#: tavletta/ui/texts.py:646 tavletta/ui/texts.py:666
#: tavletta/server/service.py:690
#, python-format
msgid "The file is damaged: %s"
msgstr "Dosya bozuk: %s"

#: tavletta/ui/texts.py:653
#, python-format
msgid "The data file %s is not there any more. Choose it again or remove it."
msgstr "%s veri dosyası artık yok. Yeniden seçin ya da kaldırın."

#: tavletta/ui/texts.py:657
#, python-format
msgid "%(file)s has no sheet named %(sheet)s"
msgstr "%(file)s içinde %(sheet)s adlı sayfa yok"

#: tavletta/ui/texts.py:659
#, python-format
msgid "%s is not a table. Use a CSV, ODS or XLSX file."
msgstr "%s bir tablo değil. CSV, ODS veya XLSX dosyası kullanın."

#: tavletta/ui/texts.py:661
#, python-format
msgid ""
"%s is too large for serial labels. Split it into smaller files or remove "
"rows and columns that are not needed."
msgstr "%s seri etiketler için çok büyük. Daha küçük dosyalara bölün ya da gerekmeyen satır ve sütunları kaldırın."

#: tavletta/ui/texts.py:664
#, python-format
msgid "%s contains no data."
msgstr "%s veri içermiyor."

#: tavletta/ui/texts.py:675
#, python-format
msgid ""
"Printing stopped at row %(row)d. To continue, print again from row %(row)d."
msgstr "Yazdırma %(row)d. satırda durdu. Devam etmek için %(row)d. satırdan itibaren yeniden yazdırın."

#: tavletta/ui/texts.py:679
#, python-format
msgid "Copies of row %(row)d already printed: %(copies)d."
msgstr "%(row)d. satırın zaten yazdırılan kopyaları: %(copies)d."

#: tavletta/ui/texts.py:684
#, python-format
msgid "Row %(row)d goes at position %(position)d of sheet %(sheet)d."
msgstr "%(row)d. satır %(sheet)d. sayfanın %(position)d. konumuna gelir."

#: tavletta/ui/texts.py:695
#, python-format
msgid "Cannot save %s: no permission to write there"
msgstr "%s kaydedilemiyor: oraya yazma izni yok"

#: tavletta/ui/texts.py:697
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s kaydedilemiyor: disk dolu"

#: tavletta/ui/texts.py:707
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Bu kasetin üretim tarihi büyük olasılıkla: %(month)s %(year)d. Eski ZINK kağıdı daha soluk renkler basar."

#: tavletta/ui/variables.py:24
msgid "Date"
msgstr "Tarih"

#: tavletta/ui/variables.py:25
msgid "Best before (in 30 days)"
msgstr "Son tüketim tarihi (30 gün sonra)"

#: tavletta/ui/variables.py:26
msgid "Time"
msgstr "Saat"

#: tavletta/ui/variables.py:27 tavletta/ui/variables.py:113
msgid "Counter"
msgstr "Sayaç"

#: tavletta/ui/variables.py:28
msgid "Counter with leading zeros"
msgstr "Baştaki sıfırlı sayaç"

#: tavletta/ui/variables.py:29
msgid "Copy number"
msgstr "Kopya numarası"

#: tavletta/ui/variables.py:30
msgid "Number of copies"
msgstr "Kopya sayısı"

#: tavletta/ui/variables.py:31
msgid "Random ID"
msgstr "Rastgele kimlik"

#: tavletta/ui/variables.py:41
msgid "Insert variable"
msgstr "Değişken ekle"

#: tavletta/ui/variables.py:67
msgid ""
"Variables are filled in when printing. Every printed label gets the next "
"counter value, also from copy to copy. The preview shows the values of the "
"next print."
msgstr "Değişkenler yazdırırken doldurulur. Basılan her etiket, kopyadan kopyaya da olmak üzere sonraki sayaç değerini alır. Önizleme, sonraki yazdırmanın değerlerini gösterir."

#: tavletta/ui/variables.py:77
msgid "More about variables"
msgstr "Değişkenler hakkında daha fazla bilgi"

#: tavletta/ui/variables.py:113
msgid "Goes up with every printed label, by the step"
msgstr "Basılan her etiketle birlikte adım kadar artar"

#: tavletta/ui/variables.py:119
msgid "Next number"
msgstr "Sonraki sayı"

#: tavletta/ui/variables.py:122
msgid "Step"
msgstr "Adım"

#: tavletta/ui/window.py:163
msgid "Templates"
msgstr "Şablonlar"

#: tavletta/ui/window.py:194
msgid "Shipping label…"
msgstr "Gönderi etiketi…"

#: tavletta/ui/window.py:197
msgid "Data for serial labels…"
msgstr "Seri etiket verileri…"

#: tavletta/ui/window.py:198
msgid "Forget allowed data files"
msgstr "İzin verilen veri dosyalarını unut"

#: tavletta/ui/window.py:199
msgid "Export PNG…"
msgstr "PNG olarak dışa aktar…"

#: tavletta/ui/window.py:203
msgid "Report a problem…"
msgstr "Sorun bildir…"

#: tavletta/ui/window.py:204
msgid "About Tavletta"
msgstr "Tavletta Hakkında"

#: tavletta/ui/window.py:683
msgid "Unsaved label"
msgstr "Kaydedilmemiş etiket"

#: tavletta/ui/window.py:842
msgid "content scaled down to fit"
msgstr "içerik sığması için küçültüldü"

#: tavletta/ui/window.py:846
#, python-format
msgid "Problem: %s"
msgstr "Sorun: %s"

#: tavletta/ui/window.py:865
#, python-format
msgid "Too long for this printer: at most %s"
msgstr "Bu yazıcı için çok uzun: en fazla %s"

#: tavletta/ui/window.py:869
#, python-format
msgid "Too wide for this printer: at most %s"
msgstr "Bu yazıcı için çok geniş: en fazla %s"

#: tavletta/ui/window.py:941
msgid "The browser cannot be opened"
msgstr "Tarayıcı açılamıyor"

#: tavletta/ui/window.py:943
msgid "Copy link"
msgstr "Bağlantıyı kopyala"

#: tavletta/ui/window.py:1014
msgid "Only local files can be dropped"
msgstr "Yalnızca yerel dosyalar bırakılabilir"

#: tavletta/ui/window.py:1067
msgid "Please wait until printing has finished"
msgstr "Lütfen yazdırma bitene kadar bekleyin"

#: tavletta/server/config.py:79
#, python-format
msgid "%(file)s: %(key)s: %(problem)s"
msgstr "%(file)s: %(key)s: %(problem)s"

#: tavletta/server/config.py:89 tavletta/server/config.py:93
#: tavletta/server/config.py:99 tavletta/server/main.py:342
#, python-format
msgid "Cannot read %(file)s: %(reason)s"
msgstr "%(file)s okunamıyor: %(reason)s"

#: tavletta/server/config.py:109
msgid "expected a table"
msgstr "tablo bekleniyordu"

#: tavletta/server/config.py:119 tavletta/server/config.py:446
msgid "missing"
msgstr "eksik"

#: tavletta/server/config.py:122
msgid "expected text"
msgstr "metin bekleniyordu"

#: tavletta/server/config.py:124
msgid "control characters are not allowed"
msgstr "denetim karakterlerine izin verilmez"

#: tavletta/server/config.py:130
msgid "expected true or false"
msgstr "true veya false bekleniyordu"

#: tavletta/server/config.py:141
#, python-format
msgid "expected a number from %(min)s to %(max)s"
msgstr "%(min)s ile %(max)s arasında bir sayı bekleniyordu"

#: tavletta/server/config.py:148
#, python-format
msgid "expected one of: %s"
msgstr "şunlardan biri bekleniyordu: %s"

#: tavletta/server/config.py:153 tavletta/server/config.py:159
msgid "unknown key"
msgstr "bilinmeyen anahtar"

#: tavletta/server/config.py:162
msgid "nothing defined"
msgstr "hiçbir şey tanımlanmamış"

#: tavletta/server/config.py:168
msgid "not a valid name: letters, digits, . _ - (up to 64)"
msgstr "geçerli bir ad değil: harfler, rakamlar, . _ - (en fazla 64)"

#: tavletta/server/config.py:209
msgid "only one printer can be the default"
msgstr "yalnızca bir yazıcı varsayılan olabilir"

#: tavletta/server/config.py:223
msgid "not a valid printer address"
msgstr "geçerli bir yazıcı adresi değil"

#: tavletta/server/config.py:245
msgid "this printer model does not cut"
msgstr "bu yazıcı modeli kesmez"

#: tavletta/server/config.py:247
msgid "this printer model has no colour settings"
msgstr "bu yazıcı modelinin renk ayarları yok"

#: tavletta/server/config.py:406
msgid "expected a date such as 2027-12-31"
msgstr "2027-12-31 gibi bir tarih bekleniyordu"

#: tavletta/server/config.py:420
msgid "the same token twice"
msgstr "aynı belirteç iki kez"

#: tavletta/server/config.py:433
#, python-format
msgid "%s can be changed by every user of this computer: chmod 600 it"
msgstr "%s bu bilgisayarın her kullanıcısı tarafından değiştirilebilir: ona chmod 600 uygulayın"

#: tavletta/server/config.py:443
msgid "not a token hash: expected sha256:… or scrypt:…"
msgstr "belirteç karması değil: sha256:… veya scrypt:… bekleniyordu"

#: tavletta/server/config.py:469
msgid "expected a list of printer names"
msgstr "yazıcı adlarından oluşan bir liste bekleniyordu"

#: tavletta/server/config.py:471
msgid "printers can only be limited with --printers"
msgstr "yazıcılar yalnızca --printers ile sınırlandırılabilir"

#: tavletta/server/config.py:473 tavletta/server/service.py:470
#, python-format
msgid "Unknown printer: %s"
msgstr "Bilinmeyen yazıcı: %s"

#: tavletta/server/errors.py:29
#, python-format
msgid "Invalid value for %s"
msgstr "%s için geçersiz değer"

#: tavletta/server/http.py:464 tavletta/server/http.py:513
msgid "The request took too long"
msgstr "İstek çok uzun sürdü"

#: tavletta/server/http.py:473 tavletta/server/service.py:1184
msgid "The server is busy – try again later"
msgstr "Sunucu meşgul – daha sonra yeniden deneyin"

#: tavletta/server/http.py:516
msgid "Internal error"
msgstr "İç hata"

#: tavletta/server/http.py:521
msgid "This server only answers on its local address"
msgstr "Bu sunucu yalnızca yerel adresinde yanıt verir"

#: tavletta/server/http.py:525
msgid "Requests from this web page are not allowed"
msgstr "Bu web sayfasından gelen isteklere izin verilmiyor"

#: tavletta/server/http.py:543
msgid "Too many requests – try again later"
msgstr "Çok fazla istek – daha sonra yeniden deneyin"

#: tavletta/server/http.py:545
msgid "Access token missing or wrong"
msgstr "Erişim belirteci eksik veya yanlış"

#: tavletta/server/http.py:586 tavletta/server/http.py:591
msgid "The request needs a Content-Length"
msgstr "İstek bir Content-Length gerektiriyor"

#: tavletta/server/http.py:588
msgid "The request has more than one Content-Length"
msgstr "İstekte birden fazla Content-Length var"

#: tavletta/server/http.py:594
msgid "The request is too large"
msgstr "İstek çok büyük"

#: tavletta/server/http.py:599
msgid "The request body is incomplete"
msgstr "İstek gövdesi eksik"

#: tavletta/server/http.py:606
msgid "Send the request as application/json"
msgstr "İsteği application/json olarak gönderin"

#: tavletta/server/http.py:635 tavletta/server/http.py:645
msgid "Not found"
msgstr "Bulunamadı"

#: tavletta/server/http.py:644
msgid "Method not allowed"
msgstr "Yönteme izin verilmiyor"

#: tavletta/server/http.py:661
#, python-format
msgid "Send the header %s with this request"
msgstr "Bu istekle birlikte %s başlığını gönderin"

#: tavletta/server/http.py:805
msgid "The request is not valid JSON"
msgstr "İstek geçerli bir JSON değil"

#: tavletta/server/main.py:35
#, python-format
msgid "The labels folder %s does not exist"
msgstr "%s etiket klasörü mevcut değil"

#: tavletta/server/main.py:48
#, python-format
msgid "Cannot read the token file %s"
msgstr "%s belirteç dosyası okunamıyor"

#: tavletta/server/main.py:54 tavletta/server/main.py:313
msgid ""
"The access token may only contain printable ASCII characters without spaces"
msgstr "Erişim belirteci yalnızca boşluksuz, yazdırılabilir ASCII karakterleri içerebilir"

#: tavletta/server/main.py:59 tavletta/server/main.py:318
#, python-format
msgid "The access token must be at least %d characters long"
msgstr "Erişim belirteci en az %d karakter uzunluğunda olmalıdır"

#: tavletta/server/main.py:75
msgid "Use either --printers or --allow-printer"
msgstr "Ya --printers ya da --allow-printer kullanın"

#: tavletta/server/main.py:77
msgid "Use either --tokens or --token-file"
msgstr "Ya --tokens ya da --token-file kullanın"

#: tavletta/server/main.py:91
#, python-format
msgid "Not a valid printer address pattern: %s"
msgstr "Geçerli bir yazıcı adresi kalıbı değil: %s"

#: tavletta/server/main.py:117
#, python-format
msgid ""
"Refusing to listen on %s without an access token: set TAVLETTA_TOKEN or use "
"--token-file"
msgstr "Erişim belirteci olmadan %s üzerinde dinleme reddediliyor: TAVLETTA_TOKEN ayarlayın veya --token-file kullanın"

#: tavletta/server/main.py:140
#, python-format
msgid "Cannot listen on %(address)s: %(reason)s"
msgstr "%(address)s üzerinde dinlenemiyor: %(reason)s"

#: tavletta/server/main.py:272
msgid "Not a valid name: letters, digits, . _ - (up to 64)"
msgstr "Geçerli bir ad değil: harfler, rakamlar, . _ - (en fazla 64)"

#: tavletta/server/main.py:283
#, python-format
msgid "%s is in use by another program – try again later"
msgstr "%s başka bir program tarafından kullanılıyor – daha sonra yeniden deneyin"

#: tavletta/server/main.py:290
#, python-format
msgid "The token %(name)s was added to %(file)s."
msgstr "%(name)s belirteci %(file)s dosyasına eklendi."

#: tavletta/server/main.py:297
#, python-format
msgid "The token is shown only this once; %s keeps only its hash."
msgstr "Belirteç yalnızca bu kez gösterilir; %s yalnızca karmasını saklar."

#: tavletta/server/main.py:308
msgid "Access token: "
msgstr "Erişim belirteci: "

#: tavletta/server/main.py:323
msgid "A chosen token must not look like a made one (etk_…)"
msgstr "Seçilen belirteç, oluşturulmuş bir belirtece benzememelidir (etk_…)"

#: tavletta/server/main.py:367
#, python-format
msgid "A token named %s exists already"
msgstr "%s adlı bir belirteç zaten var"

#: tavletta/server/main.py:394
#, python-format
msgid "This token is in the file already, as %s"
msgstr "Bu belirteç dosyada zaten %s adıyla var"

#: tavletta/server/paths.py:39
#, python-format
msgid "No such label: %s"
msgstr "Böyle bir etiket yok: %s"

#: tavletta/server/paths.py:46
#, python-format
msgid "No such data file: %s"
msgstr "Böyle bir veri dosyası yok: %s"

#: tavletta/server/requests.py:95
msgid "The request must be a JSON object"
msgstr "İstek bir JSON nesnesi olmalıdır"

#: tavletta/server/requests.py:97
#, python-format
msgid "Unknown field: %s"
msgstr "Bilinmeyen alan: %s"

#: tavletta/server/requests.py:104
msgid "Give the label either by name or as content"
msgstr "Etiketi ya adıyla ya da içerik olarak verin"

#: tavletta/server/requests.py:109
msgid "Give data rows or a data file, not both"
msgstr "Veri satırları ya da bir veri dosyası verin, ikisini birden değil"

#: tavletta/server/requests.py:196
#, python-format
msgid "Too many data rows: at most %d"
msgstr "Çok fazla veri satırı: en fazla %d"

#: tavletta/server/requests.py:204
#, python-format
msgid "Too many columns: at most %d"
msgstr "Çok fazla sütun: en fazla %d"

#: tavletta/server/requests.py:207
#, python-format
msgid "Too many cells: at most %d"
msgstr "Çok fazla hücre: en fazla %d"

#: tavletta/server/service.py:482
msgid "Choose a printer by its name"
msgstr "Bir yazıcıyı adıyla seçin"

#: tavletta/server/service.py:546 tavletta/server/service.py:1163
msgid "This access token may not do this"
msgstr "Bu erişim belirtecinin buna izni yok"

#: tavletta/server/service.py:594
msgid "No printer address: give it as host"
msgstr "Yazıcı adresi yok: host olarak verin"

#: tavletta/server/service.py:603
#, python-format
msgid "This printer address is not allowed: %s"
msgstr "Bu yazıcı adresine izin verilmiyor: %s"

#: tavletta/server/service.py:698
msgid "Document pages in label_content are not allowed (--allow-pdf-pages)"
msgstr "label_content içinde belge sayfalarına izin verilmez (--allow-pdf-pages)"

#: tavletta/server/service.py:782
msgid "A sheet needs a data file"
msgstr "Sayfa için bir veri dosyası gerekir"

#: tavletta/server/service.py:788
msgid ""
"The label uses a data file outside the labels folder: send its rows along"
msgstr "Etiket, etiket klasörünün dışındaki bir veri dosyasını kullanıyor: satırlarını da gönderin"

#: tavletta/server/service.py:922
#, python-format
msgid "At most %d labels in one print job"
msgstr "Bir yazdırma işinde en fazla %d etiket"

#: tavletta/server/service.py:949
msgid "Too many print jobs are waiting – try again later"
msgstr "Çok fazla yazdırma işi bekliyor – daha sonra yeniden deneyin"

#: tavletta/server/service.py:1144
#, python-format
msgid "No such print job: %s"
msgstr "Böyle bir yazdırma işi yok: %s"

#: tavletta/server/service.py:1156
msgid "The print job has already finished"
msgstr "Yazdırma işi zaten tamamlandı"

#: tavletta/server/service.py:1188
msgid "The label is too large to render"
msgstr "Etiket işlenemeyecek kadar büyük"

#: tavletta/server/service.py:1202
#, python-format
msgid "The label is too large: at most %d images and codes"
msgstr "Etiket çok büyük: en fazla %d görsel ve kod"

#: tavletta/server/service.py:1225
#, python-format
msgid ""
"The label is too large: at most %(elements)d elements and %(chars)d "
"characters in a text"
msgstr "Etiket çok büyük: en fazla %(elements)d öge ve bir metinde en fazla %(chars)d karakter"

#: tavletta/server/service.py:1244
#, python-format
msgid "At most %d copies on this printer"
msgstr "Bu yazıcıda en fazla %d kopya"

#: tavletta/server/service.py:1249
msgid "Printers are chosen by name: leave out host"
msgstr "Yazıcılar adla seçilir: host alanını belirtmeyin"
