#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Kutu ve çerçeve"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Etiket tasarla ve yazdır"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta, Romanşça'da küçük bir tablet anlamına gelir (tavla, yani tahta/levha sözcüğünden). Okunuşu: tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "Tavletta contributors"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Değişkenler için fikirler (sayaç, tarih, UUID), kod içermez"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "Protokol bilgisi"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "%(projects)s ve üreticilerin kılavuzlarından, onların kodu kullanılmadan yeniden yazıldı; bkz. THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE bekleniyordu: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d ile %(max)d arasında bir tam sayı bekleniyordu: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10, 5 veya 7- gibi satırlar bekleniyordu: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Komut olmadan uygulama başlar; verilen etiket dosyaları onda açılır."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "pencere açmadan bir etiket dosyası yazdırır"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Pencere açmadan bir etiket dosyası yazdırır."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "etiket (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "yazıcı modeli, varsayılan olarak etiketinki: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "yazıcı adresi, varsayılan olarak uygulamada ayarlanan adres"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "kopya sayısı"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "NAME öğesinin metni veya {=NAME} değişkeninin değeri; metindeki değişkenler doldurulur; tekrarlanabilir"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set gibi, ancak değer olduğu gibi kullanılır: süslü parantezler değişken değildir"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "etikette kayıtlı olan yerine ilk etiketin sayacı"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "uygulamada en son seçilen kesim, renkler, kalite, ekler (zincirleme baskı, yüksek çözünürlük, bant besleme), yazıcı ayarları ve etiket sayfası dış çizgileri yerine yazıcı modelinin varsayılanlarıyla yazdır; adres ve güvenlik payı kalır"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, also with --printer-defaults"
msgstr "bu ayara sahip bir termal yazıcının yazdırma yöntemi: printer (yazıcıda ayarlandığı gibi), transfer (ribonlu) veya direct (doğrudan termal, ribonsuz); varsayılan olarak uygulamada seçilen, --printer-defaults ile de"

#: tavletta/cli.py:238
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "işlemeden önce yazıcıyı sorgulama (modeli, bandı ve çözünürlüğü)"

#: tavletta/cli.py:244
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "sonraki sayaç değerini etikete kaydetme (salt okunur bir dosya); sonraki yazdırma aynı numaradan başlar"

#: tavletta/cli.py:253
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "seri etiketler: bu CSV, ODS veya XLSX dosyasının her satırı için bir etiket; varsayılan olarak etiketin veri dosyası"

#: tavletta/cli.py:258
msgid "the sheet of the data file, by default the first"
msgstr "veri dosyasının sayfası, varsayılan olarak ilki"

#: tavletta/cli.py:264
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "veri dosyasının yalnızca bu satırları, ör. 3-10, 5 veya 7- (1'den sayılır)"

#: tavletta/cli.py:267
msgid "check and render only, do not print"
msgstr "yalnızca denetle ve oluştur, yazdırma"

#: tavletta/cli.py:273
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "--dry-run ile: her etiketi pencerenin dışa aktardığı biçimde, en fazla 600 dpi olarak PNG kaydeder (- stdout için: yalnızca ilki)"

#: tavletta/cli.py:279
msgid "list the printers found on the network"
msgstr "ağda bulunan yazıcıları listeler"

#: tavletta/cli.py:280
msgid "List the printers found on the network: model, address, name."
msgstr "Ağda bulunan yazıcıları listeler: model, adres, ad."

#: tavletta/cli.py:282
#, python-format
msgid "only this printer model: %s"
msgstr "yalnızca bu yazıcı modeli: %s"

#: tavletta/cli.py:294
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "172.16.0.0/12 gibi bir adres veya ağ bekleniyordu: %s"

#: tavletta/cli.py:304
msgid "the folder with the label files the server may use"
msgstr "sunucunun kullanabileceği etiket dosyalarının bulunduğu klasör"

#: tavletta/cli.py:311
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "yalnızca bu yazıcı adresine yazdır (* her şeyle eşleşir); tekrarlanabilir"

#: tavletta/cli.py:317
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: istemcilerin kullanabileceği yazıcılar, ada göre"

#: tavletta/cli.py:324
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "bir yazdırma işindeki en fazla etiket sayısı, kopya çarpı satır (varsayılan 10000)"

#: tavletta/cli.py:329
msgid "search the network for printers (off by default)"
msgstr "ağda yazıcı ara (varsayılan olarak kapalı)"

#: tavletta/cli.py:335
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "istekle gönderilen etiketlerde belge sayfalarına (PDF, görseller) izin ver; PDF'ler bu durumda sınırlı ayrı bir süreçte çizilir (varsayılan olarak kapalı)"

#: tavletta/cli.py:344
msgid "run a print server with a REST API"
msgstr "REST API ile bir yazdırma sunucusu çalıştırır"

#: tavletta/cli.py:345
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Bir yazdırma sunucusu çalıştırır: bir REST API ve --mcp ile yapay zekâ istemcileri için MCP."

#: tavletta/cli.py:348
msgid "address to listen on (default 127.0.0.1)"
msgstr "dinlenecek adres (varsayılan 127.0.0.1)"

#: tavletta/cli.py:354
#, python-format
msgid "port to listen on (default %d)"
msgstr "dinlenecek bağlantı noktası (varsayılan %d)"

#: tavletta/cli.py:360
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "erişim belirtecini içeren dosya; yoksa TAVLETTA_TOKEN ortam değişkeni"

#: tavletta/cli.py:366
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: rolleri olan adlandırılmış erişim belirteçleri"

#: tavletta/cli.py:368
msgid "also serve MCP at /mcp"
msgstr "MCP'yi /mcp altında da sun"

#: tavletta/cli.py:374
msgid "largest request body in MB (default 4)"
msgstr "MB cinsinden en büyük istek gövdesi (varsayılan 4)"

#: tavletta/cli.py:383
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "X-Forwarded-For üst bilgisi istemciyi bildiren bir ters vekil sunucu, ör. 172.16.0.0/12; tekrarlanabilir"

#: tavletta/cli.py:392
msgid "allow requests from web pages of this origin; repeatable"
msgstr "bu kaynağın web sayfalarından gelen isteklere izin ver; tekrarlanabilir"

#: tavletta/cli.py:397
msgid "serve MCP on standard input and output"
msgstr "MCP'yi standart giriş ve çıkış üzerinden sunar"

#: tavletta/cli.py:399
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP'yi standart giriş ve çıkış üzerinden sunar; Claude Desktop gibi yapay zekâ istemcileri için."

#: tavletta/cli.py:409
msgid "manage the access tokens of the print server"
msgstr "yazdırma sunucusunun erişim belirteçlerini yönetir"

#: tavletta/cli.py:410
msgid "Manage the access tokens of the print server."
msgstr "Yazdırma sunucusunun erişim belirteçlerini yönetir."

#: tavletta/cli.py:415
msgid "make a token and add its hash to tokens.toml"
msgstr "bir belirteç oluşturur ve karmasını tokens.toml dosyasına ekler"

#: tavletta/cli.py:416
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Bir belirteç oluşturur, karmasını tokens.toml dosyasına ekler ve belirteci bir kez gösterir."

#: tavletta/cli.py:418
msgid "name of the token, e.g. the device"
msgstr "belirtecin adı, ör. cihaz"

#: tavletta/cli.py:423
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: yalnızca görüntüleme; print: ayrıca yazdırma; admin: ayrıca tüm işler"

#: tavletta/cli.py:425
msgid "tokens.toml to add it to"
msgstr "eklenecek tokens.toml dosyası"

#: tavletta/cli.py:431
msgid "only this printer of printers.toml; repeatable"
msgstr "printers.toml içinden yalnızca bu yazıcı; tekrarlanabilir"

#: tavletta/cli.py:434
msgid "printers.toml, to check --printer"
msgstr "--printer denetimi için printers.toml"

#: tavletta/cli.py:436
msgid "valid until, e.g. 2027-12-31"
msgstr "geçerlilik sonu, ör. 2027-12-31"

#: tavletta/cli.py:437
msgid "a note for people"
msgstr "insanlar için bir not"

#: tavletta/cli.py:439
msgid "store the hash with scrypt instead of SHA-256"
msgstr "karmayı SHA-256 yerine scrypt ile sakla"

#: tavletta/cli.py:445
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "yeni bir belirteç oluşturmak yerine kendi seçtiğiniz belirteci standart girişten alır (scrypt ile saklanır)"

#: tavletta/cli.py:465 tavletta/server/config.py:220
#: tavletta/server/service.py:531
#, python-format
msgid "Unknown printer model: %s"
msgstr "Bilinmeyen yazıcı modeli: %s"

#: tavletta/cli.py:472 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:655
#: tavletta/server/service.py:679
#, python-format
msgid "Cannot open %s"
msgstr "%s açılamıyor"

#: tavletta/cli.py:494 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bir tarih değil, örneğin 2026-12-31 veya 2026-12-31T08:30 bekleniyordu"

#: tavletta/cli.py:531
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} yazdırırken doldurulur ve ayarlanamaz"

#: tavletta/cli.py:535
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Etikette %s adında bir öğe veya değişken yok"

#: tavletta/cli.py:559 tavletta/ui/printing.py:123
#: tavletta/server/service.py:973
msgid "The label is empty"
msgstr "Etiket boş"

#: tavletta/cli.py:596
msgid "Cannot write the output"
msgstr "Çıktı yazılamıyor"

#: tavletta/cli.py:627
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output PNG görüntüleri yazar: .png ile biten bir ad verin"

#: tavletta/cli.py:652 tavletta/cli.py:861 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:901
#: tavletta/server/service.py:1128 tavletta/server/service.py:1273
msgid "The label cannot be prepared for printing."
msgstr "Etiket yazdırmaya hazırlanamıyor."

#: tavletta/cli.py:739
msgid "No printer found – give its address with --host"
msgstr "Yazıcı bulunamadı – adresini --host ile belirtin"

#: tavletta/cli.py:741
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Birden çok yazıcı bulundu – --host ile birini seçin (tavletta list-printers)"

#: tavletta/cli.py:752 tavletta/ui/texts.py:698 tavletta/server/service.py:1263
#, python-format
msgid "Cannot save %s"
msgstr "%s kaydedilemiyor"

#: tavletta/cli.py:754 tavletta/server/service.py:1266
msgid "the labels were printed, but the next counter value was not saved"
msgstr "etiketler yazdırıldı ancak sonraki sayaç değeri kaydedilmedi"

#: tavletta/cli.py:769 tavletta/server/service.py:1002
msgid "nothing was printed: the next counter value could not be saved"
msgstr "hiçbir şey yazdırılmadı: sonraki sayaç değeri kaydedilemeyecekti"

#: tavletta/cli.py:829 tavletta/cli.py:856 tavletta/cli.py:1217
msgid "Interrupted"
msgstr "Kesildi"

#: tavletta/cli.py:929
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: bu yazıcı modelinin yazdırma yöntemi ayarı yok: %s"

#: tavletta/cli.py:971
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet ve --rows bir veri dosyası gerektirir (--data)"

#: tavletta/cli.py:980 tavletta/ui/printing.py:585
#: tavletta/server/service.py:774
msgid "No rows to print"
msgstr "Yazdırılacak satır yok"

#: tavletta/cli.py:990
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Etiket, klasörünün dışındaki bir veri dosyasını kullanıyor: --data ile belirtin"

#: tavletta/cli.py:1017 tavletta/ui/window.py:849
#: tavletta/server/service.py:827
#, python-format
msgid "No such column: %s"
msgstr "Böyle bir sütun yok: %s"

#: tavletta/cli.py:1022 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Bu satırların barkodu veya QR kodu değerlerinden oluşturulamıyor, örneğin harf içeren bir EAN-13 veya boş bir hücre. Veri dosyasını düzeltip yeniden okuyun ya da bu satırlar olmadan yazdırın."

#: tavletta/cli.py:1027 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Satırlar: %s"

#: tavletta/cli.py:1035
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s dosyasının başka bir yazdırmasının bitmesi bekleniyor…"

#: tavletta/cli.py:1042 tavletta/server/service.py:1122
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s hâlâ başka bir yazdırma tarafından kilitli – daha sonra yeniden deneyin"

#: tavletta/cli.py:1048
msgid "--output needs --dry-run"
msgstr "--output için --dry-run gerekir"

#: tavletta/cli.py:1065
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Sonraki sayaç değeri kaydedilmiyor: sonraki yazdırma numaraları tekrarlar"

#: tavletta/cli.py:1160
msgid "Waiting for the printer's answer…"
msgstr "Yazıcının yanıtı bekleniyor…"

#: tavletta/cli.py:1188 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Yazıcı bulunamadı"

#: tavletta/ui/data.py:91
msgid "Tables (CSV, ODS, XLSX)"
msgstr "Tablolar (CSV, ODS, XLSX)"

#: tavletta/ui/data.py:98
msgid "Choose data file"
msgstr "Veri dosyası seç"

#: tavletta/ui/data.py:108 tavletta/ui/files.py:104 tavletta/ui/files.py:126
#: tavletta/ui/files.py:207 tavletta/ui/texts.py:207
msgid "Only local files can be used"
msgstr "Yalnızca yerel dosyalar kullanılabilir"

#: tavletta/ui/data.py:167
msgid "Tavletta asks again before reading data files outside a label's folder"
msgstr "Tavletta, bir etiketin klasörü dışındaki veri dosyalarını okumadan önce yeniden soracak"

#: tavletta/ui/data.py:179
msgid "Read the data file?"
msgstr "Veri dosyası okunsun mu?"

#: tavletta/ui/data.py:181
#, python-format
msgid ""
"This label uses a data file outside its folder:\n"
"\n"
"%s\n"
"\n"
"Read it only if you know where the label comes from."
msgstr "Bu etiket, klasörünün dışındaki bir veri dosyasını kullanıyor:\n\n%s\n\nYalnızca etiketin nereden geldiğini biliyorsanız okuyun."

#: tavletta/ui/data.py:186
msgid "Not now"
msgstr "Şimdi değil"

#: tavletta/ui/data.py:187
msgid "Read data file"
msgstr "Veri dosyasını oku"

#: tavletta/ui/data.py:265
msgid "Reading…"
msgstr "Okunuyor…"

#: tavletta/ui/data.py:267
msgid "Not read: outside the label's folder"
msgstr "Okunmadı: etiketin klasörünün dışında"

#: tavletta/ui/data.py:270
#, python-format
msgid "Rows: %(rows)d · Columns: %(columns)d"
msgstr "Satır: %(rows)d · Sütun: %(columns)d"

#: tavletta/ui/data.py:281 tavletta/ui/shortcuts.py:71
msgid "Serial labels"
msgstr "Seri etiketler"

#: tavletta/ui/data.py:283
msgid ""
"One label for each row of a table. Insert columns into texts and codes; each "
"label shows the values of its row."
msgstr "Bir tablonun her satırı için bir etiket. Metinlere ve kodlara sütun ekleyin; her etiket kendi satırının değerlerini gösterir."

#: tavletta/ui/data.py:290
msgid "No data file"
msgstr "Veri dosyası yok"

#: tavletta/ui/data.py:290
msgid "CSV, ODS or XLSX"
msgstr "CSV, ODS veya XLSX"

#: tavletta/ui/data.py:291 tavletta/ui/elements.py:316
#: tavletta/ui/elements.py:334 tavletta/ui/elements.py:347
msgid "Choose…"
msgstr "Seç…"

#: tavletta/ui/data.py:304
msgid "Columns"
msgstr "Sütunlar"

#: tavletta/ui/data.py:320
msgid "Read again"
msgstr "Yeniden oku"

#: tavletta/ui/data.py:324
msgid "Choose another file"
msgstr "Başka bir dosya seç"

#: tavletta/ui/data.py:326
msgid "Remove data file"
msgstr "Veri dosyasını kaldır"

#: tavletta/ui/data.py:337
msgid "Sheet"
msgstr "Sayfa"

#: tavletta/ui/data.py:357
msgid "Insert column"
msgstr "Sütun ekle"

#: tavletta/ui/elements.py:83 tavletta/ui/shortcuts.py:57
msgid "Content"
msgstr "İçerik"

#: tavletta/ui/elements.py:93
msgid "No content yet"
msgstr "Henüz içerik yok"

#: tavletta/ui/elements.py:93
msgid "Add text, an image, a symbol or a code"
msgstr "Metin, görüntü, sembol veya kod ekleyin"

#: tavletta/ui/elements.py:104 tavletta/ui/texts.py:258
#: tavletta/ui/window.py:961
msgid "Text"
msgstr "Metin"

#: tavletta/ui/elements.py:105
msgid "Image…"
msgstr "Görüntü…"

#: tavletta/ui/elements.py:106
msgid "Symbol…"
msgstr "Sembol…"

#: tavletta/ui/elements.py:107
msgid "QR code / barcode"
msgstr "QR kodu / barkod"

#: tavletta/ui/elements.py:108
msgid "Line or shape"
msgstr "Çizgi veya şekil"

#: tavletta/ui/elements.py:110
msgid "Add"
msgstr "Ekle"

#: tavletta/ui/elements.py:204 tavletta/ui/label_group.py:145
msgid "Remove"
msgstr "Kaldır"

#: tavletta/ui/elements.py:207
