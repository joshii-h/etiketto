#: etiketto/app.py:136 etiketto/cli.py:163
msgid "Design and print labels"
msgstr "Etiket tasarla ve yazdır"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "Etiketto contributors"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE bekleniyordu: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "%(min)d ile %(max)d arasında bir tam sayı bekleniyordu: %(value)s"

#: etiketto/cli.py:157
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "3-10, 5 veya 7- gibi satırlar bekleniyordu: %s"

#: etiketto/cli.py:164
msgid "Without a command the application starts; label files given open in it."
msgstr "Komut olmadan uygulama başlar; verilen etiket dosyaları onda açılır."

#: etiketto/cli.py:170
msgid "print a label file without opening a window"
msgstr "pencere açmadan bir etiket dosyası yazdırır"

#: etiketto/cli.py:171
msgid "Print a label file without opening a window."
msgstr "Pencere açmadan bir etiket dosyası yazdırır."

#: etiketto/cli.py:173
msgid "the label (.etiketto)"
msgstr "etiket (.etiketto)"

#: etiketto/cli.py:176
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "yazıcı modeli, varsayılan olarak etiketinki: %s"

#: etiketto/cli.py:179
msgid "printer address, by default the one set in the app"
msgstr "yazıcı adresi, varsayılan olarak uygulamada ayarlanan adres"

#: etiketto/cli.py:182
msgid "number of copies"
msgstr "kopya sayısı"

#: etiketto/cli.py:192
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "NAME öğesinin metni veya {=NAME} değişkeninin değeri; metindeki değişkenler doldurulur; tekrarlanabilir"

#: etiketto/cli.py:202
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "--set gibi, ancak değer olduğu gibi kullanılır: süslü parantezler değişken değildir"

#: etiketto/cli.py:208
msgid "counter of the first label, instead of the one saved in the label"
msgstr "etikette kayıtlı olan yerine ilk etiketin sayacı"

#: etiketto/cli.py:214
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "sonraki sayaç değerini etikete kaydetme (salt okunur bir dosya); sonraki yazdırma aynı numaradan başlar"

#: etiketto/cli.py:223
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "seri etiketler: bu CSV, ODS veya XLSX dosyasının her satırı için bir etiket; varsayılan olarak etiketin veri dosyası"

#: etiketto/cli.py:228
msgid "the sheet of the data file, by default the first"
msgstr "veri dosyasının sayfası, varsayılan olarak ilki"

#: etiketto/cli.py:234
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "veri dosyasının yalnızca bu satırları, ör. 3-10, 5 veya 7- (1'den sayılır)"

#: etiketto/cli.py:237
msgid "check and render only, do not print"
msgstr "yalnızca denetle ve oluştur, yazdırma"

#: etiketto/cli.py:243
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "--dry-run ile: görüntüleri yazıcının alacağı biçimde PNG olarak kaydeder (- stdout için: yalnızca ilki)"

#: etiketto/cli.py:249
msgid "list the printers found on the network"
msgstr "ağda bulunan yazıcıları listeler"

#: etiketto/cli.py:250
msgid "List the printers found on the network: model, address, name."
msgstr "Ağda bulunan yazıcıları listeler: model, adres, ad."

#: etiketto/cli.py:252
#, python-format
msgid "only this printer model: %s"
msgstr "yalnızca bu yazıcı modeli: %s"

#: etiketto/cli.py:264
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "172.16.0.0/12 gibi bir adres veya ağ bekleniyordu: %s"

#: etiketto/cli.py:274
msgid "the folder with the label files the server may use"
msgstr "sunucunun kullanabileceği etiket dosyalarının bulunduğu klasör"

#: etiketto/cli.py:281
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "yalnızca bu yazıcı adresine yazdır (* her şeyle eşleşir); tekrarlanabilir"

#: etiketto/cli.py:287
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: istemcilerin kullanabileceği yazıcılar, ada göre"

#: etiketto/cli.py:294
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "bir yazdırma işindeki en fazla etiket sayısı, kopya çarpı satır (varsayılan 10000)"

#: etiketto/cli.py:299
msgid "search the network for printers (off by default)"
msgstr "ağda yazıcı ara (varsayılan olarak kapalı)"

#: etiketto/cli.py:306
msgid "run a print server with a REST API"
msgstr "REST API ile bir yazdırma sunucusu çalıştırır"

#: etiketto/cli.py:307
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Bir yazdırma sunucusu çalıştırır: bir REST API ve --mcp ile yapay zekâ istemcileri için MCP."

#: etiketto/cli.py:310
msgid "address to listen on (default 127.0.0.1)"
msgstr "dinlenecek adres (varsayılan 127.0.0.1)"

#: etiketto/cli.py:316
#, python-format
msgid "port to listen on (default %d)"
msgstr "dinlenecek bağlantı noktası (varsayılan %d)"

#: etiketto/cli.py:322
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "erişim belirtecini içeren dosya; yoksa ETIKETTO_TOKEN ortam değişkeni"

#: etiketto/cli.py:328
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: rolleri olan adlandırılmış erişim belirteçleri"

#: etiketto/cli.py:330
msgid "also serve MCP at /mcp"
msgstr "MCP'yi /mcp altında da sun"

#: etiketto/cli.py:336
msgid "largest request body in MB (default 4)"
msgstr "MB cinsinden en büyük istek gövdesi (varsayılan 4)"

#: etiketto/cli.py:345
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "X-Forwarded-For üst bilgisi istemciyi bildiren bir ters vekil sunucu, ör. 172.16.0.0/12; tekrarlanabilir"

#: etiketto/cli.py:354
msgid "allow requests from web pages of this origin; repeatable"
msgstr "bu kaynağın web sayfalarından gelen isteklere izin ver; tekrarlanabilir"

#: etiketto/cli.py:359
msgid "serve MCP on standard input and output"
msgstr "MCP'yi standart giriş ve çıkış üzerinden sunar"

#: etiketto/cli.py:361
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP'yi standart giriş ve çıkış üzerinden sunar; Claude Desktop gibi yapay zekâ istemcileri için."

#: etiketto/cli.py:371
msgid "manage the access tokens of the print server"
msgstr "yazdırma sunucusunun erişim belirteçlerini yönetir"

#: etiketto/cli.py:372
msgid "Manage the access tokens of the print server."
msgstr "Yazdırma sunucusunun erişim belirteçlerini yönetir."

#: etiketto/cli.py:377
msgid "make a token and add its hash to tokens.toml"
msgstr "bir belirteç oluşturur ve karmasını tokens.toml dosyasına ekler"

#: etiketto/cli.py:378
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Bir belirteç oluşturur, karmasını tokens.toml dosyasına ekler ve belirteci bir kez gösterir."

#: etiketto/cli.py:380
msgid "name of the token, e.g. the device"
msgstr "belirtecin adı, ör. cihaz"

#: etiketto/cli.py:385
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: yalnızca görüntüleme; print: ayrıca yazdırma; admin: ayrıca tüm işler"

#: etiketto/cli.py:387
msgid "tokens.toml to add it to"
msgstr "eklenecek tokens.toml dosyası"

#: etiketto/cli.py:393
msgid "only this printer of printers.toml; repeatable"
msgstr "printers.toml içinden yalnızca bu yazıcı; tekrarlanabilir"

#: etiketto/cli.py:396
msgid "printers.toml, to check --printer"
msgstr "--printer denetimi için printers.toml"

#: etiketto/cli.py:398
msgid "valid until, e.g. 2027-12-31"
msgstr "geçerlilik sonu, ör. 2027-12-31"

#: etiketto/cli.py:399
msgid "a note for people"
msgstr "insanlar için bir not"

#: etiketto/cli.py:401
msgid "store the hash with scrypt instead of SHA-256"
msgstr "karmayı SHA-256 yerine scrypt ile sakla"

#: etiketto/cli.py:407
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "yeni bir belirteç oluşturmak yerine kendi seçtiğiniz belirteci standart girişten alır (scrypt ile saklanır)"

#: etiketto/cli.py:427 etiketto/server/config.py:216
#: etiketto/server/service.py:522
#, python-format
msgid "Unknown printer model: %s"
msgstr "Bilinmeyen yazıcı modeli: %s"

#: etiketto/cli.py:434 etiketto/ui/files.py:66 etiketto/ui/texts.py:242
#: etiketto/server/service.py:670
#, python-format
msgid "Cannot open %s"
msgstr "%s açılamıyor"

#: etiketto/cli.py:456 etiketto/server/main.py:259
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s bir tarih değil, örneğin 2026-12-31 veya 2026-12-31T08:30 bekleniyordu"

#: etiketto/cli.py:493
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} yazdırırken doldurulur ve ayarlanamaz"

#: etiketto/cli.py:497
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Etikette %s adında bir öğe veya değişken yok"

#: etiketto/cli.py:521 etiketto/ui/printing.py:103
#: etiketto/server/service.py:956
msgid "The label is empty"
msgstr "Etiket boş"

#: etiketto/cli.py:554
msgid "Cannot write the output"
msgstr "Çıktı yazılamıyor"

#: etiketto/cli.py:585
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output PNG görüntüleri yazar: .png ile biten bir ad verin"

#: etiketto/cli.py:621 etiketto/cli.py:655 etiketto/cli.py:774
#: etiketto/cli.py:802 etiketto/ui/printing.py:345 etiketto/ui/printing.py:483
#: etiketto/server/service.py:884 etiketto/server/service.py:1105
#: etiketto/server/service.py:1250
msgid "The label cannot be prepared for printing."
msgstr "Etiket yazdırmaya hazırlanamıyor."

#: etiketto/cli.py:682
msgid "No printer found – give its address with --host"
msgstr "Yazıcı bulunamadı – adresini --host ile belirtin"

#: etiketto/cli.py:684
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Birden çok yazıcı bulundu – --host ile birini seçin (etiketto list-printers)"

#: etiketto/cli.py:695 etiketto/ui/texts.py:276 etiketto/server/service.py:1240
#, python-format
msgid "Cannot save %s"
msgstr "%s kaydedilemiyor"

#: etiketto/cli.py:697 etiketto/server/service.py:1243
msgid "the labels were printed, but the next counter value was not saved"
msgstr "etiketler yazdırıldı ancak sonraki sayaç değeri kaydedilmedi"

#: etiketto/cli.py:712 etiketto/server/service.py:980
msgid "nothing was printed: the next counter value could not be saved"
msgstr "hiçbir şey yazdırılmadı: sonraki sayaç değeri kaydedilemeyecekti"

#: etiketto/cli.py:772 etiketto/cli.py:799 etiketto/cli.py:1010
msgid "Interrupted"
msgstr "Kesildi"

#: etiketto/cli.py:874
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet ve --rows bir veri dosyası gerektirir (--data)"

#: etiketto/cli.py:883 etiketto/ui/printing.py:361
#: etiketto/server/service.py:757
msgid "No rows to print"
msgstr "Yazdırılacak satır yok"

#: etiketto/cli.py:893
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Etiket, klasörünün dışındaki bir veri dosyasını kullanıyor: --data ile belirtin"

#: etiketto/cli.py:914 etiketto/ui/window.py:395 etiketto/server/service.py:810
#, python-format
msgid "No such column: %s"
msgstr "Böyle bir sütun yok: %s"

#: etiketto/cli.py:919 etiketto/ui/printing.py:434
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Bu satırların barkodu veya QR kodu değerlerinden oluşturulamıyor, örneğin harf içeren bir EAN-13 veya boş bir hücre. Veri dosyasını düzeltip yeniden okuyun ya da bu satırlar olmadan yazdırın."

#: etiketto/cli.py:924 etiketto/ui/printing.py:439
#, python-format
msgid "Rows: %s"
msgstr "Satırlar: %s"

#: etiketto/cli.py:932
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "%s dosyasının başka bir yazdırmasının bitmesi bekleniyor…"

#: etiketto/cli.py:939 etiketto/server/service.py:1099
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s hâlâ başka bir yazdırma tarafından kilitli – daha sonra yeniden deneyin"

#: etiketto/cli.py:945
msgid "--output needs --dry-run"
msgstr "--output için --dry-run gerekir"

#: etiketto/cli.py:954
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Sonraki sayaç değeri kaydedilmiyor: sonraki yazdırma numaraları tekrarlar"

#: etiketto/cli.py:981 etiketto/ui/printer.py:161
msgid "No printer found"
msgstr "Yazıcı bulunamadı"

