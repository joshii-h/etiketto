msgstr "%s lässt sich nicht speichern: keine Schreibrechte"

#: etiketto/ui/texts.py:265
#, python-format
msgid "Cannot save %s: the disk is full"
msgstr "%s lässt sich nicht speichern: der Datenträger ist voll"

#: etiketto/ui/texts.py:266
#, python-format
msgid "Cannot save %s"
msgstr "%s lässt sich nicht speichern"

#: etiketto/ui/texts.py:275
#, python-format
msgid ""
"This cassette seems to be from %(month)s %(year)d. Old ZINK paper prints "
"paler colours."
msgstr "Diese Kassette stammt vermutlich von %(month)s %(year)d. Altes ZINK-Papier druckt blassere Farben."

