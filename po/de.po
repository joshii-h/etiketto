#: tavletta/app.py:143 tavletta/ui/styles.py:183
msgid "Box and frame"
msgstr "Kasten und Rahmen"

#: tavletta/app.py:217 tavletta/cli.py:170
msgid "Design and print labels"
msgstr "Etiketten gestalten und drucken"

#: tavletta/app.py:220
msgid ""
"Tavletta is Romansh for a small tablet (from tavla, table/board). Pronounced "
"tav-LET-ta."
msgstr "Tavletta ist rätoromanisch für „Täfelchen“ (von tavla, Tafel). Gesprochen tav-LET-ta."

#. translators: replace with your name to be credited in the About dialog
#: tavletta/app.py:226
msgid "translator-credits"
msgstr "joshii-h"

#: tavletta/app.py:234
msgid "Ideas for the variables (counter, date, UUID), no code"
msgstr "Ideen für die Variablen (Zähler, Datum, UUID), kein Code"

#: tavletta/app.py:237
msgid "Protocol knowledge"
msgstr "Protokollwissen"

#: tavletta/app.py:242
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Aus %(projects)s und den Handbüchern der Hersteller, neu geschrieben ohne deren Code; siehe THIRD_PARTY_NOTICES.md"

#: tavletta/cli.py:115
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE erwartet: %s"

#: tavletta/cli.py:131
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ganze Zahl von %(min)d bis %(max)d erwartet: %(value)s"

#: tavletta/cli.py:164
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "Zeilen wie 3-10, 5 oder 7- erwartet: %s"

#: tavletta/cli.py:171
msgid "Without a command the application starts; label files given open in it."
msgstr "Ohne Befehl startet die App; angegebene Etikettendateien werden darin geöffnet."

#: tavletta/cli.py:177
msgid "print a label file without opening a window"
msgstr "eine Etikettendatei drucken, ohne ein Fenster zu öffnen"

#: tavletta/cli.py:178
msgid "Print a label file without opening a window."
msgstr "Eine Etikettendatei drucken, ohne ein Fenster zu öffnen."

#: tavletta/cli.py:180
msgid "the label (.tavletta)"
msgstr "das Etikett (.tavletta)"

#: tavletta/cli.py:183
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "Druckermodell, sonst das des Etiketts: %s"

#: tavletta/cli.py:186
msgid "printer address, by default the one set in the app"
msgstr "Adresse des Druckers, sonst die in der App eingestellte"

#: tavletta/cli.py:189
msgid "number of copies"
msgstr "Anzahl Exemplare"

#: tavletta/cli.py:199
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "Text des Elements NAME oder Wert der Variable {=NAME}; Variablen in einem Text werden eingesetzt; mehrfach möglich"

#: tavletta/cli.py:209
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "wie --set, aber der Wert wird unverändert verwendet: Klammern sind keine Variablen"

#: tavletta/cli.py:215
msgid "counter of the first label, instead of the one saved in the label"
msgstr "Zähler des ersten Etiketts, statt des im Etikett gespeicherten"

#: tavletta/cli.py:221
msgid ""
"print with the printer model's defaults instead of the cut, colours, "
"quality, extras (chain printing, high resolution, tape feed), printer "
"settings and label sheet outlines last chosen in the app; the address and "
"the safety margin stay"
msgstr "mit den Standardwerten des Druckermodells drucken statt mit Schnitt, Farben, Qualität, Extras (Kettendruck, hohe Auflösung, Bandvorschub), Druckereinstellungen und Umrissen auf Etikettenbögen, die zuletzt in der App gewählt wurden; Adresse und Sicherheitsabstand bleiben"

#: tavletta/cli.py:230
msgid ""
"print method of a thermal printer that has the setting: printer (as set on "
"the printer), transfer (with a ribbon) or direct (thermal direct, no "
"ribbon); by default the one chosen in the app, with --printer-defaults the "
"one set on the printer"
msgstr "Druckverfahren eines Thermodruckers, der diese Einstellung hat: printer (wie am Drucker eingestellt), transfer (mit Farbband) oder direct (Thermodirekt, ohne Farbband); standardmässig das in der App gewählte, mit --printer-defaults das am Drucker eingestellte"

#: tavletta/cli.py:239
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "den Drucker vor dem Rendern nicht abfragen (Modell, Band und Auflösung)"

#: tavletta/cli.py:245
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "den nächsten Zählerstand nicht im Etikett speichern (eine schreibgeschützte Datei); der nächste Druck beginnt mit derselben Nummer"

#: tavletta/cli.py:254
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "Serienetiketten: ein Etikett für jede Zeile dieser CSV-, ODS- oder XLSX-Datei; sonst die Datendatei des Etiketts"

#: tavletta/cli.py:259
msgid "the sheet of the data file, by default the first"
msgstr "das Blatt der Datendatei, sonst das erste"

#: tavletta/cli.py:265
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "nur diese Zeilen der Datendatei, z. B. 3-10, 5 oder 7- (ab 1 gezählt)"

#: tavletta/cli.py:268
msgid "check and render only, do not print"
msgstr "nur prüfen und zeichnen, nicht drucken"

#: tavletta/cli.py:274
msgid ""
"with --dry-run: save each label as PNG as the window exports it, at most 600 "
"dpi (- for stdout: the first only)"
msgstr "mit --dry-run: jedes Etikett als PNG so speichern, wie das Fenster es exportiert, mit höchstens 600 dpi (- für stdout: nur das erste)"

#: tavletta/cli.py:280
msgid "list the printers found on the network"
msgstr "die im Netzwerk gefundenen Drucker auflisten"

#: tavletta/cli.py:281
msgid "List the printers found on the network: model, address, name."
msgstr "Die im Netzwerk gefundenen Drucker auflisten: Modell, Adresse, Name."

#: tavletta/cli.py:283
#, python-format
msgid "only this printer model: %s"
msgstr "nur dieses Druckermodell: %s"

#: tavletta/cli.py:295
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "Adresse oder Netz wie 172.16.0.0/12 erwartet: %s"

#: tavletta/cli.py:305
msgid "the folder with the label files the server may use"
msgstr "der Ordner mit den Etikettendateien, die der Server verwenden darf"

#: tavletta/cli.py:312
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "nur auf dieser Druckeradresse drucken (* passt auf alles); wiederholbar"

#: tavletta/cli.py:318
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: die Drucker, die Clients mit Namen verwenden dürfen"

#: tavletta/cli.py:325
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "höchstens so viele Etiketten in einem Druckauftrag, Exemplare mal Zeilen (Standard 10000)"

#: tavletta/cli.py:330
msgid "search the network for printers (off by default)"
msgstr "im Netzwerk nach Druckern suchen (sonst aus)"

#: tavletta/cli.py:336
msgid ""
"allow document pages (PDF, images) in labels sent with the request; PDFs are "
"then drawn in a separate process with limits (off by default)"
msgstr "Dokumentseiten (PDF, Bilder) in mitgeschickten Etiketten erlauben; PDFs werden dann in einem eigenen Prozess mit Grenzen gezeichnet (standardmässig aus)"

#: tavletta/cli.py:345
msgid "run a print server with a REST API"
msgstr "einen Druckserver mit REST API starten"

#: tavletta/cli.py:346
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Einen Druckserver starten: eine REST API und mit --mcp MCP für KI-Clients."

#: tavletta/cli.py:349
msgid "address to listen on (default 127.0.0.1)"
msgstr "Adresse, auf der gelauscht wird (Standard 127.0.0.1)"

#: tavletta/cli.py:355
#, python-format
msgid "port to listen on (default %d)"
msgstr "Port, auf dem gelauscht wird (Standard %d)"

#: tavletta/cli.py:361
msgid ""
"file with the access token; else the environment variable TAVLETTA_TOKEN"
msgstr "Datei mit dem Zugangstoken; sonst die Umgebungsvariable TAVLETTA_TOKEN"

#: tavletta/cli.py:367
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: benannte Zugangstoken mit Rollen"

#: tavletta/cli.py:369
msgid "also serve MCP at /mcp"
msgstr "zusätzlich MCP unter /mcp anbieten"

#: tavletta/cli.py:375
msgid "largest request body in MB (default 4)"
msgstr "grösster Anfrageinhalt in MB (Standard 4)"

#: tavletta/cli.py:384
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "ein Reverse Proxy, dessen Header X-Forwarded-For den Client nennt, zum Beispiel 172.16.0.0/12; wiederholbar"

#: tavletta/cli.py:393
msgid "allow requests from web pages of this origin; repeatable"
msgstr "Anfragen von Webseiten dieses Ursprungs erlauben; wiederholbar"

#: tavletta/cli.py:398
msgid "serve MCP on standard input and output"
msgstr "MCP über Standardein- und -ausgabe anbieten"

#: tavletta/cli.py:400
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP über Standardein- und -ausgabe anbieten, für KI-Clients wie Claude Desktop."

#: tavletta/cli.py:410
msgid "manage the access tokens of the print server"
msgstr "die Zugangstoken des Druckservers verwalten"

#: tavletta/cli.py:411
msgid "Manage the access tokens of the print server."
msgstr "Die Zugangstoken des Druckservers verwalten."

#: tavletta/cli.py:416
msgid "make a token and add its hash to tokens.toml"
msgstr "ein Token erstellen und seinen Hash in tokens.toml eintragen"

#: tavletta/cli.py:417
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Ein Token erstellen, seinen Hash in tokens.toml eintragen und das Token einmal zeigen."

#: tavletta/cli.py:419
msgid "name of the token, e.g. the device"
msgstr "Name des Tokens, zum Beispiel das Gerät"

#: tavletta/cli.py:424
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: nur ansehen; print: auch drucken; admin: auch alle Aufträge"

#: tavletta/cli.py:426
msgid "tokens.toml to add it to"
msgstr "tokens.toml, in die es eingetragen wird"

#: tavletta/cli.py:432
msgid "only this printer of printers.toml; repeatable"
msgstr "nur dieser Drucker aus printers.toml; wiederholbar"

#: tavletta/cli.py:435
msgid "printers.toml, to check --printer"
msgstr "printers.toml, um --printer zu prüfen"

#: tavletta/cli.py:437
msgid "valid until, e.g. 2027-12-31"
msgstr "gültig bis, zum Beispiel 2027-12-31"

#: tavletta/cli.py:438
msgid "a note for people"
msgstr "eine Notiz für Menschen"

#: tavletta/cli.py:440
msgid "store the hash with scrypt instead of SHA-256"
msgstr "den Hash mit scrypt statt SHA-256 speichern"

#: tavletta/cli.py:446
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ein selbst gewähltes Token von der Standardeingabe nehmen (mit scrypt gespeichert), statt eines zu erstellen"

#: tavletta/cli.py:466 tavletta/server/config.py:219
#: tavletta/server/service.py:537
#, python-format
msgid "Unknown printer model: %s"
msgstr "Unbekanntes Druckermodell: %s"

#: tavletta/cli.py:473 tavletta/ui/files.py:84 tavletta/ui/files.py:137
#: tavletta/ui/texts.py:318 tavletta/ui/texts.py:655
#: tavletta/server/service.py:685
#, python-format
msgid "Cannot open %s"
msgstr "%s lässt sich nicht öffnen"

#: tavletta/cli.py:495 tavletta/server/main.py:260
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ist kein Datum, erwartet z. B. 2026-12-31 oder 2026-12-31T08:30"

#: tavletta/cli.py:532
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} wird beim Drucken eingesetzt und kann nicht vorgegeben werden"

#: tavletta/cli.py:536
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Das Etikett hat kein Element und keine Variable namens %s"

#: tavletta/cli.py:562 tavletta/ui/printing.py:123
#: tavletta/server/service.py:1013
msgid "The label is empty"
msgstr "Das Etikett ist leer"

#: tavletta/cli.py:599
msgid "Cannot write the output"
msgstr "Die Ausgabe lässt sich nicht schreiben"

#: tavletta/cli.py:630
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output schreibt PNG-Bilder: einen Namen mit der Endung .png angeben"

#: tavletta/cli.py:655 tavletta/cli.py:864 tavletta/ui/printing.py:553
#: tavletta/ui/printing.py:715 tavletta/server/service.py:918
#: tavletta/server/service.py:941 tavletta/server/service.py:1190
#: tavletta/server/service.py:1335
msgid "The label cannot be prepared for printing."
msgstr "Das Etikett lässt sich nicht für den Druck vorbereiten."

#: tavletta/cli.py:742
msgid "No printer found – give its address with --host"
msgstr "Kein Drucker gefunden – Adresse mit --host angeben"

#: tavletta/cli.py:744
msgid ""
"Several printers found – choose one with --host (tavletta list-printers)"
msgstr "Mehrere Drucker gefunden – einen mit --host wählen (tavletta list-printers)"

#: tavletta/cli.py:755 tavletta/ui/texts.py:698 tavletta/server/service.py:1325
#, python-format
msgid "Cannot save %s"
msgstr "%s lässt sich nicht speichern"

#: tavletta/cli.py:757 tavletta/server/service.py:1328
msgid "the labels were printed, but the next counter value was not saved"
msgstr "die Etiketten wurden gedruckt, aber der nächste Zählerstand wurde nicht gespeichert"

#: tavletta/cli.py:772 tavletta/server/service.py:1042
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nichts gedruckt: der nächste Zählerstand liesse sich nicht speichern"

#: tavletta/cli.py:832 tavletta/cli.py:859 tavletta/cli.py:1220
msgid "Interrupted"
msgstr "Abgebrochen"

#: tavletta/cli.py:932
#, python-format
msgid "--print-method: this printer model has no print method setting: %s"
msgstr "--print-method: Dieses Druckermodell hat keine Einstellung für das Druckverfahren: %s"

#: tavletta/cli.py:974
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet und --rows gehen nur mit einer Datendatei (--data)"

#: tavletta/cli.py:983 tavletta/ui/printing.py:585
#: tavletta/server/service.py:782
msgid "No rows to print"
msgstr "Keine Zeilen zum Drucken"

#: tavletta/cli.py:993
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Das Etikett verwendet eine Datendatei ausserhalb seines Ordners: mit --data angeben"

#: tavletta/cli.py:1020 tavletta/ui/window.py:849
#: tavletta/server/service.py:835
#, python-format
msgid "No such column: %s"
msgstr "Unbekannte Spalte: %s"

#: tavletta/cli.py:1025 tavletta/ui/printing.py:664
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Der Strichcode oder QR-Code dieser Zeilen lässt sich aus ihren Werten nicht erstellen, zum Beispiel ein EAN-13 mit Buchstaben oder eine leere Zelle. Die Datendatei korrigieren und erneut lesen oder ohne diese Zeilen drucken."

#: tavletta/cli.py:1030 tavletta/ui/printing.py:669
#, python-format
msgid "Rows: %s"
msgstr "Zeilen: %s"

#: tavletta/cli.py:1038
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Warten, bis ein anderer Druck von %s fertig ist …"

#: tavletta/cli.py:1045 tavletta/server/service.py:1184
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ist noch von einem anderen Druck gesperrt – später erneut versuchen"

#: tavletta/cli.py:1051
msgid "--output needs --dry-run"
msgstr "--output geht nur mit --dry-run"

#: tavletta/cli.py:1068
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Der nächste Zählerstand wird nicht gespeichert: Der nächste Druck wiederholt die Nummern"

#: tavletta/cli.py:1163
msgid "Waiting for the printer's answer…"
msgstr "Warten auf die Antwort des Druckers …"

#: tavletta/cli.py:1191 tavletta/ui/printer.py:199
msgid "No printer found"
msgstr "Kein Drucker gefunden"

