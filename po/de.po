#: etiketto/app.py:136 etiketto/cli.py:163
msgid "Design and print labels"
msgstr "Etiketten gestalten und drucken"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:141
msgid "translator-credits"
msgstr "joshii-h"

#: etiketto/cli.py:108
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE erwartet: %s"

#: etiketto/cli.py:124
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ganze Zahl von %(min)d bis %(max)d erwartet: %(value)s"

#: etiketto/cli.py:157
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "Zeilen wie 3-10, 5 oder 7- erwartet: %s"

#: etiketto/cli.py:164
msgid "Without a command the application starts; label files given open in it."
msgstr "Ohne Befehl startet die App; angegebene Etikettendateien werden darin geöffnet."

#: etiketto/cli.py:170
msgid "print a label file without opening a window"
msgstr "eine Etikettendatei drucken, ohne ein Fenster zu öffnen"

#: etiketto/cli.py:171
msgid "Print a label file without opening a window."
msgstr "Eine Etikettendatei drucken, ohne ein Fenster zu öffnen."

#: etiketto/cli.py:173
msgid "the label (.etiketto)"
msgstr "das Etikett (.etiketto)"

#: etiketto/cli.py:176
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "Druckermodell, sonst das des Etiketts: %s"

#: etiketto/cli.py:179
msgid "printer address, by default the one set in the app"
msgstr "Adresse des Druckers, sonst die in der App eingestellte"

#: etiketto/cli.py:182
msgid "number of copies"
msgstr "Anzahl Exemplare"

#: etiketto/cli.py:192
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "Text des Elements NAME oder Wert der Variable {=NAME}; Variablen in einem Text werden eingesetzt; mehrfach möglich"

#: etiketto/cli.py:202
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "wie --set, aber der Wert wird unverändert verwendet: Klammern sind keine Variablen"

#: etiketto/cli.py:208
msgid "counter of the first label, instead of the one saved in the label"
msgstr "Zähler des ersten Etiketts, statt des im Etikett gespeicherten"

#: etiketto/cli.py:214
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "den nächsten Zählerstand nicht im Etikett speichern (eine schreibgeschützte Datei); der nächste Druck beginnt mit derselben Nummer"

#: etiketto/cli.py:223
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "Serienetiketten: ein Etikett für jede Zeile dieser CSV-, ODS- oder XLSX-Datei; sonst die Datendatei des Etiketts"

#: etiketto/cli.py:228
msgid "the sheet of the data file, by default the first"
msgstr "das Blatt der Datendatei, sonst das erste"

#: etiketto/cli.py:234
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "nur diese Zeilen der Datendatei, z. B. 3-10, 5 oder 7- (ab 1 gezählt)"

#: etiketto/cli.py:237
msgid "check and render only, do not print"
msgstr "nur prüfen und zeichnen, nicht drucken"

#: etiketto/cli.py:243
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "mit --dry-run: die Bilder als PNG so speichern, wie der Drucker sie bekäme (- für stdout: nur das erste)"

#: etiketto/cli.py:249
msgid "list the printers found on the network"
msgstr "die im Netzwerk gefundenen Drucker auflisten"

#: etiketto/cli.py:250
msgid "List the printers found on the network: model, address, name."
msgstr "Die im Netzwerk gefundenen Drucker auflisten: Modell, Adresse, Name."

#: etiketto/cli.py:252
#, python-format
msgid "only this printer model: %s"
msgstr "nur dieses Druckermodell: %s"

#: etiketto/cli.py:264
#, python-format
msgid "expected an address or network such as 172.16.0.0/12: %s"
msgstr "Adresse oder Netz wie 172.16.0.0/12 erwartet: %s"

#: etiketto/cli.py:274
msgid "the folder with the label files the server may use"
msgstr "der Ordner mit den Etikettendateien, die der Server verwenden darf"

#: etiketto/cli.py:281
msgid "only print on this printer address (* matches anything); repeatable"
msgstr "nur auf dieser Druckeradresse drucken (* passt auf alles); wiederholbar"

#: etiketto/cli.py:287
msgid "printers.toml: the printers clients may use, by name"
msgstr "printers.toml: die Drucker, die Clients mit Namen verwenden dürfen"

#: etiketto/cli.py:294
msgid "most labels in one print job, copies times rows (default 10000)"
msgstr "höchstens so viele Etiketten in einem Druckauftrag, Exemplare mal Zeilen (Standard 10000)"

#: etiketto/cli.py:299
msgid "search the network for printers (off by default)"
msgstr "im Netzwerk nach Druckern suchen (sonst aus)"

#: etiketto/cli.py:306
msgid "run a print server with a REST API"
msgstr "einen Druckserver mit REST API starten"

#: etiketto/cli.py:307
msgid "Run a print server: a REST API and, with --mcp, MCP for AI clients."
msgstr "Einen Druckserver starten: eine REST API und mit --mcp MCP für KI-Clients."

#: etiketto/cli.py:310
msgid "address to listen on (default 127.0.0.1)"
msgstr "Adresse, auf der gelauscht wird (Standard 127.0.0.1)"

#: etiketto/cli.py:316
#, python-format
msgid "port to listen on (default %d)"
msgstr "Port, auf dem gelauscht wird (Standard %d)"

#: etiketto/cli.py:322
msgid ""
"file with the access token; else the environment variable ETIKETTO_TOKEN"
msgstr "Datei mit dem Zugangstoken; sonst die Umgebungsvariable ETIKETTO_TOKEN"

#: etiketto/cli.py:328
msgid "tokens.toml: named access tokens with roles"
msgstr "tokens.toml: benannte Zugangstoken mit Rollen"

#: etiketto/cli.py:330
msgid "also serve MCP at /mcp"
msgstr "zusätzlich MCP unter /mcp anbieten"

#: etiketto/cli.py:336
msgid "largest request body in MB (default 4)"
msgstr "grösster Anfrageinhalt in MB (Standard 4)"

#: etiketto/cli.py:345
msgid ""
"a reverse proxy whose X-Forwarded-For header names the client, e.g. "
"172.16.0.0/12; repeatable"
msgstr "ein Reverse Proxy, dessen Header X-Forwarded-For den Client nennt, zum Beispiel 172.16.0.0/12; wiederholbar"

#: etiketto/cli.py:354
msgid "allow requests from web pages of this origin; repeatable"
msgstr "Anfragen von Webseiten dieses Ursprungs erlauben; wiederholbar"

#: etiketto/cli.py:359
msgid "serve MCP on standard input and output"
msgstr "MCP über Standardein- und -ausgabe anbieten"

#: etiketto/cli.py:361
msgid ""
"Serve MCP on standard input and output, for AI clients such as Claude "
"Desktop."
msgstr "MCP über Standardein- und -ausgabe anbieten, für KI-Clients wie Claude Desktop."

#: etiketto/cli.py:371
msgid "manage the access tokens of the print server"
msgstr "die Zugangstoken des Druckservers verwalten"

#: etiketto/cli.py:372
msgid "Manage the access tokens of the print server."
msgstr "Die Zugangstoken des Druckservers verwalten."

#: etiketto/cli.py:377
msgid "make a token and add its hash to tokens.toml"
msgstr "ein Token erstellen und seinen Hash in tokens.toml eintragen"

#: etiketto/cli.py:378
msgid "Make a token, add its hash to tokens.toml and show the token once."
msgstr "Ein Token erstellen, seinen Hash in tokens.toml eintragen und das Token einmal zeigen."

#: etiketto/cli.py:380
msgid "name of the token, e.g. the device"
msgstr "Name des Tokens, zum Beispiel das Gerät"

#: etiketto/cli.py:385
msgid "preview: look only; print: also print; admin: also all jobs"
msgstr "preview: nur ansehen; print: auch drucken; admin: auch alle Aufträge"

#: etiketto/cli.py:387
msgid "tokens.toml to add it to"
msgstr "tokens.toml, in die es eingetragen wird"

#: etiketto/cli.py:393
msgid "only this printer of printers.toml; repeatable"
msgstr "nur dieser Drucker aus printers.toml; wiederholbar"

#: etiketto/cli.py:396
msgid "printers.toml, to check --printer"
msgstr "printers.toml, um --printer zu prüfen"

#: etiketto/cli.py:398
msgid "valid until, e.g. 2027-12-31"
msgstr "gültig bis, zum Beispiel 2027-12-31"

#: etiketto/cli.py:399
msgid "a note for people"
msgstr "eine Notiz für Menschen"

#: etiketto/cli.py:401
msgid "store the hash with scrypt instead of SHA-256"
msgstr "den Hash mit scrypt statt SHA-256 speichern"

#: etiketto/cli.py:407
msgid ""
"take a token you chose from standard input (stored with scrypt) instead of "
"making one"
msgstr "ein selbst gewähltes Token von der Standardeingabe nehmen (mit scrypt gespeichert), statt eines zu erstellen"

#: etiketto/cli.py:427 etiketto/server/config.py:216
#: etiketto/server/service.py:522
#, python-format
msgid "Unknown printer model: %s"
msgstr "Unbekanntes Druckermodell: %s"

#: etiketto/cli.py:434 etiketto/ui/files.py:66 etiketto/ui/texts.py:242
#: etiketto/server/service.py:670
#, python-format
msgid "Cannot open %s"
msgstr "%s lässt sich nicht öffnen"

