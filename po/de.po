#: etiketto/app.py:125 etiketto/ui/styles.py:183
msgid "Box and frame"
msgstr "Kasten und Rahmen"

#: etiketto/app.py:199 etiketto/cli.py:151
msgid "Design and print labels"
msgstr "Etiketten gestalten und drucken"

#. translators: replace with your name to be credited in the About dialog
#: etiketto/app.py:204
msgid "translator-credits"
msgstr "joshii-h"

#: etiketto/app.py:209
msgid "Protocol knowledge"
msgstr "Protokollwissen"

#: etiketto/app.py:214
#, python-format
msgid ""
"From %(projects)s and the manufacturers' manuals, written anew without their "
"code; see THIRD_PARTY_NOTICES.md"
msgstr "Aus %(projects)s und den Handbüchern der Hersteller, neu geschrieben ohne deren Code; siehe THIRD_PARTY_NOTICES.md"

#: etiketto/cli.py:106
#, python-format
msgid "expected NAME=VALUE: %s"
msgstr "NAME=VALUE erwartet: %s"

#: etiketto/cli.py:122
#, python-format
msgid "expected a whole number from %(min)d to %(max)d: %(value)s"
msgstr "ganze Zahl von %(min)d bis %(max)d erwartet: %(value)s"

#: etiketto/cli.py:140 etiketto/cli.py:144
#, python-format
msgid "expected rows such as 3-10, 5 or 7-: %s"
msgstr "Zeilen wie 3-10, 5 oder 7- erwartet: %s"

#: etiketto/cli.py:152
msgid "Without a command the application starts; label files given open in it."
msgstr "Ohne Befehl startet die App; angegebene Etikettendateien werden darin geöffnet."

#: etiketto/cli.py:158
msgid "print a label file without opening a window"
msgstr "eine Etikettendatei drucken, ohne ein Fenster zu öffnen"

#: etiketto/cli.py:159
msgid "Print a label file without opening a window."
msgstr "Eine Etikettendatei drucken, ohne ein Fenster zu öffnen."

#: etiketto/cli.py:161
msgid "the label (.etiketto)"
msgstr "das Etikett (.etiketto)"

#: etiketto/cli.py:164
#, python-format
msgid "printer model, by default the label's: %s"
msgstr "Druckermodell, sonst das des Etiketts: %s"

#: etiketto/cli.py:167
msgid "printer address, by default the one set in the app"
msgstr "Adresse des Druckers, sonst die in der App eingestellte"

#: etiketto/cli.py:170
msgid "number of copies"
msgstr "Anzahl Exemplare"

#: etiketto/cli.py:180
msgid ""
"text of the element NAME, or value of the variable {=NAME}; variables in a "
"text are filled in; repeatable"
msgstr "Text des Elements NAME oder Wert der Variable {=NAME}; Variablen in einem Text werden eingesetzt; mehrfach möglich"

#: etiketto/cli.py:190
msgid "like --set, but the value is used as it is: braces are no variables"
msgstr "wie --set, aber der Wert wird unverändert verwendet: Klammern sind keine Variablen"

#: etiketto/cli.py:196
msgid "counter of the first label, instead of the one saved in the label"
msgstr "Zähler des ersten Etiketts, statt des im Etikett gespeicherten"

#: etiketto/cli.py:201
msgid ""
"do not ask the printer before rendering (its model, tape and resolution)"
msgstr "den Drucker vor dem Rendern nicht abfragen (Modell, Band und Auflösung)"

#: etiketto/cli.py:207
msgid ""
"do not save the next counter value in the label (a read-only file); the next "
"print starts from the same number"
msgstr "den nächsten Zählerstand nicht im Etikett speichern (eine schreibgeschützte Datei); der nächste Druck beginnt mit derselben Nummer"

#: etiketto/cli.py:216
msgid ""
"serial labels: one label for each row of this CSV, ODS or XLSX file; by "
"default the data file of the label"
msgstr "Serienetiketten: ein Etikett für jede Zeile dieser CSV-, ODS- oder XLSX-Datei; sonst die Datendatei des Etiketts"

#: etiketto/cli.py:221
msgid "the sheet of the data file, by default the first"
msgstr "das Blatt der Datendatei, sonst das erste"

#: etiketto/cli.py:227
msgid "only these rows of the data file, e.g. 3-10, 5 or 7- (counted from 1)"
msgstr "nur diese Zeilen der Datendatei, z. B. 3-10, 5 oder 7- (ab 1 gezählt)"

#: etiketto/cli.py:230
msgid "check and render only, do not print"
msgstr "nur prüfen und zeichnen, nicht drucken"

#: etiketto/cli.py:236
msgid ""
"with --dry-run: save the images as the printer would get them, as PNG (- for "
"stdout: the first only)"
msgstr "mit --dry-run: die Bilder als PNG so speichern, wie der Drucker sie bekäme (- für stdout: nur das erste)"

#: etiketto/cli.py:242
msgid "list the printers found on the network"
msgstr "die im Netzwerk gefundenen Drucker auflisten"

#: etiketto/cli.py:243
msgid "List the printers found on the network: model, address, name."
msgstr "Die im Netzwerk gefundenen Drucker auflisten: Modell, Adresse, Name."

#: etiketto/cli.py:245
#, python-format
msgid "only this printer model: %s"
msgstr "nur dieses Druckermodell: %s"

#: etiketto/cli.py:264
#, python-format
msgid "Unknown printer model: %s"
msgstr "Unbekanntes Druckermodell: %s"

#: etiketto/cli.py:271 etiketto/ui/files.py:89 etiketto/ui/files.py:142
#: etiketto/ui/texts.py:290 etiketto/ui/texts.py:589
#, python-format
msgid "Cannot open %s"
msgstr "%s lässt sich nicht öffnen"

#: etiketto/cli.py:293
#, python-format
msgid "%s is not a date, expected e.g. 2026-12-31 or 2026-12-31T08:30"
msgstr "%s ist kein Datum, erwartet z. B. 2026-12-31 oder 2026-12-31T08:30"

#: etiketto/cli.py:323
#, python-format
msgid "{=%s} is filled in when printing and cannot be set"
msgstr "{=%s} wird beim Drucken eingesetzt und kann nicht vorgegeben werden"

#: etiketto/cli.py:328
#, python-format
msgid "The label has no element or variable named %s"
msgstr "Das Etikett hat kein Element und keine Variable namens %s"

#: etiketto/cli.py:352 etiketto/ui/printing.py:107
msgid "The label is empty"
msgstr "Das Etikett ist leer"

#: etiketto/cli.py:385
msgid "Cannot write the output"
msgstr "Die Ausgabe lässt sich nicht schreiben"

#: etiketto/cli.py:416
msgid "--output writes PNG images: give a name ending in .png"
msgstr "--output schreibt PNG-Bilder: einen Namen mit der Endung .png angeben"

#: etiketto/cli.py:440 etiketto/cli.py:644 etiketto/ui/printing.py:546
#: etiketto/ui/printing.py:697
msgid "The label cannot be prepared for printing."
msgstr "Das Etikett lässt sich nicht für den Druck vorbereiten."

#: etiketto/cli.py:522
msgid "No printer found – give its address with --host"
msgstr "Kein Drucker gefunden – Adresse mit --host angeben"

#: etiketto/cli.py:524
msgid ""
"Several printers found – choose one with --host (etiketto list-printers)"
msgstr "Mehrere Drucker gefunden – einen mit --host wählen (etiketto list-printers)"

#: etiketto/cli.py:535 etiketto/ui/texts.py:623
#, python-format
msgid "Cannot save %s"
msgstr "%s lässt sich nicht speichern"

#: etiketto/cli.py:537
msgid "the labels were printed, but the next counter value was not saved"
msgstr "die Etiketten wurden gedruckt, aber der nächste Zählerstand wurde nicht gespeichert"

#: etiketto/cli.py:552
msgid "nothing was printed: the next counter value could not be saved"
msgstr "nichts gedruckt: der nächste Zählerstand liesse sich nicht speichern"

#: etiketto/cli.py:612 etiketto/cli.py:639 etiketto/cli.py:876
msgid "Interrupted"
msgstr "Abgebrochen"

#: etiketto/cli.py:721
msgid "The label uses a data file outside its folder: give it with --data"
msgstr "Das Etikett verwendet eine Datendatei ausserhalb seines Ordners: mit --data angeben"

#: etiketto/cli.py:727
msgid "--sheet and --rows need a data file (--data)"
msgstr "--sheet und --rows gehen nur mit einer Datendatei (--data)"

#: etiketto/cli.py:747 etiketto/ui/printing.py:575
msgid "No rows to print"
msgstr "Keine Zeilen zum Drucken"

#: etiketto/cli.py:756 etiketto/ui/window.py:739
#, python-format
msgid "No such column: %s"
msgstr "Unbekannte Spalte: %s"

#: etiketto/cli.py:761 etiketto/ui/printing.py:648
msgid ""
"The barcode or QR code of these rows cannot be made from their values, for "
"example an EAN-13 with letters or an empty cell. Correct the data file and "
"read it again, or print without these rows."
msgstr "Der Strichcode oder QR-Code dieser Zeilen lässt sich aus ihren Werten nicht erstellen, zum Beispiel ein EAN-13 mit Buchstaben oder eine leere Zelle. Die Datendatei korrigieren und erneut lesen oder ohne diese Zeilen drucken."

#: etiketto/cli.py:766 etiketto/ui/printing.py:653
#, python-format
msgid "Rows: %s"
msgstr "Zeilen: %s"

#: etiketto/cli.py:774
#, python-format
msgid "Waiting for another print of %s to finish…"
msgstr "Warten, bis ein anderer Druck von %s fertig ist …"

#: etiketto/cli.py:781
#, python-format
msgid "%s is still locked by another print – try again later"
msgstr "%s ist noch von einem anderen Druck gesperrt – später erneut versuchen"

#: etiketto/cli.py:787
msgid "--output needs --dry-run"
msgstr "--output geht nur mit --dry-run"

#: etiketto/cli.py:799
msgid "The next counter value is not saved: the next print repeats the numbers"
msgstr "Der nächste Zählerstand wird nicht gespeichert: Der nächste Druck wiederholt die Nummern"

